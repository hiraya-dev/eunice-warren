{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eunice-warren",
  "compatibility_date": "2026-08-13",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "RSVP_STORE": "d1",
    "ACCESS_TEAM_DOMAIN": "warren-eunice.cloudflareaccess.com",
    "ACCESS_AUD": "7622f360d30408b0c41a184357254a5a548fd6e31b8cf433ecf6483cb1719202",
  },

  "send_email": [{ "name": "RSVP_EMAIL" }],

  "d1_databases": [{
    "binding": "DB",
    "database_name": "eunice-warren",
    "database_id": "e61094a2-492b-41df-9b58-804de5e834da",
    "migrations_dir": "migrations",
  }],

  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page",
    "run_worker_first": ["/admin", "/admin/*", "/_actions/*", "/api/*"],
  },

  "ratelimits": [
    {
      "name": "RSVP_LOOKUP_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    { "name": "RSVP_SUBMIT_LIMITER", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
    { "name": "SONG_LIMITER", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } },
    { "name": "SONG_SEARCH_LIMITER", "namespace_id": "1005", "simple": { "limit": 30, "period": 60 } },
  ],

  "env": {
    "test": {
      "vars": {
        "RSVP_STORE": "fake",
        "PUBLIC_RSVP_STORE": "fake",
        "PUBLIC_TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
      },
    },
  },

  "previews": {
    "vars": {
      "RSVP_STORE": "fake",
      "PUBLIC_RSVP_STORE": "fake",
      "ACCESS_TEAM_DOMAIN": "",
      "ACCESS_AUD": "",
    },
  },

  "observability": {
    "enabled": true,
  },
}
