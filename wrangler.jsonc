{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eunice-warren",
  "compatibility_date": "2026-08-13",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "RSVP_STORE": "d1",
    // Cloudflare Access "Guest ledger" app on thefisheswedding.com/admin (and www).
    // Set here, not in the dashboard: deploys overwrite dashboard vars.
    "ACCESS_TEAM_DOMAIN": "warren-eunice.cloudflareaccess.com",
    "ACCESS_AUD": "7622f360d30408b0c41a184357254a5a548fd6e31b8cf433ecf6483cb1719202",
  },

  // Sends only to verified Email Routing destinations on the free plan; recipients come from the NOTIFY_TO secret.
  "send_email": [{ "name": "RSVP_EMAIL" }],

  "d1_databases": [{
    "binding": "DB",
    "database_name": "eunice-warren",
    "database_id": "e61094a2-492b-41df-9b58-804de5e834da",
    "migrations_dir": "migrations",
  }],

  // The adapter entrypoint serves static assets and runs Astro actions on demand.
  // Production uses D1; the test environment selects fake fixtures.
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page",
    // Browser navigations to a missing asset get 404.html without reaching the
    // Worker, which would hide /admin from a real browser. A pattern list also
    // sends every other non-listed POST to the asset service (405 locally), so
    // the Worker's own routes (actions, API) are listed too.
    "run_worker_first": ["/admin", "/admin/*", "/_actions/*", "/api/*"],
  },

  "ratelimits": [
    {
      "name": "RSVP_LOOKUP_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    { "name": "RSVP_SUBMIT_LIMITER", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
    { "name": "SONG_LIMITER", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } },
    { "name": "SONG_SEARCH_LIMITER", "namespace_id": "1005", "simple": { "limit": 30, "period": 60 } },
  ],

  "env": {
    "test": {
      "vars": {
        "RSVP_STORE": "fake",
        "PUBLIC_RSVP_STORE": "fake",
        "PUBLIC_TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
      },
    },
  },

  // Previews share the Worker's production bindings, so explicitly use the fake
  // stores and client mode when `npx wrangler preview` publishes a branch.
  "previews": {
    "vars": {
      "RSVP_STORE": "fake",
      "PUBLIC_RSVP_STORE": "fake",
      // Blank so preview /admin shows the sample host for Local review, even
      // if previews inherit the production ADMIN_HOSTS secret.
      "ACCESS_TEAM_DOMAIN": "",
      "ACCESS_AUD": "",
    },
  },

  // Add a `routes` entry to serve this on your own domain. Until then it is
  // reachable at https://eunice-warren.<your-subdomain>.workers.dev.

  "observability": {
    "enabled": true,
  },
}
