---
import "@/styles/global.css";
import "lenis/dist/lenis.css";
import BaseHead from "@/components/utility/BaseHead.astro";
import SkipLink from "@/components/global/SkipLink.astro";
import Nav from "@/components/global/Nav.astro";
import Footer from "@/components/global/Footer.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place. */
  theme?: "inherit" | "light" | "dark" | "brand";
  /**
   * Fix the nav over the page rather than letting it stick in flow, so the
   * first section starts underneath it. Give that section
   * `paddingTop="navoverlap"` to clear the bar.
   */
  overlap?: boolean;
};

const { theme = "inherit", overlap = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en" class:list={[theme !== "inherit" && `theme-${theme}`]}>
  <head>
    <BaseHead {...seo} />
    <slot name="head" />
  </head>
  <body>
    <SkipLink />
    <Nav overlap={overlap} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import { initDrawPathOnScroll } from "@/scripts/draw-path.ts";
  import { initHighlightText } from "@/scripts/highlight-text.ts";
  import { initGlobalParallax, initScroll } from "@/scripts/scroll.ts";
  import { initFadeIn } from "@/scripts/fade-in.ts";
  import { initTabSystem } from "@/scripts/tab-system.ts";
  import { initStayCompass } from "@/scripts/stay-compass.ts";

  initScroll();
  initGlobalParallax();
  initDrawPathOnScroll();
  initHighlightText();
  initTabSystem();
  initFadeIn();
  initStayCompass();
  document.addEventListener("astro:page-load", initDrawPathOnScroll);
  document.addEventListener("astro:page-load", initHighlightText);
  document.addEventListener("astro:page-load", initTabSystem);
  document.addEventListener("astro:page-load", initFadeIn);
  document.addEventListener("astro:page-load", initStayCompass);
</script>
