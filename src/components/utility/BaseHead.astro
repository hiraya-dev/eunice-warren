---
import { Font } from "astro:assets";
import { SITE_INDEXABLE, SITE_NAME, SITE_DESCRIPTION } from "@/consts.ts";
import { isNoindexRoute } from "@/utils/seo.ts";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps;

const {
  title,
  description = SITE_DESCRIPTION,
  image = "/og-image.jpg",
  type = "website",
  noindex,
} = Astro.props;

const isNoindex = !SITE_INDEXABLE || (noindex ?? isNoindexRoute(Astro.url.pathname));

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<meta charset="utf-8" />
<style is:inline>
  @layer base, patterns, components, utilities;
</style>
<meta name="viewport" content="width=device-width, initial-scale=1" />
{Astro.url.pathname === "/" && <script is:inline>
  try {
    const raw = localStorage.getItem("ew-guest-v1");
    const state = raw ? JSON.parse(raw) : null;
    if (!state || (state.skipped !== true && (typeof state.name !== "string" || !state.name.trim()))) document.documentElement.classList.add("ew-preloader-pending");
  } catch {
    document.documentElement.classList.add("ew-preloader-pending");
  }
</script>}
<Font cssVariable="--font-neue-montreal" preload={[{ weight: 400, style: "normal" }]} />
<Font cssVariable="--font-editorial-new" preload={[{ weight: 200, style: "normal" }]} />
<Font cssVariable="--font-fraktion-mono" />
<Font cssVariable="--font-delicious-handrawn" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{isNoindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />
