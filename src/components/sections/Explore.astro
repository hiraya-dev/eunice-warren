---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { HTMLAttributes } from "astro/types";
import Stamp from "@/components/media/Stamp.astro";
import Arrow from "@/assets/icons/arrow-full.svg";
import stamp from "@/assets/images/stamps/shell.jpg";
import boatSticker from "@/assets/images/explore/sticker-boat.svg?raw";
import fishSticker from "@/assets/images/explore/sticker-fish.svg?raw";
import shellSticker from "@/assets/images/explore/sticker-shell.svg?raw";
import sunSticker from "@/assets/images/explore/sticker-sun.svg?raw";

interface Props extends HTMLAttributes<"section"> {}

const { class: className, ...rest } = Astro.props;
const notes = (await getCollection("explore")).sort(
  (a, b) => a.data.order - b.data.order,
);
const stickers = {
  sun: sunSticker,
  shell: shellSticker,
  fish: fishSticker,
  boat: boatSticker,
};
---

<section
  id="explore"
  class:list={["explore_wrap", "theme-light", className]}
  {...rest}
>
  <div class="explore_layout">
    <div
      class="explore_slider"
      data-gsap-slider-init
      role="region"
      aria-roledescription="carousel"
      aria-label="Field notes"
    >
      <header class="explore_header" data-fade-in>
        <h2 class="explore_title" data-fade-in-item>
          Field notes<br />on Boracay
        </h2>
        <div class="explore_stamp" data-fade-in-item><Stamp><Image src={stamp} alt="" aria-hidden="true" width={100} height={129} densities={[1, 2]} loading="lazy" /></Stamp></div>
        <div
          class="explore_controls explore_controls-header"
          data-fade-in-item
          data-gsap-slider-controls
        >
          <button
            class="explore_control explore_control-prev"
            type="button"
            data-gsap-slider-control="prev"
            aria-label="Previous note"
          >
            <span class="explore_control-icon" aria-hidden="true"
              ><Arrow /></span
            >
          </button>
          <button
            class="explore_control explore_control-next"
            type="button"
            data-gsap-slider-control="next"
            aria-label="Next note"
          >
            <span class="explore_control-icon" aria-hidden="true"
              ><Arrow /></span
            >
          </button>
        </div>
      </header>

      <div class="explore_collection" data-gsap-slider-collection data-fade-in data-fade-in-item>
        <div class="explore_list gsap-slider__list" data-gsap-slider-list>
          {
            notes.map((note) => (
              <div class="explore_item gsap-slider__item" data-gsap-slider-item>
                <article
                  class:list={[
                    "explore_card",
                    `explore_card-offset-${note.data.offset}`,
                  ]}
                  style={`--_tilt: ${note.data.tilt}deg`}
                >
                  <div class="explore_photo">
                    <Image
                      src={note.data.image}
                      alt={note.data.alt}
                      width={400}
                      height={400}
                      widths={[280, 400]}
                      sizes="(min-width: 64rem) 25rem, 18.125rem"
                      loading="lazy"
                    />
                  </div>
                  <div class="explore_card-title-row">
                    <h3>{note.data.title}</h3>
                    <span class="explore_tag">{note.data.tag}</span>
                  </div>
                  <p>{note.data.body}</p>
                  <span
                    class="explore_sticker"
                    data-sticker={note.data.sticker}
                    aria-hidden="true"
                    set:html={stickers[note.data.sticker]}
                  />
                </article>
              </div>
            ))
          }
        </div>
      </div>

      <footer class="explore_footer" data-fade-in data-fade-in-item>
        <span class="explore_counter" data-gsap-slider-counter aria-live="polite"
          >-- / -- <span aria-hidden="true">· SWIPE →</span></span
        >
        <div
          class="explore_controls explore_controls-footer"
          data-gsap-slider-controls
        >
          <button
            class="explore_control explore_control-prev"
            type="button"
            data-gsap-slider-control="prev"
            aria-label="Previous note"
          >
            <span class="explore_control-icon" aria-hidden="true"
              ><Arrow /></span
            >
          </button>
          <button
            class="explore_control explore_control-next"
            type="button"
            data-gsap-slider-control="next"
            aria-label="Next note"
          >
            <span class="explore_control-icon" aria-hidden="true"
              ><Arrow /></span
            >
          </button>
        </div>
      </footer>
    </div>
  </div>
</section>

<style>
  @layer components {
    .explore_wrap {
      position: relative;
      overflow: clip;
      --explore-inset: max(
        0px,
        calc((100% - var(--site-margin) - var(--max-width-main)) / 2)
      );
      padding: var(--section-space-medium) 0 var(--section-space-medium)
        var(--site-margin);
      background: var(--light-100) var(--background-texture) center / 32rem
        repeat;
      color: var(--dark-900);
    }
    .explore_layout {
      width: min(var(--max-width-main), 100%);
      margin-left: var(--explore-inset);
    }
    .explore_slider {
      --slider-status: on;
      --slider-gap: 1.5rem;
      width: 100%;
    }
    .explore_header {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: var(--space-5);
      padding-right: var(--space-7);
    }
    .explore_title {
      margin: 0;
      color: var(--dark-900);
      font: var(--secondary-regular) var(--h1) / var(--line-height-medium)
        var(--secondary-family);
      letter-spacing: var(--letter-spacing-tight);
    }
    .explore_stamp {
      position: absolute;
      top: 6rem;
      left: calc(
        var(--site-margin) +
          max(
            0px,
            calc((100% - 2 * var(--site-margin) - var(--max-width-main)) / 2)
          ) + 33.5rem
      );
      width: 7rem;
      height: 8.75rem;
      rotate: -8deg;
      transform-origin: 0 0;
    }
    .explore_controls {
      display: flex;
      flex: none;
      gap: var(--space-2);
    }
    .explore_control {
      display: grid;
      width: 3.25rem;
      height: 3.25rem;
      flex: none;
      place-items: center;
      padding: 0;
      border: 0.09375rem solid var(--dark-900);
      border-radius: 50%;
      background: transparent;
      color: var(--dark-900);
      cursor: pointer;
      transition: opacity 0.2s ease, scale 150ms cubic-bezier(0.23, 1, 0.32, 1);
    }
    .explore_control-next {
      border-color: var(--dark-900);
      background: var(--dark-900);
      color: var(--light-100);
    }
    .explore_control-icon {
      display: block;
      width: 1.25rem;
      height: 1rem;
    }
    .explore_control-icon svg {
      display: block;
      width: 100%;
      height: 100%;
    }
    .explore_control-prev .explore_control-icon {
      rotate: 180deg;
    }
    .explore_control:focus-visible {
      outline: var(--focus-width) solid var(--dark-900);
      outline-offset: var(--focus-offset);
    }
    .explore_control:active:not(:disabled):not([data-gsap-slider-control-status="not-active"]) { scale: 0.97; }
    [data-gsap-slider-control-status="not-active"] {
      opacity: 0.4;
      pointer-events: none;
    }
    .explore_collection {
      width: calc(
        100vw - var(--site-margin) -
          max(
            0px,
            calc((100vw - 2 * var(--site-margin) - var(--max-width-main)) / 2)
          )
      );
      margin-top: var(--space-6);
    }
    .explore_list {
      display: flex;
      align-items: flex-start;
      padding: var(--space-5) 0 var(--space-4) var(--space-1);
      user-select: none;
      will-change: transform;
      touch-action: pan-y;
      backface-visibility: hidden;
    }
    [data-gsap-slider-list-status="grab"] {
      cursor: grab;
    }
    [data-gsap-slider-list-status="grabbing"] {
      cursor: grabbing;
    }
    .explore_item {
      width: 25rem;
      margin-right: var(--slider-gap);
      flex: none;
    }
    [data-gsap-slider-item]:last-child {
      margin-right: 0;
    }
    .explore_card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding: var(--space-3) var(--space-3) var(--space-4);
      background: var(--light-200)
        url("../../assets/textures/polaroid-paper.jpg") center / 32rem repeat;
      box-shadow: 0 1.125rem 2.5rem rgb(31 47 92 / 16%);
      transform-origin: center;
      rotate: var(--_tilt, 0deg);
    }
    .explore_card-offset-space-5 {
      margin-top: var(--space-5);
    }
    .explore_card-offset-space-6 {
      margin-top: var(--space-6);
    }
    .explore_photo {
      width: 100%;
      height: 25rem;
      overflow: clip;
    }
    .explore_photo img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .explore_card-title-row {
      display: flex;
      align-items: last baseline;
      justify-content: space-between;
      gap: var(--space-2);
    }
    .explore_card h3 {
      --_trim-top: 0.5lh;
      --_trim-bottom: 0.5lh;
      min-width: 0;
      margin: 0;
      color: var(--dark-900);
      font: italic var(--secondary-ultralight) var(--h6) / 1.15
        var(--secondary-family);
    }
    .explore_tag {
      flex: none;
      color: var(--accent-500);
      font: var(--primary-regular) var(--eyebrow) / 1rem var(--mono-family);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .explore_card p {
      --_trim-top: 0.5lh;
      --_trim-bottom: 0.5lh;
      margin: 0;
      color: var(--dark-700);
      font: var(--primary-regular) var(--text-main) / 1.5 var(--primary-family);
    }
    .explore_sticker {
      position: absolute;
      z-index: 1;
      display: grid;
      width: 8.125rem;
      height: 8.125rem;
      place-items: center;
      filter: drop-shadow(0 0.1875rem 0.25rem rgb(31 47 92 / 20%));
      transform-origin: 0 0;
    }
    .explore_sticker :global(svg) {
      width: 80%;
      height: 80%;
    }
    .explore_sticker[data-sticker="sun"] {
      top: -3.125rem;
      right: -3.125rem;
      rotate: 12deg;
    }
    .explore_sticker[data-sticker="shell"] {
      bottom: 5.625rem;
      left: -3rem;
      rotate: -14deg;
    }
    .explore_sticker[data-sticker="fish"] {
      top: 18.75rem;
      right: -2.875rem;
      rotate: -8deg;
    }
    .explore_sticker[data-sticker="boat"] {
      top: -3.25rem;
      left: -2.75rem;
      rotate: -10deg;
    }
    .explore_footer {
      display: none;
    }
    [data-gsap-slider-status="not-active"] [data-gsap-slider-controls] {
      display: none;
    }
  }

  @media (min-width: 90.001rem) {
    .explore_header {
      padding-right: 0;
    }
  }

  @media (max-width: 63.999rem) {
    .explore_wrap {
      padding-top: var(--section-space-small);
      padding-bottom: var(--section-space-medium);
    }
    .explore_header {
      padding-right: var(--site-margin);
    }
    .explore_title {
      line-height: var(--line-height-small);
    }
    .explore_stamp {
      top: 4.375rem;
      right: 1.75rem;
      left: auto;
      width: 4rem;
      height: 5rem;
    }
    .explore_controls-header {
      display: none;
    }
    .explore_collection {
      margin-top: var(--space-6);
    }
    .explore_item {
      width: min(18.125rem, calc(100vw - 2.5rem));
    }
    .explore_card {
      padding: var(--space-3) var(--space-3) var(--space-4);
    }
    .explore_photo {
      height: 17.5rem;
    }
    .explore_sticker {
      width: 5.75rem;
      height: 5.75rem;
    }
    .explore_sticker[data-sticker="sun"] {
      top: -2.125rem;
      right: -1.75rem;
    }
    .explore_sticker[data-sticker="fish"] {
      top: 13.125rem;
      right: -1.75rem;
    }
    .explore_sticker[data-sticker="boat"] {
      top: -2.25rem;
      left: -1.875rem;
    }
    .explore_footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
      padding: var(--space-6) var(--site-margin) 0 0;
    }
    .explore_counter {
      color: var(--dark-700);
      font: var(--primary-regular) var(--eyebrow) / 1rem var(--mono-family);
      letter-spacing: var(--letter-spacing-wide);
      white-space: nowrap;
    }
    .explore_control {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  @media (max-width: 24rem) {
    .explore_item {
      width: 17.5rem;
    }
    .explore_photo {
      height: 16.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .explore_control {
      transition: none;
    }
  }
</style>

<script>
  import "@/scripts/gsap-slider";
</script>
