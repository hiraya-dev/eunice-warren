---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { HTMLAttributes } from "astro/types";
import Stamp from "@/components/media/Stamp.astro";
import stamp from "@/assets/images/stamps/paraw.jpg";
import familyPolaroid from "@/assets/images/entourage/polaroid-family.jpg";
import sampaguita from "@/assets/images/entourage/keepsake-sampaguita.jpg";
import barkadaPolaroid from "@/assets/images/entourage/polaroid-barkada.jpg";
import willysRock from "@/assets/images/stamps/willys-rock.jpg";
import pawikan from "@/assets/images/stamps/pawikan.jpg";

interface Props extends HTMLAttributes<"section"> {}

const { class: className, ...rest } = Astro.props;
const [{ data }] = await getCollection("entourage");
---

<section id="entourage" class:list={["entourage_wrap", className]} {...rest}>
  <div class="entourage_stamp"><Stamp><Image src={stamp} alt="" width={90} height={116} densities={[1, 2]} aria-hidden="true" /></Stamp></div>
  <div class="entourage_layout">
    <header class="entourage_header" data-fade-in>
      <h2 class="entourage_title" data-fade-in-item>The ones who<br />stand with us</h2>
      <p class="entourage_intro" data-fade-in-item>Our parents, our ninongs and ninangs, and the friends who'll walk the sand ahead of us. Salamat — we couldn't do this without you.</p>
    </header>

    <div class="entourage_programme">
      {data.groups.map((group) => (
        <div class:list={["entourage_block", `entourage_${group.id}`]} data-fade-in>
          {group.title && (
            <h3 class="entourage_group-title" data-fade-in-item>
              <span>{group.title}</span>{group.italic && <em>{group.italic}</em>}
            </h3>
          )}
          {group.id === "parents" && (
            <div class="entourage_keepsake entourage_family-polaroid" aria-hidden="true">
              <Image src={familyPolaroid} alt="" width={138} height={138} densities={[1, 2]} loading="lazy" />
            </div>
          )}
          {group.id === "principal-sponsors" && (
            <>
              <svg class="entourage_keepsake entourage_postmark" viewBox="0 0 260 96" width="260" height="96" fill="none" aria-hidden="true">
                <circle cx="48" cy="48" r="44" stroke-width="2.5" />
                <circle cx="48" cy="48" r="34" stroke-width="1.5" />
                <text x="48" y="44" text-anchor="middle" font-size="10" letter-spacing="1">BORACAY</text>
                <text x="48" y="58" text-anchor="middle" font-size="10" letter-spacing="1">01.14.27</text>
                <path d="M100 30 C120 22 140 38 160 30 S200 22 220 30 S250 38 258 32" stroke-width="2.5" />
                <path d="M100 48 C120 40 140 56 160 48 S200 40 220 48 S250 56 258 50" stroke-width="2.5" />
                <path d="M100 66 C120 58 140 74 160 66 S200 58 220 66 S250 74 258 68" stroke-width="2.5" />
              </svg>
              <div class="entourage_keepsake entourage_willys-rock"><Stamp><Image src={willysRock} alt="" width={100} height={129} densities={[1, 2]} loading="lazy" aria-hidden="true" /></Stamp></div>
            </>
          )}
          {group.id === "secondary-sponsors" && (
            <Image class="entourage_keepsake entourage_sampaguita" src={sampaguita} alt="" width={92} height={130} densities={[1, 2]} loading="lazy" aria-hidden="true" />
          )}
          {group.id === "bridal-party" && (
            <Image class="entourage_keepsake entourage_barkada-polaroid" src={barkadaPolaroid} alt="" width={138} height={138} densities={[1, 2]} loading="lazy" aria-hidden="true" />
          )}
          <div class="entourage_rows">
            {group.rows.map((row, rowIndex) => (
              <div class="entourage_row" data-fade-in-item>
                {row.roles.map((role, roleIndex) => {
                  const labelId = `${group.id}-row-${rowIndex}-role-${roleIndex}`;
                  return (
                    <div class="entourage_role">
                      <h4 id={labelId}>{role.label}</h4>
                      <ul aria-labelledby={labelId}>
                        {role.names.map((name) => <li>{name}</li>)}
                      </ul>
                    </div>
                  );
                })}
                {group.id === "bridal-party" && rowIndex === group.rows.length - 1 && (
                  <div class="entourage_keepsake entourage_pawikan"><Stamp><Image src={pawikan} alt="" width={84} height={108} densities={[1, 2]} loading="lazy" aria-hidden="true" /></Stamp></div>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
  <div class="entourage_scallop" aria-hidden="true"></div>
</section>

<style>
  @layer components {
    .entourage_wrap { position: relative; overflow: clip; padding: var(--section-space-medium) var(--site-margin); background: var(--light-100) var(--background-texture) center / 32rem repeat; color: var(--dark-900); }
    .entourage_layout { display: flex; width: 100%; max-width: var(--max-width-main); margin-inline: auto; flex-direction: column; align-items: center; gap: var(--space-8); }
    .entourage_header { display: flex; flex-direction: column; align-items: center; gap: var(--space-5); text-align: center; }
    .entourage_title { margin: 0; font: var(--secondary-regular) var(--h1) / var(--line-height-medium) var(--secondary-family); font-size: min(var(--h1), calc((100vw - 2 * var(--site-margin)) / 5.6)); letter-spacing: var(--letter-spacing-tight); }
    .entourage_intro { max-width: 31.25rem; margin: 0; font: var(--primary-regular) var(--text-main) / var(--line-height-huge) var(--primary-family); }
    .entourage_programme { display: flex; width: 100%; max-width: 60rem; flex-direction: column; gap: 4.5rem; text-align: center; }
    .entourage_block { position: relative; display: flex; flex-direction: column; align-items: center; gap: var(--space-7); }
    .entourage_officiant, .entourage_parents { gap: 0; }
    .entourage_principal-sponsors, .entourage_secondary-sponsors { gap: 2.5rem; }
    .entourage_bridal-party { gap: 3.5rem; }
    .entourage_group-title { display: flex; align-items: baseline; justify-content: center; gap: var(--space-3); margin: 0; font: var(--secondary-regular) var(--h4) / 1.25 var(--secondary-family); letter-spacing: var(--letter-spacing-snug); }
    .entourage_group-title em { font-weight: var(--secondary-ultralight); }
    .entourage_rows { display: flex; width: 100%; flex-direction: column; gap: var(--space-7); }
    .entourage_row { display: grid; width: 100%; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
    .entourage_officiant .entourage_row { grid-template-columns: 1fr; }
    .entourage_bridal-party .entourage_row:first-child { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .entourage_bridal-party .entourage_rows { gap: 3.5rem; }
    .entourage_secondary-sponsors .entourage_row, .entourage_bridal-party .entourage_row:last-child { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .entourage_bridal-party .entourage_row:last-child { position: relative; grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .entourage_role { display: flex; min-width: 0; flex-direction: column; align-items: center; gap: var(--space-1); }
    .entourage_role h4 { margin: 0; color: var(--dark-700); font: italic 400 1.25rem / 1.4 var(--secondary-family); }
    .entourage_role ul { display: flex; margin: 0; padding: 0; flex-direction: column; list-style: none; color: var(--dark-900); font: var(--secondary-regular) var(--text-large) / 1.5 var(--secondary-family); }
    .entourage_keepsake { position: absolute; z-index: 1; pointer-events: none; transform-origin: 0 0; }
    .entourage_family-polaroid, .entourage_barkada-polaroid { --_paper: #fbf8f1; width: 9.75rem; padding: 0.5625rem 0.5625rem 2.125rem; background: var(--_paper); box-shadow: 0 0.0625rem 0.0625rem color-mix(in srgb, var(--dark-900) 16%, transparent), 0 0.625rem 1.375rem color-mix(in srgb, var(--dark-900) 12%, transparent); }
    .entourage_family-polaroid { top: -4.375rem; left: calc(50% - 39.25rem); rotate: -5deg; }
    .entourage_barkada-polaroid { top: 0; left: calc(50% + 29.75rem); rotate: 5deg; }
    .entourage_family-polaroid img, .entourage_barkada-polaroid img { display: block; width: 8.625rem; height: 8.625rem; object-fit: cover; }
    .entourage_postmark { top: -4.375rem; left: calc(50% + 10.625rem); width: 16.25rem; height: 6rem; overflow: visible; rotate: -8deg; opacity: 0.16; stroke: var(--dark-900); fill: none; }
    .entourage_postmark text { fill: var(--dark-900); font-family: var(--mono-family); }
    .entourage_willys-rock { top: -0.5rem; left: calc(50% + 30.875rem); width: 7.25rem; height: 9.0625rem; rotate: -4deg; }
    .entourage_sampaguita { top: -0.75rem; left: calc(50% - 38rem); width: 5.75rem; height: 8.125rem; object-fit: cover; rotate: 4deg; box-shadow: 0 0.0625rem 0.0625rem color-mix(in srgb, var(--dark-900) 14%, transparent), 0 0.5rem 1.125rem color-mix(in srgb, var(--dark-900) 10%, transparent); }
    .entourage_pawikan { top: -2rem; left: calc(50% - 37.25rem); width: 6rem; height: 7.5rem; rotate: -6deg; }
    .entourage_stamp { position: absolute; top: 9.375rem; left: calc(50% + 21.25rem); width: 6.5rem; height: 8.125rem; transform: rotate(6deg); transform-origin: top left; }
    .entourage_scallop { position: absolute; right: 0; bottom: 0; left: 0; height: 0.8125rem; background: linear-gradient(var(--dark-900) 0 0) bottom / 100% 0.125rem no-repeat, radial-gradient(circle at 1.125rem 0.6875rem, var(--dark-900) 0.6875rem, transparent calc(0.6875rem + 0.5px)) 0 0 / 2.25rem 0.6875rem repeat-x; }
  }

  @media (max-width: 61.999rem) {
    .entourage_wrap { padding-block: var(--section-space-medium); }
    .entourage_stamp { top: var(--space-5); right: var(--site-margin); left: auto; width: 3rem; height: 3.75rem; }
    .entourage_programme { gap: var(--space-7); }
    .entourage_block { gap: var(--space-5); }
    .entourage_officiant, .entourage_parents { gap: 0; }
    .entourage_principal-sponsors, .entourage_secondary-sponsors, .entourage_bridal-party { gap: var(--space-5); }
    .entourage_bridal-party .entourage_rows { gap: var(--space-5); }
    .entourage_group-title { gap: var(--space-2); line-height: 1.125; }
    .entourage_rows { gap: var(--space-5); }
    .entourage_row { gap: var(--space-4) var(--space-2); }
    .entourage_role h4 { font-size: 1rem; line-height: 1.5; }
    .entourage_role ul { font-size: 1.25rem; line-height: 1.6; }
    .entourage_principal-sponsors .entourage_row { grid-template-columns: 1fr; gap: var(--space-5); }
    .entourage_secondary-sponsors .entourage_row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .entourage_secondary-sponsors .entourage_role:last-child { grid-column: 1 / -1; justify-self: center; }
    .entourage_bridal-party .entourage_row:first-child { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .entourage_bridal-party .entourage_row:first-child .entourage_role:nth-child(1) { grid-column: 1; grid-row: 1; }
    .entourage_bridal-party .entourage_row:first-child .entourage_role:nth-child(2) { grid-column: 1 / -1; grid-row: 2; }
    .entourage_bridal-party .entourage_row:first-child .entourage_role:nth-child(3) { grid-column: 2; grid-row: 1; }
    .entourage_bridal-party .entourage_row:last-child { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 79.999rem) {
    .entourage_keepsake { display: none; }
  }
</style>
