---
import { Image } from "astro:assets";
import type { HTMLAttributes } from "astro/types";
import beach from "@/assets/images/hero/polaroid-white-beach.jpg";
import sailboatBeach from "@/assets/images/ribbon/stamp-sailboat-beach.jpg";
import sailboat from "@/assets/images/footer/stamp-sunset.jpg";
import arch from "@/assets/images/wedding/polaroid-arch.jpg";

interface Props extends HTMLAttributes<"section"> {}

const { class: className, ...rest } = Astro.props;

const stampPath =
  "M0 0L3 0A3.5 3.5 0 0 0 10 0L14 0A3.5 3.5 0 0 0 21 0L25 0A3.5 3.5 0 0 0 32 0L36 0A3.5 3.5 0 0 0 43 0L47 0A3.5 3.5 0 0 0 54 0L58 0A3.5 3.5 0 0 0 65 0L68 0L68 5.5A3.5 3.5 0 0 0 68 12.5L68 16.5A3.5 3.5 0 0 0 68 23.5L68 27.5A3.5 3.5 0 0 0 68 34.5L68 38.5A3.5 3.5 0 0 0 68 45.5L68 49.5A3.5 3.5 0 0 0 68 56.5L68 60.5A3.5 3.5 0 0 0 68 67.5L68 71.5A3.5 3.5 0 0 0 68 78.5L68 84L65 84A3.5 3.5 0 0 0 58 84L54 84A3.5 3.5 0 0 0 47 84L43 84A3.5 3.5 0 0 0 36 84L32 84A3.5 3.5 0 0 0 25 84L21 84A3.5 3.5 0 0 0 14 84L10 84A3.5 3.5 0 0 0 3 84L0 84L0 78.5A3.5 3.5 0 0 0 0 71.5L0 67.5A3.5 3.5 0 0 0 0 60.5L0 56.5A3.5 3.5 0 0 0 0 49.5L0 45.5A3.5 3.5 0 0 0 0 38.5L0 34.5A3.5 3.5 0 0 0 0 27.5L0 23.5A3.5 3.5 0 0 0 0 16.5L0 12.5A3.5 3.5 0 0 0 0 5.5Z";

const ribbons = [
  {
    className: "ribbons_ribbon-navy",
    direction: "left",
    items: [
      { text: "MNL → MPH", kind: "regular" },
      { image: sailboat, rotation: "-3deg" },
      { text: "see you there", kind: "italic" },
      { image: arch, rotation: "3deg" },
      { text: "01.14.27", kind: "regular" },
    ],
  },
  {
    className: "ribbons_ribbon-blue",
    direction: "right",
    items: [
      { text: "WHITE BEACH", kind: "regular" },
      { image: beach, rotation: "-3deg" },
      { text: "island hopping", kind: "italic" },
      { image: sailboatBeach, rotation: "3deg" },
      { text: "SUNSET SAIL", kind: "regular" },
    ],
  },
] as const;

---

<section
  id="ribbons"
  class:list={["ribbons_wrap", "theme-light", className]}
  aria-label="Wedding weekend highlights"
  {...rest}
>
  {
    ribbons.map((ribbon) => (
      <div
        class:list={["ribbons_ribbon", ribbon.className, "marquee-advanced"]}
        data-marquee-duplicate="2"
        data-marquee-scroll-direction-target
        data-marquee-direction={ribbon.direction}
        data-marquee-status="normal"
        data-marquee-speed="15"
        data-marquee-scroll-speed="10"
      >
        <div class="ribbons_scroll marquee-advanced__scroll" data-marquee-scroll-target>
          {
            Array.from({ length: 2 }, (_, index) => (
              <div
                class="ribbons_collection marquee-advanced__collection"
                data-marquee-collection-target
                aria-hidden={index > 0 ? "true" : undefined}
                inert={index > 0 ? true : undefined}
              >
                {
                  ribbon.items.map((item) =>
                    "text" in item ? (
                      <span class:list={["ribbons_word", item.kind === "italic" && "is-italic"]}>
                        {item.text}
                      </span>
                    ) : (
                      <span class="ribbons_stamp" style={`--_rotation: ${item.rotation}`}>
                        <svg viewBox="0 0 68 84" preserveAspectRatio="none" aria-hidden="true">
                          <path d={stampPath} fill="var(--light-200)" />
                        </svg>
                        <Image src={item.image} alt="" width={108} height={140} loading="lazy" />
                      </span>
                    ),
                  )
                }
              </div>
            ))
          }
        </div>
      </div>
    ))
  }
</section>

<script>
  import { gsap, ScrollTrigger } from "@/scripts/scroll.ts";

  const initRibbons = () => {
    const ribbons = Array.from(
      document.querySelectorAll<HTMLElement>("[data-marquee-scroll-direction-target]"),
    ).filter((ribbon) => ribbon.dataset.marqueeInitialized !== "true");

    if (!ribbons.length) return;

    const media = gsap.matchMedia();
    media.add("(prefers-reduced-motion: no-preference)", () => {
      const contexts: gsap.Context[] = [];

      ribbons.forEach((ribbon) => {
        const collection = ribbon.querySelector<HTMLElement>("[data-marquee-collection-target]");
        const scroll = ribbon.querySelector<HTMLElement>("[data-marquee-scroll-target]");
        if (!collection || !scroll) return;

        ribbon.dataset.marqueeInitialized = "true";
        const duplicateAmount = Number(ribbon.dataset.marqueeDuplicate || 0);
        const marqueeDirectionAttr = ribbon.dataset.marqueeDirection === "right" ? 1 : -1;
        const marqueeSpeedAttr = Number(ribbon.dataset.marqueeSpeed || 15);
        const scrollSpeedAttr = Number(ribbon.dataset.marqueeScrollSpeed || 10);
        const speedMultiplier = window.innerWidth < 479 ? 0.25 : window.innerWidth < 991 ? 0.5 : 1;
        const marqueeSpeed = marqueeSpeedAttr * (collection.offsetWidth / window.innerWidth) * speedMultiplier;

        scroll.style.marginLeft = `${scrollSpeedAttr * -1}%`;
        scroll.style.width = `${scrollSpeedAttr * 2 + 100}%`;

        const fragment = document.createDocumentFragment();
        for (let index = 0; index < duplicateAmount; index += 1) {
          const duplicate = collection.cloneNode(true) as HTMLElement;
          duplicate.setAttribute("aria-hidden", "true");
          duplicate.setAttribute("inert", "");
          fragment.appendChild(duplicate);
        }
        scroll.appendChild(fragment);

        const collections = Array.from(
          ribbon.querySelectorAll<HTMLElement>("[data-marquee-collection-target]"),
        );
        const context = gsap.context(() => {
          const animation = gsap
            .to(collections, {
              xPercent: -100,
              repeat: -1,
              duration: marqueeSpeed,
              ease: "linear",
            })
            .totalProgress(0.5);
          gsap.set(collections, { xPercent: marqueeDirectionAttr === 1 ? 100 : -100 });
          animation.timeScale(marqueeDirectionAttr);
          animation.play();

          ScrollTrigger.create({
            trigger: ribbon,
            start: "top bottom",
            end: "bottom top",
            onUpdate: (self) => {
              const isInverted = self.direction === 1;
              animation.timeScale(isInverted ? -marqueeDirectionAttr : marqueeDirectionAttr);
              ribbon.dataset.marqueeStatus = isInverted ? "normal" : "inverted";
            },
          });

          const push = gsap.timeline({
            scrollTrigger: {
              trigger: ribbon,
              start: "0% 100%",
              end: "100% 0%",
              scrub: 0,
            },
          });
          const scrollStart = marqueeDirectionAttr === -1 ? scrollSpeedAttr : -scrollSpeedAttr;
          push.fromTo(scroll, { x: `${scrollStart}vw` }, { x: `${-scrollStart}vw`, ease: "none" });
        }, ribbon);
        contexts.push(context);
      });

      return () => contexts.forEach((context) => context.revert());
    });
  };

  initRibbons();
  document.addEventListener("astro:page-load", initRibbons);
</script>

<style is:global>
  @layer components {
    .ribbons_wrap {
      --_p: clamp(0, tan(atan2(100vw - 48rem, 42rem)), 1);
      position: relative;
      height: calc(15.625rem + 11.875rem * var(--_p));
      overflow: clip;
    }

    .ribbons_ribbon {
      position: absolute;
      left: calc(-2.5rem - 5rem * var(--_p));
      width: calc(100% + 5rem + 10rem * var(--_p));
      overflow: hidden;
      transform-origin: 0 0;
    }

    .ribbons_ribbon-navy {
      top: 1.375rem;
      border-block: 0.09375rem solid var(--dark-900);
      background: var(--dark-900);
      color: var(--light-100);
      rotate: calc(4deg - 1deg * var(--_p));
      z-index: 1;
    }

    .ribbons_ribbon-blue {
      top: calc(10.5rem + 8.25rem * var(--_p));
      background: var(--brand-500);
      color: var(--dark-900);
      rotate: calc(-4deg + 1deg * var(--_p));
    }

    .ribbons_scroll {
      display: flex;
      width: max-content;
      position: relative;
      will-change: transform;
    }

    .ribbons_collection {
      display: flex;
      flex: none;
      align-items: center;
      gap: calc(1rem + 1.5rem * var(--_p));
      width: max-content;
      padding-block: calc(0.75rem + 0.25rem * var(--_p));
      padding-right: calc(1rem + 1.5rem * var(--_p));
      position: relative;
      will-change: transform;
    }

    .ribbons_word {
      position: relative;
      top: calc(0.3125rem + 0.25rem * var(--_p));
      flex: none;
      font-family: var(--secondary-family);
      font-size: calc(3rem + 3rem * var(--_p));
      font-weight: var(--secondary-regular);
      line-height: 1;
      letter-spacing: var(--letter-spacing-snug);
      white-space: nowrap;
    }

    .ribbons_word.is-italic {
      font-weight: var(--secondary-ultralight);
      font-style: italic;
    }

    .ribbons_stamp {
      position: relative;
      display: block;
      flex: none;
      width: calc(3rem + 1.25rem * var(--_p));
      height: calc(3.6875rem + 1.5625rem * var(--_p));
      rotate: var(--_rotation);
      filter: drop-shadow(0 0.0625rem 0.0625rem color-mix(in srgb, var(--dark-900) 18%, transparent)) drop-shadow(0 0.5rem 0.875rem color-mix(in srgb, var(--dark-900) 14%, transparent));
    }

    .ribbons_stamp svg,
    .ribbons_stamp img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .ribbons_stamp img {
      inset: calc(0.3125rem + 0.125rem * var(--_p));
      width: calc(100% - (0.625rem + 0.25rem * var(--_p)));
      height: calc(100% - (0.625rem + 0.25rem * var(--_p)));
      object-fit: cover;
    }

    @media (prefers-reduced-motion: reduce) {
      .ribbons_scroll,
      .ribbons_collection { will-change: auto; }
    }
  }
</style>
