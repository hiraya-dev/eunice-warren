<div class="with-love_upload" data-with-love-upload>
  <div class="with-love_copy">
    <p class="with-love_eyebrow">LEAVE A POLAROID</p>
    <h3>Add yours to the stack.</h3>
    <p class="with-love_intro">A photo of you with Eunice or Warren, a memory, or just a wish for the two of them.</p>
    <ol>
      <li><span>01</span>Your polaroid joins the stack right away.</li>
      <li><span>02</span>We shrink the photo and strip its location before it leaves your phone.</li>
      <li><span>03</span>One photo per polaroid. JPG, PNG or iPhone photos.</li>
    </ol>
  </div>
  <div class="with-love_form-area">
    <form data-with-love-form class="with-love_form" novalidate>
      <div class="with-love_polaroid">
        <label data-photo-slot class="with-love_photo-slot" tabindex="0">
          <input data-photo-input name="photo" type="file" accept="image/*" />
          <span class="with-love_camera" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M4 8.5A1.5 1.5 0 0 1 5.5 7h2l1.5-2h6l1.5 2h2A1.5 1.5 0 0 1 20 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.5v-9Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
              <circle cx="12" cy="13" r="3.25" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </span>
          <span data-photo-empty>Add a photo</span>
          <small data-photo-hint>TAP TO CHOOSE · OR DROP IT HERE</small>
          <img data-photo-preview alt="Selected photo preview" hidden />
          <span data-change-photo class="with-love_change-photo" hidden>
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M2.5 8a5.5 5.5 0 0 1 9.6-3.7M13.5 8a5.5 5.5 0 0 1-9.6 3.7M12.5 2v2.5H10M3.5 14v-2.5H6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            CHANGE PHOTO
          </span>
        </label>
        <div class="with-love_crop-controls" data-crop-controls hidden>
          <span aria-hidden="true">−</span>
          <label><span class="sr-only">Zoom</span><input data-zoom type="range" min="1" max="4" step="0.01" value="1" /></label>
          <span aria-hidden="true">+</span>
        </div>
        <p class="with-love_crop-hint with-love_crop-hint-touch">DRAG TO MOVE · PINCH TO ZOOM</p>
        <p class="with-love_crop-hint with-love_crop-hint-fine">DRAG TO MOVE · SCROLL-PINCH OR SLIDE TO ZOOM</p>
        <label class="with-love_message-label">
          <span class="sr-only">Message</span>
          <textarea data-message name="message" maxlength="140" rows="2" placeholder="Write them a little note…" required></textarea>
          <span data-counter>0 / 140</span>
        </label>
        <div class="with-love_signature">
          <label class="with-love_name"><span class="sr-only">Your name</span><span aria-hidden="true">—</span><input data-name name="name" maxlength="60" placeholder="YOUR NAME" required /></label>
          <label class="with-love_city"><span class="sr-only">City, optional</span><input data-city name="city" maxlength="60" placeholder="CITY (OPTIONAL)" /></label>
        </div>
      </div>
      <div data-turnstile class="with-love_turnstile"></div>
      <button data-submit type="submit" disabled>Pin it to the stack</button>
      <p class="with-love_fine">NO SIGN-IN NEEDED</p>
      <p data-form-error class="with-love_error" aria-live="polite" hidden></p>
    </form>
    <div data-sent class="with-love_sent" hidden>
      <div data-sent-card class="with-love_polaroid"></div>
      <h3>Salamat, <span data-sent-name></span>!</h3>
      <p>Pinned! It's on the stack now.</p>
      <button data-another type="button">Leave another</button>
    </div>
  </div>
</div>

<script>
  import { initWithLoveUpload } from "@/scripts/with-love/upload";

  initWithLoveUpload();
  document.addEventListener("astro:page-load", initWithLoveUpload);
</script>

