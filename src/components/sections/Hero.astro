---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { HTMLAttributes } from "astro/types";
import Stamp from "@/components/media/Stamp.astro";
import couple from "@/assets/images/gallery/img-4477.jpg";
import whiteBeach from "@/assets/images/gallery/img-4464.jpg";
import sunsetSail from "@/assets/images/gallery/img-2509.jpg";
import paraw from "@/assets/images/stamps/paraw.jpg";
import palm from "@/assets/images/stamps/palm.jpg";
import postmark from "@/assets/images/hero/postmark-received.png";
import Button from "@/components/Button.astro";
import { BACKGROUND_MUSIC } from "@/consts";
import MusicTicker from "@/components/global/MusicTicker.astro";

interface Props extends HTMLAttributes<"section"> {
  /** RSVP destination. */
  rsvpHref?: string;
  /** Weekend details destination. */
  weekendHref?: string;
}

const { rsvpHref = "#rsvp", weekendHref = "#wedding", class: className, ...rest } = Astro.props;
const [{ data }] = await getCollection("hero");
---

{!data.hidden && <section id="hero" class:list={["hero", className]} {...rest}>
  <div class="hero_collage">
    <div class="hero_keepsake hero_couple" data-hero-keepsake>
      <div class="hero_polaroid">
        <Image src={couple} alt={data.coupleAlt} width={206} height={230} widths={[206, 412]} sizes="(min-width: 48rem) 14.31vw, 160px" loading="eager" fetchpriority="high" />
      </div>
    </div>
    <div class="hero_keepsake hero_white-beach" data-hero-keepsake>
      <div class="hero_polaroid"><Image src={whiteBeach} alt="" width={186} height={200} widths={[186, 372]} sizes="(min-width: 48rem) 12.92vw, 134px" loading="eager" fetchpriority="low" /></div>
    </div>
    <div class="hero_keepsake hero_sunset" data-hero-keepsake>
      <div class="hero_polaroid"><Image src={sunsetSail} alt="" width={176} height={200} widths={[176, 352]} sizes="(min-width: 48rem) 12.22vw, 176px" loading="eager" fetchpriority="low" /></div>
    </div>
    {BACKGROUND_MUSIC.enabled && <div class="hero_keepsake hero_music" data-hero-keepsake data-music-surface data-state="idle" data-music-polaroid>
      <div class="hero_polaroid music-polaroid_wrap">
        <Image src={BACKGROUND_MUSIC.cover} alt={`Cover of ${BACKGROUND_MUSIC.title} by ${BACKGROUND_MUSIC.artist}`} width={206} height={206} widths={[206, 412]} sizes="(min-width: 64rem) 14.31vw, 206px" loading="eager" fetchpriority="low" />
        <div class="music-polaroid_strip">
          <div class="music-polaroid_info">
            <span class="music-polaroid_label">{data.musicLabel}</span>
            <MusicTicker class="music-polaroid_title" text={BACKGROUND_MUSIC.title} />
          </div>
          <div class="music-polaroid_controls">
            <button type="button" data-music-mute aria-pressed="false" aria-label={`${data.musicMute} ${BACKGROUND_MUSIC.title} by ${BACKGROUND_MUSIC.artist}`}>
              <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M3 7h3l4-3v10l-4-3H3z" fill="currentColor" /><path class="music-polaroid_waves" d="M12.5 6.5c1 .8 1 4.2 0 5M14.5 4.5c2 1.8 2 7.2 0 9" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg>
            </button>
            <button type="button" data-music-toggle aria-pressed="false" aria-label={`${data.musicPlay} ${BACKGROUND_MUSIC.title} by ${BACKGROUND_MUSIC.artist}`}>
              <svg data-music-play-icon viewBox="0 0 14 14" aria-hidden="true"><path d="M3.5 1.8v10.4L12 7z" fill="currentColor" /></svg>
              <svg data-music-pause-icon viewBox="0 0 14 14" aria-hidden="true"><rect x="2.5" y="1.5" width="3" height="11" fill="currentColor" /><rect x="8.5" y="1.5" width="3" height="11" fill="currentColor" /></svg>
            </button>
          </div>
        </div>
        <div class="music-polaroid_progress"><span data-music-elapsed>0:00</span><span class="music-polaroid_track"><span data-music-fill></span></span><span data-music-duration>0:00</span></div>
      </div>
    </div>}
    <div class="hero_keepsake hero_paraw" data-hero-keepsake><Stamp><Image src={paraw} alt="" width={860} height={1110} widths={[120, 240]} sizes="(min-width: 48rem) 8.33vw, 72px" loading="eager" fetchpriority="low" /></Stamp></div>
    <div class="hero_keepsake hero_palm" data-hero-keepsake><Stamp><Image src={palm} alt="" width={860} height={1110} widths={[96, 192]} sizes="(min-width: 48rem) 6.67vw, 96px" loading="eager" fetchpriority="low" /></Stamp></div>
    <Image class="hero_keepsake hero_postmark" data-hero-keepsake src={postmark} alt="" width={195} height={120} widths={[195, 390]} sizes="(min-width: 48rem) 13.54vw, 130px" loading="eager" fetchpriority="low" />
    <p class="hero_keepsake hero_note" data-hero-keepsake aria-hidden="true">
      <span class="hero_note-text">{data.note}</span>
      <svg class="hero_note-arrow" viewBox="0 0 100 56" focusable="false" aria-hidden="true"><path d="M97 3 C74 10 58 23 45 36 C34 45 19 47 8 44 M8 44 L19 36 M8 44 L19 52" fill="none" stroke="var(--accent-500)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </p>
  </div>

  <div class="hero_content">
    <p class="hero_date" data-hero-text-item>
      <span class="hero_date-full">{data.dateFull}</span>
      <span class="hero_date-short">{data.dateShort}</span>
      <span class="hero_venue"><span class="hero_venue-full">{data.venueFull}</span><span class="hero_venue-short">{data.venueShort}</span></span>
    </p>
    <h1 class="hero_title" data-hero-text-item><span>{data.titleFirst}</span> <span>{data.titleSecond}</span></h1>
    <p class="hero_subtitle" data-hero-text-item>{data.subtitle}</p>
    <div class="hero_actions" data-hero-text-item>
      <Button class="hero_rsvp" element="link" href={rsvpHref} shape="pill">{data.rsvp}</Button>
      <a class="hero_weekend" data-button-016 href={weekendHref} aria-label={data.weekendAria}>
        <span class="button-016__inner">
          <span class="button-016__text">{data.weekend}</span>
        </span>
        <span aria-hidden="true">↓</span>
      </a>
    </div>
  </div>
</section>}

<script is:inline>
  if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    document.querySelector("#hero")?.setAttribute("data-hero-motion", "");
  }
</script>

<script>
  import { gsap } from "gsap";

  const initHero = () => {
    const hero = document.querySelector<HTMLElement>("#hero");
    if (!hero || hero.dataset.heroInitialized === "true") return;
    hero.dataset.heroInitialized = "true";
    const textItems = hero.querySelectorAll<HTMLElement>("[data-hero-text-item]");
    const keepsakes = hero.querySelectorAll<HTMLElement>("[data-hero-keepsake]");
    const media = gsap.matchMedia();
    const root = document.documentElement;
    const preloader = document.querySelector<HTMLElement>("[data-preloader]");
    const waitingForPreloader = root.classList.contains("ew-preloader-pending") && preloader && !root.dataset.preloaderClosing;
    let timeline: gsap.core.Timeline | null = null;
    let revealFallback: MutationObserver | null = null;

    const play = () => {
      revealFallback?.disconnect();
      if (timeline || !window.matchMedia("(prefers-reduced-motion: no-preference)").matches) return;
      timeline = gsap.timeline();
      hero.dataset.heroEntering = "";
      timeline.from(textItems, { autoAlpha: 0, y: 16, duration: 0.8, stagger: 0.08, ease: "power3.out" });
      timeline.from(keepsakes, { autoAlpha: 0, y: -24, scale: 1.06, rotation: (_index, element) => element.matches(".hero_couple, .hero_sunset, .hero_music, .hero_palm, .hero_postmark, .hero_note") ? "-=4" : "+=4", duration: 0.9, stagger: 0.07, ease: "power3.out" }, "<0.25");
      hero.removeAttribute("data-hero-motion");
      timeline.eventCallback("onComplete", () => {
        delete hero.dataset.heroEntering;
        gsap.set([textItems, keepsakes], { clearProps: "transform,opacity,visibility" });
      });
    };

    media.add("(prefers-reduced-motion: no-preference)", () => {
      if (!waitingForPreloader) play();
      return () => {
        timeline?.kill();
        timeline = null;
        delete hero.dataset.heroEntering;
      };
    });

    const onPreloaderClose = () => play();
    document.addEventListener("ew:preloader-close", onPreloaderClose);

    if (waitingForPreloader) {
      revealFallback = new MutationObserver(() => {
        if (!document.documentElement.contains(preloader) || !root.classList.contains("ew-preloader-pending")) play();
      });
      revealFallback.observe(document.documentElement, { attributes: true, attributeFilter: ["class", "data-preloader-closing"] });
      revealFallback.observe(document.body, { childList: true });
    }

    const cleanup = () => {
      document.removeEventListener("ew:preloader-close", onPreloaderClose);
      revealFallback?.disconnect();
      media.revert();
      gsap.set([textItems, keepsakes], { clearProps: "transform,opacity,visibility" });
      hero.removeAttribute("data-hero-motion");
      delete hero.dataset.heroEntering;
      hero.removeAttribute("data-hero-initialized");
      delete root.dataset.preloaderClosing;
    };
    document.addEventListener("astro:before-swap", cleanup, { once: true });
  };

  initHero();
  document.addEventListener("astro:page-load", initHero);
</script>

<style>
  @layer components {
    .hero { position: relative; display: grid; align-items: center; min-height: calc(56.944vw + 5rem); padding: 2.5rem var(--site-margin); overflow: clip; color: var(--dark-900); isolation: isolate; }
    .hero_collage { position: absolute; z-index: 0; top: 50%; left: 50%; width: min(100%, 90rem); aspect-ratio: 1440 / 820; container-type: inline-size; transform: translate(-50%, -50%); pointer-events: none; }
    .hero_keepsake { position: absolute; transform-origin: 0 0; }
    .hero_polaroid { background: var(--light-200) url("../../assets/textures/polaroid-paper.jpg") center / 32rem repeat; box-shadow: 0 0.875rem 2rem rgb(31 47 92 / 16%); }
    .hero_polaroid img { display: block; width: 100%; height: auto; object-fit: cover; }
    .hero_couple .hero_polaroid img { aspect-ratio: 206 / 230; }
    .hero_white-beach .hero_polaroid img { aspect-ratio: 186 / 200; }
    .hero_sunset .hero_polaroid img { aspect-ratio: 176 / 200; }
    .hero_couple { top: 4.861cqw; left: 4.444cqw; transform: rotate(-7deg); }
    .hero_couple .hero_polaroid { width: 15.972cqw; padding: 0.833cqw 0.833cqw 2.778cqw; }
    .hero_white-beach { top: 4.167cqw; left: 79.861cqw; transform: rotate(6deg); }
    .hero_white-beach .hero_polaroid { width: 14.583cqw; padding: 0.833cqw 0.833cqw 2.778cqw; }
    .hero_sunset { top: 36.111cqw; left: 77.778cqw; transform: rotate(-4deg); }
    .hero_sunset .hero_polaroid { width: 13.889cqw; padding: 0.833cqw 0.833cqw 2.222cqw; }
    .hero_music { display: none; top: 32.5cqw; left: 76.667cqw; transform: rotate(-4deg); pointer-events: auto; }
    .hero_music .hero_polaroid { display: flex; flex-direction: column; gap: 0.833cqw; width: 15.972cqw; padding: 0.833cqw 0.833cqw 0.972cqw; }
    .hero_music .hero_polaroid img { aspect-ratio: 1; }
    .music-polaroid_strip { display: flex; align-items: center; justify-content: space-between; gap: 0.25rem; padding-inline: 0.139cqw; }
    .music-polaroid_info { display: flex; min-width: 0; flex-direction: column; gap: 0.139cqw; }
    .music-polaroid_label { color: var(--accent-500); font: 400 clamp(1rem, 1.667cqw, 1.5rem) / 1 var(--hand-family); white-space: nowrap; }
    .music-polaroid_info :global(.music-polaroid_title) { overflow: hidden; color: var(--dark-700); font: var(--primary-regular) clamp(0.5rem, 0.764cqw, 0.6875rem) / 1.273 var(--mono-family); letter-spacing: 0.12em; text-overflow: ellipsis; text-transform: uppercase; white-space: nowrap; }
    .music-polaroid_controls { display: flex; flex: none; align-items: center; gap: clamp(0.25rem, 0.417cqw, 0.375rem); }
    .music-polaroid_controls button { display: grid; width: clamp(2rem, 2.361cqw, 2.125rem); height: clamp(2rem, 2.361cqw, 2.125rem); padding: 0; place-items: center; border: 0.0625rem solid var(--border); border-radius: 50%; background: transparent; color: var(--dark-900); cursor: pointer; transition: border-color 0.2s, background-color 0.2s, opacity 0.2s; }
    .music-polaroid_controls button + button { border-color: var(--dark-900); background: var(--dark-900); color: var(--light-100); }
    .music-polaroid_controls button:not(:disabled):hover { border-color: var(--dark-900); }
    .music-polaroid_controls button + button:not(:disabled):hover { background: var(--accent-500); border-color: var(--accent-500); }
    .music-polaroid_controls button:disabled { cursor: default; opacity: 0.4; }
    .music-polaroid_controls svg { grid-area: 1 / 1; width: 1rem; height: 1rem; }
    .music-polaroid_controls button + button svg { width: 0.75rem; height: 0.75rem; }
    .music-polaroid_controls [data-music-mute][aria-pressed="true"] .music-polaroid_waves { opacity: 0.25; }
    .music-polaroid_progress { display: flex; align-items: center; gap: clamp(0.25rem, 0.556cqw, 0.5rem); padding-inline: 0.139cqw; color: var(--dark-700); font: var(--primary-regular) clamp(0.5rem, 0.694cqw, 0.625rem) / 1.2 var(--mono-family); }
    .music-polaroid_track { flex: 1; height: 0.125rem; background: var(--border); }
    .music-polaroid_track span { display: block; width: 100%; height: 100%; background: var(--accent-500); transform: scaleX(var(--music-progress, 0)); transform-origin: left; }
    .hero_paraw { top: 36.111cqw; left: 10.417cqw; width: 8.333cqw; height: 10.417cqw; transform: rotate(8deg); }
    .hero_palm { top: 20.833cqw; left: 90cqw; width: 6.667cqw; height: 8.333cqw; transform: rotate(-9deg); }
    .hero_postmark { top: 44.444cqw; left: 17.361cqw; width: 13.542cqw; height: 8.333cqw; object-fit: contain; transform: rotate(-10deg); opacity: 0.9; }
    .hero_note { top: 4.722cqw; left: 21.597cqw; width: 13.194cqw; height: 7.917cqw; margin: 0; color: var(--accent-500); font: 400 3.3cqw / 1 var(--hand-family); white-space: nowrap; transform: rotate(-8deg); }
    .hero_note-text { position: absolute; top: 0; left: 0; }
    .hero_note-arrow { position: absolute; bottom: -0.15em; left: 12%; width: 62%; height: auto; overflow: visible; }
    .hero_content { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-4); text-align: center; }
    .hero_date { margin: 0; color: var(--dark-700); font: var(--primary-regular) clamp(0.9375rem, calc(0.2915rem + 1.345vw), 1.125rem) / 1 var(--mono-family); letter-spacing: var(--letter-spacing-wider); text-transform: uppercase; }
    .hero_date-short { display: none; }
    .hero_venue { display: block; margin-top: var(--space-2); font-size: var(--eyebrow); }
    .hero_venue-short { display: none; }
    .hero_title { --_trim-top: 0.5lh; --_trim-bottom: 0.5lh; margin: 0; color: var(--dark-900); font: var(--secondary-ultralight) var(--display) / var(--line-height-medium) var(--secondary-family); letter-spacing: var(--letter-spacing-tighter); }
    .hero_title span { display: inline; }
    .hero_subtitle { margin: 0; color: var(--dark-900); font: italic var(--secondary-ultralight) clamp(1.5rem, calc(1.1429rem + 1.984vw), 2.5rem) / 1.1 var(--secondary-family); }
    .hero_actions { display: flex; align-items: center; gap: var(--space-4); padding-top: var(--space-3); }
    .hero_rsvp { --button-016-color-background: var(--accent-500); --button-016-color: var(--light-100); --button-016-hover-color: var(--light-100); --button-016-hover-color-background: var(--dark-900); --button-016-color-focus: var(--dark-900); padding: 0; font-size: 1rem; }
    .hero_rsvp :global(.button-016__inner) { padding: var(--space-3) var(--space-4); line-height: 1.25; }
    .hero_weekend { display: inline-flex; align-items: baseline; gap: 0.35em; padding-bottom: 0.25rem; border-bottom: 1px solid var(--dark-900); color: var(--dark-900); font: var(--primary-regular) 1rem / 1 var(--mono-family); letter-spacing: var(--letter-spacing-wide); text-decoration: none; }
    .hero_weekend { --button-016-color: var(--dark-900); --button-016-hover-color: var(--dark-900); --button-016-color-background: transparent; --button-016-hover-color-background: transparent; --button-016-color-focus: var(--dark-900); }
    .hero_weekend :global(.button-016__inner) { padding: 0; }
  }

  @media (min-width: 48rem) {
    .hero_title { font-size: min(var(--display), 8.9vw); }
  }

  @media (max-width: 61.999rem) {
    .hero_venue-full { display: none; }
    .hero_venue-short { display: inline; }
  }

  @media (min-width: 48rem) and (max-width: 61.999rem) {
    .hero_postmark { top: 47.5cqw; }
    .hero_content { gap: var(--space-3); padding-top: 1.25rem; }
  }

  @media (min-width: 62rem) {
    .hero { min-height: max(min(51.25rem, 56.944vw), calc(100svh - var(--nav-height))); }
  }

  @media (max-width: 47.999rem) {
    .hero { display: block; min-height: 0; padding: 19rem var(--site-margin) 9.5rem; }
    .hero_collage { --_center-shift: max(0px, 50% - 12.1875rem); top: 0; left: 0; width: 100%; height: 100%; aspect-ratio: auto; transform: none; }
    .hero_polaroid { box-shadow: 0 0.75rem 1.75rem rgb(31 47 92 / 16%); }
    .hero_couple { top: 2.5rem; left: calc(1.75rem + var(--_center-shift)); transform: rotate(-6deg); }
    .hero_couple .hero_polaroid { width: 11rem; padding: 0.5rem 0.5rem 2rem; }
    .hero_couple .hero_polaroid img { aspect-ratio: 160 / 170; }
    .hero_white-beach { top: 2.75rem; left: calc(12.875rem + var(--_center-shift)); transform: rotate(7deg); }
    .hero_white-beach .hero_polaroid { width: 9.375rem; padding: 0.5rem 0.5rem 1.5rem; }
    .hero_white-beach .hero_polaroid img { aspect-ratio: 134 / 144; }
    .hero_note { top: 14.25rem; left: calc(9.375rem + var(--_center-shift)); width: 7.5rem; height: 4.5rem; font-size: 1.875rem; transform: rotate(-8deg); }
    .hero_note-text { top: auto; bottom: 0.5rem; }
    .hero_note-arrow { top: -0.75rem; bottom: auto; width: 54%; transform: scaleY(-1); }
    .hero_sunset, .hero_palm { display: none; }
    .hero_music { display: none; }
    .hero_paraw { top: auto; bottom: 1.75rem; left: 1.125rem; width: 4.5rem; height: 5.625rem; transform: rotate(8deg); }
    .hero_postmark { top: auto; right: 1rem; bottom: 2.5rem; left: auto; width: 8.125rem; height: 5rem; transform: rotate(-10deg); }
    .hero_date-full { display: none; }
    .hero_date { font-size: min(1.125rem, calc((100vw - 3rem) / 18.2)); letter-spacing: var(--eyebrow-letter-spacing); white-space: nowrap; }
    .hero_date-short { display: inline; }
    .hero_title { line-height: var(--line-height-tight); }
    .hero_title span { display: block; }
    .hero_actions { flex-direction: column; gap: var(--space-4); }
    .hero_rsvp :global(.button-016__inner) { padding: var(--space-4) var(--space-5); }
    .hero_weekend { font-size: var(--eyebrow); }
  }

  @media (min-width: 64rem) {
    #hero:has(.hero_music) .hero_sunset { display: none; }
    .hero_music { display: block; }
  }

  #hero[data-hero-motion] :is([data-hero-text-item], [data-hero-keepsake]) {
    visibility: hidden;
  }
</style>
