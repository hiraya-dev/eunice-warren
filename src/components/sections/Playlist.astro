---
import { Image } from "astro:assets";
import Stamp from "@/components/media/Stamp.astro";
import Form from "@/components/form/Form.astro";
import Input from "@/components/form/Input.astro";
import Textarea from "@/components/form/Textarea.astro";
import stamp from "@/assets/images/stamps/paraw.jpg";
import postcardPaper from "@/assets/textures/postcard-paper.jpg";
import { PLAYLIST_URI } from "@/settings/playlist.ts";
---

<section
  id="playlist"
  class="playlist_wrap theme-light"
  style="scroll-margin-top: var(--nav-height)"
>
  <div class="playlist_layout">
    <div class="playlist_left">
      <header class="playlist_header" data-fade-in>
        <h2 class="playlist_title" data-fade-in-item>What gets<br />you dancing?</h2>
        <p class="playlist_intro" data-fade-in-item>
          Send a song to the DJ. We'll play as many as we can.
        </p>
      </header>
      <div class="playlist_player">
        <div class="playlist_player-row">
          <div
            class="playlist_turntable"
            data-playlist-turntable
            aria-hidden="true"
          >
            <div class="playlist_turntable-rim"></div>
            <svg class="playlist_turntable-platter" viewBox="0 0 220 220">
              <circle
                cx="110"
                cy="110"
                r="109"
                fill="#0E1630"
                stroke="#FFFFFF24"></circle>
              <g data-playlist-record>
                <circle cx="110" cy="110" r="102" fill="#141414"></circle>
                <g fill="none" stroke-width="1">
                  <circle cx="110" cy="110" r="96" stroke="#FFFFFF14"
                  ></circle><circle cx="110" cy="110" r="89" stroke="#FFFFFF10"
                  ></circle><circle cx="110" cy="110" r="82" stroke="#FFFFFF14"
                  ></circle><circle cx="110" cy="110" r="74" stroke="#FFFFFF0E"
                  ></circle><circle cx="110" cy="110" r="67" stroke="#FFFFFF14"
                  ></circle><circle cx="110" cy="110" r="60" stroke="#FFFFFF10"
                  ></circle><circle cx="110" cy="110" r="52" stroke="#FFFFFF14"
                  ></circle>
                </g>
                <circle cx="110" cy="110" r="38" fill="var(--accent-500)"
                ></circle>
                <circle
                  cx="110"
                  cy="110"
                  r="33"
                  fill="none"
                  stroke="#F5EFE34D"
                  stroke-width="0.75"></circle>
                <text
                  x="110"
                  y="104"
                  text-anchor="middle"
                  class="playlist_record-name">E &amp; W</text
                >
                <text
                  x="110"
                  y="128"
                  text-anchor="middle"
                  class="playlist_record-date">01·14·27</text
                >
              </g>
              <path
                d="M38 62 A86 86 0 0 1 92 26"
                fill="none"
                stroke="#FFFFFF2E"
                stroke-width="6"
                stroke-linecap="round"></path>
              <path
                d="M182 158 A86 86 0 0 1 140 192"
                fill="none"
                stroke="#FFFFFF1A"
                stroke-width="5"
                stroke-linecap="round"></path>
              <circle cx="110" cy="110" r="3.5" fill="#D6CDBB"></circle>
            </svg>
            <svg class="playlist_turntable-tonearm" viewBox="0 0 180 150">
              <circle cx="140" cy="26" r="20" fill="#121B3A" stroke="#FFFFFF1F"
              ></circle>
              <g data-playlist-tonearm class="playlist_tonearm-moving">
                <rect
                  x="152"
                  y="14"
                  width="18"
                  height="24"
                  rx="4"
                  fill="#D6CDBB"
                  transform="rotate(28 140 26)"></rect>
                <path
                  d="M140 26 L132 70 L36 98"
                  fill="none"
                  stroke="#E9DFCB"
                  stroke-width="4"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <rect
                  x="16"
                  y="90"
                  width="26"
                  height="14"
                  rx="2.5"
                  fill="#F5EFE3"
                  transform="rotate(-16 29 97)"></rect>
                <rect
                  x="20"
                  y="100"
                  width="6"
                  height="5"
                  rx="1"
                  fill="#C23B2E"
                  transform="rotate(-16 29 97)"></rect>
              </g>
              <circle cx="140" cy="26" r="9" fill="#D6CDBB"></circle><circle
                cx="140"
                cy="26"
                r="3"
                fill="#1F2F5C"></circle>
            </svg>
          </div>
          <div class="playlist_listen-copy">
            <div class="playlist_eyebrow">
              <span aria-hidden="true"></span>SIDE A · LISTEN ALONG
            </div><h3>Side A — Boracay ’27</h3><p>
              Press play below and the needle drops. Every song you send lands
              on it.
            </p>
          </div>
          <div
            class="playlist_embed"
            data-playlist-embed
            data-uri={PLAYLIST_URI}
            aria-label="Spotify playlist"
          >
            <span>Playlist unavailable right now.</span>
            <div data-playlist-embed-target></div>
          </div>
        </div>
      </div>
    </div>
    <Form
      name="song-request"
      successMessage="Song requests open soon — hold that thought."
      class="playlist_form-wrap"
    >
      <div
        class="playlist_postcard"
        style={`--postcard-texture: url("${postcardPaper.src}")`}
      >
        <div class="playlist_stamp"><Stamp><Image src={stamp} alt="" width={72} height={93} densities={[1, 2]} aria-hidden="true" /></Stamp></div><Input
          appearance="postcard"
          label="Your name"
          name="name"
          placeholder=""
          required
        /><Input
          appearance="postcard"
          label="Song"
          name="song"
          required
          placeholder="Song title"
        /><Input
          appearance="postcard"
          label="Artist (optional)"
          name="artist"
          placeholder="Who sings it"
        /><Textarea
          appearance="postcard"
          label="Dedication (optional)"
          name="dedication"
          minLines={4}
          maxLines={6}
        /><button class="playlist_submit" type="submit">Add it to Side A</button
        >
      </div>
    </Form>
  </div>
  <div class="playlist_scallop" aria-hidden="true"></div>
</section>

<script>
  import { getGuest } from "@/lib/guest";
  const initPlaylist = () => {
    const section = document.querySelector<HTMLElement>("#playlist");
    if (!section || section.dataset.playlistInitialized === "true") return;
    section.dataset.playlistInitialized = "true";
    const nameInput = section.querySelector<HTMLInputElement>('input[name="name"]');
    const remembered = getGuest();
    if (nameInput && remembered && "name" in remembered && !nameInput.value) nameInput.value = remembered.name;
    const onGuest = (event: Event) => {
      const guestName = (event as CustomEvent<{ name?: string }>).detail?.name;
      if (nameInput && guestName && !nameInput.value) nameInput.value = guestName;
    };
    document.addEventListener("ew:guest", onGuest);
    const embed = section.querySelector<HTMLElement>("[data-playlist-embed]");
    const embedTarget = section.querySelector<HTMLElement>(
      "[data-playlist-embed-target]",
    );
    const record = section.querySelector<SVGElement>("[data-playlist-record]");
    const tonearm = section.querySelector<SVGElement>(
      "[data-playlist-tonearm]",
    );
    if (!embed || !embedTarget || !record || !tonearm) return;
    interface SpotifyPlaybackEvent {
      data: { isPaused: boolean; position: number; duration: number };
    }
    interface SpotifyController {
      addListener: (
        event: string,
        callback: (event: SpotifyPlaybackEvent) => void,
      ) => void;
    }
    interface SpotifyAPI {
      createController: (
        element: HTMLElement,
        options: { uri: string; width: string; height: number; theme: "dark" },
        callback: (controller: SpotifyController) => void,
      ) => void;
    }
    let controller: SpotifyController | undefined;
    let playing = false;
    let frame = 0;
    let timeout: number | undefined;
    let armStartTimeout: number | undefined;
    let pauseTimeout: number | undefined;
    let observer: IntersectionObserver | undefined;
    let script: HTMLScriptElement | undefined;
    let recordAngle = 0;
    let lastFrameAt = 0;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const playlistUri = embed.dataset.uri;
    const spinDegreesPerMillisecond = 360 / 1800;
    const decelerationDuration = 1000;
    const setRecordAngle = (angle: number) => {
      recordAngle = angle;
      record.style.transform = `rotate(${angle}deg)`;
    };
    const stopFrame = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      lastFrameAt = 0;
    };
    const spin = (now: number) => {
      if (!playing || reducedMotion.matches) {
        stopFrame();
        return;
      }
      const elapsed = lastFrameAt ? Math.min(now - lastFrameAt, 100) : 0;
      lastFrameAt = now;
      setRecordAngle(recordAngle + elapsed * spinDegreesPerMillisecond);
      frame = requestAnimationFrame(spin);
    };
    const startSpin = () => {
      if (playing && !reducedMotion.matches && !frame) {
        lastFrameAt = 0;
        frame = requestAnimationFrame(spin);
      }
    };
    const decelerate = () => {
      stopFrame();
      if (reducedMotion.matches) return;
      const startedAt = performance.now();
      const startedAngle = recordAngle;
      const slow = (now: number) => {
        const progress = Math.min((now - startedAt) / decelerationDuration, 1);
        const decelerationAngle =
          (spinDegreesPerMillisecond * decelerationDuration) / 3;
        setRecordAngle(
          startedAngle + decelerationAngle * (1 - (1 - progress) ** 3),
        );
        if (progress < 1) frame = requestAnimationFrame(slow);
      };
      frame = requestAnimationFrame(slow);
    };
    const liftArm = () => {
      pauseTimeout = undefined;
      playing = false;
      if (reducedMotion.matches) {
        stopFrame();
        tonearm.style.transition = "none";
        tonearm.style.transform = "rotate(-30deg)";
        return;
      }
      decelerate();
      tonearm.style.transition =
        "transform 600ms cubic-bezier(0.23, 1, 0.32, 1)";
      tonearm.style.transform = "rotate(-30deg)";
    };
    const play = () => {
      if (pauseTimeout) window.clearTimeout(pauseTimeout);
      pauseTimeout = undefined;
      if (playing) return;
      stopFrame();
      playing = true;
      if (reducedMotion.matches) {
        stopFrame();
        tonearm.style.transition = "none";
        tonearm.style.transform = "rotate(0deg)";
        return;
      }
      tonearm.style.transition =
        "transform 600ms cubic-bezier(0.23, 1, 0.32, 1)";
      tonearm.style.transform = "rotate(0deg)";
      if (armStartTimeout) window.clearTimeout(armStartTimeout);
      armStartTimeout = window.setTimeout(() => {
        armStartTimeout = undefined;
        startSpin();
      }, 600);
    };
    const pause = () => {
      if (!playing || pauseTimeout) return;
      pauseTimeout = window.setTimeout(liftArm, 400);
    };
    const handleReducedMotion = () => {
      const pausing = Boolean(pauseTimeout);
      if (pauseTimeout) window.clearTimeout(pauseTimeout);
      pauseTimeout = undefined;
      if (reducedMotion.matches) {
        if (pausing) playing = false;
        if (armStartTimeout) window.clearTimeout(armStartTimeout);
        armStartTimeout = undefined;
        stopFrame();
        tonearm.style.transition = "none";
        tonearm.style.transform = `rotate(${playing ? 0 : -30}deg)`;
      } else if (playing) {
        tonearm.style.transition =
          "transform 600ms cubic-bezier(0.23, 1, 0.32, 1)";
        tonearm.style.transform = "rotate(0deg)";
        armStartTimeout = window.setTimeout(startSpin, 600);
      }
    };
    const fail = () => {
      if (timeout) window.clearTimeout(timeout);
      if (embed.querySelector("iframe")) embed.classList.add("is-ready");
    };
    const ready = (api: SpotifyAPI) => {
      if (controller || !playlistUri) return;
      api.createController(
        embedTarget,
        { uri: playlistUri, width: "100%", height: 80, theme: "dark" },
        (created) => {
          controller = created;
          embed.classList.add("is-ready");
          if (timeout) window.clearTimeout(timeout);
          controller.addListener("playback_update", (event) => {
            if (event.data.isPaused) pause();
            else play();
          });
        },
      );
    };
    const load = () => {
      const spotify = (window as Window & { IFrameAPI?: SpotifyAPI }).IFrameAPI;
      if (spotify) return ready(spotify);
      (
        window as Window & {
          onSpotifyIframeApiReady?: (api: SpotifyAPI) => void;
        }
      ).onSpotifyIframeApiReady = ready;
      script = document.createElement("script");
      script.src = "https://open.spotify.com/embed/iframe-api/v1";
      script.async = true;
      script.addEventListener("error", fail, { once: true });
      document.head.appendChild(script);
      timeout = window.setTimeout(() => {
        if (!controller) fail();
      }, 10000);
    };
    observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          load();
          observer?.disconnect();
        }
      },
      { rootMargin: "200px" },
    );
    observer.observe(section);
    tonearm.style.transform = "rotate(-30deg)";
    reducedMotion.addEventListener("change", handleReducedMotion);
    document.addEventListener(
      "astro:before-swap",
      () => {
        stopFrame();
        if (armStartTimeout) window.clearTimeout(armStartTimeout);
        if (pauseTimeout) window.clearTimeout(pauseTimeout);
        reducedMotion.removeEventListener("change", handleReducedMotion);
        observer?.disconnect();
        if (timeout) window.clearTimeout(timeout);
      },
      { once: true },
    );
  };
  initPlaylist();
  document.addEventListener("astro:page-load", initPlaylist);
</script>

<style is:global>
  @layer components {
    .playlist_wrap {
      position: relative;
      overflow: clip;
      padding: var(--section-space-medium) var(--site-margin)
        calc(var(--section-space-medium) + 1rem);
      background-color: var(--light-100);
      background-image: var(--background-texture);
      color: var(--dark-900);
    }
    .playlist_layout {
      display: grid;
      gap: var(--space-7);
      max-width: var(--max-width-main);
      margin-inline: auto;
    }
    .playlist_left {
      display: grid;
      gap: var(--space-7);
      min-width: 0;
    }
    .playlist_header {
      display: grid;
      gap: var(--space-4);
    }
    .playlist_title {
      margin: 0;
      font-family: var(--secondary-family);
      font-size: var(--h1);
      font-weight: var(--secondary-regular);
      line-height: 1.1;
      padding-bottom: var(--secondary-trim-bottom);
      letter-spacing: var(--letter-spacing-tight);
    }
    .playlist_intro {
      max-width: 32ch;
      margin: 0;
      font-size: var(--text-main);
      line-height: 1.5;
    }
    .playlist_player {
      display: grid;
      gap: var(--space-4);
      min-width: 0;
    }
    .playlist_player-row {
      display: grid;
      grid-template-areas: "copy" "turntable" "embed";
      gap: var(--space-4);
    }
    .playlist_eyebrow {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--accent-500);
      font-family: var(--mono-family);
      font-size: 0.75rem;
      letter-spacing: 0.14em;
      line-height: 1;
    }
    .playlist_eyebrow span {
      width: 0.375rem;
      height: 0.375rem;
      flex: 0 0 auto;
      border-radius: 50%;
      background: currentColor;
    }
    .playlist_listen-copy {
      display: grid;
      grid-area: copy;
      gap: var(--space-4);
    }
    .playlist_listen-copy h3,
    .playlist_listen-copy p {
      display: none;
    }
    .playlist_turntable {
      grid-area: turntable;
    }
    .playlist_embed {
      grid-area: embed;
    }
    .playlist_turntable {
      container-type: inline-size;
      position: relative;
      width: 100%;
      aspect-ratio: 380 / 260;
      transform: rotate(-3deg);
      isolation: isolate;
    }
    .playlist_turntable::before {
      position: absolute;
      inset: 0;
      content: "";
      border: 0.1cqw solid #121b3a;
      border-radius: 3.68cqw;
      background: linear-gradient(
        165deg,
        #2a3b6b 0%,
        var(--dark-900) 55%,
        #18244a 100%
      );
      box-shadow:
        inset 0 0.53cqw 0.26cqw rgb(255 255 255 / 0.18),
        inset 0 -0.79cqw 0.79cqw rgb(0 0 0 / 0.4),
        0 6.32cqw 10.53cqw rgb(31 47 92 / 0.22),
        0 1.58cqw 3.16cqw rgb(31 47 92 / 0.16);
    }
    .playlist_turntable-rim {
      position: absolute;
      inset: 1.58cqw;
      border: 0.1cqw solid rgb(255 255 255 / 0.12);
      border-radius: 2.37cqw;
      pointer-events: none;
    }
    .playlist_turntable-platter,
    .playlist_turntable-tonearm {
      position: absolute;
      display: block;
      overflow: visible;
    }
    .playlist_turntable-platter {
      top: 7.89cqw;
      left: 5.26cqw;
      width: 57.89cqw;
      height: 57.89cqw;
    }
    .playlist_turntable-tonearm {
      top: 7.89cqw;
      left: 47.37cqw;
      width: 47.37cqw;
      height: 39.47cqw;
      overflow: visible;
    }
    [data-playlist-record] {
      transform-box: view-box;
      transform-origin: 50% 50%;
    }
    .playlist_tonearm-moving {
      transform: rotate(-30deg);
      transform-box: view-box;
      transform-origin: 77.78% 17.33%;
    }
    .playlist_record-name {
      fill: var(--light-100);
      font: italic 14px/14px var(--secondary-family);
      letter-spacing: -0.01em;
    }
    .playlist_record-date {
      fill: var(--light-100);
      font: 6px/8px var(--mono-family);
      letter-spacing: 0.14em;
    }
    .playlist_embed {
      position: relative;
      width: max(100%, 18.75rem);
      justify-self: center;
      height: 5rem;
      overflow: hidden;
      border-radius: 0.75rem;
      background: #1f1f1f;
      color: var(--light-100);
    }
    .playlist_embed span {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      font-size: 0.875rem;
    }
    .playlist_embed.is-ready span {
      display: none;
    }
    .playlist_embed iframe {
      position: relative;
      z-index: 1;
      display: block;
      width: 100%;
      height: 5rem;
      border: 0;
      opacity: 0;
      transition: opacity 300ms cubic-bezier(0.23, 1, 0.32, 1);
    }
    .playlist_embed.is-ready iframe {
      opacity: 1;
    }
    .playlist_form-wrap {
      min-width: 0;
    }
    .playlist_postcard {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding: 1.5rem;
      border: 0.09375rem solid var(--dark-900);
      background: var(--light-200) var(--postcard-texture) repeat;
      box-shadow:
        0 0.0625rem 0.0625rem rgb(31 47 92 / 0.1),
        0 0.375rem 0.875rem rgb(31 47 92 / 0.1),
        0 1.375rem 2.5rem rgb(31 47 92 / 0.08);
      transform: rotate(1.5deg);
    }
    .playlist_stamp {
      position: absolute;
      top: 1rem;
      right: 1rem;
      width: 3.75rem;
      height: 4.6875rem;
      transform: rotate(4deg);
    }
    .playlist_submit {
      width: 100%;
      text-align: center;
      padding: 1rem;
      border: 0;
      background: var(--accent-500);
      color: var(--light-100);
      font: 500 1rem/1.25 var(--primary-family);
      cursor: pointer;
    }
    .playlist_submit:focus-visible {
      outline: var(--focus-width) solid var(--dark-900);
      outline-offset: var(--focus-offset);
    }
    .playlist_scallop {
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
      height: 0.8125rem;
      background:
        linear-gradient(var(--brand-500) 0 0) bottom / 100% 0.125rem no-repeat,
        radial-gradient(
            circle at 1.125rem 0.6875rem,
            var(--brand-500) 0.6875rem,
            transparent calc(0.6875rem + 0.03125rem)
          )
          0 0 / 2.25rem 0.6875rem repeat-x;
    }
    @media (width >= 64rem) {
      .playlist_wrap {
        padding-block: var(--section-space-large);
      }
      .playlist_left {
        gap: 1.75rem;
      }
      .playlist_header {
        gap: 1.75rem;
      }
      .playlist_layout {
        grid-template-columns: minmax(0, 1fr) 32.5rem;
        gap: 6rem;
        align-items: start;
      }
      .playlist_player-row {
        grid-template-areas: "turntable copy" "embed .";
        grid-template-columns: 23.75rem minmax(0, 17.5rem);
        column-gap: 2.25rem;
        row-gap: 1.75rem;
        align-items: center;
        padding-top: 0.75rem;
      }
      .playlist_listen-copy {
        gap: 0.875rem;
      }
      .playlist_listen-copy h3,
      .playlist_listen-copy p {
        display: block;
        margin: 0;
      }
      .playlist_listen-copy h3 {
        font: 1.875rem/1 var(--secondary-family);
        letter-spacing: -0.02em;
      }
      .playlist_listen-copy p {
        color: var(--dark-700);
        font-size: 0.875rem;
        line-height: 1.43;
      }
      .playlist_turntable {
        width: 23.75rem;
        transform: rotate(-3deg);
      }
      .playlist_embed {
        width: 23.75rem;
      }
      .playlist_postcard {
        padding: 2.25rem;
        transform: rotate(2.5deg);
      }
      .playlist_stamp {
        top: 1.25rem;
        right: 1.125rem;
        width: 5rem;
        height: 6.25rem;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .playlist_embed iframe {
        transition: none;
      }
      .playlist_tonearm-moving {
        transition: none !important;
      }
    }
  }
</style>
