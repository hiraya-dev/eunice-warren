---
import { Image } from "astro:assets";
import Stamp from "@/components/media/Stamp.astro";
import Form from "@/components/form/Form.astro";
import Input from "@/components/form/Input.astro";
import Textarea from "@/components/form/Textarea.astro";
import stamp from "@/assets/images/stamps/paraw.jpg";
import postcardPaper from "@/assets/textures/postcard-paper.jpg";
import { PLAYLIST_URI } from "@/settings/playlist.ts";
import { getCollection } from "astro:content";

const [{ data }] = await getCollection("playlist");
const copy = data.copy;
---

{!data.hidden && <section
  id="playlist"
  class="playlist_wrap theme-light"
  style="scroll-margin-top: var(--nav-height)"
>
  <div class="playlist_layout">
    <div class="playlist_left">
      <header class="playlist_header" data-fade-in>
        <h2 class="playlist_title" data-fade-in-item>{copy.titleBefore}<br />{copy.titleAfter}</h2>
      </header>
      <div class="playlist_player" data-fade-in data-fade-in-item>
        <div class="playlist_player-row">
          <div
            class="playlist_turntable"
            data-playlist-turntable
            aria-hidden="true"
          >
            <div class="playlist_turntable-rim"></div>
            <svg class="playlist_turntable-platter" viewBox="0 0 220 220">
              <circle
                cx="110"
                cy="110"
                r="109"
                fill="#0E1630"
                stroke="#FFFFFF24"></circle>
              <g data-playlist-record>
                <circle cx="110" cy="110" r="102" fill="#141414"></circle>
                <g fill="none" stroke-width="1">
                  <circle cx="110" cy="110" r="96" stroke="#FFFFFF14"
                  ></circle><circle cx="110" cy="110" r="89" stroke="#FFFFFF10"
                  ></circle><circle cx="110" cy="110" r="82" stroke="#FFFFFF14"
                  ></circle><circle cx="110" cy="110" r="74" stroke="#FFFFFF0E"
                  ></circle><circle cx="110" cy="110" r="67" stroke="#FFFFFF14"
                  ></circle><circle cx="110" cy="110" r="60" stroke="#FFFFFF10"
                  ></circle><circle cx="110" cy="110" r="52" stroke="#FFFFFF14"
                  ></circle>
                </g>
                <circle cx="110" cy="110" r="38" fill="var(--accent-500)"
                ></circle>
                <circle
                  cx="110"
                  cy="110"
                  r="33"
                  fill="none"
                  stroke="#F5EFE34D"
                  stroke-width="0.75"></circle>
                <text
                  x="110"
                  y="104"
                  text-anchor="middle"
                  class="playlist_record-name">W &amp; E</text
                >
                <text
                  x="110"
                  y="128"
                  text-anchor="middle"
                  class="playlist_record-date">01·14·27</text
                >
              </g>
              <path
                d="M38 62 A86 86 0 0 1 92 26"
                fill="none"
                stroke="#FFFFFF2E"
                stroke-width="6"
                stroke-linecap="round"></path>
              <path
                d="M182 158 A86 86 0 0 1 140 192"
                fill="none"
                stroke="#FFFFFF1A"
                stroke-width="5"
                stroke-linecap="round"></path>
              <circle cx="110" cy="110" r="3.5" fill="#D6CDBB"></circle>
            </svg>
            <svg class="playlist_turntable-tonearm" viewBox="0 0 180 150">
              <circle cx="140" cy="26" r="20" fill="#121B3A" stroke="#FFFFFF1F"
              ></circle>
              <g data-playlist-tonearm class="playlist_tonearm-moving">
                <rect
                  x="152"
                  y="14"
                  width="18"
                  height="24"
                  rx="4"
                  fill="#D6CDBB"
                  transform="rotate(28 140 26)"></rect>
                <path
                  d="M140 26 L132 70 L36 98"
                  fill="none"
                  stroke="#E9DFCB"
                  stroke-width="4"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <rect
                  x="16"
                  y="90"
                  width="26"
                  height="14"
                  rx="2.5"
                  fill="#F5EFE3"
                  transform="rotate(-16 29 97)"></rect>
                <rect
                  x="20"
                  y="100"
                  width="6"
                  height="5"
                  rx="1"
                  fill="#C23B2E"
                  transform="rotate(-16 29 97)"></rect>
              </g>
              <circle cx="140" cy="26" r="9" fill="#D6CDBB"></circle><circle
                cx="140"
                cy="26"
                r="3"
                fill="#1F2F5C"></circle>
            </svg>
          </div>
          <div class="playlist_listen-copy">
            <div class="playlist_eyebrow">
              <span aria-hidden="true"></span>{copy.eyebrow}
            </div><h3>{copy.listenTitle}</h3><p>{copy.listenBody}</p>
          </div>
          <div
            class="playlist_embed"
            data-playlist-embed
            data-uri={PLAYLIST_URI}
            aria-label={copy.spotifyLabel}
          >
            <span>{copy.unavailable}</span>
            <div data-playlist-embed-target></div>
          </div>
        </div>
      </div>
    </div>
    <Form
      name="song-request"
      successMessage={copy.success}
      class="playlist_form-wrap"
      data-fade-in
      data-fade-in-item
      aria-labelledby="playlist-postcard-title"
      data-action-form="true"
    >
      <div
        class="playlist_postcard"
        style={`--postcard-texture: url("${postcardPaper.src}")`}
      >
        <div class="playlist_stamp"><Stamp><Image src={stamp} alt="" width={72} height={93} densities={[1, 2]} aria-hidden="true" /></Stamp></div><div class="playlist_postcard-intro">
          <h3 class="playlist_postcard-title" id="playlist-postcard-title">
            {copy.requestTitle}
          </h3>
          <p class="playlist_postcard-text">
            {copy.requestBody}
          </p>
        </div><Input
          appearance="postcard"
          label={copy.nameLabel}
          name="name"
          placeholder=""
          required
        /><div class="song-search_field"><Input
          appearance="postcard"
          label={copy.songLabel}
          name="song"
          id="song-request-song"
          required
          placeholder={copy.songPlaceholder}
          autocomplete="off"
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls="song-request-suggestions"
        /><div class="song-search_popup" data-song-search-popup hidden><div id="song-request-suggestions" class="song-search_list" role="listbox" aria-label={copy.suggestionsLabel}></div><div class="song-search_footer"><span>{copy.notListed}</span><a class="song-search_credit" href="https://open.spotify.com/" target="_blank" rel="noopener" aria-label={copy.spotifyLink} data-song-search-credit><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M7 9.5c3.8-1 7.1-.5 10 1M7.5 13c3.1-.7 5.8-.3 8.4 1M8.5 16c2.2-.3 4.1.1 5.9 1"/></svg><span>{copy.spotifyBrand}</span></a></div></div><div class="sr-only" aria-live="polite" data-song-search-live></div></div><input type="hidden" name="spotifyTrackId" /><input type="hidden" name="coverUrl" /><Input
          appearance="postcard"
          label={copy.artistLabel}
          name="artist"
          placeholder={copy.artistPlaceholder}
        /><Textarea
          appearance="postcard"
          label={copy.dedicationLabel}
          name="dedication"
          minLines={4}
          maxLines={6}
        /><button class="playlist_submit" type="submit">{copy.submit}</button
        ><div class="playlist_turnstile" data-playlist-turnstile></div>
      </div>
    </Form>
  </div>
  <div class="playlist_scallop" aria-hidden="true"></div>
</section>}

<script>
  import { getGuest } from "@/lib/guest";
  import { actions } from "astro:actions";
  import { createTurnstileController, isFakeTurnstileMode } from "@/scripts/turnstile";
  import copy from "@/content/playlist/playlist.json";
  const initPlaylist = () => {
    const section = document.querySelector<HTMLElement>("#playlist");
    if (!section || section.dataset.playlistInitialized === "true") return;
    section.dataset.playlistInitialized = "true";
    const nameInput = section.querySelector<HTMLInputElement>('input[name="name"]');
    const form = section.querySelector<HTMLFormElement>("form[name='song-request']");
    const wrap = section.querySelector<HTMLElement>(".form_wrap");
    const submit = form?.querySelector<HTMLButtonElement>("button[type='submit']");
    const failed = wrap?.querySelector<HTMLElement>(".form_note-failed");
    const songInput = form?.querySelector<HTMLInputElement>('input[name="song"]');
    const artistInput = form?.querySelector<HTMLInputElement>('input[name="artist"]');
    const list = form?.querySelector<HTMLElement>("[role='listbox']");
    const live = form?.querySelector<HTMLElement>("[data-song-search-live]");
    const popup = form?.querySelector<HTMLElement>("[data-song-search-popup]");
    const credit = form?.querySelector<HTMLAnchorElement>("[data-song-search-credit]");
    const spotifyTrackId = form?.querySelector<HTMLInputElement>('input[name="spotifyTrackId"]');
    const coverUrl = form?.querySelector<HTMLInputElement>('input[name="coverUrl"]');
    type Suggestion = { id: string; title: string; artist: string; album: string; cover: string | null };
    let suggestions: Suggestion[] = [], highlighted = -1, timer: number | undefined, sequence = 0, searchController: AbortController | undefined;
    const closeSuggestions = () => { if (!list || !songInput) return; if (popup) popup.hidden = true; songInput.setAttribute("aria-expanded", "false"); songInput.removeAttribute("aria-activedescendant"); highlighted = -1; };
    const clearPicked = () => { if (spotifyTrackId) spotifyTrackId.value = ""; if (coverUrl) coverUrl.value = ""; };
    const renderSuggestions = () => {
      if (!list || !songInput) return;
      list.replaceChildren();
      suggestions.forEach((item, index) => {
        const option = document.createElement("div"); option.className = "song-search_option"; option.id = `song-search-option-${index}`; option.setAttribute("role", "option"); option.setAttribute("aria-selected", String(index === highlighted)); option.dataset.index = String(index);
        const cover = document.createElement(item.cover ? "img" : "span"); cover.className = "song-search_cover"; if (item.cover) { (cover as HTMLImageElement).src = item.cover; (cover as HTMLImageElement).alt = ""; (cover as HTMLImageElement).loading = "lazy"; } else cover.setAttribute("aria-hidden", "true");
        const text = document.createElement("span"); text.className = "song-search_text"; const title = document.createElement("span"); title.className = "song-search_title"; title.textContent = item.title; const meta = document.createElement("span"); meta.className = "song-search_meta"; meta.textContent = `${item.artist} · ${item.album}`; text.append(title, meta); option.append(cover, text); list.append(option);
      });
      if (suggestions.length) {
        if (credit) credit.href = `https://open.spotify.com/track/${suggestions[highlighted >= 0 ? highlighted : 0].id}`;
        if (popup) popup.hidden = false; songInput.setAttribute("aria-expanded", "true"); if (highlighted >= 0) songInput.setAttribute("aria-activedescendant", `song-search-option-${highlighted}`); live && (live.textContent = `${suggestions.length} ${copy.copy.searchCount}`);
      } else { closeSuggestions(); if (live) live.textContent = ""; }
    };
    const cancelSearch = () => { sequence++; if (timer) window.clearTimeout(timer); searchController?.abort(); };
    const dismissSuggestions = () => { cancelSearch(); closeSuggestions(); };
    const pickSuggestion = (item: Suggestion) => { if (!songInput || !artistInput) return; cancelSearch(); songInput.value = item.title; artistInput.value = item.artist; if (spotifyTrackId) spotifyTrackId.value = item.id; if (coverUrl) coverUrl.value = item.cover ?? ""; closeSuggestions(); };
    songInput?.addEventListener("input", () => { clearPicked(); cancelSearch(); const query = songInput.value.trim(); if (query.length < 2) { suggestions = []; renderSuggestions(); return; } const current = sequence; timer = window.setTimeout(async () => { const requestController = new AbortController(); searchController = requestController; try { const response = await fetch(`/api/songs/search?q=${encodeURIComponent(query)}`, { signal: requestController.signal }); if (!response.ok) throw new Error("search failed"); const data = await response.json() as { results?: Suggestion[] }; if (current !== sequence) return; suggestions = (data.results ?? []).slice(0, 5); highlighted = -1; renderSuggestions(); } catch { if (current === sequence) { suggestions = []; renderSuggestions(); } } }, 250); });
    songInput?.addEventListener("keydown", (event) => { if (event.key === "Escape") { if (!popup?.hidden) event.preventDefault(); dismissSuggestions(); return; } if (!suggestions.length || popup?.hidden) return; if (event.key === "ArrowDown" || event.key === "ArrowUp") { event.preventDefault(); highlighted = highlighted < 0 ? (event.key === "ArrowDown" ? 0 : suggestions.length - 1) : (highlighted + (event.key === "ArrowDown" ? 1 : -1) + suggestions.length) % suggestions.length; songInput.setAttribute("aria-activedescendant", `song-search-option-${highlighted}`); renderSuggestions(); } else if (event.key === "Enter" && highlighted >= 0) { event.preventDefault(); pickSuggestion(suggestions[highlighted]); } });
    popup?.addEventListener("pointerdown", (event) => { event.preventDefault(); const option = (event.target as HTMLElement).closest<HTMLElement>("[data-index]"); if (!option) return; pickSuggestion(suggestions[Number(option.dataset.index)]!); });
    const leavesSearch = (next: EventTarget | null) => !(next instanceof Node && (popup?.contains(next) || next === songInput));
    songInput?.addEventListener("blur", (event) => { if (leavesSearch(event.relatedTarget)) dismissSuggestions(); });
    popup?.addEventListener("focusout", (event) => { if (leavesSearch(event.relatedTarget)) dismissSuggestions(); }); artistInput?.addEventListener("input", clearPicked); document.addEventListener("pointerdown", (event) => { if (!form?.contains(event.target as Node)) dismissSuggestions(); });
    const turnstile = createTurnstileController(isFakeTurnstileMode(import.meta.env.PUBLIC_RSVP_STORE, import.meta.env.DEV));
    const remembered = getGuest();
    if (nameInput && remembered && "name" in remembered && !nameInput.value) nameInput.value = remembered.name;
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      dismissSuggestions();
      if (!form.checkValidity() || !submit) return;
      submit.disabled = true;
      if (wrap) wrap.dataset.state = "sending";
      if (failed) failed.hidden = true;
      try {
        const value = (field: string) => (form.elements.namedItem(field) as HTMLInputElement | HTMLTextAreaElement).value;
        const result = await actions.songs.submit({ name: value("name"), song: value("song"), artist: value("artist") || undefined, dedication: value("dedication") || undefined, spotifyTrackId: value("spotifyTrackId") || undefined, coverUrl: value("coverUrl") || undefined, turnstileToken: await turnstile.getToken(section.querySelector<HTMLElement>("[data-playlist-turnstile]")!) });
        if (result.error) throw new Error(result.error.message);
        if (wrap) wrap.dataset.state = "sent";
        form.reset(); clearPicked(); dismissSuggestions();
      } catch (error) {
        if (wrap) wrap.dataset.state = "failed";
        if (failed) { failed.textContent = error instanceof Error ? error.message : copy.copy.error; failed.hidden = false; }
      } finally { turnstile.reset(); submit.disabled = false; }
    });
    const onGuest = (event: Event) => {
      const guestName = (event as CustomEvent<{ name?: string }>).detail?.name;
      if (nameInput && guestName && !nameInput.value) nameInput.value = guestName;
    };
    document.addEventListener("ew:guest", onGuest);
    const embed = section.querySelector<HTMLElement>("[data-playlist-embed]");
    const embedTarget = section.querySelector<HTMLElement>(
      "[data-playlist-embed-target]",
    );
    const record = section.querySelector<SVGElement>("[data-playlist-record]");
    const tonearm = section.querySelector<SVGElement>(
      "[data-playlist-tonearm]",
    );
    if (!embed || !embedTarget || !record || !tonearm) return;
    interface SpotifyPlaybackEvent {
      data: { isPaused: boolean; position: number; duration: number };
    }
    interface SpotifyController {
      pause: () => void;
      addListener: (
        event: string,
        callback: (event: SpotifyPlaybackEvent) => void,
      ) => void;
    }
    interface SpotifyAPI {
      createController: (
        element: HTMLElement,
        options: { uri: string; width: string; height: number; theme: "dark" },
        callback: (controller: SpotifyController) => void,
      ) => void;
    }
    let controller: SpotifyController | undefined;
    let playing = false;
    let frame = 0;
    let timeout: number | undefined;
    let armStartTimeout: number | undefined;
    let pauseTimeout: number | undefined;
    let observer: IntersectionObserver | undefined;
    let script: HTMLScriptElement | undefined;
    let recordAngle = 0;
    let lastFrameAt = 0;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const playlistUri = embed.dataset.uri;
    const spinDegreesPerMillisecond = 360 / 1800;
    const decelerationDuration = 1000;
    const setRecordAngle = (angle: number) => {
      recordAngle = angle;
      record.style.transform = `rotate(${angle}deg)`;
    };
    const stopFrame = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      lastFrameAt = 0;
    };
    const spin = (now: number) => {
      if (!playing || reducedMotion.matches) {
        stopFrame();
        return;
      }
      const elapsed = lastFrameAt ? Math.min(now - lastFrameAt, 100) : 0;
      lastFrameAt = now;
      setRecordAngle(recordAngle + elapsed * spinDegreesPerMillisecond);
      frame = requestAnimationFrame(spin);
    };
    const startSpin = () => {
      if (playing && !reducedMotion.matches && !frame) {
        lastFrameAt = 0;
        frame = requestAnimationFrame(spin);
      }
    };
    const decelerate = () => {
      stopFrame();
      if (reducedMotion.matches) return;
      const startedAt = performance.now();
      const startedAngle = recordAngle;
      const slow = (now: number) => {
        const progress = Math.min((now - startedAt) / decelerationDuration, 1);
        const decelerationAngle =
          (spinDegreesPerMillisecond * decelerationDuration) / 3;
        setRecordAngle(
          startedAngle + decelerationAngle * (1 - (1 - progress) ** 3),
        );
        if (progress < 1) frame = requestAnimationFrame(slow);
      };
      frame = requestAnimationFrame(slow);
    };
    const liftArm = () => {
      pauseTimeout = undefined;
      playing = false;
      if (reducedMotion.matches) {
        stopFrame();
        tonearm.style.transition = "none";
        tonearm.style.transform = "rotate(-30deg)";
        return;
      }
      decelerate();
      tonearm.style.transition =
        "transform 600ms cubic-bezier(0.23, 1, 0.32, 1)";
      tonearm.style.transform = "rotate(-30deg)";
    };
    const play = () => {
      if (pauseTimeout) window.clearTimeout(pauseTimeout);
      pauseTimeout = undefined;
      if (playing) return;
      stopFrame();
      playing = true;
      if (reducedMotion.matches) {
        stopFrame();
        tonearm.style.transition = "none";
        tonearm.style.transform = "rotate(0deg)";
        return;
      }
      tonearm.style.transition =
        "transform 600ms cubic-bezier(0.23, 1, 0.32, 1)";
      tonearm.style.transform = "rotate(0deg)";
      if (armStartTimeout) window.clearTimeout(armStartTimeout);
      armStartTimeout = window.setTimeout(() => {
        armStartTimeout = undefined;
        startSpin();
      }, 600);
    };
    const pause = () => {
      if (!playing || pauseTimeout) return;
      pauseTimeout = window.setTimeout(liftArm, 400);
    };
    const pauseForHiddenPage = () => {
      controller?.pause();
      pause();
    };
    const handleReducedMotion = () => {
      const pausing = Boolean(pauseTimeout);
      if (pauseTimeout) window.clearTimeout(pauseTimeout);
      pauseTimeout = undefined;
      if (reducedMotion.matches) {
        if (pausing) playing = false;
        if (armStartTimeout) window.clearTimeout(armStartTimeout);
        armStartTimeout = undefined;
        stopFrame();
        tonearm.style.transition = "none";
        tonearm.style.transform = `rotate(${playing ? 0 : -30}deg)`;
      } else if (playing) {
        tonearm.style.transition =
          "transform 600ms cubic-bezier(0.23, 1, 0.32, 1)";
        tonearm.style.transform = "rotate(0deg)";
        armStartTimeout = window.setTimeout(startSpin, 600);
      }
    };
    const fail = () => {
      if (timeout) window.clearTimeout(timeout);
      if (embed.querySelector("iframe")) embed.classList.add("is-ready");
    };
    const ready = (api: SpotifyAPI) => {
      if (controller || !playlistUri) return;
      api.createController(
        embedTarget,
        { uri: playlistUri, width: "100%", height: 80, theme: "dark" },
        (created) => {
          controller = created;
          embed.classList.add("is-ready");
          if (timeout) window.clearTimeout(timeout);
          controller.addListener("playback_update", (event) => {
            if (event.data.isPaused) pause();
            else { document.dispatchEvent(new CustomEvent("ew:playlist-play")); play(); }
          });
        },
      );
    };
    const load = () => {
      const spotify = (window as Window & { IFrameAPI?: SpotifyAPI }).IFrameAPI;
      if (spotify) return ready(spotify);
      (
        window as Window & {
          onSpotifyIframeApiReady?: (api: SpotifyAPI) => void;
        }
      ).onSpotifyIframeApiReady = ready;
      script = document.createElement("script");
      script.src = "https://open.spotify.com/embed/iframe-api/v1";
      script.async = true;
      script.addEventListener("error", fail, { once: true });
      document.head.appendChild(script);
      timeout = window.setTimeout(() => {
        if (!controller) fail();
      }, 10000);
    };
    observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          load();
          observer?.disconnect();
        }
      },
      { rootMargin: "200px" },
    );
    observer.observe(section);
    tonearm.style.transform = "rotate(-30deg)";
    reducedMotion.addEventListener("change", handleReducedMotion);
    const onVisibilityChange = () => { if (document.visibilityState === "hidden") pauseForHiddenPage(); };
    document.addEventListener("visibilitychange", onVisibilityChange);
    window.addEventListener("pagehide", pauseForHiddenPage);
    document.addEventListener(
      "astro:before-swap",
      () => {
        stopFrame();
        if (armStartTimeout) window.clearTimeout(armStartTimeout);
        if (pauseTimeout) window.clearTimeout(pauseTimeout);
        reducedMotion.removeEventListener("change", handleReducedMotion);
        observer?.disconnect();
        if (timeout) window.clearTimeout(timeout);
        document.removeEventListener("visibilitychange", onVisibilityChange);
        window.removeEventListener("pagehide", pauseForHiddenPage);
      },
      { once: true },
    );
  };
  initPlaylist();
  document.addEventListener("astro:page-load", initPlaylist);
</script>

<style is:global>
  @layer components {
    .playlist_wrap {
      position: relative;
      overflow: clip;
      padding: var(--section-space-medium) var(--site-margin)
        calc(var(--section-space-medium) + 1rem);
      background-color: var(--light-100);
      background-image: var(--background-texture);
      color: var(--dark-900);
    }
    .playlist_layout {
      display: grid;
      gap: var(--space-7);
      max-width: var(--max-width-main);
      margin-inline: auto;
    }
    .playlist_left {
      display: grid;
      gap: var(--space-7);
      min-width: 0;
    }
    .playlist_header {
      display: grid;
      gap: var(--space-4);
    }
    .playlist_title {
      margin: 0;
      font-family: var(--secondary-family);
      font-size: var(--h1);
      font-weight: var(--secondary-regular);
      line-height: 1.1;
      padding-bottom: var(--secondary-trim-bottom);
      letter-spacing: var(--letter-spacing-tight);
    }
    .playlist_player {
      display: grid;
      gap: var(--space-4);
      min-width: 0;
    }
    .playlist_player-row {
      display: grid;
      grid-template-areas: "copy" "turntable" "embed";
      gap: var(--space-4);
    }
    .playlist_eyebrow {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--accent-500);
      font-family: var(--mono-family);
      font-size: 0.75rem;
      letter-spacing: 0.14em;
      line-height: 1;
    }
    .playlist_eyebrow span {
      width: 0.375rem;
      height: 0.375rem;
      flex: 0 0 auto;
      border-radius: 50%;
      background: currentColor;
    }
    .playlist_listen-copy {
      display: grid;
      grid-area: copy;
      gap: var(--space-4);
    }
    .playlist_listen-copy h3,
    .playlist_listen-copy p {
      display: none;
    }
    .playlist_turntable {
      grid-area: turntable;
    }
    .playlist_embed {
      grid-area: embed;
    }
    .playlist_turntable {
      container-type: inline-size;
      position: relative;
      width: 100%;
      aspect-ratio: 380 / 260;
      transform: rotate(-3deg);
      isolation: isolate;
    }
    .playlist_turntable::before {
      position: absolute;
