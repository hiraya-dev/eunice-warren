---
import { Image } from "astro:assets";
import Arrow from "@/assets/icons/arrow-full.svg";
import ladies01OneShoulder from "@/assets/images/attire/ladies-01-one-shoulder.jpg";
import ladies02HalterPleat from "@/assets/images/attire/ladies-02-halter-pleat.jpg";
import ladies03Tiered from "@/assets/images/attire/ladies-03-tiered.jpg";
import ladies04FlutterWrap from "@/assets/images/attire/ladies-04-flutter-wrap.jpg";
import ladies05FlutterSleeve from "@/assets/images/attire/ladies-05-flutter-sleeve.jpg";
import ladies06Coord from "@/assets/images/attire/ladies-06-coord.jpg";
import ladies07RuffleCascade from "@/assets/images/attire/ladies-07-ruffle-cascade.jpg";
import gents01LongSleeves from "@/assets/images/attire/gents-01-long-sleeves.jpg";
import gents02CampCollar from "@/assets/images/attire/gents-02-camp-collar.jpg";
import gents03ChineseCollar from "@/assets/images/attire/gents-03-chinese-collar.jpg";
import gents04RolledSleeves from "@/assets/images/attire/gents-04-rolled-sleeves.jpg";
import gents05ShortSleeves from "@/assets/images/attire/gents-05-short-sleeves.jpg";
import gents06LightSuit from "@/assets/images/attire/gents-06-light-suit.jpg";
import gents07DressShirt from "@/assets/images/attire/gents-07-dress-shirt.jpg";
import postmark from "@/assets/images/attire/postmark-no-white.png";

const colours = [
  { name: "Tiffany blue", key: "tiffany" },
  { name: "Seafoam green", key: "seafoam" },
  { name: "Champagne", key: "champagne" },
  { name: "Gold", key: "gold" },
];

const looks = [
  {
    id: "ladies",
    label: "Looks for the ladies",
    heading: "ladies",
    lead: "Opt for solid-coloured, monochromatic dresses in elegant styles.",
    rest: " Long, flowy dresses, draped silhouettes, slip dresses and sophisticated co-ord sets are welcome.",
    items: [
      { caption: "One-shoulder", colour: "Tiffany", src: ladies01OneShoulder, alt: "Woman in a Tiffany blue one-shoulder chiffon gown with a draped cape sleeve and a side slit" },
      { caption: "Halter pleat", colour: "Seafoam", src: ladies02HalterPleat, alt: "Woman in a seafoam green halter-neck pleated maxi dress, holding a cream clutch" },
      { caption: "Tiered", colour: "Champagne", src: ladies03Tiered, alt: "Woman in a champagne strappy maxi dress with a tiered ruffled skirt" },
      { caption: "Flutter wrap", colour: "Gold", src: ladies04FlutterWrap, alt: "Woman in a gold flutter-sleeve wrap maxi dress with a side slit" },
      { caption: "Flutter sleeve", colour: "Tiffany", src: ladies05FlutterSleeve, alt: "Woman in a Tiffany blue V-neck pleated maxi dress with sheer flutter sleeves" },
      { caption: "Co-ord set", colour: "Seafoam", src: ladies06Coord, alt: "Woman in a seafoam green halter top and wide-leg trouser co-ord set" },
      { caption: "Ruffle cascade", colour: "Champagne", src: ladies07RuffleCascade, alt: "Woman in a champagne strappy maxi dress with a cascading ruffle skirt" },
    ],
  },
  {
    id: "gentlemen",
    label: "Looks for the gentlemen",
    heading: "gentlemen",
    lead: "Think relaxed sophistication.",
    rest: " Wear a long-sleeve or short-sleeve dress shirt, a refined co-ord or a Chinese-collared top in our wedding colours.",
    items: [
      { caption: "Long sleeves", colour: "Champagne", src: gents01LongSleeves, alt: "Man in a champagne long-sleeve linen shirt and cream trousers, a sage blazer over his arm" },
      { caption: "Camp collar", colour: "Tiffany", src: gents02CampCollar, alt: "Man in a Tiffany blue short-sleeve camp-collar shirt with matching trousers" },
      { caption: "Chinese collar", colour: "Champagne", src: gents03ChineseCollar, alt: "Man in a champagne Chinese-collared long-sleeve shirt with matching trousers" },
      { caption: "Rolled sleeves", colour: "Seafoam", src: gents04RolledSleeves, alt: "Man in a seafoam green dress shirt with rolled sleeves and cream trousers" },
      { caption: "Short sleeves", colour: "Gold", src: gents05ShortSleeves, alt: "Man in a gold short-sleeve shirt with cream trousers" },
      { caption: "Light suit", colour: "Tiffany", src: gents06LightSuit, alt: "Man in a Tiffany blue suit over an open-collar champagne shirt" },
      { caption: "Dress shirt", colour: "Seafoam", src: gents07DressShirt, alt: "Man in a seafoam green long-sleeve dress shirt with beige trousers" },
    ],
  },
];

const notes = [
  { label: "Tops", crossed: true, items: ["No T-shirts", "No polo shirts", "No multi-coloured", "No floral"] },
  { label: "Bottoms", crossed: true, items: ["No shorts", "No black pants"] },
  { label: "Footwear", crossed: false, items: ["Wear something appropriate for the church."] },
];

const holes = Array.from({ length: 8 });
---

<section id="attire" class="attire_wrap">
  <div class="attire_layout">
    <header class="attire_header">
      <p class="attire_eyebrow">Wedding attire guide</p>
      <div class="attire_title-wrap">
        <h2 class="attire_title">Island <em>formal</em></h2>
        <p class="attire_accent">
          <svg class="attire_accent-arrow" viewBox="0 0 40 28" focusable="false" aria-hidden="true"><path d="M38 23 C27 23 12 18 5 5 M4 4 L6.5 15 M4 4 L15 7.5" fill="none" stroke="var(--accent-500)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span class="attire_accent-text">Elegance meets<br />island charm.</span>
        </p>
      </div>
      <p class="attire_intro">We invite you to dress in elevated, elegant attire with a relaxed island feel.</p>
      <ul class="attire_colours" aria-label="Wedding colours">
        {colours.map((colour) => (
          <li class="attire_colour">
            <span class={`attire_swatch attire_swatch-${colour.key}`} aria-hidden="true"></span>
            <span class="attire_colour-name">{colour.name}</span>
          </li>
        ))}
      </ul>
      <p class="attire_suggestions">The looks below are suggestions to inspire you. Any elegant style in our colours is welcome.</p>
    </header>

    {looks.map((group) => (
      <div class="attire_looks">
        <div class="attire_looks-header">
          <h3 class="attire_looks-title">For the <em>{group.heading}</em></h3>
          <p class="attire_looks-copy"><span>{group.lead}</span>{group.rest}</p>
        </div>

        <div
          class="attire_row"
          data-gsap-slider-init
          role="region"
          aria-roledescription="carousel"
          aria-label={group.label}
        >
          <svg class="attire_string attire_string-desktop" viewBox="0 0 1440 80" preserveAspectRatio="none" focusable="false" aria-hidden="true"><path d="M0 18 Q720 78 1440 18" fill="none" stroke="#8c7a5b" stroke-width="1.5" vector-effect="non-scaling-stroke" /></svg>
          <svg class="attire_string attire_string-mobile" viewBox="0 0 420 40" preserveAspectRatio="none" focusable="false" aria-hidden="true"><path d="M0 12 Q210 30 420 14" fill="none" stroke="#8c7a5b" stroke-width="1.5" vector-effect="non-scaling-stroke" /></svg>

          <div class="attire_collection" data-gsap-slider-collection>
            <div class="attire_list gsap-slider__list" data-gsap-slider-list>
              {group.items.map((look) => (
                <div class="attire_item gsap-slider__item" data-gsap-slider-item>
                  <figure class="attire_polaroid">
                    <span class="attire_peg" aria-hidden="true"></span>
                    <div class="attire_photo">
                      <Image
                        src={look.src}
                        alt={look.alt}
                        width={888}
                        height={1184}
                        widths={[176, 352, 704]}
                        sizes="(min-width: 75rem) 9.25rem, 11rem"
                        loading="lazy"
                      />
                    </div>
                    <figcaption class="attire_caption">
                      <span class="attire_caption-name">{look.caption}<span class="sr-only">, {look.colour}</span></span>
                      <span class={`attire_caption-dot attire_caption-dot-${look.colour.toLowerCase()}`} aria-hidden="true"></span>
                    </figcaption>
                  </figure>
                </div>
              ))}
            </div>
          </div>

          <div class="attire_controls-row">
            <span class="attire_counter" data-gsap-slider-counter aria-live="polite">01 / {String(group.items.length).padStart(2, "0")}</span>
            <div class="attire_controls" data-gsap-slider-controls>
              <button class="attire_control attire_control-prev" type="button" data-gsap-slider-control="prev" aria-label="Previous look">
                <span class="attire_control-icon" aria-hidden="true"><Arrow /></span>
              </button>
              <button class="attire_control attire_control-next" type="button" data-gsap-slider-control="next" aria-label="Next look">
                <span class="attire_control-icon" aria-hidden="true"><Arrow /></span>
              </button>
            </div>
          </div>
        </div>
      </div>
    ))}

    <div class="attire_note-wrap">
      <div class="attire_note">
        <span class="attire_note-tape" aria-hidden="true"></span>
        <span class="attire_note-holes" aria-hidden="true">{holes.map(() => <i></i>)}</span>
        <h3 class="attire_note-title">Please take note</h3>
        <div class="attire_note-groups">
          {notes.map((group) => (
            <div class="attire_note-group">
              <h4 class="attire_note-label">{group.label}</h4>
              <ul class="attire_note-list">
                {group.items.map((item) => (
                  <li>
                    {group.crossed && (
                      <svg class="attire_note-cross" viewBox="0 0 28 28" focusable="false" aria-hidden="true"><path d="M6.5 7 L21 21.5 M21.5 6.5 L7 21" fill="none" stroke="var(--accent-500)" stroke-width="3" stroke-linecap="round" /></svg>
                    )}
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div class="attire_note-seal">
          <Image
            class="attire_postmark"
            src={postmark}
            alt="Strictly no white"
            width={340}
            height={254}
            densities={[1, 2]}
            loading="lazy"
          />
          <p class="attire_note-sentence">Please reserve this colour for the newlyweds so they stand out in the crowd.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @layer components {
    .attire_wrap {
      /* Guest attire motif colours, deliberately not site tokens. */
      --_attire-tiffany: #81d8d0;
      --_attire-seafoam: #a8c9a6;
      --_attire-champagne: #eedfc4;
      --_attire-gold: #c9a33f;
      --_attire-string: #8c7a5b;
      --_attire-paper: #fcfaf4;
      --_attire-rule: rgb(130 170 205 / 55%);
      --_attire-ink-soft: rgb(31 47 92 / 14%);
      position: relative;
      overflow: clip;
      padding: var(--section-space-medium) var(--site-margin);
      background: var(--light-100) var(--background-texture) center / 32rem repeat;
      color: var(--dark-900);
    }
    .attire_layout {
      display: flex;
      width: 100%;
      max-width: var(--max-width-main);
      margin-inline: auto;
      flex-direction: column;
      gap: 4.5rem;
    }

    /* Header */
    .attire_header {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .attire_eyebrow {
      margin: 0;
      color: var(--accent-500);
      font: var(--primary-regular) var(--eyebrow) / 1.333 var(--mono-family);
      letter-spacing: var(--letter-spacing-wider);
      text-transform: uppercase;
    }
    .attire_title-wrap {
      --_title-size: clamp(3.875rem, 19.5vw, 4.75rem);
      position: relative;
      width: fit-content;
      margin: var(--space-3) auto 0;
      font-size: var(--_title-size);
    }
    .attire_title {
      margin: 0;
      font: var(--secondary-regular) 1em / 0.95 var(--secondary-family);
      letter-spacing: var(--letter-spacing-tighter);
    }
    .attire_title em {
      display: block;
      font-weight: var(--secondary-ultralight);
    }
    .attire_accent {
      position: absolute;
      top: calc(100% + 0.375rem);
      left: calc(50% - 2.75rem);
      display: flex;
      margin: 0;
      align-items: flex-start;
      gap: 0.25rem;
      color: var(--accent-500);
      font: 400 max(1.375rem, 0.342em) / 1.0769 var(--hand-family);
      text-align: left;
      white-space: nowrap;
      rotate: -7deg;
      transform-origin: 0 0;
    }
    .attire_accent-arrow {
      width: 2.5em;
      height: 1.75em;
      flex: none;
      margin-top: -0.35em;
    }
    .attire_intro {
      max-width: 24rem;
      margin: 5.75rem 0 0;
      color: var(--dark-900);
      font: var(--primary-regular) 1.125rem / 1.75rem var(--primary-family);
    }
    .attire_colours {
      display: grid;
      margin: var(--space-5) 0 0;
      padding: 0;
      grid-template-columns: repeat(4, 4.5rem);
      gap: 1rem 1.125rem;
      list-style: none;
    }
    .attire_colour {
      display: flex;
      min-width: 0;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }
    .attire_swatch {
      display: block;
      width: 3.25rem;
      aspect-ratio: 1;
      border-radius: 50%;
      outline: 1px dashed rgb(31 47 92 / 35%);
      outline-offset: -7px;
      box-shadow: 0 4px 10px rgb(31 47 92 / 14%);
    }
    .attire_swatch-tiffany { background: var(--_attire-tiffany); }
    .attire_swatch-seafoam { background: var(--_attire-seafoam); }
    .attire_swatch-champagne { background: linear-gradient(135deg, var(--_attire-champagne) 0%, #faf3e6 50%, #ebdbbe 100%); }
    .attire_swatch-gold { background: linear-gradient(135deg, var(--_attire-gold) 0%, #f0da92 50%, #c59d3a 100%); }
    .attire_colour-name {
      color: var(--dark-900);
      font: var(--primary-regular) 0.6875rem / 1.25 var(--mono-family);
      letter-spacing: var(--letter-spacing-wide);
      text-transform: uppercase;
    }
    .attire_suggestions {
      max-width: 35rem;
      margin: var(--space-6) 0 0;
      color: var(--dark-700);
      font: var(--primary-regular) 0.9375rem / 1.375rem var(--primary-family);
    }

    /* Looks */
    .attire_looks {
      display: flex;
      min-width: 0;
      flex-direction: column;
      gap: var(--space-5);
    }
    .attire_looks-header {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .attire_looks-title {
      margin: 0;
      font: var(--secondary-regular) 2.75rem / 3rem var(--secondary-family);
      letter-spacing: var(--letter-spacing-tight);
    }
    .attire_looks-title em {
      font-weight: var(--secondary-ultralight);
    }
    .attire_looks-copy {
      margin: 0;
      color: var(--dark-700);
      font: var(--primary-regular) 1rem / 1.5rem var(--primary-family);
    }
    .attire_looks-copy span {
      color: var(--dark-900);
    }
    .attire_row {
      --slider-status: on;
      --slider-gap: 1.5rem;
      position: relative;
    }
    .attire_string {
      position: absolute;
      z-index: 0;
      top: 0.5rem;
      left: 50%;
      width: 100vw;
      /* The global svg rule caps width at the parent; the string must outrun it. */
      max-width: none;
      translate: -50% 0;
      pointer-events: none;
    }
    .attire_string-desktop { display: none; }
    .attire_string-mobile { height: 2.5rem; }
    .attire_collection {
      overflow: hidden;
      margin: 0 calc(var(--site-margin) * -1) 0 -0.75rem;
    }
    .attire_list {
      display: flex;
      align-items: flex-start;
      padding: 2.0625rem 0 1.25rem 0.75rem;
      user-select: none;
      touch-action: pan-y;
    }
    [data-gsap-slider-list-status="grab"] { cursor: grab; }
    [data-gsap-slider-list-status="grabbing"] { cursor: grabbing; }
    .attire_item {
      position: relative;
      z-index: 1;
      width: 12.5rem;
      flex: none;
      margin-right: var(--slider-gap);
      container-type: inline-size;
    }
    [data-gsap-slider-item]:last-child {
      margin-right: 0;
    }
    .attire_polaroid {
      position: relative;
      display: flex;
      margin: 0;
      padding: 0.75rem 0.75rem 1rem;
      flex-direction: column;
      gap: 0.625rem;
      background: var(--light-200);
      box-shadow: 0 1px 1px rgb(31 47 92 / 10%), 0 10px 22px rgb(31 47 92 / 12%);
      rotate: var(--_tilt, 0deg);
    }
    .attire_item:nth-child(1) .attire_polaroid { --_tilt: -3deg; }
    .attire_item:nth-child(2) .attire_polaroid { --_tilt: 2deg; }
    .attire_item:nth-child(3) .attire_polaroid { --_tilt: -1.5deg; }
    .attire_item:nth-child(4) .attire_polaroid { --_tilt: 2.5deg; }
    .attire_item:nth-child(5) .attire_polaroid { --_tilt: -2deg; }
    .attire_item:nth-child(6) .attire_polaroid { --_tilt: 1.5deg; }
    .attire_item:nth-child(7) .attire_polaroid { --_tilt: 3deg; }
    .attire_peg {
      position: absolute;
      z-index: 2;
      top: -1.5rem;
      left: 50%;
      width: 0.875rem;
      height: 2.375rem;
      border-radius: 3px;
      background: linear-gradient(90deg, #c9a77a, #e2c79c 50%, #b8956a);
      box-shadow: 0 2px 3px rgb(31 47 92 / 20%);
      translate: -50% 0;
    }
    .attire_photo {
      overflow: clip;
      background: var(--light-300);
    }
    .attire_photo :global(img) {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 3 / 4;
      object-fit: cover;
    }
    .attire_caption {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0 0.5rem;
    }
    .attire_caption-name {
      min-width: 0;
      color: var(--dark-900);
      font: 400 1.375rem / 1.5rem var(--hand-family);
    }
    .attire_caption-dot {
      width: 0.625rem;
      height: 0.625rem;
      flex: none;
      border-radius: 50%;
      background: var(--_dot);
      box-shadow: inset 0 0 0 1px rgb(31 47 92 / 15%);
    }
    .attire_caption-dot-tiffany { --_dot: var(--_attire-tiffany); }
    .attire_caption-dot-seafoam { --_dot: var(--_attire-seafoam); }
    .attire_caption-dot-champagne { --_dot: var(--_attire-champagne); }
    .attire_caption-dot-gold { --_dot: var(--_attire-gold); }

    /* Slider controls (mobile only) */
    .attire_controls-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
      padding-top: var(--space-3);
    }
    .attire_counter {
      color: var(--dark-700);
      font: var(--primary-regular) var(--eyebrow) / 1rem var(--mono-family);
      letter-spacing: var(--letter-spacing-wide);
      white-space: nowrap;
    }
    .attire_controls {
      display: flex;
      flex: none;
      gap: var(--space-2);
    }
    .attire_control {
      display: grid;
      width: 2.75rem;
      height: 2.75rem;
      flex: none;
      place-items: center;
      padding: 0;
      border: 0.09375rem solid var(--dark-900);
      border-radius: 50%;
      background: transparent;
      color: var(--dark-900);
      cursor: pointer;
    }
    .attire_control-next {
      background: var(--dark-900);
      color: var(--light-100);
    }
    .attire_control-icon {
      display: block;
      width: 1.25rem;
      height: 1rem;
    }
    .attire_control-icon :global(svg) {
      display: block;
      width: 100%;
      height: 100%;
    }
    .attire_control-prev .attire_control-icon { rotate: 180deg; }
    .attire_control:focus-visible {
      outline: var(--focus-width) solid var(--dark-900);
      outline-offset: var(--focus-offset);
    }
    [data-gsap-slider-control-status="not-active"] {
      opacity: 0.4;
      pointer-events: none;
    }
    [data-gsap-slider-status="not-active"] [data-gsap-slider-controls] {
      display: none;
    }

    /* Notebook page */
    .attire_note-wrap {
      display: flex;
      justify-content: center;
      padding-block: 0.75rem;
    }
    .attire_note {
      position: relative;
      width: 100%;
      padding: 6rem 1.25rem 2rem 3.5rem;
      background:
        repeating-linear-gradient(to bottom, transparent 0 31px, var(--_attire-rule) 31px 32px) 0 64px / 100% calc(100% - 64px) no-repeat,
        var(--_attire-paper);
      box-shadow: 0 1px 1px rgb(31 47 92 / 10%), 0 14px 28px rgb(31 47 92 / 12%);
      rotate: -1deg;
    }
    .attire_note::before {
      position: absolute;
      top: 0;
      right: 0;
      left: 0;
      height: 9px;
      background: var(--light-100) var(--background-texture) center / 32rem repeat;
      content: "";
      mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 18px 100%;
    }
    .attire_note::after {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 2.375rem;
      width: 5px;
      background: linear-gradient(90deg, rgb(194 59 46 / 55%) 0 1px, transparent 1px 4px, rgb(194 59 46 / 55%) 4px 5px);
      content: "";
    }
    .attire_note-tape {
      position: absolute;
      z-index: 1;
      top: -0.8125rem;
      left: 30%;
      width: 5.25rem;
      height: 1.625rem;
      background: rgb(129 216 208 / 55%);
      rotate: -3deg;
    }
    .attire_note-holes {
      position: absolute;
      top: 18px;
      right: 1.75rem;
      left: 1.75rem;
      display: flex;
      gap: clamp(0.25rem, 2.2vw, 1.5rem);
    }
    .attire_note-holes i {
      display: block;
      width: 12px;
      height: 12px;
      flex: none;
      border: 1px solid rgb(31 47 92 / 18%);
      border-radius: 50%;
      background: #e9e1d0;
      box-sizing: border-box;
    }
    .attire_note-holes i:nth-child(4) { margin-right: auto; }
    .attire_note-title {
      margin: 0;
      color: var(--dark-900);
      font: 400 clamp(2rem, 9.75vw, 2.375rem) / 4rem var(--hand-family);
    }
    .attire_note-groups {
      display: flex;
      margin-top: 4rem;
      flex-direction: column;
      gap: 2rem;
    }
    .attire_note-group {
      min-width: 0;
    }
    .attire_note-label {
      margin: 0;
      color: var(--accent-500);
      font: var(--primary-regular) 0.6875rem / 2rem var(--mono-family);
