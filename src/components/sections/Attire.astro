            <li>
              <svg class="attire_item-icon" viewBox="0 0 28 28" focusable="false" aria-hidden="true"><path d="M3 4.5 Q13 3 24.5 3.5 Q25.5 14 24 24.5 Q13 25.5 3.5 24 Q2.5 14 3 4.5Z" fill="none" stroke="var(--dark-900)" stroke-width="1.6" stroke-linejoin="round" /><path d="M7 14 L12 20 L26 2" fill="none" stroke="var(--accent-500)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
