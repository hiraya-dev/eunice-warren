---
import { Image } from "astro:assets";
import type { HTMLAttributes } from "astro/types";
import stamp from "@/assets/images/rsvp/stamp-received.png";
import postcardPaper from "@/assets/textures/postcard-paper.jpg";
import { CHURCH_MAP_URL, MESSAGE_US_HREF, RSVP_DEADLINE_LABEL, WEDDING_CALENDAR_PATH } from "@/consts";
import RsvpTicketPrinter from "@/components/sections/RsvpTicketPrinter.astro";
import { getCollection } from "astro:content";

const [{ data }] = await getCollection("rsvp");
const copy = data.copy;

interface Props extends HTMLAttributes<"section"> {
  /** Message destination for guests who cannot find an invite. */
  messageHref?: string;
  /** Calendar event destination. */
  calendarHref?: string;
  /** Map destination. */
  mapsHref?: string;
}

const {
  messageHref = MESSAGE_US_HREF,
  calendarHref = WEDDING_CALENDAR_PATH,
  mapsHref = CHURCH_MAP_URL,
  class: className,
  ...rest
} = Astro.props;
---

{!data.hidden && <section
  id="rsvp"
  class:list={["rsvp_wrap", "theme-dark", className]}
  style="scroll-margin-top: var(--nav-height)"
  {...rest}
>
  <div
    class="rsvp_layout"
    data-rsvp-init
    data-rsvp-deadline={RSVP_DEADLINE_LABEL}
  >
    <div class="rsvp_left">
      <header class="rsvp_header" data-rsvp-header data-fade-in>
        <h2 class="rsvp_title" data-fade-in-item>{copy.titleBefore}<br />{copy.titleAfter}</h2>
        <p class="rsvp_intro" data-rsvp-intro data-fade-in-item>
          {copy.intro.replace("{deadline}", () => RSVP_DEADLINE_LABEL)}
        </p>
      </header>
      <div class="rsvp_invitation" data-rsvp-invitation hidden>
        <div class="rsvp_invitation-top">
          <div>
            <span class="rsvp_eyebrow">{copy.invitation}</span><strong
              data-rsvp-household></strong>
          </div><div class="rsvp_admits">
            <span class="rsvp_eyebrow">{copy.admits}</span><strong data-rsvp-seats
            ></strong>
          </div>
        </div>
        <div class="rsvp_invitation-bottom">
          <ul>
            <li>{copy.date}</li><li>{copy.venue}</li><li>{copy.dress}</li>
          </ul><div class="rsvp_invitation-links">
            <a href={calendarHref}>{copy.calendar}</a><a href={mapsHref} target="_blank" rel="noopener"
              >{copy.maps}</a
            >
          </div>
        </div>
      </div>
    </div>

    <div class="rsvp_right">
      <ol class="rsvp_steps" aria-label={copy.progress} data-rsvp-steps data-fade-in data-fade-in-item>
        <li data-step="1" aria-current="step">
          <span></span><b
            >1 · <span class="rsvp_step-full">{copy.findFull}</span><span
              class="rsvp_step-short">{copy.findShort}</span
            ></b
          >
        </li>
        <li data-step="2"><span></span><b>2 · {copy.attendingStep}</b></li>
        <li data-step="3"><span></span><b>3 · {copy.detailsStep}</b></li>
      </ol>
      <div class="rsvp_sent-steps" data-rsvp-sent-steps hidden>
        <span>{copy.received}</span><span>{copy.doneStep}</span>
      </div>

      <div class="rsvp_card-wrap" data-fade-in data-fade-in-item>
        <div
          class="rsvp_card"
          style={`--rsvp-paper: url("${postcardPaper.src}")`}
        >
          <div class="rsvp_stub" aria-hidden="true">{copy.stub}</div>
          <div class="rsvp_content">
            <div class="rsvp_panel" data-rsvp-panel="1">
              <form data-rsvp-find novalidate>
                <h3 tabindex="-1" data-rsvp-heading>
                  {copy.findHeading}
                </h3>
                <div class="rsvp_field">
                  <label for="rsvp-name">{copy.nameLabel}</label><input
                    id="rsvp-name"
                    name="name"
                    autocomplete="name"
                    required
                    maxlength="120"
                    data-rsvp-name
                  /><p class="rsvp_help">
                    {copy.nameHelp}
                  </p><p
                    class="rsvp_error"
                    id="rsvp-name-error"
                    data-rsvp-name-error
                    role="alert"
                    hidden
                  >
                  </p>
                </div>
                <div class="rsvp_turnstile" data-rsvp-turnstile></div>
                <div class="rsvp_actions">
                  <a class="rsvp_text-link" href={messageHref}
                    >{copy.message}</a
                  ><button class="rsvp_primary" type="submit" aria-label={copy.find}
                    ><span class="rsvp_primary-label"><span>{copy.find}</span><span class="rsvp_primary-label-busy" aria-hidden="true">{copy.finding}</span></span> <span class="rsvp_primary-mark" aria-hidden="true"><span class="rsvp_primary-arrow">→</span><span class="rsvp_primary-spinner"></span></span></button
                  >
                </div>
              </form>
            </div>

            <div class="rsvp_panel" data-rsvp-panel="2" hidden>
              <form data-rsvp-attending>
                <h3 tabindex="-1" data-rsvp-heading>
                  {copy.greetingBefore} <span data-rsvp-first-name></span>{copy.greetingAfter}
                </h3>
                <fieldset class="rsvp_options">
                  <legend>{copy.attendingLegend}</legend><label
                    class="rsvp_option"
                    ><input
                      type="radio"
                      name="attending"
                      value="yes"
                      checked
                    /><span>{copy.accept}</span></label
                  ><label class="rsvp_option"
                    ><input type="radio" name="attending" value="no" /><span
                      >{copy.decline}</span
                    ></label
                  >
                </fieldset>
                <fieldset class="rsvp_guest-list" data-rsvp-guests>
                  <legend class="rsvp_guest-list-header"><span class="rsvp_guest-list-wide">{copy.guestsWide}</span><span class="rsvp_guest-list-narrow" aria-hidden="true">{copy.guestsNarrow}</span><output data-rsvp-count aria-live="polite"></output></legend>
                  <div data-rsvp-seat-list></div>
                  <p class="rsvp_help rsvp_guest-help" data-rsvp-guest-help>{copy.guestHelp}</p>
                  <p class="rsvp_error rsvp_guest-error" data-rsvp-guest-error role="alert" hidden>{copy.guestError}</p>
                </fieldset>
                <div class="rsvp_actions">
                  <button class="rsvp_back" type="button" data-rsvp-back
                    >{copy.back}</button
                  ><button class="rsvp_primary" type="submit"
                    >{copy.continue} <span class="rsvp_primary-mark" aria-hidden="true"><span class="rsvp_primary-arrow">→</span><span class="rsvp_primary-spinner"></span></span></button
                  >
                </div>
              </form>
            </div>

            <div class="rsvp_panel" data-rsvp-panel="3" hidden>
              <form data-rsvp-details novalidate>
                <h3 tabindex="-1" data-rsvp-heading>
                  {copy.detailsHeading}
                </h3>
                <div class="rsvp_field">
                  <label for="rsvp-email">{copy.emailLabel}</label><input
                    id="rsvp-email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    maxlength="254"
                    required
                  /><p
                    class="rsvp_error"
                    id="rsvp-email-error"
                    data-rsvp-email-error
                    role="alert"
                    hidden
                  >
                    {copy.emailError}
                  </p>
                </div>
                <div class="rsvp_after-party" data-rsvp-after-party hidden>
                  <div class="rsvp_after-party-header">
                    <span class="rsvp_eyebrow">{copy.gift}</span>
                    <span class="rsvp_eyebrow" data-rsvp-after-party-count></span>
                  </div>
                  <div data-rsvp-slipper-list></div>
                  <p class="rsvp_after-party-absent" data-rsvp-not-coming hidden><span>{copy.notComing}</span> </p>
                  <p class="rsvp_after-party-help">{copy.giftHelp}</p>
                </div>
                <div class="rsvp_field">
                  <label for="rsvp-note"
                    >{copy.noteLabel}</label
                  ><textarea
                    id="rsvp-note"
                    name="note"
                    maxlength="1000"
                    placeholder={copy.notePlaceholder}
                  ></textarea>
                </div>
                <div class="rsvp_turnstile" data-rsvp-turnstile></div>
                <div class="rsvp_actions">
                  <button class="rsvp_back" type="button" data-rsvp-details-back
                    >{copy.back}</button
                  ><button class="rsvp_primary" type="submit" data-rsvp-submit aria-label={copy.send}
                    ><span class="rsvp_primary-label"><span>{copy.send}</span><span class="rsvp_primary-label-busy" aria-hidden="true">{copy.sending}</span></span> <span class="rsvp_primary-mark" aria-hidden="true"><span class="rsvp_primary-arrow">→</span><span class="rsvp_primary-spinner"></span></span></button
                  >
                </div>
                <p
                  class="rsvp_error"
                  data-rsvp-submit-error
                  role="alert"
                  hidden
                >
                  {copy.genericError}
                </p>
              </form>
            </div>

            <div class="rsvp_panel rsvp_sent" data-rsvp-panel="sent" hidden>
              <Image
                class="rsvp_stamp"
                src={stamp}
                alt=""
                aria-hidden="true"
                width={180}
                height={73}
              />
              <h3 tabindex="-1" data-rsvp-heading></h3>
              <dl class="rsvp_summary">
                <div>
                  <dt>{copy.attendingSummary}</dt><dd data-rsvp-attending-summary></dd>
                </div><div data-rsvp-guests-summary>
                  <dt>{copy.guestsSummary}</dt><dd data-rsvp-guests-summary-value></dd>
                </div><div>
                  <dt>{copy.updatesTo}</dt><dd data-rsvp-email-summary></dd>
                </div>
              </dl>
              <button
                class="rsvp_text-link rsvp_edit"
                type="button"
                data-rsvp-edit>{copy.editRsvp}</button
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="rsvp_scallop" aria-hidden="true"></div>
</section>}
<RsvpTicketPrinter />

<script>
  import { actions, isInputError } from "astro:actions";
  import type { Invite } from "@/lib/rsvp/store";
  import { normalizeGuestName } from "@/lib/rsvp/store";
  import { SLIPPER_SIZES } from "@/lib/rsvp/slippers";
  import { createTurnstileController, isFakeTurnstileMode } from "@/scripts/turnstile";
  import { getGuest, setGuest } from "@/lib/guest";
  import copy from "@/content/rsvp/rsvp.json";

  const initRsvp = () => {
    document
      .querySelectorAll<HTMLElement>("[data-rsvp-init]")
      .forEach((root) => {
        if (root.dataset.rsvpReady) return;
        root.dataset.rsvpReady = "true";
        const fakeMode = isFakeTurnstileMode(import.meta.env.PUBLIC_RSVP_STORE, import.meta.env.DEV);
        const turnstile = createTurnstileController(fakeMode);
        let invite: Invite | null = null;
        let matchedName = "";
        let suggestion = "";
        type Seat = { seatId: number; original: string | null; shownName?: string | null; name: string; attending: boolean; slipperSize?: string };
        let attending = true;
        let seats: Seat[] = [];
        let editingSeat = -1;
        let step: "1" | "2" | "3" | "sent" = "1";
        const heading = () =>
          root.querySelector<HTMLElement>(
            `[data-rsvp-panel="${step}"] [data-rsvp-heading]`,
          );
        const nameInput =
          root.querySelector<HTMLInputElement>("[data-rsvp-name]")!;
        const title = root.querySelector<HTMLElement>(".rsvp_title")!;
        const intro = root.querySelector<HTMLElement>("[data-rsvp-intro]")!;
        const deadline = root.dataset.rsvpDeadline ?? "[deadline]";
        const findButton = root.querySelector<HTMLButtonElement>(
          "[data-rsvp-find] button[type='submit']",
        )!;
        const setFindLabel = (text: string) => {
          findButton.querySelector(".rsvp_primary-label > span:first-child")!.textContent = text;
          findButton.setAttribute("aria-label", text);
        };
        nameInput.addEventListener("input", () => {
          if (!suggestion) return;
          suggestion = "";
          setFindLabel(copy.copy.find);
          const error = root.querySelector<HTMLElement>("[data-rsvp-name-error]")!;
          error.textContent = "";
          error.hidden = true;
        });
        const remembered = getGuest();
        if (remembered && "name" in remembered && !nameInput.value) nameInput.value = remembered.name;
        const onGuest = (event: Event) => {
          const name = (event as CustomEvent<{ name?: string }>).detail?.name;
          if (name && !nameInput.value) nameInput.value = name;
        };
        document.addEventListener("ew:guest", onGuest);
        const setConfirmationCopy = (isAttending: boolean) => {
          title.textContent = isAttending
            ? copy.copy.seeYou
            : copy.copy.missYou;
          intro.textContent = isAttending
            ? copy.copy.freshTicket.replace("{deadline}", () => deadline)
            : copy.copy.plansChange.replace("{deadline}", () => deadline);
        };
        const restoreIntro = () => {
          title.replaceChildren(
            document.createTextNode(copy.copy.titleBefore),
            document.createElement("br"),
            document.createTextNode(copy.copy.titleAfter),
          );
          intro.textContent = copy.copy.intro.replace("{deadline}", () => deadline);
        };
        const setStep = (next: typeof step) => {
          step = next;
          if (next === "3") renderAfterParty();
          updateInvitation();
          root
            .querySelectorAll<HTMLElement>("[data-rsvp-panel]")
            .forEach((item) => {
              item.hidden = item.dataset.rsvpPanel !== next;
            });
          root.querySelectorAll<HTMLElement>("[data-step]").forEach((item) => {
            const current = item.dataset.step === next;
            if (current) {
              item.setAttribute("aria-current", "step");
            } else {
              item.removeAttribute("aria-current");
            }
            item.classList.toggle(
              "is-complete",
              Number(item.dataset.step) < Number(next),
            );
          });
          root.querySelector<HTMLElement>("[data-rsvp-steps]")!.hidden =
            next === "sent";
          root.querySelector<HTMLElement>("[data-rsvp-sent-steps]")!.hidden =
            next !== "sent";
          root.querySelector<HTMLElement>(".rsvp_card")!.dataset.sent = String(
            next === "sent",
          );
          requestAnimationFrame(() => heading()?.focus());
        };
        const updateGuestControls = () => {
          const count = root.querySelector<HTMLOutputElement>("[data-rsvp-count]")!;
          const attendingCount = seats.filter((seat) => seat.attending).length;
          count.value = copy.copy.seats.replace("{count}", () => String(attendingCount)).replace("{total}", () => String(invite?.seats ?? 0));
          count.textContent = copy.copy.seats.replace("{count}", () => String(attendingCount)).replace("{total}", () => String(invite?.seats ?? 0));
        };
        const clearGuestError = () => {
          root.querySelector<HTMLElement>("[data-rsvp-guest-error]")!.hidden = true;
          root.querySelector<HTMLElement>("[data-rsvp-guests]")!.classList.remove("has-error");
        };
        const renderAfterParty = () => {
          const block = root.querySelector<HTMLElement>("[data-rsvp-after-party]")!;
          const list = root.querySelector<HTMLElement>("[data-rsvp-slipper-list]")!;
          const absent = root.querySelector<HTMLElement>("[data-rsvp-not-coming]")!;
          const selectedSeats = attending ? seats.filter((seat) => seat.attending) : [];
          const absentSeats = seats.filter((seat) => !seat.attending && seat.name.trim());
          block.hidden = !attending;
          list.replaceChildren();
          absent.hidden = absentSeats.length === 0;
          absent.replaceChildren();
          const absentPrefix = document.createElement("span");
          absentPrefix.textContent = copy.copy.notComing;
          absent.textContent = absentSeats.map((seat) => seat.name).join(", ");
          absent.prepend(absentPrefix, " ");
          const count = root.querySelector<HTMLElement>("[data-rsvp-after-party-count]")!;
          count.textContent = selectedSeats.length === 1
            ? copy.copy.guestCount.replace("{count}", () => String(selectedSeats.length))
            : copy.copy.guestsCount.replace("{count}", () => String(selectedSeats.length));
          selectedSeats.forEach((seat, index) => {
            const row = document.createElement("div");
            row.className = "rsvp_after-party-row";
            const nameWrap = document.createElement("div");
            nameWrap.className = "rsvp_after-party-name";
            const name = document.createElement("span");
            name.textContent = seat.name;
            nameWrap.append(name);
            if (seat.original && normalizeGuestName(seat.original) === normalizeGuestName(matchedName)) {
              const you = document.createElement("span");
              you.className = "rsvp_after-party-you";
              you.textContent = copy.copy.you;
              nameWrap.append(you);
            }
            const control = document.createElement("div");
            control.className = "rsvp_after-party-control";
            const label = document.createElement("label");
            label.className = "rsvp_eyebrow";
            label.textContent = copy.copy.sizeLabel;
            const select = document.createElement("select");
            select.required = true;
            select.id = `rsvp-slipper-${index}`;
            select.setAttribute("aria-label", copy.copy.slipperFor.replace("{name}", () => seat.name));
            const placeholder = document.createElement("option");
            placeholder.value = "";
            placeholder.textContent = copy.copy.sizePlaceholder;
            placeholder.disabled = true;
            placeholder.selected = !seat.slipperSize;
            select.append(placeholder);
            for (const group of ["Women's", "Men's"] as const) {
              const optgroup = document.createElement("optgroup");
              optgroup.label = group;
              const prefix = group === "Women's" ? "W " : "M ";
              SLIPPER_SIZES.filter((size) => size.startsWith(prefix)).forEach((size) => {
                const option = document.createElement("option");
                option.value = size;
                option.textContent = size;
                option.selected = seat.slipperSize === size;
                optgroup.append(option);
              });
              select.append(optgroup);
            }
            const error = document.createElement("p");
            error.className = "rsvp_error rsvp_slipper-error";
            error.setAttribute("role", "alert");
            error.hidden = true;
            error.textContent = copy.copy.sizeError;
            select.addEventListener("change", () => {
              seat.slipperSize = select.value;
              error.hidden = true;
              select.removeAttribute("aria-invalid");
            });
            label.htmlFor = select.id;
            control.append(label, select);
            row.append(nameWrap, control, error);
            list.append(row);
          });
        };
        const renderSeats = (focusIndex = -1, focusTarget: "checkbox" | "action" = "action") => {
          const list = root.querySelector<HTMLElement>("[data-rsvp-seat-list]")!;
          list.replaceChildren();
          seats.forEach((seat, index) => {
            const row = document.createElement("div");
            row.className = "rsvp_seat-row";
            row.dataset.seatIndex = String(index);
            if (!seat.attending) row.classList.add("is-not-coming");
            if (seat.original === null && !seat.name) row.classList.add("is-open");
            const checkbox = document.createElement("input");
            checkbox.type = "checkbox";
            checkbox.checked = seat.attending;
            checkbox.id = `rsvp-seat-${index}`;
            checkbox.setAttribute("aria-label", copy.copy.seat.replace("{number}", () => String(index + 1)).replace("{name}", () => seat.name || copy.copy.openSeat));
            checkbox.dataset.rsvpSeatToggle = "true";
            const label = document.createElement("label");
            label.htmlFor = checkbox.id;
            label.className = "rsvp_seat-label";
            const name = document.createElement("span");
            name.className = "rsvp_seat-name";
            name.textContent = seat.name || copy.copy.openSeat;
            label.append(checkbox, name);
            const meta = document.createElement("span");
            meta.className = "rsvp_seat-meta";
            if (index === invite?.members.indexOf(matchedName)) meta.textContent = copy.copy.you;
            if (!seat.attending && seat.name) {
              const notComing = document.createElement("span");
              notComing.textContent = copy.copy.notComingSeat;
              meta.append(notComing);
            }
            if (meta.textContent) label.append(meta);
            row.append(label);
            if (editingSeat === index) {
              row.classList.add("is-editing");
              const editWrap = document.createElement("div");
              editWrap.className = "rsvp_seat-edit";
              const input = document.createElement("input");
              input.value = seat.name;
              input.id = `rsvp-seat-name-${index}`;
              input.maxLength = 120;
              input.setAttribute("aria-label", copy.copy.nameForSeat.replace("{number}", () => String(index + 1)));
              const done = document.createElement("button");
              done.type = "button";
              done.textContent = copy.copy.done;
              done.setAttribute("aria-label", copy.copy.doneEditing.replace("{name}", () => seat.name || `seat ${index + 1}`));
              const message = document.createElement("p");
              message.className = "rsvp_error";
              message.hidden = true;
              message.textContent = copy.copy.pleaseName;
              const finish = () => {
                const value = input.value.trim();
                if (!value) { message.hidden = false; input.focus(); return; }
                seat.name = value;
                if (seat.original === null) seat.attending = true;
                clearGuestError();
                editingSeat = -1;
                renderSeats(index, "action");
              };
              done.addEventListener("click", finish);
              input.addEventListener("keydown", (event) => {
                if (event.key === "Enter") { event.preventDefault(); finish(); }
                if (event.key === "Escape") { editingSeat = -1; renderSeats(index, "action"); }
              });
              editWrap.append(input, done, message);
              if (seat.original && normalizeGuestName(seat.name) !== normalizeGuestName(seat.original)) {
                const changed = document.createElement("span");
                changed.className = "rsvp_seat-change";
                changed.textContent = copy.copy.was.replace("{name}", () => seat.original!);
                const undo = document.createElement("button");
                undo.type = "button";
                undo.textContent = copy.copy.undo;
                undo.setAttribute("aria-label", copy.copy.undoChange.replace("{name}", () => seat.name));
                undo.addEventListener("click", () => { seat.name = seat.original!; renderSeats(index, "action"); });
                editWrap.append(changed, undo);
              }
              row.append(editWrap);
              list.append(row);
              requestAnimationFrame(() => input.focus());
              return;
            }
            const action = document.createElement("button");
            action.type = "button";
            action.className = "rsvp_seat-action";
            const icon = document.createElementNS("http://www.w3.org/2000/svg", "svg");
            icon.setAttribute("viewBox", "0 0 12 12");
            icon.setAttribute("aria-hidden", "true");
            icon.innerHTML = seat.name
              ? '<path d="M8.2 1.3 10.7 3.8 4 10.5H1.5V8L8.2 1.3Z" />'
              : '<path d="M6 1v10M1 6h10" />';
            action.append(icon, document.createTextNode(seat.name ? copy.copy.edit : copy.copy.addName));
            action.setAttribute("aria-label", seat.name ? copy.copy.editName.replace("{name}", () => seat.name) : copy.copy.addNameForSeat.replace("{number}", () => String(index + 1)));
            action.dataset.rsvpSeatAction = "true";
            action.addEventListener("click", () => { editingSeat = index; renderSeats(); });
            row.append(action);
            if (seat.original && normalizeGuestName(seat.name) !== normalizeGuestName(seat.original) && seat.name) {
              const change = document.createElement("div");
              change.className = "rsvp_seat-change-line";
              change.textContent = copy.copy.was.replace("{name}", () => seat.original!);
              const undo = document.createElement("button");
              undo.type = "button";
              undo.textContent = copy.copy.undo;
              undo.setAttribute("aria-label", copy.copy.undoChange.replace("{name}", () => seat.name));
              undo.addEventListener("click", () => { seat.name = seat.original!; renderSeats(index, "action"); });
              change.append(" ", undo);
              row.append(change);
            } else if (seat.original === null && seat.name) {
              const change = document.createElement("div");
              change.className = "rsvp_seat-change-line";
              change.textContent = copy.copy.plusOne;
              const remove = document.createElement("button");
              remove.type = "button";
              remove.textContent = copy.copy.remove;
              remove.setAttribute("aria-label", copy.copy.removeName.replace("{name}", () => seat.name));
              remove.addEventListener("click", () => { seat.name = ""; seat.attending = false; renderSeats(index, "action"); });
              change.append(" ", remove);
              row.append(change);
            }
            checkbox.addEventListener("change", () => {
              seat.attending = checkbox.checked;
              clearGuestError();
              if (checkbox.checked && seat.original === null && !seat.name) editingSeat = index;
              renderSeats(index, "checkbox");
            });
            list.append(row);
          });
          updateGuestControls();
          if (focusIndex >= 0) {
            const control = focusTarget === "checkbox"
              ? root.querySelector<HTMLInputElement>(`#rsvp-seat-${focusIndex}`)
              : root.querySelector<HTMLButtonElement>(`[data-seat-index="${focusIndex}"] [data-rsvp-seat-action]`);
            control?.focus();
          }
        };
        const updateInvitation = () => {
          root.querySelector<HTMLElement>("[data-rsvp-invitation]")!.hidden =
            !invite || step === "1";
          if (invite) {
            root.querySelector("[data-rsvp-household]")!.textContent =
              invite.householdName;
            root.querySelector("[data-rsvp-seats]")!.textContent = String(
              invite.seats,
            );
          }
        };
        root
          .querySelector<HTMLFormElement>("[data-rsvp-find]")!
          .addEventListener("submit", async (event) => {
            event.preventDefault();
            const error = root.querySelector<HTMLElement>(
              "[data-rsvp-name-error]",
            )!;
            const value = nameInput.value;
            if (!value.trim()) {
              error.textContent = copy.copy.findRequired;
              error.hidden = false;
              nameInput.setAttribute("aria-invalid", "true");
              nameInput.setAttribute("aria-describedby", "rsvp-name-error");
              return;
            }
            findButton.disabled = true;
            findButton.setAttribute("aria-busy", "true");
            const submittedValue = value;
            try {
              const result = await actions.rsvp.find({
                name: suggestion || value,
                  turnstileToken: await turnstile.getToken(
                  root.querySelectorAll<HTMLElement>(
                    "[data-rsvp-turnstile]",
                  )[0],
                ),
              });
              if (nameInput.value !== submittedValue) return;
              if (result.error || !result.data) {
                suggestion = "";
                setFindLabel(copy.copy.find);
                error.textContent =
                  isInputError(result.error)
                    ? copy.copy.nameTooLong
                    : result.error?.message || copy.copy.genericError;
                error.hidden = false;
                nameInput.setAttribute("aria-invalid", "true");
                nameInput.setAttribute("aria-describedby", "rsvp-name-error");
                return;
              }
              if (!result.data.invite) {
                if (result.data.suggestion) {
                  suggestion = result.data.suggestion;
                  error.textContent = copy.copy.suggestion.replace("{name}", () => suggestion);
                  error.hidden = false;
                  nameInput.removeAttribute("aria-invalid");
                  nameInput.removeAttribute("aria-describedby");
                  setFindLabel("Yes, that's me");
                  return;
                }
                error.textContent =
                  copy.copy.notFound;
                suggestion = "";
                setFindLabel(copy.copy.find);
                error.hidden = false;
                nameInput.setAttribute("aria-invalid", "true");
                nameInput.setAttribute("aria-describedby", "rsvp-name-error");
                return;
              }
              error.hidden = true;
              suggestion = "";
                setFindLabel(copy.copy.find);
              nameInput.removeAttribute("aria-invalid");
              nameInput.removeAttribute("aria-describedby");
              invite = result.data.invite as unknown as Invite;
              matchedName = result.data.matchedName;
              setGuest({
                name: matchedName,
                householdName: invite.householdName,
                seats: invite.seats,
                at: new Date().toISOString(),
              });
              const token = result.data.token;
              const previous = result.data.previous;
              const savedBySeat = new Map((previous?.seats ?? []).map((seat) => [seat.seatId, seat]));
              seats = (invite.seatList ?? invite.members.map((member, index) => ({ seatId: index + 1, kind: "member" as const, invitedName: member, name: member }))).map((seat): Seat => {
                const saved = savedBySeat.get(seat.seatId);
                return saved
                  ? { seatId: seat.seatId, original: seat.invitedName, shownName: saved.shownName ?? seat.name, name: saved.name, attending: previous?.attending ? saved.attending : seat.kind === "member", slipperSize: saved.slipperSize }
                  : { seatId: seat.seatId, original: seat.invitedName, shownName: seat.name, name: seat.name ?? "", attending: seat.kind === "member" };
              });
              attending = previous?.attending ?? true;
              root.querySelector("[data-rsvp-first-name]")!.textContent =
                matchedName.split(" ")[0];
              root.querySelector<HTMLInputElement>(`input[name="attending"][value="${attending ? "yes" : "no"}"]`)!.checked = true;
              root.querySelector<HTMLElement>("[data-rsvp-guests]")!.hidden = !attending;
              renderSeats();
              root.dataset.rsvpToken = token;
              setStep("2");
            } catch {
              suggestion = "";
              setFindLabel(copy.copy.find);
              error.textContent = copy.copy.genericError;
              error.hidden = false;
              nameInput.setAttribute("aria-invalid", "true");
              nameInput.setAttribute("aria-describedby", "rsvp-name-error");
            } finally {
              turnstile.reset();
              findButton.disabled = false;
              findButton.removeAttribute("aria-busy");
            }
          });
        root
          .querySelector<HTMLFormElement>("[data-rsvp-attending]")!
          .addEventListener("change", (event) => {
            if ((event.target as HTMLInputElement).name === "attending") {
              attending = (event.target as HTMLInputElement).value === "yes";
              root.querySelector<HTMLElement>("[data-rsvp-guests]")!.hidden =
                !attending;
              clearGuestError();
              if (attending) renderSeats();
            }
          });
        root
          .querySelector<HTMLFormElement>("[data-rsvp-attending]")!
          .addEventListener("submit", (event) => {
            event.preventDefault();
            if (attending && !seats.some((seat) => seat.attending)) {
              const error = root.querySelector<HTMLElement>("[data-rsvp-guest-error]")!;
              error.textContent = copy.copy.guestError;
              error.hidden = false;
              root.querySelector<HTMLElement>("[data-rsvp-guests]")!.classList.add("has-error");
              root.querySelector<HTMLInputElement>("[data-rsvp-seat-toggle]")?.focus();
              return;
            }
            const blankAttending = attending && seats.find((seat) => seat.attending && !seat.name.trim());
            if (blankAttending) {
              const error = root.querySelector<HTMLElement>("[data-rsvp-guest-error]")!;
              error.textContent = copy.copy.blankSeatError;
              error.hidden = false;
              root.querySelector<HTMLElement>(`[data-seat-index="${seats.indexOf(blankAttending)}"] [data-rsvp-seat-action]`)?.focus();
              return;
            }
            const attendingNames = new Map<string, Seat>();
            const duplicateAttending = attending && seats.find((seat) => {
              if (!seat.attending || !seat.name.trim()) return false;
              const normalizedName = normalizeGuestName(seat.name);
              if (attendingNames.has(normalizedName)) return true;
              attendingNames.set(normalizedName, seat);
              return false;
            });
            if (duplicateAttending) {
              const error = root.querySelector<HTMLElement>("[data-rsvp-guest-error]")!;
              error.textContent = `${duplicateAttending.name} is on two seats. Change one of them.`;
              error.hidden = false;
              root.querySelector<HTMLElement>("[data-rsvp-guests]")!.classList.add("has-error");
              root.querySelector<HTMLElement>(`[data-seat-index="${seats.indexOf(duplicateAttending)}"] [data-rsvp-seat-action]`)?.focus();
              return;
            }
            setStep("3");
          });
        root
          .querySelector<HTMLButtonElement>("[data-rsvp-back]")!
          .addEventListener("click", () => {
            setStep("1");
          });
        root
          .querySelector<HTMLButtonElement>("[data-rsvp-details-back]")!
          .addEventListener("click", () => {
            setStep("2");
          });
        root
          .querySelector<HTMLFormElement>("[data-rsvp-details]")!
          .addEventListener("submit", async (event) => {
            event.preventDefault();
            const form = event.currentTarget as HTMLFormElement;
            const email = form.elements.namedItem("email") as HTMLInputElement;
            const error = root.querySelector<HTMLElement>(
              "[data-rsvp-email-error]",
            )!;
            if (!email.checkValidity()) {
              email.setAttribute("aria-invalid", "true");
              email.setAttribute("aria-describedby", "rsvp-email-error");
              error.hidden = false;
              email.focus();
              return;
            }
            const missingSeat = attending ? seats.find((seat) => seat.attending && !seat.slipperSize) : undefined;
            if (missingSeat) {
              const selectedIndex = seats.filter((seat) => seat.attending).indexOf(missingSeat);
              const select = root.querySelector<HTMLSelectElement>(`#rsvp-slipper-${selectedIndex}`)!;
              const rowError = select.closest(".rsvp_after-party-row")?.querySelector<HTMLElement>(".rsvp_slipper-error");
              select.setAttribute("aria-invalid", "true");
              if (rowError) rowError.hidden = false;
              select.focus();
              return;
            }
            email.removeAttribute("aria-invalid");
            email.removeAttribute("aria-describedby");
            error.hidden = true;
            const submit =
              root.querySelector<HTMLButtonElement>("[data-rsvp-submit]")!;
            const submitError = root.querySelector<HTMLElement>(
              "[data-rsvp-submit-error]",
            )!;
            submit.disabled = true;
            submit.setAttribute("aria-busy", "true");
            submitError.hidden = true;
            try {
              const submitRsvp = async () => actions.rsvp.submit({
                token: root.dataset.rsvpToken ?? "",
                name: matchedName,
                attending,
                seats: seats.map((seat) => ({ ...seat, shownName: seat.shownName ?? seat.original, attending: attending && seat.attending, slipperSize: attending && seat.attending ? seat.slipperSize : undefined })),
                email: email.value,
                note:
                  (form.elements.namedItem("note") as HTMLTextAreaElement)
                    .value || undefined,
                turnstileToken: await turnstile.getToken(
                  root.querySelectorAll<HTMLElement>("[data-rsvp-turnstile]")[1],
                ),
              });
              let result = await submitRsvp();
              if (result.error?.code === "UNAUTHORIZED") {
                const refreshed = await actions.rsvp.find({
                  name: matchedName,
                  turnstileToken: await turnstile.getToken(root.querySelectorAll<HTMLElement>("[data-rsvp-turnstile]")[0]),
                });
                if (refreshed.data?.invite && refreshed.data.token) {
                  root.dataset.rsvpToken = refreshed.data.token;
                  result = await submitRsvp();
                }
              }
              if (result.error) {
                if (result.error.code === "CONFLICT") {
                  const typed = new Map(seats.map((seat) => [seat.seatId, { ...seat }]));
                  const refreshed = await actions.rsvp.find({
                    name: matchedName,
                    turnstileToken: await turnstile.getToken(root.querySelectorAll<HTMLElement>("[data-rsvp-turnstile]")[0]),
                  });
                  if (refreshed.data?.invite) {
                    invite = refreshed.data.invite as unknown as Invite;
                    matchedName = refreshed.data.matchedName;
                    root.dataset.rsvpToken = refreshed.data.token;
                    seats = (invite.seatList ?? []).map((seat) => {
                      const old = typed.get(seat.seatId);
                      return old
                        ? { ...old, original: seat.invitedName, shownName: old.shownName ?? seat.name }
                        : { seatId: seat.seatId, original: seat.invitedName, shownName: seat.name, name: seat.name ?? "", attending: seat.kind === "member" };
                    });
                    renderSeats();
                  }
                }
                submitError.textContent =
                  isInputError(result.error)
                    ? copy.copy.nameTooLong
                    : result.error.message;
                submitError.hidden = false;
                return;
              }
            } catch {
              submitError.textContent = copy.copy.genericError;
              submitError.hidden = false;
              return;
            } finally {
              turnstile.reset();
              submit.disabled = false;
              submit.removeAttribute("aria-busy");
            }
            root.querySelector<HTMLElement>(
              "[data-rsvp-email-summary]",
            )!.textContent = email.value;
            root.querySelector<HTMLElement>(
              "[data-rsvp-attending-summary]",
            )!.textContent = attending
              ? copy.copy.accept
              : copy.copy.decline;
            const tickedNames = seats.filter((seat) => attending && seat.attending).map((seat) => seat.name);
            root.querySelector<HTMLElement>("[data-rsvp-guests-summary-value]")!.textContent = attending
              ? `${(tickedNames.length === 1 ? copy.copy.guestCount : copy.copy.guestsCount).replace("{count}", () => String(tickedNames.length))}: ${tickedNames.join(", ")}`
              : "";
            root.querySelector<HTMLElement>(
              "[data-rsvp-guests-summary]",
            )!.hidden = !attending;
            root.querySelector<HTMLElement>(
              "[data-rsvp-panel=sent] h3",
            )!.textContent = attending
              ? copy.copy.onList.replace("{name}", () => matchedName.split(" ")[0])
              : copy.copy.thanks.replace("{name}", () => matchedName.split(" ")[0]);
            setConfirmationCopy(attending);
            submit.disabled = false;
            submit.removeAttribute("aria-busy");
            setStep("sent");
            if (attending && invite) {
              document.dispatchEvent(
                new CustomEvent("rsvp-ticket-open", {
                  detail: {
                    inviteId: invite.ticketCode,
                    matchedName,
                    names: tickedNames,
                    guests: tickedNames.length,
                    deadline,
                  },
                }),
              );
            }
          });
        root
          .querySelector<HTMLButtonElement>("[data-rsvp-edit]")!
          .addEventListener("click", () => {
            restoreIntro();
            setStep("2");
          });
        document.addEventListener("rsvp-ticket-edit", () => {
          restoreIntro();
          setStep("2");
        });
        updateGuestControls();
      });
  };
  initRsvp();
  document.addEventListener("astro:page-load", initRsvp);
</script>

