---
import { Image } from "astro:assets";
import type { HTMLAttributes } from "astro/types";
import stamp from "@/assets/images/rsvp/stamp-received.png";
import postcardPaper from "@/assets/textures/postcard-paper.jpg";
import { RSVP_DEADLINE_LABEL } from "@/consts";
import RsvpTicketPrinter from "@/components/sections/RsvpTicketPrinter.astro";

interface Props extends HTMLAttributes<"section"> {
  /** Message destination for guests who cannot find an invite. */
  messageHref?: string;
  /** Calendar event destination. */
  calendarHref?: string;
  /** Map destination. */
  mapsHref?: string;
}

const {
  messageHref = "#",
  calendarHref = "#",
  mapsHref = "#",
  class: className,
  ...rest
} = Astro.props;
---

<section
  id="rsvp"
  class:list={["rsvp_wrap", "theme-dark", className]}
  style="scroll-margin-top: var(--nav-height)"
  {...rest}
>
  <div
    class="rsvp_layout"
    data-rsvp-init
    data-rsvp-deadline={RSVP_DEADLINE_LABEL}
  >
    <div class="rsvp_left">
      <header class="rsvp_header" data-rsvp-header data-fade-in>
        <h2 class="rsvp_title" data-fade-in-item>Will you<br />be there?</h2>
        <p class="rsvp_intro" data-rsvp-intro data-fade-in-item>
          Please reply by {RSVP_DEADLINE_LABEL}. Three quick steps, and you can
          change your answer until then.
        </p>
      </header>
      <div class="rsvp_invitation" data-rsvp-invitation hidden>
        <div class="rsvp_invitation-top">
          <div>
            <span class="rsvp_eyebrow">Your invitation</span><strong
              data-rsvp-household></strong>
          </div><div class="rsvp_admits">
            <span class="rsvp_eyebrow">Admits</span><strong data-rsvp-seats
            ></strong>
          </div>
        </div>
        <div class="rsvp_invitation-bottom">
          <ul>
            <li>Thu, Jan 14, 2027 · 3:00 PM</li><li>
              [Venue], White Beach, Boracay
            </li><li>Island formal</li>
          </ul><div class="rsvp_invitation-links">
            <a href={calendarHref}>Add to calendar ↗</a><a href={mapsHref}
              >Open in maps ↗</a
            >
          </div>
        </div>
      </div>
    </div>

    <div class="rsvp_right">
      <ol class="rsvp_steps" aria-label="RSVP progress" data-rsvp-steps>
        <li data-step="1" aria-current="step">
          <span></span><b
            >1 · <span class="rsvp_step-full">Find invite</span><span
              class="rsvp_step-short">Find</span
            ></b
          >
        </li>
        <li data-step="2"><span></span><b>2 · Attending</b></li>
        <li data-step="3"><span></span><b>3 · Details</b></li>
      </ol>
      <div class="rsvp_sent-steps" data-rsvp-sent-steps hidden>
        <span>✓ RSVP received</span><span>3 of 3 · Done</span>
      </div>

      <div class="rsvp_card-wrap">
        <div
          class="rsvp_card"
          style={`--rsvp-paper: url("${postcardPaper.src}")`}
        >
          <div class="rsvp_stub" aria-hidden="true">RSVP · Nº 011427</div>
          <div class="rsvp_content">
            <div class="rsvp_panel" data-rsvp-panel="1">
              <form data-rsvp-find novalidate>
                <h3 tabindex="-1" data-rsvp-heading>
                  First, let's find your invitation.
                </h3>
                <div class="rsvp_field">
                  <label for="rsvp-name">Full name on your invite</label><input
                    id="rsvp-name"
                    name="name"
                    autocomplete="name"
                    required
                    data-rsvp-name
                  /><p class="rsvp_help">
                    Just one name from your household is enough. We'll find the
                    rest.
                  </p><p
                    class="rsvp_error"
                    id="rsvp-name-error"
                    data-rsvp-name-error
                    role="alert"
                    hidden
                  >
                  </p>
                </div>
                <div class="rsvp_turnstile" data-rsvp-turnstile></div>
                <div class="rsvp_actions">
                  <a class="rsvp_text-link" href={messageHref}
                    >Can't find it? Message us</a
                  ><button class="rsvp_primary" type="submit" aria-label="Find my invite"
                    ><span class="rsvp_primary-label"><span>Find my invite</span><span class="rsvp_primary-label-busy" aria-hidden="true">Finding…</span></span> <span class="rsvp_primary-mark" aria-hidden="true"><span class="rsvp_primary-arrow">→</span><span class="rsvp_primary-spinner"></span></span></button
                  >
                </div>
              </form>
            </div>

            <div class="rsvp_panel" data-rsvp-panel="2" hidden>
              <form data-rsvp-attending>
                <h3 tabindex="-1" data-rsvp-heading>
                  Hi <span data-rsvp-first-name></span> — can you make it?
                </h3>
                <fieldset class="rsvp_options">
                  <legend>Will you be attending?</legend><label
                    class="rsvp_option"
                    ><input
                      type="radio"
                      name="attending"
                      value="yes"
                      checked
                    /><span>Joyfully accepts</span></label
                  ><label class="rsvp_option"
                    ><input type="radio" name="attending" value="no" /><span
                      >Regretfully declines</span
                    ></label
                  >
                </fieldset>
                <fieldset class="rsvp_guest-list" data-rsvp-guests>
                  <legend class="rsvp_guest-list-header"><span class="rsvp_guest-list-wide">Tick everyone who's coming</span><span class="rsvp_guest-list-narrow" aria-hidden="true">Who's coming</span><output data-rsvp-count aria-live="polite"></output></legend>
                  <div data-rsvp-seat-list></div>
                  <p class="rsvp_help rsvp_guest-help" data-rsvp-guest-help>Someone can't make it? Untick them, or tap Edit to give their seat to someone else. You can also fix a misspelled name.</p>
                  <p class="rsvp_error rsvp_guest-error" data-rsvp-guest-error role="alert" hidden>Tick at least one guest. If no one can make it, choose “Regretfully declines” above.</p>
                </fieldset>
                <div class="rsvp_actions">
                  <button class="rsvp_back" type="button" data-rsvp-back
                    >← Back</button
                  ><button class="rsvp_primary" type="submit"
                    >Continue <span class="rsvp_primary-mark" aria-hidden="true"><span class="rsvp_primary-arrow">→</span><span class="rsvp_primary-spinner"></span></span></button
                  >
                </div>
              </form>
            </div>

            <div class="rsvp_panel" data-rsvp-panel="3" hidden>
              <form data-rsvp-details novalidate>
                <h3 tabindex="-1" data-rsvp-heading>
                  Last bit — a few details.
                </h3>
                <div class="rsvp_field">
                  <label for="rsvp-email">Email for updates</label><input
                    id="rsvp-email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    required
                  /><p
                    class="rsvp_error"
                    id="rsvp-email-error"
                    data-rsvp-email-error
                    role="alert"
                    hidden
                  >
                    Please enter a valid email address.
                  </p>
                </div>
                <div class="rsvp_field">
                  <label for="rsvp-note"
                    >A note for Eunice &amp; Warren (optional)</label
                  ><textarea
                    id="rsvp-note"
                    name="note"
                    placeholder="Can't wait to see you two in Boracay…"
                  ></textarea>
                </div>
                <div class="rsvp_turnstile" data-rsvp-turnstile></div>
                <div class="rsvp_actions">
                  <button class="rsvp_back" type="button" data-rsvp-details-back
                    >← Back</button
                  ><button class="rsvp_primary" type="submit" data-rsvp-submit aria-label="Send RSVP"
                    ><span class="rsvp_primary-label"><span>Send RSVP</span><span class="rsvp_primary-label-busy" aria-hidden="true">Sending…</span></span> <span class="rsvp_primary-mark" aria-hidden="true"><span class="rsvp_primary-arrow">→</span><span class="rsvp_primary-spinner"></span></span></button
                  >
                </div>
                <p
                  class="rsvp_error"
                  data-rsvp-submit-error
                  role="alert"
                  hidden
                >
                  Something went wrong — please try again.
                </p>
              </form>
            </div>

            <div class="rsvp_panel rsvp_sent" data-rsvp-panel="sent" hidden>
              <Image
                class="rsvp_stamp"
                src={stamp}
                alt=""
                aria-hidden="true"
                width={180}
                height={73}
              />
              <h3 tabindex="-1" data-rsvp-heading></h3>
              <dl class="rsvp_summary">
                <div>
                  <dt>Attending</dt><dd data-rsvp-attending-summary></dd>
                </div><div data-rsvp-guests-summary>
                  <dt>Guests</dt><dd data-rsvp-guests-summary-value></dd>
                </div><div>
                  <dt>Updates to</dt><dd data-rsvp-email-summary></dd>
                </div>
              </dl>
              <button
                class="rsvp_text-link rsvp_edit"
                type="button"
                data-rsvp-edit>Edit my RSVP</button
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="rsvp_scallop" aria-hidden="true"></div>
</section>
<RsvpTicketPrinter />

<script>
  import { actions } from "astro:actions";
  import type { Invite } from "@/lib/rsvp/store";
  import { normalizeGuestName } from "@/lib/rsvp/store";
  import { createTurnstileController, isFakeTurnstileMode } from "@/scripts/turnstile";
  import { getGuest } from "@/lib/guest";

  const initRsvp = () => {
    document
      .querySelectorAll<HTMLElement>("[data-rsvp-init]")
      .forEach((root) => {
        if (root.dataset.rsvpReady) return;
        root.dataset.rsvpReady = "true";
        const fakeMode = isFakeTurnstileMode(import.meta.env.PUBLIC_RSVP_STORE, import.meta.env.DEV);
        const turnstile = createTurnstileController(fakeMode);
        let invite: Invite | null = null;
        let matchedName = "";
        type Seat = { original: string | null; name: string; attending: boolean };
        let attending = true;
        let seats: Seat[] = [];
        let editingSeat = -1;
        let step: "1" | "2" | "3" | "sent" = "1";
        const heading = () =>
          root.querySelector<HTMLElement>(
            `[data-rsvp-panel="${step}"] [data-rsvp-heading]`,
          );
        const nameInput =
          root.querySelector<HTMLInputElement>("[data-rsvp-name]")!;
        const title = root.querySelector<HTMLElement>(".rsvp_title")!;
        const intro = root.querySelector<HTMLElement>("[data-rsvp-intro]")!;
        const deadline = root.dataset.rsvpDeadline ?? "[deadline]";
        const findButton = root.querySelector<HTMLButtonElement>(
          "[data-rsvp-find] button[type='submit']",
        )!;
        const remembered = getGuest();
        if (remembered && "name" in remembered && !nameInput.value) nameInput.value = remembered.name;
        const onGuest = (event: Event) => {
          const name = (event as CustomEvent<{ name?: string }>).detail?.name;
          if (name && !nameInput.value) nameInput.value = name;
        };
        document.addEventListener("ew:guest", onGuest);
        const setConfirmationCopy = (isAttending: boolean) => {
          title.textContent = isAttending
            ? "See you in Boracay."
            : "We'll miss you.";
          intro.textContent = isAttending
            ? `Your ticket is fresh off the press. Save it for the big day, and change your answer any time before ${deadline}.`
            : `Plans change? You can update your RSVP any time before ${deadline}.`;
        };
        const restoreIntro = () => {
          title.replaceChildren(
            document.createTextNode("Will you"),
            document.createElement("br"),
            document.createTextNode("be there?"),
          );
          intro.textContent = `Please reply by ${deadline}. Three quick steps, and you can change your answer until then.`;
        };
        const setStep = (next: typeof step) => {
          step = next;
          updateInvitation();
          root
            .querySelectorAll<HTMLElement>("[data-rsvp-panel]")
            .forEach((item) => {
              item.hidden = item.dataset.rsvpPanel !== next;
            });
          root.querySelectorAll<HTMLElement>("[data-step]").forEach((item) => {
            const current = item.dataset.step === next;
            if (current) {
              item.setAttribute("aria-current", "step");
            } else {
              item.removeAttribute("aria-current");
            }
            item.classList.toggle(
              "is-complete",
              Number(item.dataset.step) < Number(next),
            );
          });
          root.querySelector<HTMLElement>("[data-rsvp-steps]")!.hidden =
            next === "sent";
          root.querySelector<HTMLElement>("[data-rsvp-sent-steps]")!.hidden =
            next !== "sent";
          root.querySelector<HTMLElement>(".rsvp_card")!.dataset.sent = String(
            next === "sent",
          );
          requestAnimationFrame(() => heading()?.focus());
        };
        const updateGuestControls = () => {
          const count = root.querySelector<HTMLOutputElement>("[data-rsvp-count]")!;
          const attendingCount = seats.filter((seat) => seat.attending).length;
          count.value = `${attendingCount} of ${invite?.seats ?? 0} seats`;
          count.textContent = `${attendingCount} of ${invite?.seats ?? 0} seats`;
        };
        const renderSeats = (focusIndex = -1, focusTarget: "checkbox" | "action" = "action") => {
          const list = root.querySelector<HTMLElement>("[data-rsvp-seat-list]")!;
          list.replaceChildren();
          seats.forEach((seat, index) => {
            const row = document.createElement("div");
            row.className = "rsvp_seat-row";
            row.dataset.seatIndex = String(index);
            if (!seat.attending) row.classList.add("is-not-coming");
            if (seat.original === null && !seat.name) row.classList.add("is-open");
            const checkbox = document.createElement("input");
            checkbox.type = "checkbox";
            checkbox.checked = seat.attending;
            checkbox.id = `rsvp-seat-${index}`;
            checkbox.setAttribute("aria-label", `Seat ${index + 1}: ${seat.name || "Open seat"}`);
            checkbox.dataset.rsvpSeatToggle = "true";
            const label = document.createElement("label");
            label.htmlFor = checkbox.id;
            label.className = "rsvp_seat-label";
            const name = document.createElement("span");
            name.className = "rsvp_seat-name";
            name.textContent = seat.name || "Open seat";
            label.append(checkbox, name);
            const meta = document.createElement("span");
            meta.className = "rsvp_seat-meta";
            if (index === invite?.members.indexOf(matchedName)) meta.textContent = "You";
            if (!seat.attending && seat.name) {
              const notComing = document.createElement("span");
              notComing.textContent = "Not coming";
              meta.append(notComing);
            }
            if (meta.textContent) label.append(meta);
            row.append(label);
            if (editingSeat === index) {
              row.classList.add("is-editing");
              const editWrap = document.createElement("div");
              editWrap.className = "rsvp_seat-edit";
              const input = document.createElement("input");
              input.value = seat.name;
              input.id = `rsvp-seat-name-${index}`;
              input.setAttribute("aria-label", `Name for seat ${index + 1}`);
              const done = document.createElement("button");
              done.type = "button";
              done.textContent = "Done";
              done.setAttribute("aria-label", `Done editing ${seat.name || `seat ${index + 1}`}`);
              const message = document.createElement("p");
              message.className = "rsvp_error";
              message.hidden = true;
              message.textContent = "Please enter a name.";
              const finish = () => {
                const value = input.value.trim();
                if (!value) { message.hidden = false; input.focus(); return; }
                seat.name = value;
                if (seat.original === null) seat.attending = true;
                editingSeat = -1;
                renderSeats(index, "action");
              };
              done.addEventListener("click", finish);
              input.addEventListener("keydown", (event) => {
                if (event.key === "Enter") { event.preventDefault(); finish(); }
                if (event.key === "Escape") { editingSeat = -1; renderSeats(index, "action"); }
              });
              editWrap.append(input, done, message);
              if (seat.original && normalizeGuestName(seat.name) !== normalizeGuestName(seat.original)) {
                const changed = document.createElement("span");
                changed.className = "rsvp_seat-change";
                changed.textContent = `Was ${seat.original}`;
                const undo = document.createElement("button");
                undo.type = "button";
                undo.textContent = "Undo";
                undo.setAttribute("aria-label", `Undo name change for ${seat.name}`);
                undo.addEventListener("click", () => { seat.name = seat.original!; renderSeats(index, "action"); });
                editWrap.append(changed, undo);
              }
              row.append(editWrap);
              list.append(row);
              requestAnimationFrame(() => input.focus());
              return;
            }
            const action = document.createElement("button");
            action.type = "button";
            action.className = "rsvp_seat-action";
            const icon = document.createElementNS("http://www.w3.org/2000/svg", "svg");
            icon.setAttribute("viewBox", "0 0 12 12");
            icon.setAttribute("aria-hidden", "true");
            icon.innerHTML = seat.name
              ? '<path d="M8.2 1.3 10.7 3.8 4 10.5H1.5V8L8.2 1.3Z" />'
              : '<path d="M6 1v10M1 6h10" />';
            action.append(icon, document.createTextNode(seat.name ? "Edit" : "Add name"));
            action.setAttribute("aria-label", seat.name ? `Edit ${seat.name}` : `Add name for seat ${index + 1}`);
            action.dataset.rsvpSeatAction = "true";
            action.addEventListener("click", () => { editingSeat = index; renderSeats(); });
            row.append(action);
            if (seat.original && normalizeGuestName(seat.name) !== normalizeGuestName(seat.original) && seat.name) {
              const change = document.createElement("div");
              change.className = "rsvp_seat-change-line";
              change.textContent = `Was ${seat.original}`;
              const undo = document.createElement("button");
              undo.type = "button";
              undo.textContent = "Undo";
              undo.setAttribute("aria-label", `Undo name change for ${seat.name}`);
              undo.addEventListener("click", () => { seat.name = seat.original!; renderSeats(index, "action"); });
              change.append(" ", undo);
              row.append(change);
            } else if (seat.original === null && seat.name) {
              const change = document.createElement("div");
              change.className = "rsvp_seat-change-line";
              change.textContent = "Plus-one";
              const remove = document.createElement("button");
              remove.type = "button";
              remove.textContent = "Remove";
              remove.setAttribute("aria-label", `Remove ${seat.name}`);
              remove.addEventListener("click", () => { seat.name = ""; seat.attending = false; renderSeats(index, "action"); });
              change.append(" ", remove);
              row.append(change);
            }
            checkbox.addEventListener("change", () => {
              seat.attending = checkbox.checked;
              if (checkbox.checked) {
                root.querySelector<HTMLElement>("[data-rsvp-guest-error]")!.hidden = true;
                root.querySelector<HTMLElement>("[data-rsvp-guests]")!.classList.remove("has-error");
              }
              renderSeats(index, "checkbox");
            });
            list.append(row);
          });
          updateGuestControls();
          if (focusIndex >= 0) {
            const control = focusTarget === "checkbox"
              ? root.querySelector<HTMLInputElement>(`#rsvp-seat-${focusIndex}`)
              : root.querySelector<HTMLButtonElement>(`[data-seat-index="${focusIndex}"] [data-rsvp-seat-action]`);
            control?.focus();
          }
        };
        const updateInvitation = () => {
          root.querySelector<HTMLElement>("[data-rsvp-invitation]")!.hidden =
            !invite || step === "1";
          if (invite) {
            root.querySelector("[data-rsvp-household]")!.textContent =
              invite.householdName;
            root.querySelector("[data-rsvp-seats]")!.textContent = String(
              invite.seats,
            );
          }
        };
        root
          .querySelector<HTMLFormElement>("[data-rsvp-find]")!
          .addEventListener("submit", async (event) => {
            event.preventDefault();
            const error = root.querySelector<HTMLElement>(
              "[data-rsvp-name-error]",
            )!;
            const value = nameInput.value;
            if (!value.trim()) {
              error.textContent = "Please enter the name on your invitation.";
              error.hidden = false;
              nameInput.setAttribute("aria-invalid", "true");
              nameInput.setAttribute("aria-describedby", "rsvp-name-error");
              return;
            }
            findButton.disabled = true;
            findButton.setAttribute("aria-busy", "true");
            try {
              const result = await actions.rsvp.find({
                name: value,
                  turnstileToken: await turnstile.getToken(
                  root.querySelectorAll<HTMLElement>(
                    "[data-rsvp-turnstile]",
                  )[0],
                ),
              });
              if (result.error || !result.data) {
                error.textContent =
                  result.error?.message ||
                  "Something went wrong — please try again.";
                error.hidden = false;
                nameInput.setAttribute("aria-invalid", "true");
                nameInput.setAttribute("aria-describedby", "rsvp-name-error");
                return;
              }
              if (!result.data.invite) {
                error.textContent =
                  "We couldn't find that name. Try it exactly as it's written on your invite, or message us.";
                error.hidden = false;
                nameInput.setAttribute("aria-invalid", "true");
                nameInput.setAttribute("aria-describedby", "rsvp-name-error");
                return;
              }
              error.hidden = true;
              nameInput.removeAttribute("aria-invalid");
              nameInput.removeAttribute("aria-describedby");
              invite = result.data.invite;
              matchedName = result.data.matchedName;
              const token = result.data.token;
              const previous = result.data.previous;
              seats = previous?.seats?.length === invite.seats
                ? previous.seats.map((seat, index) => ({ ...seat, attending: previous.attending ? seat.attending : index < invite!.members.length }))
                : [
                    ...invite.members.map((member): Seat => ({ original: member, name: member, attending: true })),
                    ...Array.from({ length: Math.max(0, invite.seats - invite.members.length) }, (): Seat => ({ original: null, name: "", attending: false })),
                  ];
              attending = previous?.attending ?? true;
              root.querySelector("[data-rsvp-first-name]")!.textContent =
                matchedName.split(" ")[0];
              root.querySelector<HTMLInputElement>(`input[name="attending"][value="${attending ? "yes" : "no"}"]`)!.checked = true;
              root.querySelector<HTMLElement>("[data-rsvp-guests]")!.hidden = !attending;
              renderSeats();
              root.dataset.rsvpToken = token;
              setStep("2");
            } catch {
              error.textContent = "Something went wrong — please try again.";
              error.hidden = false;
              nameInput.setAttribute("aria-invalid", "true");
              nameInput.setAttribute("aria-describedby", "rsvp-name-error");
            } finally {
              turnstile.reset();
              findButton.disabled = false;
              findButton.removeAttribute("aria-busy");
            }
          });
        root
          .querySelector<HTMLFormElement>("[data-rsvp-attending]")!
          .addEventListener("change", (event) => {
            if ((event.target as HTMLInputElement).name === "attending") {
              attending = (event.target as HTMLInputElement).value === "yes";
              root.querySelector<HTMLElement>("[data-rsvp-guests]")!.hidden =
                !attending;
              root.querySelector<HTMLElement>("[data-rsvp-guest-error]")!.hidden = true;
              root.querySelector<HTMLElement>("[data-rsvp-guests]")!.classList.remove("has-error");
              if (attending) renderSeats();
            }
          });
        root
          .querySelector<HTMLFormElement>("[data-rsvp-attending]")!
          .addEventListener("submit", (event) => {
            event.preventDefault();
            if (attending && !seats.some((seat) => seat.attending)) {
              const error = root.querySelector<HTMLElement>("[data-rsvp-guest-error]")!;
              error.hidden = false;
              root.querySelector<HTMLElement>("[data-rsvp-guests]")!.classList.add("has-error");
              root.querySelector<HTMLInputElement>("[data-rsvp-seat-toggle]")?.focus();
              return;
            }
            setStep("3");
          });
        root
          .querySelector<HTMLButtonElement>("[data-rsvp-back]")!
          .addEventListener("click", () => {
            setStep("1");
          });
        root
          .querySelector<HTMLButtonElement>("[data-rsvp-details-back]")!
          .addEventListener("click", () => {
            setStep("2");
          });
        root
          .querySelector<HTMLFormElement>("[data-rsvp-details]")!
          .addEventListener("submit", async (event) => {
            event.preventDefault();
            const form = event.currentTarget as HTMLFormElement;
            const email = form.elements.namedItem("email") as HTMLInputElement;
            const error = root.querySelector<HTMLElement>(
              "[data-rsvp-email-error]",
            )!;
            if (!email.checkValidity()) {
              email.setAttribute("aria-invalid", "true");
              email.setAttribute("aria-describedby", "rsvp-email-error");
              error.hidden = false;
              email.focus();
              return;
            }
            email.removeAttribute("aria-invalid");
            email.removeAttribute("aria-describedby");
            error.hidden = true;
            const submit =
              root.querySelector<HTMLButtonElement>("[data-rsvp-submit]")!;
            const submitError = root.querySelector<HTMLElement>(
              "[data-rsvp-submit-error]",
            )!;
            submit.disabled = true;
            submit.setAttribute("aria-busy", "true");
            submitError.hidden = true;
            try {
              const result = await actions.rsvp.submit({
                token: root.dataset.rsvpToken ?? "",
                name: matchedName,
                attending,
                seats: seats.map((seat) => ({ ...seat, attending: attending && seat.attending })),
                email: email.value,
                note:
                  (form.elements.namedItem("note") as HTMLTextAreaElement)
                    .value || undefined,
                turnstileToken: await turnstile.getToken(
                  root.querySelectorAll<HTMLElement>(
                    "[data-rsvp-turnstile]",
                  )[1],
                ),
              });
              if (result.error) {
                submitError.textContent = result.error.message;
                submitError.hidden = false;
                return;
              }
            } catch {
              submitError.textContent =
                "Something went wrong — please try again.";
              submitError.hidden = false;
              return;
            } finally {
              turnstile.reset();
              submit.disabled = false;
              submit.removeAttribute("aria-busy");
            }
            root.querySelector<HTMLElement>(
              "[data-rsvp-email-summary]",
            )!.textContent = email.value;
            root.querySelector<HTMLElement>(
              "[data-rsvp-attending-summary]",
            )!.textContent = attending
              ? "Joyfully accepts"
              : "Regretfully declines";
            const tickedNames = seats.filter((seat) => attending && seat.attending).map((seat) => seat.name);
            root.querySelector<HTMLElement>("[data-rsvp-guests-summary-value]")!.textContent = attending
              ? `${tickedNames.length} ${tickedNames.length === 1 ? "guest" : "guests"}: ${tickedNames.join(", ")}`
              : "";
            root.querySelector<HTMLElement>(
              "[data-rsvp-guests-summary]",
            )!.hidden = !attending;
            root.querySelector<HTMLElement>(
              "[data-rsvp-panel=sent] h3",
            )!.textContent = attending
              ? `You're on the list, ${matchedName.split(" ")[0]}.`
              : `Thanks for letting us know, ${matchedName.split(" ")[0]}.`;
            setConfirmationCopy(attending);
            submit.disabled = false;
            submit.removeAttribute("aria-busy");
            setStep("sent");
            if (attending && invite) {
              document.dispatchEvent(
                new CustomEvent("rsvp-ticket-open", {
                  detail: {
                    inviteId: invite.id,
                    matchedName,
                    names: tickedNames,
                    guests: tickedNames.length,
                    deadline,
                  },
                }),
              );
            }
          });
        root
          .querySelector<HTMLButtonElement>("[data-rsvp-edit]")!
          .addEventListener("click", () => {
            restoreIntro();
            setStep("2");
          });
        document.addEventListener("rsvp-ticket-edit", () => {
          restoreIntro();
          setStep("2");
        });
        updateGuestControls();
      });
  };
  initRsvp();
  document.addEventListener("astro:page-load", initRsvp);
</script>

