---
import { Image } from "astro:assets";
import type { HTMLAttributes } from "astro/types";
import beachCircle from "@/assets/images/with-love/note-beach-circle.jpg";
import shoreline from "@/assets/images/with-love/note-shoreline.jpg";
import beachWalk from "@/assets/images/with-love/note-beach-walk.jpg";
import barkada from "@/assets/images/entourage/polaroid-barkada.jpg";
import whiteBeach from "@/assets/images/hero/polaroid-white-beach.jpg";
import arch from "@/assets/images/wedding/polaroid-arch.jpg";
import WithLoveUpload from "@/components/sections/WithLoveUpload.astro";

interface Props extends HTMLAttributes<"section"> {}

type LoveNote = {
  id: string;
  image: ImageMetadata;
  alt: string;
  message: string;
  attribution: string;
};

// Placeholder content; replace with guest submissions in a later PR.
const notes: LoveNote[] = [
  {
    id: "beach-circle",
    image: beachCircle,
    alt: "Friends sitting together in a circle on the beach",
    message: "Finally! Save me a seat by the dance floor.",
    attribution: "TITA LIZA, MANILA",
  },
  {
    id: "shoreline",
    image: shoreline,
    alt: "Two friends wading together at the shoreline",
    message: "Boracay 2019, when you two swore you were 'just friends.' See you on the sand!",
    attribution: "MIGS, CEBU",
  },
  {
    id: "beach-walk",
    image: beachWalk,
    alt: "Four friends walking together along the beach",
    message: "The barkada is ready. Are you?",
    attribution: "JOANNA, QUEZON CITY",
  },
  {
    id: "barkada",
    image: barkada,
    alt: "A group of friends smiling together",
    message: "Twenty years of friendship and you still can't pick a karaoke song.",
    attribution: "PAOLO, MAKATI",
  },
  {
    id: "white-beach",
    image: whiteBeach,
    alt: "A white beach beneath a bright blue sky",
    message: "Wishing you a lifetime of sunsets like this.",
    attribution: "LOLA NENA, ILOILO",
  },
  {
    id: "arch",
    image: arch,
    alt: "A wedding couple standing beneath a stone arch",
    message: "See you at the arch. Don't be late, Warren.",
    attribution: "ATE CHRISTINE, DAVAO",
  },
];

const { class: className, ...rest } = Astro.props;
---

<section
  id="with-love"
  class:list={["with-love_wrap", "theme-brand", className]}
  aria-labelledby="with-love-title"
  {...rest}
>
  <h2 id="with-love-title" class="sr-only">With love</h2>
  <div class="with-love_stage">
    <div class="with-love_words" aria-hidden="true">
      <span class="with-love_word with-love_word-with">WITH</span>
      <span class="with-love_word with-love_word-love">love</span>
    </div>

    <div data-stacked-cards class="stack-cards with-love_stack" aria-label="Guest notes">
      <div class="stacked-cards__stack">
        <div class="stack-cards__before"></div>
        <div class="stacked-cards__collection">
          <div data-stacked-cards-list class="stack-cards__list">
            {
              notes.map((note) => (
                <div
                  data-stacked-cards-item
                  data-note-id={note.id}
                  class="stack-cards__item"
                >
                  <article data-stacked-cards-card class="stack-cards__card">
                    <Image
                      class="with-love_photo"
                      src={note.image}
                      alt={note.alt}
                      width={1800}
                      height={1200}
                      widths={[250, 380, 760]}
                      sizes="(min-width: 64rem) 23.75rem, 15.625rem"
                      loading="lazy"
                    />
                    <p class="with-love_message">“{note.message}”</p>
                    <p class="with-love_attribution">— {note.attribution}</p>
                  </article>
                </div>
              ))
            }
          </div>
        </div>
      </div>
      <div class="stacked-cards__controls">
        <button data-stacked-cards-control="next" class="shuffle-btn" type="button">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="100%"
            viewBox="0 0 24 24"
            fill="none"
            class="shuffle-btn__icon-svg"
            aria-hidden="true"
          >
            <path d="M1 4V10H7" stroke="currentColor" stroke-width="2"></path>
            <path d="M23 20V14H17" stroke="currentColor" stroke-width="2"></path>
            <path d="M20.5 8.99998C19.6855 6.75968 18.0244 4.92842 15.8739 3.89992C13.7235 2.87143 11.2553 2.72782 9 3.49998C7.7459 3.98238 6.59283 4.69457 5.6 5.59998L1 9.99998M23 14L18.4 18.4C16.6963 20.0855 14.3965 21.0308 12 21.0308C9.60347 21.0308 7.30368 20.0855 5.6 18.4C4.69459 17.4072 3.9824 16.2541 3.5 15" stroke="currentColor" stroke-width="2"></path>
          </svg>
          <span class="shuffle-btn__span">Shuffle</span>
        </button>
      </div>
    </div>
  </div>
  <WithLoveUpload />
</section>

<script>
  import { initWithLoveStack } from "@/scripts/with-love/stack";

  initWithLoveStack();
  document.addEventListener("astro:page-load", initWithLoveStack);
</script>

<style is:global>
  @layer components {
    .with-love_wrap {
      position: relative;
      overflow: clip;
      pointer-events: auto;
      padding: var(--section-space-large) var(--site-margin) var(--section-space-medium);
      background: var(--background) var(--background-texture) center / 32rem repeat;
      color: var(--dark-900);
    }
    .with-love_stage {
      position: relative;
      min-height: max(
        calc(2 * var(--with-love-line) + var(--with-love-gap)),
        calc(var(--with-love-stack-offset) + var(--with-love-card-width) * 1.175 + 1.25rem)
      );
    }
    .with-love_words {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--with-love-gap);
    }
    .with-love_word {
      color: color-mix(in srgb, var(--dark-900) 50%, transparent);
      font-family: var(--secondary-family);
      font-size: var(--with-love-size);
      line-height: var(--with-love-line);
      letter-spacing: var(--letter-spacing-tighter);
      white-space: nowrap;
    }
    .with-love_word-love {
      font-weight: var(--secondary-ultralight);
      font-style: italic;
    }
    .with-love_stack {
      position: absolute;
      top: var(--with-love-stack-offset);
      left: 50%;
      z-index: 1;
      width: var(--with-love-card-width);
      transform: translateX(-50%);
    }
    .stacked-cards__stack { z-index: 0; position: relative; width: 100%; }
    .stack-cards__before { padding-top: var(--with-love-stack-height); }
    .stacked-cards__collection,
    .stack-cards__list { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
    .stack-cards__item { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
    .stack-cards__card {
      position: absolute;
      top: 0;
      left: 0;
      display: flex;
      width: 100%;
      height: 100%;
      flex-direction: column;
      gap: var(--space-3);
      overflow: hidden;
      padding: var(--space-3) var(--space-3) var(--space-4);
      border: 0;
      border-radius: 0;
      background: var(--light-200) url("../../assets/textures/polaroid-paper.jpg") center / 32rem repeat;
      box-shadow: 0 1rem 2.25rem rgb(31 47 92 / 18%);
      box-sizing: border-box;
      transition: box-shadow 0.25s cubic-bezier(0.625, 0.05, 0, 1);
      cursor: grab;
    }
    .stack-cards__card.is--dragging { cursor: grabbing; }
    .with-love_photo { display: block; width: 100%; height: auto; aspect-ratio: 8 / 7; flex: 0 0 auto; object-fit: cover; pointer-events: none; user-select: none; }
    .with-love_message { margin: 0; color: var(--dark-900); font: italic var(--secondary-ultralight) var(--with-love-message-size) / var(--with-love-message-line) var(--secondary-family); }
    .with-love_attribution { margin: 0; color: var(--dark-700); font: var(--primary-regular) var(--eyebrow) / 1rem var(--mono-family); letter-spacing: 0.04em; text-transform: uppercase; }
    .stacked-cards__controls { z-index: 1; position: relative; display: flex; align-items: center; justify-content: center; margin-top: -1.375rem; }
    .shuffle-btn { display: flex; height: 2.75rem; align-items: center; justify-content: center; gap: 0.5rem; padding: 0 1.375rem 0 1.125rem; border: 0; border-radius: var(--radius-round); background: var(--dark-900); color: var(--light-100); cursor: pointer; font: var(--primary-medium) 1rem / 1.25 var(--primary-family); }
    .shuffle-btn__icon-svg { display: block; width: 1rem; height: 1rem; }
    .shuffle-btn__span { white-space: nowrap; }
    .shuffle-btn:focus-visible { outline: var(--focus-width) solid var(--dark-900); outline-offset: var(--focus-offset); }

    .with-love_wrap {
      --with-love-size-min: 128;
      --with-love-size-max: 320;
      --with-love-size: clamp(var(--with-love-size-min) / 16 * 1rem, ((var(--with-love-size-min) - ((var(--with-love-size-max) - var(--with-love-size-min)) / (var(--viewport-max) - var(--viewport-min)) * var(--viewport-min))) / 16 * 1rem + ((var(--with-love-size-max) - var(--with-love-size-min)) / (var(--viewport-max) - var(--viewport-min))) * 100vw), var(--with-love-size-max) / 16 * 1rem);
      --with-love-line-min: 108;
      --with-love-line-max: 260;
      --with-love-line: clamp(var(--with-love-line-min) / 16 * 1rem, ((var(--with-love-line-min) - ((var(--with-love-line-max) - var(--with-love-line-min)) / (var(--viewport-max) - var(--viewport-min)) * var(--viewport-min))) / 16 * 1rem + ((var(--with-love-line-max) - var(--with-love-line-min)) / (var(--viewport-max) - var(--viewport-min))) * 100vw), var(--with-love-line-max) / 16 * 1rem);
      --with-love-gap-min: 236;
      --with-love-gap-max: 300;
      --with-love-gap: clamp(var(--with-love-gap-min) / 16 * 1rem, ((var(--with-love-gap-min) - ((var(--with-love-gap-max) - var(--with-love-gap-min)) / (var(--viewport-max) - var(--viewport-min)) * var(--viewport-min))) / 16 * 1rem + ((var(--with-love-gap-max) - var(--with-love-gap-min)) / (var(--viewport-max) - var(--viewport-min))) * 100vw), var(--with-love-gap-max) / 16 * 1rem);
      --with-love-card-width-min: 250;
      --with-love-card-width-max: 380;
      --with-love-card-width: clamp(var(--with-love-card-width-min) / 16 * 1rem, ((var(--with-love-card-width-min) - ((var(--with-love-card-width-max) - var(--with-love-card-width-min)) / (var(--viewport-max) - var(--viewport-min)) * var(--viewport-min))) / 16 * 1rem + ((var(--with-love-card-width-max) - var(--with-love-card-width-min)) / (var(--viewport-max) - var(--viewport-min))) * 100vw), var(--with-love-card-width-max) / 16 * 1rem);
      --with-love-stack-offset-min: 48;
      --with-love-stack-offset-max: 100;
      --with-love-stack-offset: clamp(var(--with-love-stack-offset-min) / 16 * 1rem, ((var(--with-love-stack-offset-min) - ((var(--with-love-stack-offset-max) - var(--with-love-stack-offset-min)) / (var(--viewport-max) - var(--viewport-min)) * var(--viewport-min))) / 16 * 1rem + ((var(--with-love-stack-offset-max) - var(--with-love-stack-offset-min)) / (var(--viewport-max) - var(--viewport-min))) * 100vw), var(--with-love-stack-offset-max) / 16 * 1rem);
      /* Osmo's 117.5% card ratio, plus room for the caption on narrow cards: +3.5rem at 320px, none at 1440px. */
      --with-love-stack-height: calc(117.5% + clamp(0rem, 4.5rem - 5vw, 3.5rem));
      --with-love-message-size-min: 16;
      --with-love-message-size-max: 24;
      --with-love-message-size: clamp(var(--with-love-message-size-min) / 16 * 1rem, ((var(--with-love-message-size-min) - ((var(--with-love-message-size-max) - var(--with-love-message-size-min)) / (var(--viewport-max) - var(--viewport-min)) * var(--viewport-min))) / 16 * 1rem + ((var(--with-love-message-size-max) - var(--with-love-message-size-min)) / (var(--viewport-max) - var(--viewport-min))) * 100vw), var(--with-love-message-size-max) / 16 * 1rem);
      --with-love-message-line-min: 20;
      --with-love-message-line-max: 28;
      --with-love-message-line: clamp(var(--with-love-message-line-min) / 16 * 1rem, ((var(--with-love-message-line-min) - ((var(--with-love-message-line-max) - var(--with-love-message-line-min)) / (var(--viewport-max) - var(--viewport-min)) * var(--viewport-min))) / 16 * 1rem + ((var(--with-love-message-line-max) - var(--with-love-message-line-min)) / (var(--viewport-max) - var(--viewport-min))) * 100vw), var(--with-love-message-line-max) / 16 * 1rem);
    }

    @media (max-width: 39.9375rem) {
      .with-love_wrap { padding-block: var(--section-space-small); }
    }
    @media (prefers-reduced-motion: reduce) {
      .stack-cards__card { transition: none; }
    }
  }
</style>
