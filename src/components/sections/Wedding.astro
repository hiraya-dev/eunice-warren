    .wedding_dress-eyebrow { color: var(--dark-700); font: var(--primary-regular) var(--eyebrow) / var(--line-height-medium) var(--mono-family); letter-spacing: 0.04em; }
    .wedding_dress h3 { margin: 0; color: var(--dark-900); font: var(--secondary-regular) 1.5rem / 1.167 var(--secondary-family); }
    .wedding_dress p { margin: 0; color: var(--dark-900); font: var(--primary-regular) var(--text-main) / var(--line-height-large) var(--primary-family); }
    .wedding_swatches { display: flex; gap: var(--space-2); padding-top: var(--space-1); }
    .wedding_swatch { width: 1.875rem; height: 1.875rem; border-radius: 50%; }
    .wedding_swatch-blue { border: var(--border-width) solid var(--dark-900); background: var(--brand-500); }
    .wedding_swatch-cream { border: var(--border-width) solid var(--dark-900); background: var(--light-100); }
    .wedding_swatch-sand { background: #d9c4a3; }
    .wedding_swatch-navy { background: var(--dark-900); }
    .wedding_scallop { position: absolute; right: 0; bottom: 0; left: 0; height: 0.8125rem; background: linear-gradient(var(--light-100) 0 0) bottom / 100% 0.125rem no-repeat, radial-gradient(circle at 1.125rem 0.6875rem, var(--light-100) 0.6875rem, transparent calc(0.6875rem + 0.5px)) 0 0 / 2.25rem 0.6875rem repeat-x; }
  }

  @media (min-width: 62rem) {
    .wedding_wrap { padding-block: var(--section-space-medium); }
    .wedding_title { margin-bottom: 3.5rem; }
    .wedding_body { flex-direction: row; align-items: start; gap: var(--space-8); }
    .wedding_visual-column { flex: 1 1 0; padding-top: var(--space-4); }
    .wedding_content { flex: 1.2 1 0; gap: 2.5rem; min-width: 0; }
    .wedding_visual-item { width: 23.75rem; }
    .wedding_visual-item img { height: 21.25rem; }
    .wedding_row { grid-template-columns: minmax(0, 1fr) 9.375rem; align-items: center; column-gap: var(--space-4); }
    .wedding_tab { grid-template-columns: 2.75rem minmax(0, 1fr); align-items: center; gap: var(--space-4); }
    .wedding_number { padding-top: 0; font-size: 1rem; line-height: 1.25; }
    .wedding_tab-title { flex-direction: row; align-items: baseline; gap: var(--space-2); font-size: var(--h4); line-height: 1.25; }
    .wedding_meta { padding-top: 0; }
    .wedding_time { font-size: 1rem; line-height: 1.25; }
    .wedding_footer { align-items: center; flex-direction: row; justify-content: space-between; gap: var(--space-4); padding-bottom: 0.25rem; }
    .wedding_dress { padding: var(--space-4) var(--space-4) calc(var(--space-5) + 0.5rem); }
    .wedding_swatch { width: 2rem; height: 2rem; }
  }

  @media (max-width: 61.999rem) {
    .wedding_row { align-items: start; }
    .wedding_meta { padding-top: 0.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wedding_row, .wedding_tab { transition: none; }
    .wedding_visual-item { transform: none; transition: none; }
  }
</style>
