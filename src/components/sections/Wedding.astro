---
import { Image } from "astro:assets";
import type { HTMLAttributes } from "astro/types";
import arch from "@/assets/images/wedding/polaroid-arch.jpg";
import sunsetSail from "@/assets/images/hero/polaroid-sunset-sail.jpg";
import whiteBeach from "@/assets/images/hero/polaroid-white-beach.jpg";

interface Props extends HTMLAttributes<"section"> {
  /** Calendar event destination. */
  calendarHref?: string;
}

const { calendarHref = "#", class: className, ...rest } = Astro.props;

const schedule = [
  {
    number: "01",
    title: "Ceremony",
    time: "3:00 PM",
    location: "[Location]",
    mapLabel: "Map for Ceremony",
    image: arch,
    alt: "A white wedding arch draped in fabric and flowers on the sand by the water",
    caption: "Where we'll say yes — White Beach, 3 PM",
    tilt: -3,
  },
  {
    number: "02",
    title: "Sunset",
    italic: "cocktails",
    time: "5:00 PM",
    location: "[Location]",
    mapLabel: "Map for Sunset cocktails",
    image: sunsetSail,
    alt: "A sailboat on the water at sunset",
    caption: "Where we'll toast — [Location], 5 PM",
    tilt: 2.5,
  },
  {
    number: "03",
    title: "Reception &",
    italic: "dancing",
    time: "7:00 PM",
    location: "[Location]",
    mapLabel: "Map for Reception and dancing",
    image: whiteBeach,
    alt: "White Beach, Boracay",
    caption: "Where we'll dance — [Location], 7 PM",
    tilt: -1.5,
  },
];
---

<section id="wedding" class:list={["wedding_wrap", className]} {...rest}>
  <div class="wedding_layout">
    <header class="wedding_header" data-fade-in>
      <h2 class="wedding_title" data-fade-in-item>One day<br />by the sea</h2>
    </header>

    <div class="wedding_body" data-tabs="wrapper" data-tabs-autoplay="true" data-tabs-autoplay-duration="5000">
      <div class="wedding_visual-column">
        <div class="wedding_visual" data-tabs="visual-list">
          {schedule.map((item, index) => (
            <div class:list={["wedding_visual-item", index === 0 && "is-active"]} id={`wedding-panel-${index + 1}`} data-tabs="visual-item" data-tilt={item.tilt} style={`--_tilt: ${item.tilt}deg`} role="tabpanel" aria-labelledby={`wedding-tab-${index + 1}`} hidden={index !== 0}>
              <Image src={item.image} alt={item.alt} width={680} height={680} widths={[560, 680]} sizes="(min-width: 62rem) 21.25rem, 15.75rem" loading="lazy" />
              <span class="wedding_caption">{item.caption}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="wedding_content">
        <div class="wedding_schedule">
          <div class="wedding_tablist" role="tablist" aria-label="Wedding schedule">
            {schedule.map((item, index) => (
              <div class:list={["wedding_row", index === 0 && "is-active"]} data-tabs="content-item">
                <button class="wedding_tab" id={`wedding-tab-${index + 1}`} type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} aria-controls={`wedding-panel-${index + 1}`} tabindex={index === 0 ? 0 : -1}>
                  <span class="wedding_number">({item.number})</span>
                  <span class="wedding_tab-title"><span>{item.title}</span>{item.italic && <em>{item.italic}</em>}</span>
                </button>
                <div class="wedding_meta">
                  <span class="wedding_time">{item.time}</span>
                  <span class="wedding_location">{item.location} · <a href="#" aria-label={item.mapLabel}>Map <span aria-hidden="true">↗</span></a></span>
                </div>
                <span class="wedding_progress" data-tabs="item-progress" aria-hidden="true"></span>
              </div>
            ))}
          </div>
          <div class="wedding_footer">
            <span>All times Philippine Time (GMT+8)</span>
            <a href={calendarHref}>ADD THE DAY TO YOUR CALENDAR <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <div class="wedding_dress-wrap">
          <div class="wedding_dress">
            <span class="wedding_dress-eyebrow">DRESS CODE</span>
            <h3>Island formal</h3>
            <p>Light linen and cotton, flat or block heels — the ceremony is on the sand. Wear the couple's blues if you like; please skip all-white.</p>
            <div class="wedding_swatches" aria-label="Suggested colours: sky blue, cream, sand, navy">
              <span class="wedding_swatch wedding_swatch-blue" aria-hidden="true"></span>
              <span class="wedding_swatch wedding_swatch-cream" aria-hidden="true"></span>
              <!-- One-off raw value from the Paper design: sand. -->
              <span class="wedding_swatch wedding_swatch-sand" aria-hidden="true"></span>
              <span class="wedding_swatch wedding_swatch-navy" aria-hidden="true"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="wedding_scallop" aria-hidden="true"></div>
</section>

<style>
  @layer components {
    .wedding_wrap { --_muted: color-mix(in srgb, var(--dark-900) 50%, transparent); position: relative; overflow: clip; padding: var(--section-space-small) var(--site-margin) var(--section-space-medium); background: var(--brand-500) url("../../assets/textures/grain-brand.jpg") center / 32rem repeat; color: var(--dark-900); }
    .wedding_layout { width: 100%; max-width: var(--max-width-main); margin-inline: auto; }
    .wedding_title { margin: 0 0 var(--space-7); font: var(--secondary-regular) var(--h1) / var(--line-height-medium) var(--secondary-family); letter-spacing: var(--letter-spacing-tight); }
    .wedding_body { display: flex; flex-direction: column; gap: var(--space-7); }
    .wedding_visual-column { display: flex; justify-content: center; }
    .wedding_visual { display: grid; width: max-content; max-width: 100%; }
    .wedding_visual-item { grid-area: 1 / 1; display: flex; flex-direction: column; gap: var(--space-2); width: 17.5rem; padding: var(--space-2) var(--space-2) var(--space-3); background: var(--light-200) url("../../assets/textures/polaroid-paper.jpg") center / 32rem repeat; border: var(--border-width) solid #d9d9d9; box-shadow: 0 0.0625rem 0.0625rem rgb(31 47 92 / 10%), 0 0.375rem 0.875rem rgb(31 47 92 / 10%), 0 1.375rem 2.5rem rgb(31 47 92 / 8%); rotate: var(--_tilt); opacity: 0; transform: translateX(3%); }
    .wedding_visual-item[data-tabs-ready] { rotate: none; }
    .wedding_visual-item.is-active { opacity: 1; transform: translateX(0); }
    .wedding_visual-item[hidden] { display: none; }
    .wedding_visual-item img { display: block; width: 100%; height: 15.625rem; object-fit: cover; }
    .wedding_caption { display: block; font: italic var(--secondary-regular) 1rem / 1.25 var(--secondary-family); }
    .wedding_schedule { width: 100%; }
    .wedding_tablist { border-top: 0.09375rem solid var(--dark-900); }
    .wedding_row { display: grid; grid-template-columns: minmax(0, 1fr) 6rem; align-items: start; column-gap: var(--space-3); position: relative; padding-block: var(--space-4); border-bottom: var(--border-width) solid var(--_muted); color: var(--_muted); transition: color 0.25s ease; }
    .wedding_row.is-active { color: var(--dark-900); }
    .wedding_tab { display: grid; grid-column: 1; grid-template-columns: 2.125rem minmax(0, 1fr); align-items: start; gap: var(--space-3); width: 100%; padding: 0; border: 0; background: transparent; color: inherit; font: inherit; text-align: left; cursor: pointer; }
    .wedding_tab:focus-visible, .wedding_meta a:focus-visible, .wedding_footer a:focus-visible { outline-color: var(--dark-900); outline-offset: var(--focus-offset); }
    .wedding_number { padding-top: 0.75rem; font: var(--primary-regular) 0.75rem / 1rem var(--mono-family); letter-spacing: 0.04em; }
    .wedding_tab-title { display: flex; flex-direction: column; font: var(--secondary-regular) var(--h4) / 1 var(--secondary-family); letter-spacing: var(--letter-spacing-snug); }
    .wedding_tab-title em { font-weight: var(--secondary-ultralight); }
    .wedding_meta { grid-column: 2; display: flex; align-items: end; flex-direction: column; gap: 0.25rem; padding-top: 0.25rem; font: var(--primary-regular) var(--text-small) / var(--line-height-huge) var(--primary-family); text-align: right; }
    .wedding_time { font: var(--primary-regular) 0.75rem / 1rem var(--mono-family); letter-spacing: 0.04em; }
    .wedding_location { color: var(--dark-700); }
    .wedding_row:not(.is-active) .wedding_location { color: inherit; }
    .wedding_meta a, .wedding_footer a { color: inherit; text-decoration: none; }
    .wedding_meta a:hover, .wedding_meta a:focus-visible { text-decoration: underline; text-underline-offset: 0.2em; }
    .wedding_progress { position: absolute; right: 0; bottom: -0.0625rem; left: 0; height: var(--border-width); background: var(--dark-900); transform: scaleX(0); transform-origin: left; }
    .wedding_footer { display: flex; align-items: start; flex-direction: column; gap: var(--space-4); padding-top: var(--space-3); font: var(--primary-regular) var(--text-small) / var(--line-height-huge) var(--primary-family); color: var(--dark-700); }
    .wedding_content { display: flex; flex-direction: column; gap: var(--space-7); }
    .wedding_footer a { padding-bottom: var(--space-1); border-bottom: var(--border-width) solid var(--dark-900); color: var(--dark-900); font: var(--primary-regular) var(--eyebrow) / var(--line-height-medium) var(--mono-family); letter-spacing: 0.04em; }
    .wedding_dress-wrap { position: relative; margin-bottom: -0.5rem; filter: drop-shadow(0 0.0625rem 0.0625rem rgb(31 47 92 / 10%)) drop-shadow(0 0.375rem 0.875rem rgb(31 47 92 / 10%)) drop-shadow(0 1.375rem 2.5rem rgb(31 47 92 / 8%)); }
    .wedding_dress { position: relative; display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-4) var(--space-4) calc(var(--space-5) + 0.5rem); background: var(--light-100) url("../../assets/textures/polaroid-paper.jpg") center / 32rem repeat; -webkit-mask-image: linear-gradient(#000 0 0), url("data:image/svg+xml,%3Csvg%20viewBox='0%200%20663%2018'%20preserveAspectRatio='none'%20xmlns='http://www.w3.org/2000/svg'%3E%3Cpath%20fill='black'%20d='M0.0%200.0%20L0.0%209.6%20L5.9%2013.2%20L11.3%2011.9%20L18.5%206.6%20L26.6%206.4%20L34.2%206.8%20L39.7%2010.7%20L49.7%207.4%20L56.0%2012.9%20L66.7%2012.3%20L74.1%2016.7%20L79.4%2015.4%20L86.1%207.6%20L91.8%209.4%20L101.7%208.0%20L110.2%2013.0%20L117.4%2012.0%20L122.8%206.7%20L129.0%2013.5%20L136.6%209.5%20L145.1%2011.0%20L151.9%2014.7%20L161.1%208.7%20L169.6%2011.8%20L179.8%2014.0%20L186.5%2016.8%20L192.3%2010.6%20L201.8%207.7%20L209.7%206.4%20L218.7%2014.4%20L227.2%2015.6%20L234.1%2013.6%20L242.6%2012.4%20L250.4%2015.2%20L261.0%2011.2%20L270.0%206.7%20L279.2%2013.1%20L290.2%2015.0%20L296.9%2010.2%20L305.9%206.2%20L313.7%207.8%20L319.4%206.6%20L329.0%207.4%20L335.5%2010.3%20L345.7%206.9%20L353.4%2012.0%20L363.7%2015.0%20L373.9%209.1%20L381.4%209.9%20L391.7%2016.5%20L397.6%207.9%20L404.0%208.6%20L411.9%2012.5%20L418.5%206.0%20L426.0%2010.1%20L434.4%2016.5%20L443.5%2011.7%20L452.2%2013.4%20L457.5%2015.9%20L467.2%2015.6%20L477.0%2010.3%20L484.4%207.1%20L493.2%206.7%20L498.6%208.3%20L504.6%209.7%20L509.9%206.0%20L515.8%207.1%20L523.0%206.3%20L533.2%2012.8%20L539.1%208.8%20L546.2%2010.0%20L552.0%2015.3%20L562.9%2011.1%20L570.8%206.9%20L576.4%209.8%20L583.0%2015.1%20L589.0%206.3%20L599.7%2011.8%20L605.6%2012.0%20L610.7%2011.8%20L621.6%2015.5%20L630.8%208.9%20L638.0%207.8%20L647.6%2011.9%20L657.3%209.6%20L663.0%2014.9%20L663.0%200.0%20Z'/%3E%3C/svg%3E"); mask-image: linear-gradient(#000 0 0), url("data:image/svg+xml,%3Csvg%20viewBox='0%200%20663%2018'%20preserveAspectRatio='none'%20xmlns='http://www.w3.org/2