          <path d="M46.024 126.918L67.906 135.671 46.024 144.424 51.494 135.671Z" fill="#E3B5AC" />
          <path d="M384.106 149.895C384.106 149.895 372.071 142.236 372.071 133.483 372.071 128.669 375.791 125.824 379.292 125.824 381.699 125.824 383.34 127.247 384.106 128.888 384.872 127.247 386.513 125.824 388.92 125.824 392.421 125.824 396.141 128.669 396.141 133.483 396.141 142.236 384.106 149.895 384.106 149.895Z" fill="#E3B5AC" />
