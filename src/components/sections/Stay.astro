          <text x="24" y="34" font-size="11" letter-spacing="1.6" fill="#BCD3E8">BORACAY / ARRIVAL ROUTE</text>
          <text x="462" y="28" font-size="11" fill="#F5EFE3">N</text>
          <text x="52" y="154" font-size="12" letter-spacing="1.6" fill="#F5EFE3">CATICLAN</text>
          <text x="24" y="218" font-size="11" letter-spacing="1.6" fill="#BCD3E8">PANAY</text>
          <text x="344" y="284" font-size="12" letter-spacing="1.6" fill="#F5EFE3">CAGBAN</text>
