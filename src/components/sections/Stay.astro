          <path d="M383 48C398 48 404 60 403 74C402 94 405 116 408 134C410 150 406 166 401 182C398 198 402 214 403 228C404 240 395 248 383 248" fill="none" stroke="#BCD3E838" stroke-width="0.8" stroke-dasharray="2 3" />
