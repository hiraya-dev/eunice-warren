---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {}

const { class: className, ...rest } = Astro.props;

const steps = [
  {
    number: "1",
    title: "Fly to Caticlan",
    body: "Caticlan (MPH) is the closest airport — about 1 hr from Manila or Cebu. Kalibo (KLO) has more flights but adds ~2 hrs by van to the jetty port.",
    detail: "~1 hr flight · MNL / CEB → MPH",
  },
  {
    number: "2",
    title: "Cross by boat",
    body: "From Caticlan Jetty Port, take the 15-min boat to Cagban Port. Pay the terminal and environmental fees at the counter, and bring a valid ID.",
    detail: "~15 min · Boats run 5 AM – 7 PM",
  },
  {
    number: "3",
    title: "Ride to White Beach",
    body: "Grab an e-trike from Cagban to Station [X] — about 20 mins. The ceremony is right on the sand, steps from the main path.",
    detail: "~20 min · Cagban → Station [X]",
  },
];
---

<section id="stay" class:list={["stay_wrap", "theme-dark", className]} {...rest}>
  <div class="stay_layout">
    <header class="stay_header" data-fade-in>
      <div class="stay_intro">
        <h2 class="stay_title" data-fade-in-item>Make it a<br />weekend</h2>
        <p class="stay_description" data-fade-in-item>Three days, one island. Here’s how to get here — the field notes below cover what to do once you land.</p>
      </div>
      <div class="stay_compass_wrap" aria-hidden="true">
        <svg class="stay_compass" width="460" height="480" viewBox="0 0 460 480" xmlns="http://www.w3.org/2000/svg" role="presentation" aria-hidden="true">
          <circle cx="230" cy="240" r="188" fill="none" stroke="#BCD3E8" stroke-opacity="0.35" stroke-width="1" />
          <circle cx="230" cy="240" r="176" fill="#2A3A6B" fill-opacity="0.55" stroke="#BCD3E8" stroke-width="1.2" />
          <path d="M230.0 64.0L230.0 78.0M245.3 64.7L244.9 69.7M260.6 66.7L259.7 71.6M275.6 70.0L273.2 78.7M290.2 74.6L288.5 79.3M304.4 80.5L302.3 85.0M318.0 87.6L311.0 99.7M330.9 95.8L328.1 99.9M343.1 105.2L339.9 109.0M354.5 115.5L348.1 121.9M364.8 126.9L361.0 130.1M374.2 139.1L370.1 141.9M382.4 152.0L370.3 159.0M389.5 165.6L385.0 167.7M395.4 179.8L390.7 181.5M400.0 194.4L391.3 196.8M403.3 209.4L398.4 210.3M405.3 224.7L400.3 225.1M406.0 240.0L392.0 240.0M405.3 255.3L400.3 254.9M403.3 270.6L398.4 269.7M400.0 285.6L391.3 283.2M395.4 300.2L390.7 298.5M389.5 314.4L385.0 312.3M382.4 328.0L370.3 321.0M374.2 340.9L370.1 338.1M364.8 353.1L361.0 349.9M354.5 364.5L348.1 358.1M343.1 374.8L339.9 371.0M330.9 384.2L328.1 380.1M318.0 392.4L311.0 380.3M304.4 399.5L302.3 395.0M290.2 405.4L288.5 400.7M275.6 410.0L273.2 401.3M260.6 413.3L259.7 408.4M245.3 415.3L244.9 410.3M230.0 416.0L230.0 402.0M214.7 415.3L215.1 410.3M199.4 413.3L200.3 408.4M184.4 410.0L186.8 401.3M169.8 405.4L171.5 400.7M155.6 399.5L157.7 395.0M142.0 392.4L149.0 380.3M129.1 384.2L131.9 380.1M116.9 374.8L120.1 371.0M105.5 364.5L111.9 358.1M95.2 353.1L99.0 349.9M85.8 340.9L89.9 338.1M77.6 328.0L89.7 321.0M70.5 314.4L75.0 312.3M64.6 300.2L69.3 298.5M60.0 285.6L68.7 283.2M56.7 270.6L61.6 269.7M54.7 255.3L59.7 254.9M54.0 240.0L68.0 240.0M54.7 224.7L59.7 225.1M56.7 209.4L61.6 210.3M60.0 194.4L68.7 196.8M64.6 179.8L69.3 181.5M70.5 165.6L75.0 167.7M77.6 152.0L89.7 159.0M85.8 139.1L89.9 141.9M95.2 126.9L99.0 130.1M105.5 115.5L111.9 121.9M116.9 105.2L120.1 109.0M129.1 95.8L131.9 99.9M142.0 87.6L149.0 99.7M155.6 80.5L157.7 85.0M169.8 74.6L171.5 79.3M184.4 70.0L186.8 78.7M199.4 66.7L200.3 71.6M214.7 64.7L215.1 69.7" fill="none" stroke="#BCD3E8" stroke-width="1" stroke-linecap="round" />
          <circle cx="230" cy="240" r="130" fill="none" stroke="#BCD3E8" stroke-opacity="0.3" stroke-width="0.8" stroke-dasharray="2 4" />
          <g fill="#BCD3E8" fill-opacity="0.7" font-family="var(--mono-family)" font-size="10" text-anchor="middle"><text x="303" y="117.1">030</text><text x="356.4" y="170.5">060</text><text x="356.4" y="316.5">120</text><text x="303" y="369.9">150</text><text x="157" y="369.9">210</text><text x="103.6" y="316.5">240</text><text x="103.6" y="170.5">300</text><text x="157" y="117.1">330</text></g>
          <path d="M230 240 285.2 184.8 230 226Zm0 0 55.2 55.2-41.2-55.2Zm0 0-55.2 55.2 55.2-41.2Zm0 0-55.2-55.2 41.2 55.2Z" fill="#BCD3E8" fill-opacity="0.55" />
          <path d="m230 240 55.2-55.2L244 240Zm0 0 55.2 55.2-41.2-55.2Zm0 0-55.2 55.2 41.2-55.2Zm0 0-55.2-55.2L230 226Z" fill="#1F2F5C" stroke="#BCD3E8" stroke-opacity="0.55" stroke-width="0.8" />
          <path d="M230 240V112l-14.1 113.9Zm0 0 128-0-113.9-14.1Zm0 0v128l14.1-113.9Zm0 0H102l113.9 14.1Z" fill="#F5EFE3" />
          <path d="M230 240V112l14.1 113.9Zm0 0 128 0-113.9 14.1Zm0 0V368l-14.1-113.9Zm0 0H102l113.9-14.1Z" fill="#1F2F5C" stroke="#F5EFE3" stroke-width="1" stroke-linejoin="round" />
          <g class="stay_compass-needle" data-angle="22" transform="rotate(0 230 240)">
            <path d="M230 240 289.9 91.7" fill="none" stroke="#E3B5AC" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="6 5" />
            <circle cx="230" cy="240" r="6" fill="#1F2F5C" stroke="#E3B5AC" stroke-width="1.6" />
          </g>
          <path class="stay_compass-heart" d="M302.7 71.1s-11-7-11-15c0-4.4 3.4-7 6.6-7 2.2 0 3.7 1.3 4.4 2.8.7-1.5 2.2-2.8 4.4-2.8 3.2 0 6.6 2.6 6.6 7 0 8-11 15-11 15Z" fill="#E3B5AC" />
          <g font-family="var(--mono-family)" font-size="13" letter-spacing="1.6" text-anchor="middle"><text x="230" y="40" fill="#F5EFE3">N</text><text x="230" y="450" fill="#BCD3E8">S</text><text x="432" y="244.5" fill="#BCD3E8">E</text><text x="28" y="244.5" fill="#BCD3E8">W</text></g>
          <g font-family="var(--mono-family)" font-size="11" letter-spacing="1.6"><text x="320.7" y="56.1" fill="#E3B5AC">WHITE BEACH</text><text x="320.7" y="72.1" fill="#BCD3E8">BEARING 022°</text></g>
        </svg>
      </div>
    </header>

    <div class="stay_directions" data-fade-in>
      <h2 class="stay_directions-title" data-fade-in-item>Getting there</h2>
      <ol class="stay_steps">
        {steps.map((step) => (
          <li class="stay_step" data-fade-in-item>
            <span class="stay_step-number" aria-hidden="true">{step.number}</span>
            <div class="stay_step-content">
              <h3>{step.title}</h3>
              <p>{step.body}</p>
              <span class="stay_step-detail">{step.detail}</span>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
  <div class="stay_scallop" aria-hidden="true"></div>
</section>

<style>
  @layer components {
    .stay_wrap { position: relative; overflow: clip; padding: var(--section-space-medium) var(--site-margin); background: var(--dark-900) var(--background-texture) center / 32rem repeat; color: var(--light-100); }
    .stay_layout { width: 100%; max-width: var(--max-width-main); margin-inline: auto; }
    .stay_header { display: flex; align-items: end; justify-content: space-between; gap: var(--space-5); min-height: 23.25rem; }
    .stay_intro { display: flex; max-width: 34.375rem; flex-direction: column; gap: var(--space-4); }
    .stay_title { --_trim-top: 0.5lh; --_trim-bottom: 0.5lh; margin: 0; color: var(--light-100); font: var(--secondary-regular) var(--h1) / var(--line-height-medium) var(--secondary-family); letter-spacing: var(--letter-spacing-tight); }
    .stay_description { --_trim-top: 0.5lh; --_trim-bottom: 0.5lh; max-width: 27.5rem; margin: 0; color: var(--brand-500); font: var(--primary-regular) 1.25rem / 1.6 var(--primary-family); }
    .stay_compass_wrap { flex: 0 1 28.75rem; width: min(28.75rem, 50%); }
    .stay_compass { display: block; width: 100%; height: auto; font-family: var(--mono-family); }
    .stay_compass-needle { transform-box: view-box; transform-origin: 230px 240px; }
    .stay_compass-heart { transform-box: fill-box; transform-origin: center; }
    .stay_compass-heart.is-pulsing { animation: stay-compass-heart-pulse 400ms ease-out; }
    .stay_directions { display: flex; flex-direction: column; gap: var(--space-5); padding-top: 3.5rem; }
    .stay_directions-title { --_trim-top: 0.5lh; --_trim-bottom: 0.5lh; margin: 0; color: var(--light-100); font: var(--secondary-regular) var(--h5) / 1.1 var(--secondary-family); }
    .stay_steps { position: relative; display: flex; margin: 0; padding: 0; gap: var(--space-6); list-style: none; }
    .stay_steps::before { position: absolute; top: 1.125rem; right: 2.25rem; left: 2.25rem; border-top: 0.09375rem dashed var(--brand-500); content: ""; }
    .stay_step { position: relative; display: flex; min-width: 0; flex: 1 1 0; flex-direction: column; gap: var(--space-3); }
    .stay_step-number { z-index: 1; display: grid; width: 2.25rem; height: 2.25rem; flex: 0 0 2.25rem; place-items: center; border: 0.09375rem solid var(--light-100); border-radius: 50%; background: var(--dark-900); color: var(--light-100); font: var(--primary-regular) 1rem / 1.25 var(--mono-family); }
    .stay_step-content { display: flex; flex-direction: column; gap: var(--space-3); }
    .stay_step h3 { --_trim-top: 0.5lh; --_trim-bottom: 0.5lh; margin: 0; color: var(--light-100); font: var(--secondary-regular) 1.5rem / 1.75rem var(--secondary-family); }
    .stay_step p { --_trim-top: 0.5lh; --_trim-bottom: 0.5lh; margin: 0; color: var(--brand-500); font: var(--primary-regular) var(--text-main) / 1.5 var(--primary-family); }
    .stay_step-detail { --_trim-top: 0.5lh; --_trim-bottom: 0.5lh; padding-top: var(--space-2); border-top: 0.0625rem solid color-mix(in srgb, var(--brand-500) 20%, var(--dark-900)); color: var(--light-100); font: var(--primary-regular) var(--eyebrow) / 1rem var(--mono-family); letter-spacing: 0.04em; text-transform: uppercase; }
    .stay_scallop { position: absolute; right: 0; bottom: 0; left: 0; height: 0.8125rem; background: linear-gradient(var(--light-100) 0 0) bottom / 100% 0.125rem no-repeat, radial-gradient(circle at 1.125rem 0.6875rem, var(--light-100) 0.6875rem, transparent calc(0.6875rem + 0.03125rem)) 0 0 / 2.25rem 0.6875rem repeat-x; }
  }

  @media (max-width: 61.999rem) {
    .stay_wrap { padding-top: var(--section-space-small); padding-bottom: var(--section-space-medium); }
    .stay_header { display: flex; min-height: 0; flex-direction: column; align-items: start; gap: var(--space-7); }
    .stay_intro { max-width: none; gap: var(--space-5); }
    .stay_title { font-size: min(var(--h1), calc((100vw - 2 * var(--site-margin)) / 5.6)); line-height: 0.94; letter-spacing: var(--letter-spacing-tighter); }
    .stay_description { max-width: none; font-size: var(--text-main); line-height: var(--line-height-huge); }
    .stay_compass_wrap { width: 21.875rem; max-width: 100%; flex: none; }
    .stay_directions { gap: var(--space-6); padding-top: var(--space-7); }
    .stay_steps { flex-direction: column; gap: var(--space-6); }
    .stay_steps::before { display: none; }
    .stay_step { flex: none; flex-direction: row; gap: var(--space-4); }
    .stay_step:not(:last-child)::after { position: absolute; top: 2.25rem; bottom: calc(var(--space-6) * -1); left: 1.125rem; border-left: 0.09375rem dashed var(--brand-500); content: ""; }
    .stay_step-content { min-width: 0; padding-top: var(--space-1); }
    .stay_step-detail { padding-top: var(--space-3); }
  }

  @keyframes stay-compass-heart-pulse {
    0%, 100% { transform: scale(1); }
    45% { transform: scale(1.14); }
  }

  @media (prefers-reduced-motion: reduce) {
    .stay_compass-needle { transform: rotate(0deg); }
    .stay_compass-heart.is-pulsing { animation: none; }
  }
</style>
