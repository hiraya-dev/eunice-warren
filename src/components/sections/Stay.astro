          <text x="2.259" y="238.518" font-size="12" letter-spacing="1.751" fill="#BCD3E8">PANAY</text>
          <text x="352.377" y="310.73" font-size="13" letter-spacing="1.751" fill="#F5EFE3">CAGBAN</text>
          <text x="321.552" y="204" font-size="12" letter-spacing="1.751" transform="translate(144 536) rotate(-90)" fill="#F5EFE3">WHITE BEACH</text>
        </svg>
