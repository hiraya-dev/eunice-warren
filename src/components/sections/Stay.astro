          <circle cx="466" cy="52" r="14" fill="none" stroke="#F5EFE3" stroke-width="1.2" />
          <path d="M466 40V64M459 52H473M466 40L462 46M466 40L470 46" fill="none" stroke="#F5EFE3" stroke-width="1.2" stroke-linecap="round" />
