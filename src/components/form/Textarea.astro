---
import type { HTMLAttributes } from "astro/types";
import { slug } from "@/utils/slug.ts";

interface Props extends Omit<HTMLAttributes<"textarea">, "rows"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Field label. */
  label?: string;
  /** Initial value. */
  value?: string;
  /** Submitted name. Defaults to the label slug. */
  name?: string;
  /** Empty-field hint. */
  placeholder?: string;
  /** Minimum visible lines. Defaults to `3`.
   *
   * @min 1
   * @int */
  minLines?: number;
  /** Maximum visible lines. Defaults to `12`.
   *
   * @min 1
   * @int */
  maxLines?: number;
  /** Require the field and mark its label. */
  required?: boolean;
  /** Visual treatment for the field. */
  appearance?: "default" | "postcard";
}

const {
  render = true,
  label,
  value,
  name,
  placeholder,
  minLines = 3,
  maxLines = 12,
  required = false,
  appearance = "default",
  class: className,
  ...rest
} = Astro.props;
---

{
  render && label && (
    <label
      class:list={[
        "field",
        "form-textarea",
        appearance !== "default" && appearance,
        className,
      ]}
      style={`--_min-lines: ${minLines}; --_max-lines: ${maxLines};`}
    >
      <span class="field-label text-style-main">
        <span>{label}</span>
        {required && (
          <span class="field-star" aria-hidden="true">
            *
          </span>
        )}
      </span>
      <textarea
        class="field-control form-textarea_field text-style-main"
        name={name ?? slug(label)}
        placeholder={placeholder}
        required={required || undefined}
        rows={minLines}
        {...rest}
      >
        {value}
      </textarea>
    </label>
  )
}

<style is:global>
  @layer components {
    .form-textarea_field {
      field-sizing: content;
      min-height: calc(
        var(--_min-lines, 3) * 1lh + var(--_field-pad-block) * 2 +
          var(--border-width) * 2
      );
      max-height: calc(
        var(--_max-lines, 12) * 1lh + var(--_field-pad-block) * 2 +
          var(--border-width) * 2
      );
      resize: vertical;
    }
    .form-textarea.postcard .field-label {
      display: inline-flex;
      align-self: flex-start;
      padding: 0.25rem 0.5rem;
      background: var(--brand-500);
      color: var(--dark-900);
      font-family: var(--mono-family);
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      line-height: 1;
      text-transform: uppercase;
    }
    .form-textarea.postcard .field-star {
      display: none;
    }
    .form-textarea.postcard .field-control {
      min-height: 4rem;
      padding: 0.5rem;
      border: 0.0625rem solid var(--light-300);
      border-radius: 0;
      background: transparent;
      color: var(--dark-900);
    }
  }
</style>
