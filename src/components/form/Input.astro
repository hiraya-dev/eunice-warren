---
import type { HTMLAttributes } from "astro/types";
import { slug } from "@/utils/slug.ts";

type InputVariant =
  | "text"
  | "first-name"
  | "last-name"
  | "email"
  | "phone"
  | "date"
  | "zip-code"
  | "number"
  | "search"
  | "password"
  | "url";

interface Props extends Omit<HTMLAttributes<"input">, "type"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Field label. Defaults to the variant name. */
  label?: string;
  /** Initial value. */
  value?: string;
  /** Input type and autofill preset. */
  variant?: InputVariant;
  /** Submitted name. Defaults to the label slug. */
  name?: string;
  /** Empty-field hint. Defaults to the variant name. */
  placeholder?: string;
  /** Require the field and mark its label. */
  required?: boolean;
  /** Visually hide the label. */
  labelHidden?: boolean;
  /** Visual treatment for the field. */
  appearance?: "default" | "postcard" | "postcard-search";
}

const {
  render = true,
  label,
  value,
  variant = "text",
  name,
  placeholder,
  required = false,
  labelHidden = false,
  appearance = "default",
  class: className,
  ...rest
} = Astro.props;

type InputAttrs = HTMLAttributes<"input">;

const KINDS: Record<
  InputVariant,
  {
    label: string;
    type: NonNullable<InputAttrs["type"]>;
    mode: NonNullable<InputAttrs["inputmode"]>;
    fill: NonNullable<InputAttrs["autocomplete"]>;
  }
> = {
  text: { label: "Text", type: "text", mode: "text", fill: "on" },
  "first-name": {
    label: "First Name",
    type: "text",
    mode: "text",
    fill: "given-name",
  },
  "last-name": {
    label: "Last Name",
    type: "text",
    mode: "text",
    fill: "family-name",
  },
  email: { label: "Email", type: "email", mode: "email", fill: "email" },
  phone: { label: "Phone", type: "tel", mode: "tel", fill: "tel" },
  date: { label: "Date", type: "date", mode: "text", fill: "bday" },
  "zip-code": {
    label: "Zip Code",
    type: "text",
    mode: "numeric",
    fill: "postal-code",
  },
  number: { label: "Number", type: "number", mode: "numeric", fill: "off" },
  search: { label: "Search", type: "search", mode: "search", fill: "off" },
  password: {
    label: "Password",
    type: "password",
    mode: "text",
    fill: "current-password",
  },
  url: { label: "URL", type: "url", mode: "url", fill: "url" },
};

const kind = KINDS[variant];
const text = label ?? kind.label;
---

{
  render && (
    <label
      class:list={[
        "field",
        "form-input",
        appearance !== "default" && appearance,
        className,
      ]}
    >
      <span
        class:list={["field-label text-style-main", labelHidden && "sr-only"]}
      >
        <span>{text}</span>
        {required && (
          <span class="field-star" aria-hidden="true">
            *
          </span>
        )}
      </span>
      {appearance === "postcard-search" && (
        <svg class="field-search-icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="M20 20l-3.5-3.5" />
        </svg>
      )}
      <input
        class="field-control text-style-main"
        type={kind.type}
        name={name ?? slug(text)}
        placeholder={placeholder ?? text}
        inputmode={kind.mode}
        autocomplete={kind.fill}
        required={required || undefined}
        value={value}
        {...rest}
      />
    </label>
  )
}

<style is:global>
  @layer components {
    .form-input.postcard .field-label,
    .form-input.postcard-search .field-label {
      display: inline-flex;
      align-self: flex-start;
      padding: 0.25rem 0.5rem;
      background: var(--brand-500);
      color: var(--dark-900);
      font-family: var(--mono-family);
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      line-height: 1;
      text-transform: uppercase;
    }
    .form-input.postcard .field-star,
    .form-input.postcard-search .field-star {
      display: none;
    }
    .form-input.postcard .field-control,
    .form-input.postcard-search .field-control {
      min-height: 2rem;
      padding: 0.25rem 0;
      border: 0;
      box-shadow: inset 0 -0.09375rem 0 var(--dark-900);
      border-radius: 0;
      background: transparent;
      color: var(--dark-900);
    }
    .form-input.postcard .field-control {
      max-width: 12.5rem;
    }
    .form-input.postcard-search {
      position: relative;
    }
    .form-input.postcard-search .field-control {
      min-height: 2.5rem;
      padding-left: 1.75rem;
      font-size: 1rem;
    }
    .form-input.postcard .field-control:focus,
    .form-input.postcard .field-control:focus-visible,
    .form-input.postcard-search .field-control:focus,
    .form-input.postcard-search .field-control:focus-visible {
      outline: none;
      box-shadow: inset 0 -0.1875rem 0 var(--dark-900);
    }
    .field-search-icon {
      position: absolute;
      bottom: 0.7rem;
      left: 0.25rem;
      width: 1rem;
      height: 1rem;
      fill: none;
      stroke: var(--dark-900);
      stroke-width: 2.2;
      stroke-linecap: round;
    }
  }
</style>
