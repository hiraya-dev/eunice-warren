---
import { Image } from "astro:assets";
import parAvion from "@/assets/images/preloader/par-avion.png";
import postmark from "@/assets/images/preloader/postmark-received.png";
import propPen from "@/assets/images/preloader/prop-pen.png";
import propRibbon from "@/assets/images/preloader/prop-ribbon.png";
import Stamp from "@/components/media/Stamp.astro";
import PassageTicket from "@/components/media/PassageTicket.astro";
import couple from "@/assets/images/hero/polaroid-couple.jpg";
import sunsetSail from "@/assets/images/hero/polaroid-sunset-sail.jpg";
import keepsake from "@/assets/images/entourage/keepsake-sampaguita.jpg";
import stampWe from "@/assets/images/stamps/we.jpg";
import stampPalm from "@/assets/images/stamps/palm.jpg";
import stampParaw from "@/assets/images/stamps/paraw.jpg";
import shell from "@/assets/images/explore/sticker-shell.svg";

interface Props {
  /** Message destination for guests who cannot find an invite. */
  messageHref?: string;
}

const { messageHref = "#" } = Astro.props;
---

<div
  class="preloader_wrap"
  data-preloader
  data-message-href={messageHref}
  role="dialog"
  aria-modal="true"
  aria-labelledby="preloader-title"
  aria-hidden="true"
  data-lenis-prevent
>
  <div class="preloader_layout">
    <div class="preloader_table" aria-hidden="true" data-preloader-table>
      <div class="preloader_prop preloader_ribbon" data-depth="1"><div class="preloader_float"><div class="preloader_body"><Image src={propRibbon} alt="" width={580} height={231} widths={[420, 580, 1160]} sizes="(max-width: 30rem) 420px, 580px" format="webp" loading="eager" fetchpriority="low" /></div></div></div>
      <div class="preloader_prop preloader_couple" data-depth="2"><div class="preloader_float"><div class="preloader_body preloader_polaroid"><Image src={couple} alt="" width={244} height={244} widths={[152, 244, 488]} sizes="(max-width: 30rem) 152px, 244px" loading="eager" fetchpriority="low" /></div></div></div>
      <div class="preloader_prop preloader_sunset" data-depth="2"><div class="preloader_float"><div class="preloader_body preloader_polaroid"><Image src={sunsetSail} alt="" width={226} height={226} widths={[142, 226, 452]} sizes="(max-width: 30rem) 142px, 226px" loading="eager" fetchpriority="low" /></div></div></div>
      <div class="preloader_prop preloader_keepsake" data-depth="3"><div class="preloader_float"><div class="preloader_body preloader_polaroid"><Image src={keepsake} alt="" width={148} height={148} widths={[148, 296]} sizes="148px" loading="eager" fetchpriority="low" /></div></div></div>
      <div class="preloader_prop preloader_ticket" data-depth="3"><div class="preloader_float"><div class="preloader_body"><PassageTicket loading="eager" fetchpriority="low" /></div></div></div>
      <div class="preloader_prop preloader_palm" data-depth="4"><div class="preloader_float"><div class="preloader_body"><Stamp><Image src={stampPalm} alt="" width={860} height={1110} widths={[104, 208]} sizes="104px" loading="eager" fetchpriority="low" /></Stamp></div></div></div>
      <div class="preloader_prop preloader_paraw" data-depth="4"><div class="preloader_float"><div class="preloader_body"><Stamp><Image src={stampParaw} alt="" width={860} height={1110} widths={[96, 192]} sizes="96px" loading="eager" fetchpriority="low" /></Stamp></div></div></div>
      <div class="preloader_prop preloader_shell" data-depth="5"><div class="preloader_float"><div class="preloader_body"><Image src={shell} alt="" width={78} height={78} loading="eager" fetchpriority="low" /></div></div></div>
      <div class="preloader_prop preloader_shell-small" data-depth="5"><div class="preloader_float"><div class="preloader_body"><Image src={shell} alt="" width={54} height={54} loading="eager" fetchpriority="low" /></div></div></div>
      <div class="preloader_prop preloader_pen" data-depth="5"><div class="preloader_float"><div class="preloader_body"><Image src={propPen} alt="" width={460} height={353} widths={[460, 920]} sizes="460px" format="webp" loading="eager" fetchpriority="low" /></div></div></div>
    </div>
    <p class="preloader_eyebrow">Warren &amp; Eunice · 01 · 14 · 2027</p>
    <h1 id="preloader-title" class="preloader_title">A letter is waiting for you.</h1>
    <form class="preloader_form" data-preloader-form novalidate>
      <div class="preloader_stage">
        <div class="preloader_envelope">
          <div class="preloader_face">
            <Image class="preloader_par-avion" src={parAvion} alt="" width={160} height={90} widths={[160, 320]} sizes="(max-width: 30rem) 104px, (max-width: 47rem) 190px, 160px" loading="eager" aria-hidden="true" />
            <div class="preloader_stamp-ew" aria-hidden="true"><Stamp><Image src={stampWe} alt="" width={860} height={1110} widths={[104, 208]} sizes="(max-width: 30rem) 64px, (max-width: 47rem) 117px, 104px" loading="eager" /></Stamp></div>
            <Image class="preloader_postmark" src={postmark} alt="" width={176} height={134} widths={[176, 352]} sizes="176px" loading="eager" aria-hidden="true" />
            <div class="preloader_address">
              <label for="preloader-name" data-preloader-label>To · Who's visiting?</label>
              <input id="preloader-name" name="name" autocomplete="name" required data-preloader-name />
              <p class="preloader_hint" data-preloader-hint>Write your name as it's on your invitation.</p>
              <p class="preloader_not-you" data-preloader-not-you hidden>
                Not you? <button type="button" data-preloader-reset>Write your own name</button>
              </p>
              <p class="preloader_message" data-preloader-message hidden>Still stuck? <a href={messageHref}>Message us</a></p>
            </div>
          </div>
        </div>
        <p class="preloader_hint preloader_hint-mobile" data-preloader-hint-mobile hidden></p>
        <button class="preloader_primary" type="submit" data-preloader-submit>
          <span data-preloader-submit-label>Open my letter →</span>
        </button>
      </div>
      <p class="preloader_admits" data-preloader-admits hidden>Your invitation admits <span></span>.</p>
      <button class="preloader_browse" type="button" data-preloader-browse>Just browsing →</button>
      <div class="preloader_turnstile" data-preloader-turnstile></div>
    </form>
  </div>
</div>

<script>
  import { actions } from "astro:actions";
  import { createTurnstileController, isFakeTurnstileMode } from "@/scripts/turnstile";
  import { setGuest } from "@/lib/guest";
  import { lenis } from "@/scripts/scroll.ts";

  const initPreloader = () => {
    const overlay = document.querySelector<HTMLElement>("[data-preloader]");
    if (!overlay || overlay.dataset.ready === "true") return;
    overlay.dataset.ready = "true";
    if (!document.documentElement.classList.contains("ew-preloader-pending")) {
      overlay.remove();
      return;
    }

    const form = overlay.querySelector<HTMLFormElement>("[data-preloader-form]")!;
    const input = overlay.querySelector<HTMLInputElement>("[data-preloader-name]")!;
    const title = overlay.querySelector<HTMLElement>("#preloader-title")!;
    const hint = overlay.querySelector<HTMLElement>("[data-preloader-hint]")!;
    const mobileHint = overlay.querySelector<HTMLElement>("[data-preloader-hint-mobile]")!;
    const submit = overlay.querySelector<HTMLButtonElement>("[data-preloader-submit]")!;
    const submitLabel = overlay.querySelector<HTMLElement>("[data-preloader-submit-label]")!;
    const admits = overlay.querySelector<HTMLElement>("[data-preloader-admits]")!;
    const notYou = overlay.querySelector<HTMLElement>("[data-preloader-not-you]")!;
    const message = overlay.querySelector<HTMLElement>("[data-preloader-message]")!;
    const browse = overlay.querySelector<HTMLButtonElement>("[data-preloader-browse]")!;
    const label = overlay.querySelector<HTMLElement>("[data-preloader-label]")!;
    const main = document.querySelector<HTMLElement>("main");
    const previousFocus = document.activeElement as HTMLElement | null;
    const turnstile = createTurnstileController(isFakeTurnstileMode(import.meta.env.PUBLIC_RSVP_STORE, import.meta.env.DEV));
    let state: "ask" | "found" | "not-found" | "suggest" = "ask";
    let suggestion = "";
    let closing = false;
    const stopLenis = () => lenis?.stop();

    document.body.classList.add("preloader-open");
    mobileHint.hidden = false;
    mobileHint.textContent = hint.textContent;
    document.querySelectorAll<HTMLElement>("body > *:not([data-preloader])").forEach((element) => { element.inert = true; });
    overlay.setAttribute("aria-hidden", "false");
    document.addEventListener("ew:lenis-ready", stopLenis);
    stopLenis();
    requestAnimationFrame(stopLenis);
    requestAnimationFrame(() => input.focus());

    const resetButton = overlay.querySelector<HTMLButtonElement>("[data-preloader-reset]")!;
    const setAskState = (clearInput = true) => {
      state = "ask";
      suggestion = "";
      title.textContent = "A letter is waiting for you.";
      label.textContent = "To · Who's visiting?";
      if (clearInput) input.value = "";
      input.readOnly = false;
      input.classList.remove("is-found");
      input.removeAttribute("aria-invalid");
      input.removeAttribute("aria-describedby");
      hint.textContent = "Write your name as it's on your invitation.";
      mobileHint.textContent = hint.textContent;
      hint.classList.remove("is-error");
      mobileHint.classList.remove("is-error");
      notYou.hidden = true;
      resetButton.textContent = "Write your own name";
      message.hidden = true;
      admits.hidden = true;
      submitLabel.textContent = "Open my letter →";
      submit.disabled = false;
      input.focus();
    };
    const close = () => {
      if (closing) return;
      if (state !== "found") setGuest({ skipped: true, at: new Date().toISOString() });
      finishClose();
    };
    const finishClose = () => {
      if (closing) return;
      closing = true;
      lenis?.start();
      document.removeEventListener("ew:lenis-ready", stopLenis);
      overlay.classList.add("is-closing");
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.setTimeout(() => {
        document.removeEventListener("keydown", onKeydown);
        overlay.remove();
        document.documentElement.classList.remove("ew-preloader-pending");
        document.body.classList.remove("preloader-open");
        document.querySelectorAll<HTMLElement>("body > *").forEach((element) => { element.inert = false; });
        (main ?? previousFocus)?.focus();
      }, reduced ? 160 : 700);
    };
    const focusables = () => [...overlay.querySelectorAll<HTMLElement>("button, input, a[href]")].filter((element) => !element.hidden && !element.hasAttribute("disabled"));
    const onKeydown = (event: KeyboardEvent) => {
      if (event.key === "Escape") { event.preventDefault(); close(); return; }
      if (event.key !== "Tab") return;
      const items = focusables();
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    };
    document.addEventListener("keydown", onKeydown);
    browse.addEventListener("click", close);
    resetButton.addEventListener("click", () => setAskState());
    input.addEventListener("input", () => {
      if (state === "suggest") setAskState(false);
    });
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (state === "found") { finishClose(); return; }
      if (!input.value.trim()) { input.focus(); return; }
      submit.disabled = true;
      submit.setAttribute("aria-busy", "true");
      const submittedValue = input.value;
      try {
        const result = await actions.rsvp.find({
          name: state === "suggest" ? suggestion : input.value,
          turnstileToken: await turnstile.getToken(overlay.querySelector<HTMLElement>("[data-preloader-turnstile]")!),
        });
        if (input.value !== submittedValue) return;
        if (result.error || !result.data) throw new Error(result.error?.message || "Something went wrong. Please try again.");
        if (!result.data.invite) {
          if (result.data.suggestion) {
            state = "suggest";
            suggestion = result.data.suggestion;
            title.textContent = `Did you mean ${suggestion}?`;
            hint.textContent = "Tap yes if that's the name on your invitation.";
            mobileHint.textContent = hint.textContent;
            hint.classList.remove("is-error");
            mobileHint.classList.remove("is-error");
            notYou.hidden = false;
            resetButton.textContent = "No, let me try again";
            message.hidden = true;
            submitLabel.textContent = "Yes, that's me →";
            input.removeAttribute("aria-invalid");
            submit.disabled = false;
            return;
          }
          suggestion = "";
          state = "not-found";
          title.textContent = "Hmm, we can't find that name.";
          hint.textContent = "Check the spelling, or try the name on your invitation.";
          mobileHint.textContent = hint.textContent;
          hint.classList.add("is-error");
          mobileHint.classList.add("is-error");
          message.hidden = false;
          submitLabel.textContent = "Try again →";
          input.setAttribute("aria-invalid", "true");
          submit.disabled = false;
          return;
        }
        state = "found";
        const guest = { name: result.data.matchedName, householdName: result.data.invite.householdName, seats: result.data.invite.seats, at: new Date().toISOString() };
        setGuest(guest);
        title.textContent = `Welcome, ${guest.householdName}.`;
        label.textContent = "To";
        input.value = guest.householdName;
        input.readOnly = true;
        input.classList.add("is-found");
        hint.textContent = "";
        mobileHint.textContent = "";
        hint.classList.remove("is-error");
        mobileHint.classList.remove("is-error");
        notYou.hidden = false;
        message.hidden = true;
        admits.querySelector("span")!.textContent = String(guest.seats);
        admits.hidden = false;
        submitLabel.textContent = "Open my letter →";
        submit.disabled = false;
        document.dispatchEvent(new CustomEvent("ew:guest", { detail: guest }));
      } catch (error) {
        suggestion = "";
        state = "not-found";
        hint.textContent = error instanceof Error && error.message ? error.message : "Something went wrong. Please try again.";
        mobileHint.textContent = hint.textContent;
        hint.classList.add("is-error");
        mobileHint.classList.add("is-error");
        input.setAttribute("aria-invalid", "true");
        submitLabel.textContent = "Try again →";
        submit.disabled = false;
      } finally {
        submit.disabled = false;
        submit.removeAttribute("aria-busy");
        turnstile.reset();
      }
    });
  };
  initPreloader();
  document.addEventListener("astro:page-load", initPreloader);
</script>

<script is:inline>
  if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    const overlay = document.querySelector("[data-preloader]");
    overlay?.setAttribute("data-preloader-motion", "");
    // Fail-safe: if the motion module is slow or never runs, show the form and props without motion.
    window.setTimeout(() => overlay?.removeAttribute("data-preloader-motion"), 2000);
  }
</script>

<script>
  import { gsap } from "gsap";

  /** Flat-lay motion: props settle in, drift with a fine pointer, and the close is CSS (`.is-closing`). */
  const initTable = () => {
    const overlay = document.querySelector<HTMLElement>("[data-preloader]");
    const table = overlay?.querySelector<HTMLElement>("[data-preloader-table]");
    if (!overlay || !table || table.dataset.tableReady === "true") return;
    if (!document.documentElement.classList.contains("ew-preloader-pending")) return;
    table.dataset.tableReady = "true";
    const stage = overlay.querySelector<HTMLElement>(".preloader_stage");
    // Lower depths first; equal depths keep their paint order.
    const floats = [...table.querySelectorAll<HTMLElement>("[data-depth]")]
      .map((prop, index) => ({ prop, index, depth: Number(prop.dataset.depth) }))
      .sort((a, b) => a.depth - b.depth || a.index - b.index)
      .map(({ prop }) => prop.querySelector<HTMLElement>(".preloader_float")!);
    const visible = () => floats.filter((float) => float.getClientRects().length > 0);
    const media = gsap.matchMedia();
    let settled = false;
    let stopPointer = () => {};

    media.add("(prefers-reduced-motion: no-preference)", () => {
      // The fail-safe already revealed everything: skip the entrance so nothing hides and replays.
      if (!overlay.hasAttribute("data-preloader-motion")) { settled = true; return; }
      const props = visible();
      const timeline = gsap.timeline({
        onComplete: () => { settled = true; },
      });
      if (stage) timeline.fromTo(stage, { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6, ease: "power3.out", clearProps: "opacity,transform" });
      timeline.fromTo(
        props,
        { autoAlpha: 0, y: -24, scale: 1.06, rotation: (index: number) => (index % 2 ? 4 : -4) },
        { autoAlpha: 1, y: 0, scale: 1, rotation: 0, duration: 0.9, stagger: 0.07, ease: "power3.out", clearProps: "visibility,opacity,transform" },
        stage ? "<0.1" : 0,
      );
      // The tweens have rendered their hidden start state inline, so the CSS pre-paint gate can go.
      overlay.removeAttribute("data-preloader-motion");
      return () => timeline.kill();
    });

    media.add("(prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine)", () => {
      let frame = 0;
      let nx = 0;
      let ny = 0;
      let movers: { x: (value: number) => void; y: (value: number) => void; depth: number }[] | null = null;
      const apply = () => {
        frame = 0;
        if (!settled) return;
        movers ??= floats.map((float) => ({
          depth: Number(float.parentElement!.dataset.depth),
          x: gsap.quickTo(float, "x", { duration: 0.6, ease: "power3.out" }),
          y: gsap.quickTo(float, "y", { duration: 0.6, ease: "power3.out" }),
        }));
        for (const mover of movers) {
          mover.x(nx * mover.depth * 4);
          mover.y(ny * mover.depth * 4);
        }
      };
      const onMove = (event: PointerEvent) => {
        nx = (event.clientX / window.innerWidth) * 2 - 1;
        ny = (event.clientY / window.innerHeight) * 2 - 1;
        if (!frame) frame = requestAnimationFrame(apply);
      };
      const stop = () => {
        window.removeEventListener("pointermove", onMove);
        cancelAnimationFrame(frame);
        frame = 0;
      };
      stopPointer = stop;
      window.addEventListener("pointermove", onMove, { passive: true });
      return stop;
    });

    // Stop listening as soon as the close starts; the exit itself is CSS.
    const closing = new MutationObserver(() => {
      if (overlay.classList.contains("is-closing")) { stopPointer(); closing.disconnect(); }
    });
    closing.observe(overlay, { attributes: true, attributeFilter: ["class"] });

    document.addEventListener("astro:before-swap", () => {
      closing.disconnect();
      media.revert();
      delete table.dataset.tableReady;
    }, { once: true });
  };

  initTable();
  document.addEventListener("astro:page-load", initTable);
</script>

<style is:global>
  @layer components {
    body.preloader-open { overflow: hidden; }
    .preloader_wrap { position: fixed; z-index: 100; inset: 0; display: none; overflow-x: clip; overflow-y: auto; background-color: #ede4d3; background-image: radial-gradient(ellipse 70% 65% at 42% 38%, rgb(255 250 240 / 55%) 0%, transparent 60%), radial-gradient(ellipse 120% 100% at 50% 50%, transparent 55%, rgb(31 47 92 / 10%) 100%), url("../../assets/textures/grain-light.jpg"); background-position: 0 0, 0 0, center; background-size: auto, auto, 32rem; background-repeat: no-repeat, no-repeat, repeat; background-blend-mode: normal, normal, multiply; color: var(--dark-900); opacity: 1; }
    html.ew-preloader-pending .preloader_wrap { display: block; }
    .preloader_wrap [hidden] { display: none !important; }
    .preloader_layout { position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(0, 1fr); min-height: 100%; align-content: center; justify-items: center; gap: 2.5rem; padding: 3rem var(--site-gutter); box-sizing: border-box; }
    .preloader_eyebrow { margin: 0; color: var(--dark-700); font: var(--eyebrow) / 0.875rem var(--mono-family); letter-spacing: var(--letter-spacing-wider); text-align: center; text-transform: uppercase; }
    .preloader_title { max-width: 100%; margin: -1.625rem 0 0; font: var(--secondary-ultralight) 2.75rem / 3rem var(--secondary-family); font-style: italic; letter-spacing: var(--letter-spacing-snug); text-align: center; }
    .preloader_form { container: preloader-form / inline-size; display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; gap: 1.25rem; width: 100%; }
    .preloader_stage { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); width: min(45rem, 100%); }
    .preloader_envelope { width: 100%; aspect-ratio: 12 / 7; padding: .75rem; box-sizing: border-box; transform: rotate(-1.5deg); background: repeating-linear-gradient(135deg, var(--accent-500) 0 1rem, var(--light-200) 1rem 1.625rem, var(--dark-900) 1.625rem 2.625rem, var(--light-200) 2.625rem 3.25rem); box-shadow: .875rem 1.625rem 2.75rem rgb(31 47 92 / 24%), .125rem .25rem .375rem rgb(31 47 92 / 10%); }
    .preloader_face { position: relative; display: flex; height: 100%; align-items: flex-end; padding: 3rem 3.5rem; box-sizing: border-box; background: var(--light-200) url("../../assets/textures/postcard-paper.jpg") center / 32rem repeat; }
    .preloader_par-avion { position: absolute; top: 3rem; left: 3.5rem; width: 10rem; height: auto; mix-blend-mode: multiply; transform: rotate(-4deg); }
    .preloader_stamp-ew { position: absolute; top: 2.25rem; right: 2.75rem; width: 6.5rem; height: auto; transform: rotate(4deg); }
    .preloader_postmark { position: absolute; top: 3.75rem; right: 6.5rem; width: 11rem; height: auto; mix-blend-mode: multiply; transform: rotate(-8deg); }
    .preloader_address { display: grid; gap: .875rem; width: 25rem; max-width: 100%; }
    .preloader_address label { color: var(--dark-700); font: var(--eyebrow) / .875rem var(--mono-family); letter-spacing: var(--letter-spacing-wider); text-transform: uppercase; }
    .preloader_address input { width: 100%; padding: 0 0 .375rem; border: 0; border-bottom: .09375rem solid var(--dark-900); border-radius: 0; outline: 0; background: transparent; color: var(--dark-900); caret-color: var(--accent-500); font: var(--secondary-ultralight) 2.5rem / 2.75rem var(--hand-family); }
    .preloader_address input.is-found { border-color: #b9b2a3; caret-color: transparent; }
    .preloader_hint, .preloader_message, .preloader_not-you { margin: 0; color: var(--dark-700); font: .875rem / 1.25rem var(--primary-family); }
    .preloader_hint-mobile { display: none; }
    .preloader_hint.is-error { color: var(--accent-500); }
    .preloader_message a, .preloader_not-you button { padding: 0; border: 0; border-bottom: .0625rem solid currentColor; background: none; color: var(--dark-900); cursor: pointer; font: inherit; }
    .preloader_primary { position: absolute; right: 3.75rem; bottom: 6rem; transform: rotate(-1.5deg); padding: .8125rem 1.5rem; border: 0; border-radius: var(--radius-round); background: var(--accent-500); color: var(--light-200); cursor: pointer; font: var(--primary-regular) 1rem / 1.25rem var(--primary-family); }
    .preloader_primary:disabled { opacity: .6; cursor: wait; }
    .preloader_browse { padding: 0 0 .25rem; border: 0; border-bottom: .0625rem solid var(--dark-900); background: none; color: var(--dark-900); cursor: pointer; font: var(--eyebrow) / 1rem var(--mono-family); letter-spacing: var(--letter-spacing-wider); text-transform: uppercase; }
    .preloader_admits { margin: 0; font: .875rem / 1.25rem var(--primary-family); }
    .preloader_turnstile { min-height: 0; }
    .preloader_turnstile:has(iframe) { min-height: 4.0625rem; }
