---
import { Image } from "astro:assets";
import Button from "@/components/Button.astro";
import Stamp from "@/components/media/Stamp.astro";
import disc from "@/assets/images/now-playing-disc.png";
import palm from "@/assets/images/stamps/palm.jpg";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page. */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;
const links = [
  ["The wedding", "/#the-wedding"],
  ["Stay", "/#stay"],
  ["Explore", "/#explore"],
  ["Playlist", "/#playlist"],
  ["FAQ", "/#faq"],
] as const;
---

{render && (
  <>
    <header class:list={["nav_wrap", overlap && "overlap"]} data-navigation-status="not-active">
      <div class="nav_inner">
        <a class="nav_logo" href="/" aria-label={SITE_NAME}>E &amp; W</a>
        <div class="nav_actions">
          <div class="nav_now-playing" aria-hidden="true">
            <Image src={disc} alt="" width={144} height={144} />
            <span class="nav_now-playing_text">
              <span class="nav_now-playing_label">NOW PLAYING</span>
              <span class="nav_now-playing_title">Dancing Queen · ABBA</span>
            </span>
            <svg class="nav_now-playing_pause" viewBox="0 0 10 12" aria-hidden="true">
              <rect width="3" height="12" x="0" fill="currentColor" />
              <rect width="3" height="12" x="7" fill="currentColor" />
            </svg>
          </div>
          <Button class="nav_rsvp" element="link" href="/#rsvp" shape="pill">RSVP</Button>
          <button type="button" data-navigation-toggle="toggle" class="nav_toggle" aria-expanded="false" aria-controls="site-navigation-panel" aria-label="Open menu">
            <span class="nav_toggle-label"><span class="nav_toggle-menu">MENU</span><span class="nav_toggle-close">CLOSE</span></span>
            <span class="nav_toggle-button" aria-hidden="true"><span class="nav_toggle-bar"></span><span class="nav_toggle-bar"></span></span>
          </button>
        </div>
      </div>
    </header>

    <nav id="site-navigation-panel" data-navigation-status="not-active" data-navigation-toggle="close" data-lenis-prevent class="navigation theme-dark" aria-label="Main" aria-hidden="true">
      <div class="navigation_inner">
        <ul class="navigation_links">
          {links.map(([label, href], index) => (
            <li class="navigation_item">
              <a href={href} class="navigation_link">
                <span class="navigation_number">{String(index + 1).padStart(2, "0")}</span>
                <span class="navigation_label"><span class="navigation_label-text">{label}</span></span>
              </a>
            </li>
          ))}
        </ul>
        <div class="navigation_bottom">
          <div class="navigation_now-playing">
            <Image src={disc} alt="" width={144} height={144} aria-hidden="true" />
            <span class="navigation_now-playing_text"><span class="navigation_now-playing_label">NOW PLAYING</span><span class="navigation_now-playing_title">Dancing Queen · ABBA</span></span>
            <svg class="navigation_now-playing_pause" viewBox="0 0 10 12" aria-hidden="true"><rect width="3" height="12" x="0" fill="currentColor" /><rect width="3" height="12" x="7" fill="currentColor" /></svg>
          </div>
          <Button class="navigation_rsvp" element="link" href="/#rsvp" shape="pill">RSVP by December</Button>
          <div class="navigation_meta"><span>01 · 14 · 2027</span><span class="navigation_location">BORACAY, <span class="navigation_location-full">PHILIPPINES</span><span class="navigation_location-short">PH</span></span></div>
          <div class="navigation_palm"><Stamp><Image src={palm} alt="" width={90} height={116} densities={[1, 2]} aria-hidden="true" /></Stamp></div>
        </div>
      </div>
    </nav>
  </>
)}

<!-- Without JavaScript the menu can't open, so render the panel in normal flow below the bar
     (not as a fixed overlay, which would cover the page) and hide the toggle. -->
<noscript><style>
  .nav_toggle { display: none; }
  .navigation { position: static; visibility: visible; pointer-events: auto; clip-path: none; overflow: visible; }
  .navigation_inner { min-height: 0; padding-top: 0; }
  .navigation_link { transform: none; }
  .navigation_palm { opacity: 1; }
</style></noscript>

<script>
  import { lenis } from "@/scripts/scroll.ts";

  const initNavigation = () => {
    const navigation = document.querySelector<HTMLElement>("#site-navigation-panel");
    const header = document.querySelector<HTMLElement>(".nav_wrap");
    const toggle = document.querySelector<HTMLButtonElement>('[data-navigation-toggle="toggle"]');
    const links = navigation ? Array.from(navigation.querySelectorAll<HTMLAnchorElement>(".navigation_link, .navigation_rsvp")) : [];
    if (!navigation || !header || !toggle || navigation.dataset.navigationInitialized === "true") return;
    navigation.dataset.navigationInitialized = "true";
    let previousOverflow = "";
    let previousBodyPaddingRight = "";
    let previousScrollbarCompensation = "";
    let previousBackgroundPosition = "";
    let unlockTimer: number | undefined;
    let lockActive = false;
    const unlockScroll = () => {
      if (!lockActive) return;
      if (unlockTimer !== undefined) window.clearTimeout(unlockTimer);
      unlockTimer = undefined;
      document.documentElement.style.overflow = previousOverflow;
      if (previousScrollbarCompensation) document.documentElement.style.setProperty("--scrollbar-compensation", previousScrollbarCompensation);
      else document.documentElement.style.removeProperty("--scrollbar-compensation");
      document.body.style.paddingRight = previousBodyPaddingRight;
      document.documentElement.style.backgroundPosition = previousBackgroundPosition;
      lenis?.start();
      lockActive = false;
    };
    navigation.addEventListener("transitionend", (event) => {
      if (event.target === navigation && event instanceof TransitionEvent && event.propertyName === "clip-path" && navigation.dataset.navigationStatus === "not-active") unlockScroll();
    });
    const setOpen = (open: boolean, returnFocus = true) => {
      if (open && unlockTimer !== undefined) {
        window.clearTimeout(unlockTimer);
        unlockTimer = undefined;
      }
      navigation.dataset.navigationStatus = open ? "active" : "not-active";
      header.dataset.navigationStatus = open ? "active" : "not-active";
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      navigation.setAttribute("aria-hidden", String(!open));
      if (open) {
        if (!lockActive) {
          previousOverflow = document.documentElement.style.overflow;
          previousBodyPaddingRight = document.body.style.paddingRight;
          previousScrollbarCompensation = document.documentElement.style.getPropertyValue("--scrollbar-compensation");
          const scrollbar = window.innerWidth - document.documentElement.clientWidth;
          document.documentElement.style.overflow = "hidden";
          document.documentElement.style.setProperty("--scrollbar-compensation", `${scrollbar}px`);
          document.body.style.paddingRight = "var(--scrollbar-compensation, 0px)";
          // The page texture is centred on the root, which widens by the scrollbar's width when
          // the scrollbar goes away; pull it back by half that so the grain doesn't jump.
          previousBackgroundPosition = document.documentElement.style.backgroundPosition;
          document.documentElement.style.backgroundPosition = `calc(50% - ${scrollbar / 2}px) 50%`;
          lockActive = true;
        }
        lenis?.stop();
        // The panel can still compute as `visibility: hidden` on the first frame (the global
        // reduced-motion rule turns its visibility switch into a tiny transition), so retry
        // until the first link actually takes focus.
        const firstLink = links.find((link) => link.classList.contains("navigation_link"));
        let attempts = 0;
        const focusFirstLink = () => {
          if (!firstLink || navigation.dataset.navigationStatus !== "active") return;
          firstLink.focus({ preventScroll: true });
          if (document.activeElement !== firstLink && ++attempts < 30) requestAnimationFrame(focusFirstLink);
        };
        requestAnimationFrame(focusFirstLink);
      } else {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) unlockScroll();
        else unlockTimer = window.setTimeout(unlockScroll, 1100);
        if (returnFocus) toggle.focus();
      }
    };
    toggle.addEventListener("click", () => setOpen(navigation.dataset.navigationStatus !== "active"));
    navigation.addEventListener("click", (event) => { if (event.target === navigation) setOpen(false); });
    links.forEach((link) => link.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (event) => {
      if (navigation.dataset.navigationStatus !== "active") return;
      if (event.key === "Escape") { event.preventDefault(); setOpen(false); return; }
      if (event.key !== "Tab") return;
      const isVisible = (element: HTMLElement | null): element is HTMLButtonElement | HTMLAnchorElement =>
        Boolean(element && element.getClientRects().length && getComputedStyle(element).visibility !== "hidden" && getComputedStyle(element).display !== "none");
      const panelLinks = links.filter((link) => link.classList.contains("navigation_link"));
      const panelActions = links.filter((link) => !link.classList.contains("navigation_link"));
      const focusables = [toggle, ...panelLinks, ...panelActions, document.querySelector<HTMLAnchorElement>(".nav_rsvp")]
        .filter((element): element is HTMLButtonElement | HTMLAnchorElement =>
          isVisible(element),
        );
      const currentIndex = focusables.indexOf(document.activeElement as HTMLButtonElement | HTMLAnchorElement);
      const nextIndex = event.shiftKey ? (currentIndex <= 0 ? focusables.length - 1 : currentIndex - 1) : (currentIndex === focusables.length - 1 ? 0 : currentIndex + 1);
      event.preventDefault();
      focusables[nextIndex].focus();
    });
  };
  if (!document.documentElement.dataset.navigationInitialized) { document.documentElement.dataset.navigationInitialized = "true"; initNavigation(); }
</script>

<style is:global>
  @layer components {
    .nav_wrap { position: sticky; top: 0; z-index: 100; display: flex; justify-content: center; padding: var(--space-2) var(--site-margin) var(--space-3); background-color: var(--background); background-image: var(--background-texture); background-position: 50%; background-repeat: repeat; background-size: 32rem 32rem; color: var(--text); border-bottom: var(--border-width) solid var(--border); transition: background-color 0s linear 0.6s, background-image 0s linear 0.6s, border-color 0s linear 0.6s, color 0.1s var(--open-ease) 0.6s; transition-behavior: allow-discrete; &.overlap { position: fixed; inset-inline: 0; padding-right: calc(var(--site-margin) + var(--scrollbar-compensation, 0px)); } }
    .nav_wrap::after { position: absolute; right: 0; bottom: 0; left: 0; height: var(--border-width); background: var(--dark-800); opacity: 0; content: ""; pointer-events: none; transition: opacity 0.1s var(--open-ease) 0.6s; }
    .nav_inner { width: 100%; max-width: var(--max-width-main); display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); }
    .nav_logo { flex: 0 0 auto; color: var(--text); font-family: var(--secondary-family); font-size: 1.375rem; font-weight: var(--secondary-regular); line-height: 1.2; text-decoration: none; transition: color 0.1s var(--open-ease) 0.6s; }
    .nav_actions { flex: 0 0 auto; display: flex; align-items: center; gap: var(--space-4); }
    .nav_now-playing { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-2) var(--space-3) var(--space-2) var(--space-2); background: var(--background-2); border: var(--border-width) solid var(--border); border-radius: var(--radius-round); transition: opacity var(--open-duration) var(--open-ease) 0.6s, visibility 0s linear 0.6s; }
    .nav_now-playing > img { width: 1.875rem; height: 1.875rem; border-radius: 50%; }
    .nav_now-playing_text { display: flex; flex-direction: column; gap: 0.125rem; }
    .nav_now-playing_label { color: var(--accent-500); font-family: var(--mono-family); font-size: var(--eyebrow); letter-spacing: var(--letter-spacing-wider); line-height: 1; text-transform: uppercase; }
    .nav_now-playing_title { color: var(--text); font-family: var(--primary-family); font-size: 0.75rem; font-weight: var(--primary-medium); line-height: 1; }
    .nav_now-playing_pause { flex: 0 0 auto; width: 0.625rem; height: 0.75rem; margin-left: 0.25rem; }
    .nav_rsvp { transition: opacity var(--open-duration) var(--open-ease) 0.6s, visibility 0s linear 0.6s; }
    .nav_toggle { display: inline-flex; align-items: center; gap: var(--space-3); padding: 0; color: var(--text); cursor: pointer; background: none; border: 0; transition: color 0.1s var(--open-ease) 0.6s; }
    .nav_toggle-label { color: currentColor; font-family: var(--mono-family); font-size: var(--eyebrow); letter-spacing: var(--letter-spacing-wider); line-height: 1; transition: color 0.1s var(--open-ease) 0.6s; }
    .nav_toggle-close { display: none; }
    .nav_toggle-button { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 2.5rem; height: 2.5rem; border: var(--border-width) solid currentColor; border-radius: 50%; }
    .nav_toggle-bar { position: absolute; width: 0.875rem; height: 0.09375rem; background: currentColor; border-radius: var(--radius-round); transition: transform 0.5s cubic-bezier(.7, 0, .3, 1); }
    .nav_toggle-bar:first-child { transform: rotate(0.001deg) translateY(-0.1875rem); }
    .nav_toggle-bar:last-child { transform: rotate(0.001deg) translateY(0.1875rem); }
    .nav_wrap[data-navigation-status="active"] { color: var(--light-100); background-color: transparent; background-image: none; border-color: transparent; transition: background-color 0s linear 0s, background-image 0s linear 0s, color 0.1s var(--open-ease) 0.3s; }
    .nav_wrap[data-navigation-status="active"]::after { opacity: 1; transition-delay: 0.3s; }
    .nav_wrap[data-navigation-status="active"] .nav_logo { color: var(--light-100); transition-delay: 0.3s; }
    .nav_wrap[data-navigation-status="active"] .nav_toggle-label { color: var(--brand-500); transition-delay: 0.3s; }
    .nav_wrap[data-navigation-status="active"] .nav_toggle-menu { display: none; }
    .nav_wrap[data-navigation-status="active"] .nav_toggle-close { display: inline; }
    .nav_wrap[data-navigation-status="active"] .nav_toggle-button { color: var(--light-100); transition-delay: 0.3s; }
    .nav_wrap[data-navigation-status="active"] .nav_now-playing { opacity: 0; visibility: hidden; transition-delay: 0.3s; }
    [data-navigation-status="active"] .nav_toggle-bar:first-child { transform: rotate(45deg); }
    [data-navigation-status="active"] .nav_toggle-bar:last-child { transform: rotate(-45deg); }
    .navigation { position: fixed; z-index: 90; inset: 0; display: flex; overflow-y: auto; overscroll-behavior: contain; visibility: hidden; pointer-events: none; clip-path: polygon(0 0, 100% 0, 100% 0, 0 0); transition: clip-path 1s cubic-bezier(.9, 0, .1, 1), visibility 0s linear 1s; }
    .navigation[data-navigation-status="active"] { visibility: visible; pointer-events: auto; clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%); transition: clip-path 1s cubic-bezier(.9, 0, .1, 1), visibility 0s linear 0s; }
    .navigation_inner { position: relative; display: flex; flex: 1; flex-direction: column; box-sizing: border-box; min-height: 100%; padding: var(--nav-height) var(--site-margin) 0; }
    .navigation_links { display: flex; flex-direction: column; margin: var(--space-2) 0 0; padding: 0; list-style: none; }
    .navigation_item { overflow: clip; border-bottom: var(--border-width) solid var(--dark-800); }
    .navigation_link { display: flex; align-items: baseline; gap: var(--space-3); padding: var(--space-3) 0; color: var(--light-100); transform: translateY(100%) rotate(5deg); transition: transform 0.75s cubic-bezier(.7, 0, .3, 1); }
    .navigation[data-navigation-status="active"] .navigation_link { transform: translateY(0) rotate(.001deg); }
    .navigation_item:nth-child(1) .navigation_link { transition-delay: 0.5s; }
    .navigation_item:nth-child(2) .navigation_link { transition-delay: 0.45s; }
    .navigation_item:nth-child(3) .navigation_link { transition-delay: 0.4s; }
    .navigation_item:nth-child(4) .navigation_link { transition-delay: 0.35s; }
    .navigation_item:nth-child(5) .navigation_link { transition-delay: 0.3s; }
    .navigation[data-navigation-status="active"] .navigation_item:nth-child(1) .navigation_link { transition-delay: 0.3s; }
    .navigation[data-navigation-status="active"] .navigation_item:nth-child(2) .navigation_link { transition-delay: 0.35s; }
    .navigation[data-navigation-status="active"] .navigation_item:nth-child(3) .navigation_link { transition-delay: 0.4s; }
    .navigation[data-navigation-status="active"] .navigation_item:nth-child(4) .navigation_link { transition-delay: 0.45s; }
    .navigation[data-navigation-status="active"] .navigation_item:nth-child(5) .navigation_link { transition-delay: 0.5s; }
    .navigation_number { flex: 0 0 1.75rem; color: var(--brand-500); font-family: var(--mono-family); font-size: 0.6875rem; line-height: 1.1; }
    .navigation_label { display: block; overflow: clip; font-family: var(--secondary-family); font-size: var(--h3); font-weight: var(--secondary-regular); line-height: var(--line-height-medium); letter-spacing: var(--letter-spacing-snug); }
    .navigation_label-text { display: block; text-shadow: 0 1.1em 0 currentColor; transform: none; transition: transform 0.5s cubic-bezier(.7, 0, .3, 1); }
    .navigation_bottom { position: relative; display: flex; flex-direction: column; gap: var(--space-4); margin-top: auto; padding-bottom: max(2.125rem, env(safe-area-inset-bottom)); }
    .navigation_now-playing { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-2) var(--space-4) var(--space-2) var(--space-2); background: #26386a; /* Paper's dark now-playing variant. */ border: var(--border-width) solid var(--dark-800); border-radius: var(--radius-round); }
    .navigation_now-playing > img { width: 2.5rem; height: 2.5rem; border-radius: 50%; }
    .navigation_now-playing_text { display: flex; flex: 1; flex-direction: column; gap: 0.125rem; }
    .navigation_now-playing_label { color: #e8857a; /* Paper's light accent for the dark panel. */ font-family: var(--mono-family); font-size: 0.625rem; letter-spacing: 0.14em; line-height: 1.2; }
    .navigation_now-playing_title { color: var(--light-100); font-family: var(--primary-family); font-size: 1rem; font-weight: var(--primary-medium); line-height: 1.125; }
    .navigation_now-playing_pause { flex: 0 0 auto; width: 0.75rem; height: 0.875rem; color: var(--light-100); }
    /* Out-specify Button.astro's `.button_wrap.pill` padding: Paper's panel RSVP is 17px all round. */
    .button_wrap.pill.navigation_rsvp { --button-016-color-background: var(--accent-500); --button-016-color: var(--light-100); --button-016-hover-color: var(--dark-900); --button-016-hover-color-background: var(--light-100); --button-016-color-focus: var(--light-100); width: 100%; grid-template-columns: 100%; padding: 0; line-height: 1.25; }
    .button_wrap.pill.navigation_rsvp .button-016__inner { width: 100%; box-sizing: border-box; padding: 1.0625rem; }
    .navigation_meta { display: flex; justify-content: space-between; padding-top: var(--space-2); color: var(--brand-500); font-family: var(--mono-family); font-size: var(--eyebrow); letter-spacing: var(--letter-spacing-wider); line-height: var(--line-height-medium); text-transform: uppercase; }
    .navigation_location-short { display: none; }
    .navigation_palm { position: absolute; right: 1.75rem; top: -7.5rem; width: 4.5rem; height: 5.625rem; transform: rotate(8deg); transform-origin: 0 0; opacity: 0; transition: opacity 0.75s cubic-bezier(.7, 0, .3, 1) 0.5s; }
    .navigation[data-navigation-status="active"] .navigation_palm { opacity: 1; }
    @media (width < 62rem) {
      .nav_actions { gap: var(--space-3); }
      .nav_now-playing { width: 2.5rem; height: 2.5rem; justify-content: center; padding: 0; }
      .nav_now-playing > img { width: 1.75rem; height: 1.75rem; }
      .nav_now-playing_text, .nav_now-playing_pause, .nav_toggle-label { display: none; }
      /* Paper's mobile bar shows only the button when closed, and "CLOSE" beside it when open. */
      .nav_wrap[data-navigation-status="active"] .nav_toggle-label { display: inline; }
      .nav_wrap[data-navigation-status="active"] .nav_rsvp { opacity: 0; visibility: hidden; transition-delay: 0.3s; }
      .navigation_location-full { display: none; }
      .navigation_location-short { display: inline; }
    }
    @media (width >= 62rem) {
      .navigation_inner { max-width: var(--max-width-main); width: 100%; margin-inline: auto; padding-top: var(--nav-height); }
      .navigation_links { margin-top: var(--space-7); }
      .navigation_number { flex-basis: 3rem; font-size: var(--eyebrow); }
      .navigation_bottom { position: static; flex-direction: row; align-items: end; justify-content: space-between; padding-block: var(--space-6); }
      .navigation_meta { flex: 1; }
      .navigation_now-playing, .navigation_rsvp { display: none; }
      .navigation_palm { right: 5%; top: 42%; width: 7.5rem; height: 9.375rem; transform: translateY(-50%) rotate(8deg); }
    }
    @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
      .navigation_item { transition: opacity 0.5s cubic-bezier(.7, 0, .3, 1); }
      /* Hover uses the list's own :hover rather than :has(:hover): WebKit doesn't reliably restyle
         siblings when a :has(:hover) match changes, and left rows stuck dimmed. The list has no
         padding, so hovering it means hovering a row. Keyboard focus still uses :has(). */
      .navigation_links:is(:hover, :has(.navigation_link:focus-visible)) .navigation_item { opacity: 0.15; }
      .navigation_links .navigation_item:is(:hover, :has(> .navigation_link:focus-visible)) { opacity: 1; }
      .navigation_link:is(:hover, :focus-visible) .navigation_label-text { transform: translateY(-100%); }
    }
    @media (prefers-reduced-motion: reduce) { .nav_wrap, .nav_wrap::after, .nav_logo, .nav_toggle, .nav_toggle-label, .nav_now-playing, .nav_rsvp, .nav_toggle-bar, .navigation, .navigation_link, .navigation_palm, .navigation_label-text { transition: none; } }
  }
</style>
