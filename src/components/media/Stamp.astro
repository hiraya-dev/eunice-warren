---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type Paper = "light-100" | "light-200";

interface Props extends HTMLAttributes<"span"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Paper colour. */
  paper?: Paper;
}

type AllProps = HTMLAttributes<"span"> & {
  render?: boolean;
  paper?: Paper;
};

const {
  render = true,
  paper = "light-100",
  class: className,
  ...rest
} = Astro.props as AllProps;

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <span class:list={["stamp_wrap", className]} {...rest}>
      <span class:list={["stamp_paper", paper]}>
        <span class="stamp_art">
          <Fragment set:html={content} />
        </span>
      </span>
    </span>
  )
}

<style is:global>
  @layer components {
    .stamp_wrap {
      container-type: inline-size;
      position: relative;
      display: block;
      width: 100%;
      aspect-ratio: 4 / 5;
      filter: drop-shadow(0 0.0625rem 0.0625rem color-mix(in srgb, var(--dark-900) 18%, transparent)) drop-shadow(0 0.5rem 0.875rem color-mix(in srgb, var(--dark-900) 14%, transparent));
    }

    .stamp_paper {
      display: block;
      box-sizing: border-box;
      width: 100%;
      height: 100%;
      padding: 7cqw;
      background: linear-gradient(145deg, rgb(255 255 255 / 34%), transparent 42%), var(--light-100);
      mask-image:
        radial-gradient(circle at 50% 0, transparent 0 2.6cqw, #000 calc(2.6cqw + 0.03125rem)),
        radial-gradient(circle at 50% 100%, transparent 0 2.6cqw, #000 calc(2.6cqw + 0.03125rem)),
        radial-gradient(circle at 0 50%, transparent 0 2.6cqw, #000 calc(2.6cqw + 0.03125rem)),
        radial-gradient(circle at 100% 50%, transparent 0 2.6cqw, #000 calc(2.6cqw + 0.03125rem));
      mask-position: 0 0, 0 0, 0 0, 0 0;
      mask-size: 10% 100%, 10% 100%, 100% calc(100% / 12), 100% calc(100% / 12);
      mask-repeat: repeat-x, repeat-x, repeat-y, repeat-y;
      mask-composite: intersect, intersect, intersect;
      -webkit-mask-image:
        radial-gradient(circle at 50% 0, transparent 0 2.6cqw, #000 calc(2.6cqw + 0.03125rem)),
        radial-gradient(circle at 50% 100%, transparent 0 2.6cqw, #000 calc(2.6cqw + 0.03125rem)),
        radial-gradient(circle at 0 50%, transparent 0 2.6cqw, #000 calc(2.6cqw + 0.03125rem)),
        radial-gradient(circle at 100% 50%, transparent 0 2.6cqw, #000 calc(2.6cqw + 0.03125rem));
      -webkit-mask-position: 0 0, 0 0, 0 0, 0 0;
      -webkit-mask-size: 10% 100%, 10% 100%, 100% calc(100% / 12), 100% calc(100% / 12);
      -webkit-mask-repeat: repeat-x, repeat-x, repeat-y, repeat-y;
      -webkit-mask-composite: source-in, source-in, source-in;
    }

    .stamp_paper.light-200 {
      background-color: var(--light-200);
    }

    .stamp_art {
      position: relative;
      display: block;
      width: 100%;
      height: 100%;
      overflow: hidden;
      box-shadow: inset 0 0 0 0.0625rem color-mix(in srgb, var(--dark-900) 12%, transparent);
    }

    .stamp_art > :is(img, picture, svg) {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>
