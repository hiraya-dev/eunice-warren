---
import type { HTMLAttributes } from "astro/types";
import Button from "@/components/Button.astro";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Accessible label. Defaults to `Marquee`. */
  label?: string;
  /** Travel direction. */
  direction?: "forwards" | "backwards";
};

const {
  render = true,
  label = "Marquee",
  direction = "forwards",
  class: className,
  ...rest
} = Astro.props;

const items = await slotContent(Astro.slots);

const VOID = new Set([
  "area",
  "base",
  "br",
  "col",
  "embed",
  "hr",
  "img",
  "input",
  "link",
  "meta",
  "param",
  "source",
  "track",
  "wbr",
]);

const countItems = (html: string) => {
  let depth = 0;
  let count = 0;
  for (const [, closing, name, , selfClosing] of html.matchAll(
    /<(\/?)([a-zA-Z][^\s/>]*)([^>]*?)(\/?)>/g,
  )) {
    if (closing) {
      depth = Math.max(0, depth - 1);
      continue;
    }
    if (depth === 0) count += 1;
    if (!selfClosing && !VOID.has(name.toLowerCase())) depth += 1;
  }
  return count;
};

const count = countItems(items);

const locals = `--_count: ${count}`;
---

{
  render && items && (
    <div
      class:list={[
        "marquee_wrap",
        direction !== "forwards" && direction,
        className,
      ]}
      style={locals}
      role="group"
      aria-label={label}
      {...rest}
    >
      <div class="marquee_viewport">
        <div class="marquee_track">
          <div class="marquee_panel">
            <Fragment set:html={items} />
          </div>
          <div class="marquee_panel" aria-hidden="true" inert>
            <Fragment set:html={items} />
          </div>
        </div>
      </div>

      <Button
        variant="play"
        emphasis="secondary"
        pressed={true}
        class="marquee_toggle"
        data-marquee-toggle
      />
    </div>
  )
}

<script>
  for (const marquee of document.querySelectorAll<HTMLElement>(
    ".marquee_wrap",
  )) {
    const toggle = marquee.querySelector<HTMLButtonElement>(
      "[data-marquee-toggle]",
    );
    if (!toggle) continue;

    const reduced = matchMedia("(prefers-reduced-motion: reduce)");

    const setPlaying = (playing: boolean) => {
      marquee.dataset.state = playing ? "playing" : "paused";
      toggle.setAttribute("aria-pressed", String(playing));
      toggle.setAttribute("aria-label", playing ? "Pause" : "Play");
    };

    setPlaying(!reduced.matches);
    reduced.addEventListener("change", () => setPlaying(!reduced.matches));

    toggle.addEventListener("click", () => {
      setPlaying(marquee.dataset.state !== "playing");
    });
  }
</script>

<style is:global>
  @layer components {
    .marquee_wrap {
      --_gap-size: var(--space-6);
      --_item-height: 3rem;
      --_speed: 4s;
      --_count: 1;
      --_duration: calc(var(--_count) * var(--_speed));
      display: flex;
      align-items: center;
      gap: var(--space-4);
      width: 100%;
    }

    .marquee_viewport {
      flex: 1 1 auto;
      min-width: 0;
      overflow: clip;
      container-type: inline-size;
      mask-image: linear-gradient(
        to right,
        transparent,
        black 3%,
        black 97%,
        transparent
      );
    }

    .marquee_track {
      display: flex;
      width: max-content;
      align-items: center;
      gap: var(--_gap-size);
      animation: marquee var(--_duration) linear infinite;

      .marquee_wrap.backwards & {
        animation-direction: reverse;
      }

      &:focus-within,
      .marquee_wrap[data-state="paused"] & {
        animation-play-state: paused;
      }
    }

    .marquee_panel {
      display: flex;
      flex: none;
      min-width: 100cqw;
      justify-content: space-around;
      align-items: center;
      gap: var(--_gap-size);

      > * {
        flex: none;
        margin-block: 0;
      }

      > :is(.image, .video) {
        width: auto;
        height: var(--_item-height);
      }
    }

    .marquee_toggle {
      flex: none;
    }

    @keyframes marquee {
      to {
        translate: calc(-50% - var(--_gap-size) / 2) 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .marquee_track {
        animation-name: none;
      }

      .marquee_wrap[data-state="playing"] .marquee_track {
        animation-name: marquee;
        animation-duration: var(--_duration) !important;
      }
    }
  }
</style>
