---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/components/media/Icon.astro";
import arrow from "@/assets/icons/arrow-full.svg";
import close from "@/assets/icons/close.svg";
import play from "@/assets/icons/play.svg";
import pause from "@/assets/icons/pause.svg";
import { slotContent } from "@/utils/slots.ts";

type Emphasis = "primary" | "secondary";

type Tag =
  | (HTMLAttributes<"button"> & {
      /** Rendered element. */
      element?: "button";
      /** Native button type. */
      type?: "button" | "submit" | "reset";
      /** Disable the button. */
      disabled?: boolean;
      href?: never;
    })
  | (Omit<HTMLAttributes<"a">, "type"> & {
      element: "link";
      /** Link destination. */
      href?: string;
      type?: never;
      disabled?: never;
    });

type Kind =
  | {
      /** Button type. */
      variant?: "main";
      /** Visual emphasis. */
      emphasis?: Emphasis;
      /** Button shape. */
      shape?: "square" | "pill";
      label?: never;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "link";
      /** A link carries no weight of its own: it is already the quietest. */
      emphasis?: never;
      shape?: never;
      label?: never;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "play";
      emphasis?: Emphasis;
      shape?: never;
      /** Accessible label. Defaults to `Play` or `Pause`. */
      label?: string;
      /** Show the pause icon and pressed state. */
      pressed?: boolean;
      direction?: never;
    }
  | {
      variant: "close";
      emphasis?: Emphasis;
      shape?: never;
      /** Accessible label. Defaults to `Close`. */
      label?: string;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "arrow";
      emphasis?: Emphasis;
      shape?: never;
      /** Accessible label. Defaults to `Next` or `Previous`. */
      label?: string;
      pressed?: never;
      /** Arrow direction. */
      direction?: "forward" | "back";
    };

type Props = {
  /** Set to `false` to omit the component. */
  render?: boolean;
} & Tag &
  Kind;

type AllProps = HTMLAttributes<"button"> &
  Omit<HTMLAttributes<"a">, "type"> & {
    render?: boolean;
    variant?: "main" | "link" | "play" | "close" | "arrow";
    emphasis?: Emphasis;
    shape?: "square" | "pill";
    label?: string;
    pressed?: boolean;
    direction?: "forward" | "back";
    element?: "button" | "link";
    href?: string;
    type?: "button" | "submit" | "reset";
  };

const {
  render = true,
  variant = "main",
  emphasis = "primary",
  shape = "square",
  label,
  pressed = false,
  direction = "forward",
  element = "button",
  href,
  type = "button",
  class: className,
  ...rest
} = Astro.props as AllProps;

const isLink = element === "link";
const Tag = isLink ? "a" : "button";
const tagAttrs = isLink
  ? { href: href || "#" }
  : { type: type === "submit" ? undefined : type };

const marks = { play, close, arrow };
/* main and link are written, the rest are marks with a label. */
const isWritten = variant === "main" || variant === "link";
const content = isWritten ? await slotContent(Astro.slots) : "";

const named = {
  play: pressed ? "Pause" : "Play",
  close: "Close",
  arrow: direction === "back" ? "Previous" : "Next",
};
---

{
  render && (isWritten ? content : true) && (
    <Tag
      class:list={[
        "button_wrap",
        emphasis !== "primary" && emphasis,
        variant !== "main" && variant,
        variant === "main" && shape,
        variant === "arrow" && direction === "back" && "back",
        className,
      ]}
      aria-label={isWritten ? undefined : (label ?? named[variant])}
      aria-pressed={variant === "play" ? pressed : undefined}
      {...tagAttrs}
      {...rest}
    >
      {isWritten && (
        <span class="button_text">
          <Fragment set:html={content} />
        </span>
      )}
      {variant === "play" && (
        <Fragment>
          <Icon class="button_mark button_play" src={play} variant="small" />
          <Icon class="button_mark button_pause" src={pause} variant="small" />
        </Fragment>
      )}
      {variant === "close" && (
        <Icon class="button_mark" src={marks.close} variant="small" />
      )}
      {variant === "arrow" && (
        <Icon class="button_mark" src={marks.arrow} variant="small" />
      )}
    </Tag>
  )
}

<style is:global>
  @layer components {
    .button_wrap {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 0.5em;
      padding: var(--space-3) var(--space-4);
      background-color: var(--button-background);
      color: var(--button-text);
      border: 0;
      border-radius: 0;
      font-family: var(--primary-family);
      font-size: var(--text-main);
      font-weight: var(--primary-medium);
      line-height: 1.25;
      text-decoration: none;
      text-align: center;
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover:not(:disabled) {
          background-color: var(--button-background-hover);
          color: var(--button-text-hover);
          border-color: var(--button-border-hover);
        }
      }
      &.secondary {
        --button-background: var(--button-2-background);
        --button-text: var(--button-2-text);
        --button-border: var(--button-2-border);
        --button-background-hover: var(--button-2-background-hover);
        --button-text-hover: var(--button-2-text-hover);
        --button-border-hover: var(--button-2-border-hover);
        padding-inline: 0;
        background-color: transparent;
        border: 0;
      }
      &.pill {
        border-radius: var(--radius-round);
        padding-block: var(--space-2);
        line-height: 1;
      }
      &.link {
        --button-background: transparent;
        --button-text: var(--link-text);
        --button-border: transparent;
        --button-background-hover: transparent;
        --button-text-hover: var(--link-text-hover);
        --button-border-hover: transparent;

        position: relative;
        padding: 0;
        border: 0;
        border-radius: 0;
        font-family: var(--mono-family);
        font-size: var(--eyebrow);
        font-weight: var(--primary-regular);
        letter-spacing: 0.04em;
        line-height: var(--eyebrow-line-height);
        text-transform: uppercase;
        transition:
          color var(--hover-duration) var(--hover-ease);
        &::before {
          content: "";
          position: absolute;
          right: 0;
          bottom: -0.0625em;
          left: 0;
          height: 0.1em;
          background-color: currentColor;
          transform: scaleX(0);
          transform-origin: right;
          transition: transform 0.735s cubic-bezier(0.625, 0.05, 0, 1);
        }
        @media (hover: hover) and (pointer: fine) {
          &:hover:not(:disabled) {
            &::before {
              transform: scaleX(1);
              transform-origin: left;
            }
          }
        }
        @media (prefers-reduced-motion: reduce) {
          &::before {
            transform: scaleX(1);
            transition: none;
          }
        }
      }
      &:is(.play, .close, .arrow) {
        gap: 0;
        padding: 0.75em;
        border-radius: var(--radius-round);
      }
      &.back .button_mark {
        rotate: 180deg;
      }
      &.play .button_pause {
        display: none;
      }
      &.play[aria-pressed="true"] {
        & .button_play {
          display: none;
        }
        & .button_pause {
          display: block;
        }
      }
      &:disabled {
        cursor: not-allowed;
        opacity: 0.5;
      }
    }
  }
</style>
