---
import { env } from "cloudflare:workers";
import { parseAdminHosts } from "@/lib/admin/auth";
import AdminLayout from "@/layouts/AdminLayout.astro";
import {
  memberLine,
  plusOneChipText,
  renameNote,
} from "@/lib/admin/presentation";
import { selectAdminStore } from "@/lib/admin/store";
import { StaleHouseholdError } from "@/lib/admin/store";
import type { AdminGuestList, AdminHousehold } from "@/lib/admin/store";
import { MAX_SEATS } from "@/lib/rsvp/limits";
import GuestHouseholdForm from "@/components/admin/GuestHouseholdForm.astro";
export const prerender = false;
const host = Astro.locals.adminHost!;
const store = selectAdminStore(
  (env as Record<string, unknown>).RSVP_STORE,
  (env as Record<string, unknown>).DB as never,
);
let writeError = "";
type DraftSeat = {
  id?: number;
  slot: number;
  kind: "member" | "plus_one";
  name: string;
  invitedName: string | null;
  retire?: boolean;
  hasActivity?: boolean;
};
let editDraft: {
  id: string;
  updatedAt: string;
  displayName: string;
  notes: string;
  seatCount: number;
  seats: DraftSeat[];
} | null = null;
let newDraft = {
  displayName: "",
  label: "",
  notes: "",
  memberNames: [""],
  seatCount: 1,
};
let writeHouseholdId = Astro.url.searchParams.get("edit");
if (Astro.request.method === "POST") {
  const origin = Astro.request.headers.get("origin");
  if (origin && origin !== Astro.url.origin) {
    Astro.response.status = 403;
    writeError = "Forbidden";
  } else {
    const form = await Astro.request.formData();
    const action = String(form.get("action") ?? "");
    try {
      if (action === "archive") {
        writeHouseholdId = String(form.get("id") ?? "");
        await store.archiveHousehold(
          writeHouseholdId,
          host.email,
          String(form.get("updated_at") ?? "") || undefined,
        );
      } else if (action === "add" && form.get("member_action") === "add") {
        const memberNames = form.getAll("member_name").map(String);
        const seatCount = Number(form.get("seat_count") ?? memberNames.length);
        newDraft = {
          displayName: String(form.get("display_name") ?? ""),
          label: String(form.get("label") ?? ""),
          notes: String(form.get("notes") ?? ""),
          memberNames: [...memberNames, ""],
          seatCount: Math.max(seatCount, memberNames.length + 1),
        };
      } else if (action === "add" && form.get("seat_action")) {
        const memberNames = form.getAll("member_name").map(String);
        const currentCount = Number(
          form.get("seat_count") ?? memberNames.length,
        );
        const next =
          form.get("seat_action") === "add"
            ? currentCount + 1
            : currentCount - 1;
        newDraft = {
          displayName: String(form.get("display_name") ?? ""),
          label: String(form.get("label") ?? ""),
          notes: String(form.get("notes") ?? ""),
          memberNames,
          seatCount: Math.max(memberNames.length, Math.min(MAX_SEATS, next)),
        };
      } else if (action === "add") {
        const names = form.getAll("member_name").map(String);
        const seatCount = Number(form.get("seat_count") ?? names.length);
        newDraft = {
          displayName: String(form.get("display_name") ?? ""),
          label: String(form.get("label") ?? ""),
          notes: String(form.get("notes") ?? ""),
          memberNames: names,
          seatCount,
        };
        await store.addHousehold(
          {
            label: newDraft.label,
            displayName: newDraft.displayName,
            notes: newDraft.notes || null,
            seats: names.map((name) => ({ name })),
            seatCount,
          },
          host.email,
        );
      } else if (action === "save") {
        const ids = form
          .getAll("seat_id")
          .map((value) => Number(value) || undefined);
        const names = form.getAll("seat_name").map(String);
        const invited = form.getAll("invited_name").map(String);
        const currentCount = Number(form.get("seat_count") ?? names.length);
        const delta =
          form.get("seat_action") === "add"
            ? 1
            : form.get("seat_action") === "remove"
              ? -1
              : 0;
        const seats = names.map((name, index) => ({
          id: ids[index],
          name,
          invitedName: invited[index] || undefined,
          retire: ids[index]
            ? Boolean(form.get(`retire_seat_${ids[index]}`))
            : false,
        }));
        const finalCount =
          currentCount + delta - seats.filter((seat) => seat.retire).length;
        const householdId = String(form.get("id"));
        writeHouseholdId = householdId;
        const storedRow = (await store.getGuestList()).rows.find(
          (row) => row.id === householdId,
        );
        const kindsById = new Map(
          storedRow?.seats.map((seat) => [seat.id, seat.kind]) ?? [],
        );
        editDraft = {
          id: householdId,
          updatedAt: String(form.get("updated_at") ?? ""),
          displayName: String(form.get("display_name") ?? ""),
          notes: String(form.get("notes") ?? ""),
          seatCount: Math.max(1, currentCount + delta),
          seats: seats.map((seat, index) => ({
            ...seat,
            slot: index + 1,
            kind: seat.id ? (kindsById.get(seat.id) ?? "plus_one") : "plus_one",
            invitedName: seat.invitedName ?? null,
            hasActivity: seat.id
              ? storedRow?.seats.find((stored) => stored.id === seat.id)
                  ?.hasActivity
              : false,
          })),
        };
        if (delta > 0 && currentCount >= MAX_SEATS) {
          editDraft.seatCount = currentCount;
          writeError = "Seats must be between 1 and 12.";
        } else if (delta < 0) {
          const trailing = editDraft.seats.at(-1);
          if (
            trailing &&
            (trailing.kind === "member" ||
              Boolean(trailing.name.trim()) ||
              trailing.hasActivity)
          ) {
            editDraft.seatCount = currentCount;
            writeError = `Seat ${trailing.slot} has activity. Review or retire this seat first.`;
          }
        }
        if (!form.get("seat_action")) {
          const result = await store.saveHousehold(
            {
              id: String(form.get("id")),
              updatedAt: String(form.get("updated_at") ?? "") || undefined,
              displayName: String(form.get("display_name") ?? ""),
              notes: String(form.get("notes") ?? "") || null,
              seatCount: finalCount,
              seats,
            },
            host.email,
          );
          if (!result.ok) writeError = result.message;
          else return Astro.redirect("/admin/guests", 303);
        }
      }
      if (!writeError && action === "archive")
        return Astro.redirect("/admin/guests", 303);
    } catch (error) {
      writeError =
        error instanceof StaleHouseholdError
          ? error.message
          : error instanceof Error
            ? error.message
            : "Could not save household.";
    }
  }
}
const hostNames = parseAdminHosts(
  String((env as Record<string, unknown>).ADMIN_HOSTS ?? ""),
) ?? { [host.email]: host.firstName };
let data: AdminGuestList | null = null;
let failed = false;
let counts = { households: 0, slipperPairs: 0, songRequests: 0 };
try {
  [data, counts] = await Promise.all([
    store.getGuestList(),
    store.getNavCounts(),
  ]);
} catch {
  failed = true;
  Astro.response.status = 503;
}
const view =
  data ??
  ({
    totals: { households: 0, seatsOffered: 0, unnamedPlusOnes: 0 },
    rows: [],
  } satisfies AdminGuestList);
const rsvpText = (rsvp: { state: string; coming?: number }) =>
  rsvp.state === "coming"
    ? `${rsvp.coming} coming`
    : rsvp.state === "declined"
      ? "Declined"
      : "Waiting";
const editId = Astro.url.searchParams.get("edit");
if (!newDraft.memberNames.length) newDraft.memberNames = [""];
const archiveId = Astro.url.searchParams.get("archive");
const newOpen = Astro.url.searchParams.get("new") === "1";
const archiveRow = view.rows.find((row) => row.id === archiveId);
// A refusal shows inside the open edit or new row, above its bottom line; any
// other failure (an archive, a failed load) keeps the page-level notice.
const errorInRow =
  Boolean(writeError) &&
  (newOpen || view.rows.some((row) => row.id === editId));
const reloadHref = writeError.startsWith("This household")
  ? `/admin/guests?edit=${writeHouseholdId}`
  : undefined;
const editSeats = (row: AdminHousehold) => {
  const draft = editDraft?.id === row.id ? editDraft : null;
  const source: DraftSeat[] = draft
    ? draft.seats.map((seat) => ({ ...seat }))
    : row.seats.map((seat) => ({
        id: seat.id,
        slot: seat.slot,
        kind: seat.kind,
        name: seat.name ?? "",
        invitedName: seat.invitedName,
        hasActivity: seat.hasActivity,
      }));
  const target = draft?.seatCount ?? row.seatCount;
  while (source.length < target)
    source.push({
      id: undefined,
      slot: source.length + 1,
      kind: "plus_one",
      name: "",
      invitedName: null,
    });
  return source.slice(0, target);
};
---

<AdminLayout active="guests" host={host} counts={counts}>
  <section id="guests" class="admin-guests_wrap" data-admin-guests-page>
    {
      host.sample && (
        <p class="admin_sample" data-admin-sample>
          Sample data
        </p>
      )
    }
    {
      failed ? (
        <div class="admin_notice error" data-admin-error>
          <h1>Couldn't load the guest data</h1>
          <a href={Astro.url.pathname}>Try again</a>
        </div>
      ) : view.totals.households === 0 &&
        Astro.url.searchParams.get("new") !== "1" ? (
        <div class="admin_notice empty" data-admin-empty>
          <h1>No guests yet</h1>
          <p>The guest list hasn't been loaded.</p>
        </div>
      ) : (
        <>
          <header class="admin-guests_header">
            <p class="admin_label">
              Who's invited · Seats first, names when you know them
            </p>
            <div class="admin-guests_title">
              <h1>Guest list</h1>
              <a class="admin_guests_add" href="/admin/guests?new=1">
                + Add household
              </a>
            </div>
          </header>
          {writeError && !errorInRow && (
            <p class="admin_guests_error page" data-admin-write-error>
              {writeError} {reloadHref && <a href={reloadHref}>Reload</a>}
            </p>
          )}
          <div class="admin-guests_toolbar">
            <dl class="admin-guests_stats">
              <div>
                <dt>Households</dt>
                <dd>{view.totals.households}</dd>
              </div>
              <div>
                <dt>Seats offered</dt>
                <dd>{view.totals.seatsOffered}</dd>
              </div>
              <div class="quiet">
                <dt>Plus-ones not named yet</dt>
                <dd>{view.totals.unnamedPlusOnes}</dd>
              </div>
            </dl>
            <div class="admin-guests_search">
              <label class="sr-only" for="admin-search">
                Search households or members
              </label>
              <input
                id="admin-search"
                data-admin-search
                type="search"
                placeholder="Search households or members"
                autocomplete="off"
                value={Astro.url.searchParams.get("q") ?? ""}
              />
            </div>
          </div>
          <p class="admin-guests_no-match" data-admin-no-match hidden>
            No households match
          </p>
          <div class="admin-guests_card">
            <table class="admin-guests_table" data-admin-guests>
              <thead>
                <tr>
                  <th data-col="id">ID</th>
                  <th data-col="household">Household</th>
                  <th data-col="members">Members · Notes</th>
                  <th data-col="seats">Seats</th>
                  <th data-col="rsvp">RSVP</th>
                </tr>
              </thead>
              <tbody>
                {newOpen && (
                  <GuestHouseholdForm
                    variant="new"
                    draft={newDraft}
                    error={errorInRow ? writeError : undefined}
                    reloadHref={reloadHref}
                  />
                )}
                {view.rows.map((row) => {
                  const plusOnes = row.seats.filter(
                    (seat) => seat.kind === "plus_one",
                  );
                  if (archiveRow?.id === row.id)
                    return (
                      <tr
                        class="admin-guests_archive-row"
                        data-admin-archive-confirm
                      >
                        <td colspan={5}>
                          <div class="admin_guests_confirm">
                            <p>Archive {archiveRow.displayName}?</p>
                            <form method="post">
                              <input
                                type="hidden"
                                name="action"
                                value="archive"
                              />
                              <input
                                type="hidden"
                                name="id"
                                value={archiveRow.id}
                              />
                              <input
                                type="hidden"
                                name="updated_at"
                                value={archiveRow.updatedAt ?? ""}
                              />
                              <div class="admin_guests_form-actions">
                                <button
                                  class="admin_guests_btn accent"
                                  type="submit"
                                >
                                  Archive
                                </button>
                                <a
                                  class="admin_guests_btn"
                                  href="/admin/guests"
                                >
                                  Cancel
                                </a>
                              </div>
                            </form>
                          </div>
                        </td>
                      </tr>
                    );
                  return editId === row.id ? (
                    <GuestHouseholdForm
                      variant="edit"
                      row={row}
                      seats={editSeats(row)}
                      updatedAt={
                        editDraft?.id === row.id
                          ? editDraft.updatedAt
                          : (row.updatedAt ?? "")
                      }
                      displayName={
                        editDraft?.id === row.id
                          ? editDraft.displayName
                          : row.displayName
                      }
                      notes={
                        editDraft?.id === row.id
                          ? editDraft.notes
                          : (row.notes ?? "")
                      }
                      error={errorInRow ? writeError : undefined}
                      reloadHref={reloadHref}
                    />
                  ) : (
                    <tr
                      data-admin-household
                      data-household-id={row.id}
                      data-search={[
                        row.displayName,
                        row.label,
                        ...row.seats.map((seat) => seat.name ?? ""),
                      ]
                        .join(" ")
                        .toLocaleLowerCase()}
                    >
                      <td data-col="id">{row.label}</td>
                      <th data-col="household" scope="row">
                        {row.displayName}
                      </th>
                      <td data-col="members">
                        <div class="admin-guests_detail">
                          <div>
                            {memberLine(
                              row.seats
                                .filter((seat) => seat.kind === "member")
                                .map((seat) => seat.name ?? ""),
                            )}
                          </div>
                          {plusOnes.length > 0 && (
                            <div class="admin-guests_chips">
                              {plusOnes.map((seat) => (
                                <span
                                  data-admin-plus-one
                                  data-state={seat.state}
                                >
                                  {plusOneChipText(
                                    {
                                      ...seat,
                                      state: seat.state ?? "open",
                                    },
                                    hostNames,
                                  )}
                                </span>
                              ))}
                            </div>
                          )}
                          {row.notes && <small>{row.notes}</small>}
                          {row.seats
                            .filter(
                              (seat) =>
                                seat.name &&
                                seat.invitedName &&
                                seat.name !== seat.invitedName,
                            )
                            .map((seat) => (
                              <small class="rename">
                                {renameNote(
                                  seat.name!,
                                  seat.invitedName!,
                                  seat.namedBy,
                                  seat.namedAt,
                                  hostNames,
                                )}
                              </small>
                            ))}
                        </div>
                      </td>
                      <td data-col="seats">
                        {row.seatCount}
                        <span class="admin-guests_unit">
                          {" "}
                          {row.seatCount === 1 ? "seat" : "seats"}
                        </span>
                      </td>
                      <td data-col="rsvp">
                        <span
                          class="admin_pill"
                          data-admin-rsvp
                          data-state={row.rsvp.state}
                        >
                          {rsvpText(row.rsvp)}
                        </span>
                        <details class="admin_guests_menu">
                          <summary
                            aria-label={`Actions for ${row.displayName}`}
                          >
                            ⋯
                          </summary>
                          <div class="admin_guests_popover">
                            <a
                              data-admin-edit
                              href={`/admin/guests?edit=${row.id}`}
                            >
                              Edit
                            </a>
                            <a href={`/admin/guests?archive=${row.id}`}>
                              Archive household
                            </a>
                          </div>
                        </details>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </>
      )
    }
  </section>
</AdminLayout>
<script>
  const input = document.querySelector<HTMLInputElement>("[data-admin-search]");
  const rows = [
    ...document.querySelectorAll<HTMLElement>("[data-admin-household]"),
  ];
  const empty = document.querySelector<HTMLElement>("[data-admin-no-match]");
  const normalize = (value: string) =>
    value
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLocaleLowerCase()
      .trim();
  const filterRows = () => {
    if (!input) return;
    const query = normalize(input.value);
    let visible = 0;
    for (const row of rows) {
      const match = normalize(row.dataset.search ?? "").includes(query);
      row.hidden = !match;
      if (match) visible++;
    }
    if (empty) empty.hidden = visible !== 0;
    const params = new URLSearchParams(window.location.search);
    if (input.value) params.set("q", input.value);
    else params.delete("q");
    history.replaceState(
      null,
      "",
      `${window.location.pathname}${params.toString() ? `?${params}` : ""}`,
    );
    for (const link of document.querySelectorAll<HTMLAnchorElement>(
      "[data-admin-edit]",
    )) {
      const href = new URL(link.href);
      if (input.value) href.searchParams.set("q", input.value);
      else href.searchParams.delete("q");
      link.href = href.toString();
    }
  };
  input?.addEventListener("input", filterRows);
  if (input?.value) filterRows();

  const editForm = document.querySelector<HTMLFormElement>(
    "[data-edit-household]",
  );
  if (editForm) {
    const list = editForm.querySelector<HTMLElement>("[data-seat-list]");
    const count = editForm.querySelector<HTMLInputElement>(
      "[data-seat-count-input]",
    );
    const output =
      editForm.querySelector<HTMLOutputElement>("[data-seat-output]");
    const max = 12;
    const sync = () => {
      if (!list || !count || !output) return;
      const seats = [
        ...list.querySelectorAll<HTMLElement>(".admin_guests_chip"),
      ];
      count.value = String(seats.length);
      output.value = String(seats.length);
      const remove = editForm.querySelector<HTMLButtonElement>(
        'button[name="seat_action"][value="remove"]',
      );
      const add = editForm.querySelector<HTMLButtonElement>(
        'button[name="seat_action"][value="add"]',
      );
      if (remove) {
        const trailing = seats.at(-1);
        const trailingName = trailing?.querySelector<HTMLInputElement>(
          'input[name="seat_name"]',
        );
        remove.disabled =
          !trailing ||
          trailing.dataset.seatKind === "member" ||
          Boolean(trailingName?.value.trim()) ||
          Boolean(trailing.dataset.activity);
      }
      if (add) add.disabled = seats.length >= max;
    };
    for (const button of editForm.querySelectorAll<HTMLButtonElement>(
      'button[name="seat_action"]',
    )) {
      button.addEventListener("click", (event) => {
        event.preventDefault();
        const seats = list
          ? [...list.querySelectorAll<HTMLElement>(".admin_guests_chip")]
          : [];
        if (button.value === "remove" && seats.length > 0) {
          const last = seats.at(-1)!;
          const name = last.querySelector<HTMLInputElement>(
            'input[name="seat_name"]',
          );
          const activity = last.dataset.activity;
          if (
            last.dataset.seatKind === "member" ||
            name?.value.trim() ||
            activity
          )
            return;
          last.remove();
        } else if (button.value === "add" && seats.length < max && list) {
          const wrapper = document.createElement("label");
          wrapper.className = "admin_guests_chip";
          const slot = seats.length + 1;
          wrapper.innerHTML = `<span>Open seat · add a name</span><input type="hidden" name="seat_id" value=""><input name="seat_name" placeholder="Open seat · add a name"><input type="hidden" name="invited_name" value="">`;
          list.append(wrapper);
          const hidden = wrapper.querySelector<HTMLInputElement>(
            'input[name="seat_id"]',
          );
          if (hidden) hidden.value = "";
          void slot;
        }
        sync();
      });
    }
    sync();
    for (const checkbox of editForm.querySelectorAll<HTMLInputElement>(
      'input[type="checkbox"][name^="retire_seat_"]',
    ))
      checkbox.addEventListener("change", () => {
        const chip = checkbox.closest(".admin_guests_chip");
        chip?.classList.toggle("is-retired", checkbox.checked);
        const label = chip?.querySelector<HTMLElement>("[data-retire-label]");
        if (label) label.textContent = checkbox.checked ? "Undo" : "× Retire";
      });
  }

  const newForm = document.querySelector<HTMLFormElement>(
    "[data-new-household]",
  );
  if (newForm) {
    const members = newForm.querySelector<HTMLElement>("[data-new-members]");
    const addMember = newForm.querySelector<HTMLButtonElement>(
      'button[name="member_action"]',
    );
    const syncNew = () => {
      const count = newForm.querySelector<HTMLInputElement>(
        "[data-new-seat-count]",
      );
      const output = newForm.querySelector<HTMLOutputElement>(
        "[data-new-seat-output]",
      );
      const memberCount = newForm.querySelectorAll(
        'input[name="member_name"]',
      ).length;
      if (!count || !output) return;
      const next = Math.max(memberCount, Math.min(12, Number(count.value)));
      count.value = String(next);
      output.value = String(next);
      const remove = newForm.querySelector<HTMLButtonElement>(
        'button[name="seat_action"][value="remove"]',
      );
      const add = newForm.querySelector<HTMLButtonElement>(
        'button[name="seat_action"][value="add"]',
      );
      if (remove) remove.disabled = next <= memberCount;
      if (add) add.disabled = next >= 12;
    };
    addMember?.addEventListener("click", (event) => {
      event.preventDefault();
      if (!members) return;
      const label = document.createElement("label");
      label.textContent = `Member name ${members.children.length + 1}`;
      const field = document.createElement("input");
      field.name = "member_name";
      label.append(field);
      members.append(label);
      syncNew();
      field.focus();
    });
    for (const button of newForm.querySelectorAll<HTMLButtonElement>(
      'button[name="seat_action"]',
    ))
      button.addEventListener("click", (event) => {
        event.preventDefault();
        const count = newForm.querySelector<HTMLInputElement>(
          "[data-new-seat-count]",
        );
        const output = newForm.querySelector<HTMLOutputElement>(
          "[data-new-seat-output]",
        );
        const membersCount = newForm.querySelectorAll(
          'input[name="member_name"]',
        ).length;
        if (!count || !output) return;
        const next =
          button.value === "add"
            ? Math.min(12, Number(count.value) + 1)
            : Math.max(membersCount, Number(count.value) - 1);
        count.value = String(next);
        output.value = String(next);
        syncNew();
      });
    syncNew();
  }
</script>
