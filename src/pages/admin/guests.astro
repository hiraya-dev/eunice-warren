---
import { env } from "cloudflare:workers";
import { parseAdminHosts } from "@/lib/admin/auth";
import AdminLayout from "@/layouts/AdminLayout.astro";
import {
  memberLine,
  plusOneChipText,
} from "@/lib/admin/presentation";
import { selectAdminStore } from "@/lib/admin/store";
import { StaleHouseholdError } from "@/lib/admin/store";
import type { AdminGuestList, AdminHousehold } from "@/lib/admin/store";
import { MAX_SEATS } from "@/lib/rsvp/limits";
import {
  duplicateNameKey,
  generateHostId,
  normalizeName,
  parsePlusOne,
  suggestInvitationName,
} from "@/lib/admin/names";
import GuestHouseholdForm from "@/components/admin/GuestHouseholdForm.astro";
export const prerender = false;
const host = Astro.locals.adminHost!;
const store = selectAdminStore(
  (env as Record<string, unknown>).RSVP_STORE,
  (env as Record<string, unknown>).DB as never,
);
let writeError = "";
type DraftSeat = {
  id?: number;
  slot: number;
  kind: "member" | "plus_one";
  name: string;
  invitedName: string | null;
  retire?: boolean;
  hasActivity?: boolean;
  rsvp?: string;
  namedBy?: string | null;
  namedByKind?: "guest" | "host" | null;
  namedAt?: string | null;
};
let editDraft: {
  id: string;
  updatedAt: string;
  displayName: string;
  notes: string;
  seatCount: number;
  seats: DraftSeat[];
  removedSeatIds?: number[];
  invitationEdited: boolean;
} | null = null;
let newDraft = {
  displayName: "",
  label: "",
  notes: "",
  memberNames: [""],
  seatCount: 1,
  confirmedNames: [] as string[],
  labelEdited: false,
  invitationEdited: false,
};
let writeHouseholdId = Astro.url.searchParams.get("edit");
let duplicateOpenId = "";
const namesFromForm = (form: FormData) =>
  form.getAll("member_name").map(String).map(normalizeName).filter(Boolean);
const duplicateFromList = (
  names: string[],
  rows: AdminHousehold[],
  currentId?: string,
) => {
  for (const name of names) {
    const key = duplicateNameKey(name);
    const row = rows.find(
      (item) =>
        item.id !== currentId &&
        item.seats.some((seat) =>
          [seat.name, seat.invitedName].some(
            (value) => value && duplicateNameKey(value) === key,
          ),
        ),
    );
    if (row) return { name, row };
  }
  return null;
};
if (Astro.request.method === "POST") {
  const origin = Astro.request.headers.get("origin");
  if (origin && origin !== Astro.url.origin) {
    Astro.response.status = 403;
    writeError = "Forbidden";
  } else {
    const form = await Astro.request.formData();
    const action = String(form.get("action") ?? "");
    try {
      if (action === "archive") {
        writeHouseholdId = String(form.get("id") ?? "");
        await store.archiveHousehold(
          writeHouseholdId,
          host.email,
          String(form.get("updated_at") ?? "") || undefined,
        );
      } else if (action === "add") {
        const memberNames = namesFromForm(form);
        const list = await store.getGuestList();
        const added = normalizeName(String(form.get("member_input") ?? ""));
        const plusOnes = parsePlusOne(added);
        if (added && !plusOnes)
          memberNames.push(added);
        const currentCount = Number(
          form.get("seat_count") ?? memberNames.length,
        );
        const seatAction = String(form.get("seat_action") ?? "");
        const nextCount =
          seatAction === "add"
            ? currentCount + 1
            : seatAction === "remove"
              ? currentCount - 1
              : currentCount;
        const toggle = String(form.get("plus_one") ?? "");
        const toggledCount =
          toggle === "on"
            ? memberNames.length + 1
            : toggle === "off"
              ? memberNames.length
              : nextCount;
        const seatCount = Math.max(
          1,
          memberNames.length,
          Math.min(
            MAX_SEATS,
            toggledCount +
              (plusOnes || 0),
          ),
        );
        const postedDisplayName = String(form.get("display_name") ?? "");
        // The posted name was suggested from the names that were posted, not
        // from the name this request adds; compare with that suggestion.
        const postedSuggestion = suggestInvitationName(namesFromForm(form));
        newDraft = {
          displayName: postedDisplayName,
          label: String(form.get("label") ?? ""),
          notes: String(form.get("notes") ?? ""),
          memberNames,
          seatCount,
          confirmedNames: [
            ...form.getAll("confirmed_name").map(String),
            ...(form.get("confirm_duplicate") ? memberNames : []),
          ],
          invitationEdited:
            Boolean(form.get("invitation_edited")) ||
            (Boolean(postedDisplayName) &&
              postedDisplayName !== postedSuggestion),
          labelEdited:
            Boolean(form.get("label_edited")) ||
            String(form.get("label") ?? "") !==
              String(form.get("generated_label") ?? ""),
        };
        if (
          form.get("member_action") === "add" ||
          form.get("seat_action") ||
          toggle ||
          form.get("confirm_duplicate")
        ) {
          const duplicate = duplicateFromList(memberNames, list.rows);
          if (duplicate && !form.get("confirm_duplicate")) {
            duplicateOpenId = duplicate.row.id;
            writeError = `${duplicate.name} is already invited with ${duplicate.row.displayName}.`;
          }
        } else {
          const duplicate = duplicateFromList(memberNames, list.rows);
          if (
            duplicate &&
            !newDraft.confirmedNames?.some(
              (name) =>
                duplicateNameKey(name) === duplicateNameKey(duplicate.name),
            )
          ) {
            duplicateOpenId = duplicate.row.id;
            writeError = `${duplicate.name} is already invited with ${duplicate.row.displayName}.`;
          } else {
            const displayName = newDraft.invitationEdited
              ? newDraft.displayName
              : suggestInvitationName(memberNames);
            await store.addHousehold(
              {
                label: newDraft.labelEdited
                  ? newDraft.label
                  : generateHostId(
                      displayName,
                      list.rows.flatMap((row) => [row.id, row.label]),
                    ),
                displayName,
                notes: newDraft.notes || null,
                seats: memberNames.map((name) => ({ name })),
                seatCount,
                confirmedNames: newDraft.confirmedNames,
              },
              host.email,
            );
            const target: Record<string, string> = {};
            if (form.get("save_and_add")) {
              target.new = "1";
              target.added = displayName;
            }
            return Astro.redirect(redirectHref(form, target), 303);
          }
        }
      } else if (action === "save") {
        const householdId = String(form.get("id") ?? "");
        writeHouseholdId = householdId;
        const list = await store.getGuestList();
        const storedRow = list.rows.find((row) => row.id === householdId);
        const ids = form
          .getAll("seat_id")
          .map((value) => Number(value) || undefined);
        const names = form.getAll("seat_name").map(String).map(normalizeName);
        const invited = form.getAll("invited_name").map(String);
        const kindsById = new Map(
          storedRow?.seats.map((seat) => [seat.id, seat.kind]) ?? [],
        );
        let seats = names.map((name, index) => {
          const id = ids[index];
          const fixedInvited = id
            ? String(form.get(`invited_name_${id}`) ?? invited[index] ?? "")
            : invited[index];
          return {
            id,
            kind: id
              ? (kindsById.get(id) ?? "plus_one")
              : name
                ? "member"
                : "plus_one",
            name,
            invitedName: fixedInvited || undefined,
            retire: id ? Boolean(form.get(`retire_seat_${id}`)) : false,
          } as const;
        });
        const confirmedNames = [
          ...form.getAll("confirmed_name").map(String),
          ...(form.get("confirm_duplicate")
            ? seats
                .filter((seat) => seat.kind === "member")
                .map((seat) => seat.name)
            : []),
        ];
        const memberInput = normalizeName(
          String(form.get("member_input") ?? ""),
        );
        const plusOnes = parsePlusOne(memberInput);
        const saveWithPendingInput = Boolean(
          memberInput &&
            (form.get("save") || form.get("save_and_add")),
        );
        const shouldAddInput = Boolean(
          memberInput &&
            (form.get("member_action") === "add" || saveWithPendingInput),
        );
        const pendingCount = shouldAddInput ? plusOnes || 1 : 0;
        if (shouldAddInput) {
          if (plusOnes)
            for (let index = 0; index < plusOnes; index += 1)
              seats.push({
                id: undefined,
                kind: "plus_one",
                name: "",
                invitedName: undefined,
                retire: false,
              });
          else
            seats.push({
              id: undefined,
              kind: "member",
              name: memberInput,
              invitedName: memberInput,
              retire: false,
            });
        }
        const postedDisplayName = String(form.get("display_name") ?? "");
        const suggestedDisplayName = suggestInvitationName(
          seats
            .filter((seat) => seat.kind === "member" && seat.name)
            .map((seat) => seat.name),
        );
        const invitationWasEdited =
          Boolean(form.get("invitation_edited")) ||
          (Boolean(postedDisplayName) &&
            postedDisplayName !== suggestedDisplayName);
        if (
          form.get("member_action") === "add" &&
          !saveWithPendingInput &&
          memberInput
        ) {
          editDraft = {
            id: householdId,
            updatedAt: String(form.get("updated_at") ?? ""),
            displayName: String(form.get("display_name") ?? ""),
            notes: String(form.get("notes") ?? ""),
            seatCount: Math.min(
              MAX_SEATS,
              Number(form.get("seat_count") ?? names.length) + pendingCount,
            ),
            seats: seats.map((seat, index) => ({
              ...seat,
              slot: index + 1,
              invitedName: seat.invitedName ?? null,
              rsvp: storedRow?.rsvp.state,
            })),
            invitationEdited: invitationWasEdited,
          };
        } else {
          const currentCount =
            Number(form.get("seat_count") ?? names.length) + pendingCount;
          const delta =
            form.get("seat_action") === "add"
              ? 1
              : form.get("seat_action") === "remove"
                ? -1
                : 0;
          // "Remove open seat" without JS submits remove_seat=<id> and comes
          // back as a draft without that seat; with JS the row is removed in
          // place. Both paths carry the ids already removed as removed_seat and
          // have already taken the seat off seat_count, so the save counts it
          // once and still runs when removed_seat is present.
          const removeNow = Number(form.get("remove_seat") ?? 0) || undefined;
          const removedIds = [
            ...form
              .getAll("removed_seat")
              .map((value) => Number(value))
              .filter((value) => Number.isInteger(value) && value > 0),
            ...(removeNow ? [removeNow] : []),
          ];
          if (removeNow) {
            const index = seats.findIndex((seat) => seat.id === removeNow);
            if (index !== -1) seats.splice(index, 1);
          }
          const draftCount = Math.max(
            1,
            currentCount + delta - (removeNow ? 1 : 0),
          );
          const plusOffIds =
            form.get("plus_one") === "off"
              ? seats
                  .filter((seat) => {
                    if (seat.kind !== "plus_one" || seat.name) return false;
                    if (!seat.id) return true;
                    return !storedRow?.seats.find(
                      (stored) => stored.id === seat.id,
                    )?.hasActivity;
                  })
                  .map((seat) => seat.id)
                  .filter((id): id is number => Boolean(id))
              : [];
          const plusOffPending =
            form.get("plus_one") === "off"
              ? seats.filter(
                  (seat) => seat.kind === "plus_one" && !seat.name && !seat.id,
                ).length
              : 0;
          for (const id of plusOffIds)
            if (!removedIds.includes(id)) removedIds.push(id);
          const removablePlusOnes = plusOffIds.length + plusOffPending;
          const retiredCount = seats.filter((seat) => seat.retire).length;
          let finalCount = Math.max(1, draftCount - retiredCount);
          editDraft = {
            id: householdId,
            updatedAt: String(form.get("updated_at") ?? ""),
            displayName: String(form.get("display_name") ?? ""),
            notes: String(form.get("notes") ?? ""),
            seatCount: draftCount,
            removedSeatIds: removedIds,
            seats: seats.map((seat, index) => ({
              ...seat,
              slot: index + 1,
              invitedName: seat.invitedName ?? null,
              hasActivity: seat.id
                ? storedRow?.seats.find((stored) => stored.id === seat.id)
                    ?.hasActivity
                : false,
              namedBy: seat.id
                ? storedRow?.seats.find((stored) => stored.id === seat.id)
                    ?.namedBy
                : null,
              namedByKind: seat.id
                ? storedRow?.seats.find((stored) => stored.id === seat.id)
                    ?.namedByKind
                : null,
              namedAt: seat.id
                ? storedRow?.seats.find((stored) => stored.id === seat.id)
                    ?.namedAt
                : null,
              rsvp: storedRow?.rsvp.state,
            })),
            invitationEdited: invitationWasEdited,
          };
          if (delta > 0 && currentCount >= MAX_SEATS)
            writeError = "Seats must be between 1 and 12.";
          if (form.get("plus_one") === "on")
            editDraft.seatCount = Math.min(
              MAX_SEATS,
              names.filter(Boolean).length + 1,
            );
          if (form.get("plus_one") === "off") {
            finalCount = Math.max(1, draftCount - removablePlusOnes);
            editDraft.seatCount = finalCount;
          }
          if (
            !form.get("seat_action") &&
            !form.get("plus_one") &&
            !form.get("remove_seat") &&
            !form.get("confirm_duplicate")
          ) {
            const duplicate = duplicateFromList(
              seats
                .filter((seat) => seat.kind === "member")
                .map((seat) => seat.name),
              list.rows,
              householdId,
            );
            if (
              duplicate &&
              !confirmedNames.some(
                (name) =>
                  duplicateNameKey(name) === duplicateNameKey(duplicate.name),
              )
            ) {
              duplicateOpenId = duplicate.row.id;
              writeError = `${duplicate.name} is already invited with ${duplicate.row.displayName}.`;
            } else {
              const result = await store.saveHousehold(
                {
                  id: householdId,
                  label: String(form.get("label") ?? ""),
                  updatedAt: String(form.get("updated_at") ?? "") || undefined,
                  displayName: invitationWasEdited
                    ? postedDisplayName
                    : suggestedDisplayName,
                  notes: String(form.get("notes") ?? "") || null,
                  seatCount: finalCount,
                  seats,
                  confirmedNames,
                  removeSeatIds: removedIds.length ? removedIds : undefined,
                },
                host.email,
              );
              if (!result.ok) writeError = result.message;
              else return Astro.redirect(redirectHref(form), 303);
            }
          }
        }
      }
      if (!writeError && action === "archive")
        return Astro.redirect(redirectHref(form), 303);
    } catch (error) {
      writeError =
        error instanceof StaleHouseholdError
          ? error.message
          : error instanceof Error
            ? error.message
            : "Could not save household.";
    }
  }
}
const hostNames = parseAdminHosts(
  String((env as Record<string, unknown>).ADMIN_HOSTS ?? ""),
) ?? { [host.email]: host.firstName };
let data: AdminGuestList | null = null;
let failed = false;
let counts = { households: 0, slipperPairs: 0, songRequests: 0 };
try {
  [data, counts] = await Promise.all([
    store.getGuestList(),
    store.getNavCounts(),
  ]);
} catch {
  failed = true;
  Astro.response.status = 503;
}
const view =
  data ??
  ({
    totals: { households: 0, seatsOffered: 0, unnamedPlusOnes: 0 },
    rows: [],
  } satisfies AdminGuestList);
const requestedFilter = Astro.url.searchParams.get("filter");
const filter = ["all", "waiting", "no-name", "coming", "declined"].includes(
  requestedFilter ?? "",
)
  ? requestedFilter!
  : "all";
const q = Astro.url.searchParams.get("q") ?? "";
const hasUnnamedSeat = (row: AdminHousehold) =>
  row.seats.some(
    (seat) => !seat.name?.trim() && (seat.state ?? "open") === "open",
  );
const filterRows = (value: string) =>
  value === "waiting"
    ? view.rows.filter((row) => row.rsvp.state === "waiting")
    : value === "no-name"
      ? view.rows.filter(hasUnnamedSeat)
      : value === "coming"
        ? view.rows.filter((row) => row.rsvp.state === "coming")
        : value === "declined"
          ? view.rows.filter((row) => row.rsvp.state === "declined")
          : view.rows;
const filteredRows = filterRows(filter);
const queryHref = (next: Record<string, string | null> = {}) => {
  const params = new URLSearchParams();
  const values = { filter: filter === "all" ? null : filter, q, ...next };
  for (const [key, value] of Object.entries(values))
    if (value) params.set(key, value);
  return `${Astro.url.pathname}${params.toString() ? `?${params}` : ""}`;
};
function redirectHref(form: FormData, extra: Record<string, string> = {}) {
  const params = new URLSearchParams();
  const postedFilter = String(form.get("filter") ?? "");
  const postedQ = String(form.get("q") ?? "");
  if (["waiting", "no-name", "coming", "declined"].includes(postedFilter))
    params.set("filter", postedFilter);
  if (postedQ) params.set("q", postedQ);
  for (const [key, value] of Object.entries(extra)) params.set(key, value);
  return `/admin/guests${params.toString() ? `?${params}` : ""}`;
}
const filterCounts = {
  all: view.rows.length,
  waiting: filterRows("waiting").length,
  "no-name": filterRows("no-name").length,
  coming: filterRows("coming").length,
  declined: filterRows("declined").length,
};
const rsvpText = (rsvp: { state: string; coming?: number }, seatCount: number) =>
  rsvp.state === "coming"
    ? `${rsvp.coming} of ${seatCount} coming`
    : rsvp.state === "declined"
      ? `Declined · ${seatCount} ${seatCount === 1 ? "seat" : "seats"}`
      : `Waiting · ${seatCount} ${seatCount === 1 ? "seat" : "seats"}`;
const editId = Astro.url.searchParams.get("edit");
if (!newDraft.memberNames.length) newDraft.memberNames = [""];
const takenIds = view.rows.flatMap((row) => [row.id, row.label]);
if (!newDraft.label)
  newDraft.label = generateHostId(
    newDraft.invitationEdited
      ? newDraft.displayName
      : suggestInvitationName(newDraft.memberNames.filter(Boolean)),
    takenIds,
  );
const archiveId = Astro.url.searchParams.get("archive");
const newOpen = Astro.url.searchParams.get("new") === "1";
const archiveRow = view.rows.find((row) => row.id === archiveId);
const takenHouseholds = view.rows.map((row) => ({
  id: row.id,
  label: row.label,
  displayName: row.displayName,
  names: row.seats
    .flatMap((seat) => [seat.name, seat.invitedName])
    .filter((name): name is string => Boolean(name)),
}));
// A refusal shows inside the open edit or new row, above its bottom line; any
// other failure (an archive, a failed load) keeps the page-level notice.
const errorInRow =
  Boolean(writeError) &&
  (newOpen || view.rows.some((row) => row.id === editId));
const reloadParams = new URLSearchParams();
for (const key of ["filter", "q"]) {
  const value = Astro.url.searchParams.get(key);
  if (value) reloadParams.set(key, value);
}
if (writeHouseholdId) reloadParams.set("edit", writeHouseholdId);
const reloadHref = writeError.startsWith("This household")
  ? `/admin/guests?${reloadParams}`
  : undefined;
const editSeats = (row: AdminHousehold) => {
  const draft = editDraft?.id === row.id ? editDraft : null;
  const source: DraftSeat[] = draft
    ? draft.seats.map((seat) => ({ ...seat }))
    : row.seats.map((seat) => ({
        id: seat.id,
        slot: seat.slot,
        kind: seat.kind,
        name: seat.name ?? "",
        invitedName: seat.invitedName,
        hasActivity: seat.hasActivity,
        rsvp: row.rsvp.state,
        namedBy: seat.namedBy,
        namedByKind: seat.namedByKind,
        namedAt: seat.namedAt,
      }));
  const retiredCount = source.filter((seat) => seat.retire).length;
  const target = draft
    ? Math.max(1, draft.seatCount - retiredCount)
    : row.seatCount;
  while (source.filter((seat) => !seat.retire).length > target) {
    const index = source.findLastIndex((seat) => !seat.retire);
    if (index < 0) break;
    source.splice(index, 1);
  }
  while (source.filter((seat) => !seat.retire).length < target)
    source.push({
      id: undefined,
      slot: source.length + 1,
      kind: "plus_one",
      name: "",
      invitedName: null,
      rsvp: row.rsvp.state,
    });
  return source;
};
---

<AdminLayout active="guests" host={host} counts={counts}>
  <section id="guests" class="admin-guests_wrap" data-admin-guests-page>
    {
      host.sample && (
        <p class="admin_sample" data-admin-sample>
          Sample data
        </p>
      )
    }
    {
      failed ? (
        <div class="admin_notice error" data-admin-error>
          <h1>Couldn't load the guest data</h1>
          <a href={Astro.url.pathname}>Try again</a>
        </div>
      ) : view.totals.households === 0 &&
        Astro.url.searchParams.get("new") !== "1" ? (
        <div class="admin_notice empty" data-admin-empty>
          <h1>No guests yet</h1>
          <p>The guest list hasn't been loaded.</p>
        </div>
      ) : (
        <>
          <header class="admin-guests_header">
            <p class="admin_label">
              Who's invited · Seats first, names when you know them
            </p>
            <div class="admin-guests_title">
              <h1>Guest list</h1>
              <a class="admin_guests_add" href={queryHref({ new: "1" })}>
                + Add household
              </a>
            </div>
          </header>
          {writeError && !errorInRow && (
            <p class="admin_guests_error page" data-admin-write-error>
              {writeError} {reloadHref && <a href={reloadHref}>Reload</a>}
            </p>
          )}
          <div class="admin-guests_toolbar">
            <dl class="admin-guests_stats">
              <div>
                <dt>Households</dt>
                <dd>{view.totals.households}</dd>
              </div>
              <div>
                <dt>Seats offered</dt>
                <dd>{view.totals.seatsOffered}</dd>
              </div>
              <div class="quiet">
                <dt>
                  <a href={queryHref({ filter: "no-name" })}>
                    Plus-ones not named yet
                  </a>
                </dt>
                <dd>
                  <a href={queryHref({ filter: "no-name" })}>
                    {view.totals.unnamedPlusOnes}
                  </a>
                </dd>
              </div>
              <div>
                <dt>
                  <a href={queryHref({ filter: "waiting" })}>Waiting</a>
                </dt>
                <dd>
                  <a href={queryHref({ filter: "waiting" })}>
                    {filterCounts.waiting}
                  </a>
                </dd>
              </div>
            </dl>
            <div class="admin-guests_tools">
              <nav aria-label="Guest list filters" data-admin-filters>
                {(
                  [
                    ["all", "All"],
                    ["waiting", "Waiting"],
                    ["no-name", "No name yet"],
                    ["coming", "Coming"],
                    ["declined", "Declined"],
                  ] as const
                ).map(([key, label]) => (
                  <a
                    href={queryHref({ filter: key === "all" ? null : key })}
                    aria-current={filter === key ? "page" : undefined}
                    data-admin-filter={key}
                  >
                    <span>{label}</span>{" "}
                    <span class="admin-rsvps_count">{filterCounts[key]}</span>
                  </a>
                ))}
              </nav>
              <div class="admin-guests_search">
                <label class="sr-only" for="admin-search">
                  Search households or guests
                </label>
                <input
                  id="admin-search"
                  data-admin-search
                  type="search"
                  placeholder="Search households or guests"
                  autocomplete="off"
                  value={q}
                />
              </div>
            </div>
          </div>
          <p
            class="admin-guests_no-match"
            data-admin-no-match
            hidden={filteredRows.length > 0}
          >
            No households match
          </p>
          <div class="admin-guests_card">
            <table class="admin-guests_table" data-admin-guests>
              <thead>
                <tr>
                  <th data-col="household">Household</th>
                  <th data-col="members">Members · Notes</th>
                  <th data-col="rsvp">RSVP</th>
                </tr>
              </thead>
              <tbody>
                {filteredRows.map((row) => {
                  const plusOnes = row.seats.filter(
                    (seat) => seat.kind === "plus_one",
                  );
                  if (archiveRow?.id === row.id)
                    return (
                      <tr
                        class="admin-guests_archive-row"
                        data-admin-archive-confirm
                      >
                        <td colspan={4}>
                          <div class="admin_guests_confirm">
                            <p>Archive {archiveRow.displayName}?</p>
                            <form method="post">
                              <input
                                type="hidden"
                                name="action"
                                value="archive"
                              />
                              <input
                                type="hidden"
                                name="id"
                                value={archiveRow.id}
                              />
                              <input
                                type="hidden"
                                name="updated_at"
                                value={archiveRow.updatedAt ?? ""}
                              />
                              <input
                                type="hidden"
                                name="filter"
                                value={filter === "all" ? "" : filter}
                              />
                              <input type="hidden" name="q" value={q} />
                              <div class="admin_guests_form-actions">
                                <button
                                  class="admin_guests_btn accent"
                                  type="submit"
                                >
                                  Archive
                                </button>
                                <a
                                  class="admin_guests_btn"
                                  href={queryHref({ archive: null })}
                                >
                                  Cancel
                                </a>
                              </div>
                            </form>
                          </div>
                        </td>
                      </tr>
                    );
                  return (
                    <tr
                      data-admin-household
                      data-household-id={row.id}
                      data-household-label={row.label}
                      data-invited-names={row.seats
                        .flatMap((seat) => [seat.name, seat.invitedName])
                        .filter(Boolean)
                        .join("|")}
                      data-search={[
                        row.displayName,
                        row.label,
                        ...row.seats.map((seat) => seat.name ?? ""),
                      ]
                        .join(" ")
                        .toLocaleLowerCase()}
                    >
                      <th data-col="household" scope="row">
                        {row.displayName}
                        <small class="admin-guests_id">{row.label}</small>
                      </th>
                      <td data-col="members">
                        <div class="admin-guests_detail">
                          <div>
                            {memberLine(
                              row.seats
                                .filter((seat) => seat.kind === "member")
                                .map((seat) => seat.name ?? ""),
                            )}
                            {row.seats.some(
                              (seat) =>
                                seat.kind === "member" &&
                                seat.name &&
                                seat.invitedName &&
                                seat.name !== seat.invitedName,
                            ) && (
                              <small class="admin_guests_renamed">renamed</small>
                            )}
                          </div>
                          {plusOnes.length > 0 && (
                            <div class="admin-guests_chips">
                              {plusOnes.map((seat) => (
                                <span
                                  data-admin-plus-one
                                  data-state={seat.state}
                                >
                                  {plusOneChipText(
                                    {
                                      ...seat,
                                      state: seat.state ?? "open",
                                    },
                                    hostNames,
                                  )}
                                </span>
                              ))}
                            </div>
                          )}
                          {row.notes && (
                            <small class="admin_guests_note">{row.notes}</small>
                          )}
                        </div>
                      </td>
                      <td data-col="rsvp">
                        <span
                          class="admin_pill"
                          data-admin-rsvp
                          data-state={row.rsvp.state}
                        >
                          {rsvpText(row.rsvp, row.seatCount)}
                        </span>
                        <details class="admin_guests_menu">
                          <summary
                            aria-label={`Actions for ${row.displayName}`}
                          >
                            ⋯
                          </summary>
                          <div class="admin_guests_popover">
                            <a
                              data-admin-edit
                              href={queryHref({ edit: row.id })}
                            >
                              Edit
                            </a>
                            <a href={queryHref({ archive: row.id })}>
                              Archive household
                            </a>
                          </div>
                        </details>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          {Astro.url.searchParams.get("added") && (
            <p class="admin_notice" data-admin-added>
              Added {Astro.url.searchParams.get("added")}
            </p>
          )}
          {(newOpen ||
            (editId && view.rows.some((row) => row.id === editId))) &&
            (newOpen ? (
              <GuestHouseholdForm
                variant="new"
                draft={newDraft}
                takenIds={takenIds}
                duplicateOpenId={duplicateOpenId}
                error={errorInRow ? writeError : undefined}
                reloadHref={reloadHref}
                takenHouseholds={takenHouseholds}
              />
            ) : (
              (() => {
                const row = view.rows.find((item) => item.id === editId)!;
                return (
                  <GuestHouseholdForm
                    variant="edit"
                    row={row}
                    seats={editSeats(row)}
                    removedSeatIds={
                      editDraft?.id === row.id
                        ? editDraft.removedSeatIds
                        : undefined
                    }
                    takenIds={takenIds}
                    duplicateOpenId={duplicateOpenId}
                    updatedAt={
                      editDraft?.id === row.id
                        ? editDraft.updatedAt
                        : (row.updatedAt ?? "")
                    }
                    displayName={
                      editDraft?.id === row.id
                        ? editDraft.displayName
                        : row.displayName
                    }
                    notes={
                      editDraft?.id === row.id
                        ? editDraft.notes
                        : (row.notes ?? "")
                    }
                    error={errorInRow ? writeError : undefined}
                    reloadHref={reloadHref}
                    takenHouseholds={takenHouseholds}
                    invitationEdited={
                      editDraft?.id === row.id
                        ? editDraft.invitationEdited
                        : undefined
                    }
                    hostNames={hostNames}
                  />
                );
              })()
            ))}
        </>
      )
    }
  </section>
</AdminLayout>
<script>
  import {
    duplicateNameKey,
    generateHostId,
    normalizeName,
    parsePlusOne,
    suggestInvitationName,
  } from "@/lib/admin/names";

  const input = document.querySelector<HTMLInputElement>("[data-admin-search]");
  const rows = [
    ...document.querySelectorAll<HTMLElement>("[data-admin-household]"),
  ];
  const guestPage = document.querySelector<HTMLElement>(
    "[data-admin-guests-page]",
  );
  const closeGuestMenus = () => {
    for (const menu of guestPage?.querySelectorAll<HTMLDetailsElement>(
      "details.admin_guests_menu[open]",
    ) ?? [])
      menu.open = false;
  };
  guestPage?.addEventListener(
    "toggle",
    (event) => {
      const menu = event.target;
      if (!(menu instanceof HTMLDetailsElement) || !menu.matches(".admin_guests_menu"))
        return;
      menu.removeAttribute("data-up");
      if (!menu.open) return;

      for (const other of guestPage.querySelectorAll<HTMLDetailsElement>(
        "details.admin_guests_menu[open]",
      ))
        if (other !== menu) other.open = false;

      if (window.matchMedia("(width < 84rem)").matches) {
        const popover = menu.querySelector(".admin_guests_popover");
        const tabbar = document.querySelector("[data-admin-tabbar]");
        const bottom = window.innerHeight - (tabbar?.getBoundingClientRect().height ?? 0);
        if (popover && popover.getBoundingClientRect().bottom > bottom)
          menu.setAttribute("data-up", "");
      }
    },
    true,
  );
  document.addEventListener("click", (event) => {
    const mouse = event as MouseEvent;
    if (
      mouse.button !== 0 ||
      mouse.metaKey ||
      mouse.ctrlKey ||
      mouse.shiftKey ||
      mouse.altKey
    )
      return;
    const target = event.target as Element;
    if (!target.closest(".admin_guests_menu")) closeGuestMenus();
  });
  const empty = document.querySelector<HTMLElement>("[data-admin-no-match]");
  const normalizeSearch = (value: string) => duplicateNameKey(value);
  const syncLinks = () => {
    const query = input?.value ?? "";
    for (const link of document.querySelectorAll<HTMLAnchorElement>(
      "[data-admin-guests-page] a[href*='/admin/guests']",
    )) {
      const url = new URL(link.href, location.origin);
      if (query) url.searchParams.set("q", query);
      else url.searchParams.delete("q");
      link.setAttribute("href", `${url.pathname}${url.search}`);
    }
    for (const field of document.querySelectorAll<HTMLInputElement>(
      "[data-admin-guests-page] form input[name='q']",
    ))
      field.value = query;
  };
  const filterRows = () => {
    if (!input) return;
    const query = normalizeSearch(input.value);
    let visible = 0;
    for (const row of rows) {
      row.hidden = !normalizeSearch(row.dataset.search ?? "").includes(query);
      if (!row.hidden) visible += 1;
    }
    if (empty) empty.hidden = visible !== 0;
    const url = new URL(location.href);
    if (input.value) url.searchParams.set("q", input.value);
    else url.searchParams.delete("q");
    history.replaceState(null, "", url);
    syncLinks();
  };
  input?.addEventListener("input", filterRows);
  if (input?.value) filterRows();

  let opener: HTMLElement | null = null;
  const guestFormValues = (form: HTMLFormElement) =>
    [...form.elements]
      .filter(
        (
          element,
        ): element is
          HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement =>
          element instanceof HTMLInputElement ||
          element instanceof HTMLSelectElement ||
          element instanceof HTMLTextAreaElement,
      )
      .filter(
        (element) =>
          element.name &&
          !["submit", "button", "reset", "image"].includes(element.type),
      )
      .map((element) => {
        if (
          element instanceof HTMLInputElement &&
          (element.type === "checkbox" || element.type === "radio")
        )
          return `${element.name}=${element.checked ? element.value : ""}`;
        return `${element.name}=${element.value}`;
      })
      .join("\u0000");
  const guestFormInitialValues = new WeakMap<HTMLFormElement, string>();
  const rememberGuestForm = (form: HTMLFormElement) => {
    if (!guestFormInitialValues.has(form))
      guestFormInitialValues.set(form, guestFormValues(form));
  };
  const guestFormIsDirty = (form: HTMLFormElement) =>
    form.dataset.dirtyStart === "true" ||
    (guestFormInitialValues.get(form) !== undefined &&
      guestFormInitialValues.get(form) !== guestFormValues(form));
  const currentGuestFormIsDirty = () => {
    const form = document.querySelector<HTMLFormElement>(
      "[data-admin-drawer]:not([data-closing]) [data-admin-household-form]",
    );
    return Boolean(form && !form.dataset.submitting && guestFormIsDirty(form));
  };
  const discardMessage = "Discard your changes to this household?";
  const confirmDiscard = () =>
    !currentGuestFormIsDirty() || window.confirm(discardMessage);
  let discardConfirmed = false;
  document.addEventListener("input", () => {
    discardConfirmed = false;
  });
  let stopKeyboardTracking: (() => void) | null = null;
  const clearKeyboardTracking = () => {
    const stop = stopKeyboardTracking;
    stopKeyboardTracking = null;
    stop?.();
  };
  const trackKeyboard = (drawer: HTMLElement) => {
    clearKeyboardTracking();
    const panel = drawer.querySelector<HTMLElement>(".admin_guests_panel");
    const scroll = drawer.querySelector<HTMLElement>(
      ".admin_guests_drawer_scroll",
    );
    const viewport = window.visualViewport;
    if (!panel || !scroll || !viewport) return;
    const media = window.matchMedia("(max-width: 63.999rem)");

    let frame = 0;
    let previous = -1;
    let keyboardOpen = false;
    let focusedForOpening = false;
    let listening = false;
    const clearPanel = () => {
      panel.style.removeProperty("--guest-sheet-keyboard");
      panel.removeAttribute("data-keyboard-open");
      previous = -1;
      keyboardOpen = false;
      focusedForOpening = false;
    };
    const update = () => {
      frame = 0;
      if (!media.matches) return;
      const keyboard = Math.max(
        0,
        Math.round(window.innerHeight - viewport.height - viewport.offsetTop),
      );
      if (keyboard !== previous) {
        panel.style.setProperty("--guest-sheet-keyboard", `${keyboard}px`);
        panel.toggleAttribute("data-keyboard-open", keyboard > 80);
        previous = keyboard;
      }
      if (keyboard > 80 && !keyboardOpen) {
        keyboardOpen = true;
        focusedForOpening = false;
      } else if (keyboard <= 80) {
        keyboardOpen = false;
        focusedForOpening = false;
      }
      if (keyboardOpen && !focusedForOpening) {
        const active = document.activeElement;
        if (active instanceof HTMLElement && scroll.contains(active)) {
          focusedForOpening = true;
          active.scrollIntoView({ block: "nearest" });
        }
      }
    };
    const schedule = () => {
      if (!frame) frame = window.requestAnimationFrame(update);
    };
    const addViewportListeners = () => {
      if (listening) return;
      viewport.addEventListener("resize", schedule);
      viewport.addEventListener("scroll", schedule);
      listening = true;
    };
    const removeViewportListeners = () => {
      if (!listening) return;
      viewport.removeEventListener("resize", schedule);
      viewport.removeEventListener("scroll", schedule);
      listening = false;
    };
    const onMediaChange = () => {
      if (media.matches) {
        addViewportListeners();
        update();
      } else {
        removeViewportListeners();
        clearPanel();
      }
    };
    media.addEventListener("change", onMediaChange);
    stopKeyboardTracking = () => {
      if (frame) window.cancelAnimationFrame(frame);
      removeViewportListeners();
      media.removeEventListener("change", onMediaChange);
      clearPanel();
    };
    if (media.matches) {
      addViewportListeners();
      update();
    }
  };
  const setDrawerOpen = (open: boolean) => {
    if (open) closeGuestMenus();
    document.documentElement.toggleAttribute("data-admin-drawer-open", open);
  };
  const currentDrawerUrl = () => {
    const url = new URL(location.href);
    const form = document.querySelector<HTMLFormElement>(
      "[data-admin-drawer]:not([data-closing]) [data-admin-household-form]",
    );
    url.searchParams.delete("new");
    url.searchParams.delete("edit");
    if (form?.dataset.variant === "new") url.searchParams.set("new", "1");
    else {
      const id =
        form?.querySelector<HTMLInputElement>("input[name='id']")?.value;
      if (id) url.searchParams.set("edit", id);
    }
    return `${url.pathname}${url.search}`;
  };
  const removeDrawer = (drawer: HTMLElement) => {
    clearKeyboardTracking();
    drawer.remove();
    setDrawerOpen(false);
  };
  const removeAnyDrawers = () => {
    for (const drawer of document.querySelectorAll<HTMLElement>(
      "[data-admin-drawer]",
    ))
      removeDrawer(drawer);
  };
  const closeDrawerElement = (drawer: HTMLElement) => {
    drawer.setAttribute("data-closing", "");
    drawer.inert = true;
    const panel = drawer.querySelector<HTMLElement>(".admin-drawer_panel");
    let finished = false;
    const finish = () => {
      if (finished) return;
      finished = true;
      panel?.removeEventListener("animationend", onAnimationEnd);
      removeDrawer(drawer);
    };
    const onAnimationEnd = (event: AnimationEvent) => {
      if (
        event.target === panel &&
        (event.animationName === "admin-drawer-down" ||
          event.animationName === "admin-drawer-out")
      )
        finish();
    };
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      finish();
      return;
    }
    panel?.addEventListener("animationend", onAnimationEnd);
    window.setTimeout(finish, 300);
  };
  // Callers confirm a dirty discard first; popstate has already asked.
  const beginDrawerClose = (pushHistory: boolean) => {
    if (pushHistory) {
      const url = new URL(location.href);
      url.searchParams.delete("new");
      url.searchParams.delete("edit");
      history.pushState(null, "", `${url.pathname}${url.search}`);
    }
    const drawer = document.querySelector<HTMLElement>(
      "[data-admin-drawer]:not([data-closing])",
    );
    if (!drawer) return;
    opener?.focus();
    closeDrawerElement(drawer);
  };
  const closeDrawer = () => {
    if (!confirmDiscard()) return;
    beginDrawerClose(true);
  };
  const loadDrawer = async (href: string, push = true) => {
    closeGuestMenus();
    try {
      const response = await fetch(href, { headers: { Accept: "text/html" } });
      if (!response.ok) throw new Error("drawer request failed");
      const next = new DOMParser()
        .parseFromString(await response.text(), "text/html")
        .querySelector<HTMLElement>("[data-admin-drawer]");
      const page = document.querySelector<HTMLElement>(
        "[data-admin-guests-page]",
      );
      if (!next || !page) throw new Error("drawer missing");
      removeAnyDrawers();
      page.append(next);
      if (push) history.pushState(null, "", href);
      setDrawerOpen(true);
      hydrateDrawer(next);
      // The discard was for the drawer just replaced; the new one starts clean,
      // and its stepper/switch changes fire no input event to clear the flag.
      discardConfirmed = false;
      syncLinks();
      next.querySelector<HTMLElement>("h2")?.focus();
    } catch {
      if (currentGuestFormIsDirty()) discardConfirmed = true;
      location.href = href;
    }
  };
  document.addEventListener("click", (event) => {
    const target = event.target as Element;
    const mouse = event as MouseEvent;
    if (
      mouse.button !== 0 ||
      mouse.metaKey ||
      mouse.ctrlKey ||
      mouse.shiftKey ||
      mouse.altKey
    )
      return;
    const link = target.closest<HTMLAnchorElement>(
      "[data-admin-edit], .admin_guests_add",
    );
    if (link) {
      closeGuestMenus();
      const dirty = currentGuestFormIsDirty();
      if (!confirmDiscard()) {
        event.preventDefault();
        return;
      }
      event.preventDefault();
      if (dirty) discardConfirmed = true;
      opener = link;
      void loadDrawer(link.href);
      return;
    }
    const duplicateOpen = target.closest<HTMLAnchorElement>(
      "[data-duplicate-open]",
    );
    if (duplicateOpen) {
      closeGuestMenus();
      const dirty = currentGuestFormIsDirty();
      if (!confirmDiscard()) {
        event.preventDefault();
        return;
      }
      event.preventDefault();
      if (dirty) discardConfirmed = true;
      void loadDrawer(duplicateOpen.href);
      return;
    }
    const drawer = document.querySelector<HTMLElement>(
      "[data-admin-drawer]:not([data-closing])",
    );
    const clickedLink = target.closest<HTMLAnchorElement>("a");
    if (clickedLink && drawer?.contains(clickedLink)) {
      const url = new URL(clickedLink.href, location.href);
      const isArchive = url.searchParams.has("archive");
      const isReload = Boolean(clickedLink.closest("[data-admin-write-error]"));
      if (isArchive || isReload) {
        const dirty = currentGuestFormIsDirty();
        if (!confirmDiscard()) {
          event.preventDefault();
          return;
        }
        if (dirty) discardConfirmed = true;
        return;
      }
    }
    if (target.closest("[data-admin-drawer-close], .admin-drawer_scrim")) {
      event.preventDefault();
      closeDrawer();
      return;
    }
    const dashboardNav = target.closest<HTMLAnchorElement>(
      "[data-admin-nav] a, [data-admin-tabbar] a, [data-admin-filter], .admin_brand, .admin_topbar a, .admin_account a",
    );
    if (dashboardNav) {
      const dirty = currentGuestFormIsDirty();
      if (!confirmDiscard()) event.preventDefault();
      else if (dirty) discardConfirmed = true;
    }
  });
  document.addEventListener("keydown", (event) => {
    const drawer = document.querySelector<HTMLElement>(
      "[data-admin-drawer]:not([data-closing])",
    );
    if (!drawer) {
      if (event.key !== "Escape") return;
      const menu = guestPage?.querySelector<HTMLDetailsElement>(
        "details.admin_guests_menu[open]",
      );
      if (!menu) return;
      event.preventDefault();
      const summary = menu.querySelector<HTMLElement>("summary");
      closeGuestMenus();
      summary?.focus();
      return;
    }
    if (event.key === "Escape") {
      event.preventDefault();
      closeDrawer();
      return;
    }
    if (event.key !== "Tab") return;
    const focusable = [
      ...drawer.querySelectorAll<HTMLElement>(
        "a,button,input,textarea,summary,[tabindex]:not([tabindex='-1'])",
      ),
    ];
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable.at(-1)!;
    const active = document.activeElement as HTMLElement | null;
    if (!drawer.contains(active) || !active || !focusable.includes(active)) {
      event.preventDefault();
      (event.shiftKey ? last : first).focus();
    } else if (event.shiftKey && active === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && active === last) {
      event.preventDefault();
      first.focus();
    }
  });
  window.addEventListener("popstate", () => {
    const url = new URL(location.href);
    const form = document.querySelector<HTMLFormElement>(
      "[data-admin-drawer]:not([data-closing]) [data-admin-household-form]",
    );
    if (form && (url.searchParams.has("new") || url.searchParams.has("edit"))) {
      const current = currentDrawerUrl();
      if (current !== `${url.pathname}${url.search}` && !confirmDiscard()) {
        history.pushState(null, "", current);
        return;
      }
    } else if (form && !confirmDiscard()) {
      history.pushState(null, "", currentDrawerUrl());
      return;
    }
    if (url.searchParams.has("new") || url.searchParams.has("edit"))
      void loadDrawer(url.href, false);
    else {
      beginDrawerClose(false);
    }
  });
  window.addEventListener("beforeunload", (event) => {
    if (discardConfirmed || !currentGuestFormIsDirty()) return;
    event.preventDefault();
    event.returnValue = "";
  });
  window.addEventListener("pageshow", (event) => {
    discardConfirmed = false;
    if (!event.persisted) return;
    for (const form of document.querySelectorAll<HTMLFormElement>(
      "[data-admin-household-form]",
    )) {
      delete form.dataset.submitting;
      for (const mirror of form.querySelectorAll<HTMLInputElement>(
        "[data-admin-submit-mirror]",
      ))
        mirror.remove();
      for (const button of form.querySelectorAll<HTMLButtonElement>(
        "button[type='submit'][name='save'], button[type='submit'][name='save_and_add']",
      )) {
        button.disabled = false;
        button.textContent =
          button.name === "save_and_add" ? "Save and add another" : "Save";
      }
    }
  });

  function hydrateDrawer(drawer: HTMLElement) {
    const form = drawer.querySelector<HTMLFormElement>(
      "[data-admin-household-form]",
    );
    if (!form) return;
    trackKeyboard(drawer);
    // The no-JS "Add" button is hidden once the script owns Enter.
    form.dataset.js = "true";
    // A drawer the server re-rendered after a refused save holds a draft that
    // was never stored, so it starts dirty. Read this before sync(): sync()
    // shows the duplicate warning for any shared name, refused or not.
    const refusedOnLoad = Boolean(
      form.querySelector("[data-admin-write-error]") ||
        form.querySelector("[data-duplicate-warning]:not([hidden])"),
    );
    const addInput = form.querySelector<HTMLInputElement>("[data-add-name]");
    const list = form.querySelector<HTMLElement>("[data-name-list]");
    const count = form.querySelector<HTMLInputElement>(
      "[data-seat-count-input]",
    );
    const output = form.querySelector<HTMLOutputElement>("[data-seat-output]");
    const summary = form.querySelector<HTMLElement>("[data-seat-summary]");
    const invitation = form.querySelector<HTMLInputElement>("#display-name");
    const preview = form.querySelector<HTMLElement>("[data-preview-name]");
    const admits = form.querySelector<HTMLElement>("[data-preview-admits]");
    const toggle = form.querySelector<HTMLButtonElement>(
      "[data-plus-one-toggle]",
    );
    const hint = form.querySelector<HTMLElement>("[data-invitation-hint]");
    const restore = form.querySelector<HTMLButtonElement>(
      "[data-restore-suggestion]",
    );
    const hostId = form.querySelector<HTMLInputElement>("input[name='label']");
    const hostIdText = form.querySelector<HTMLElement>("[data-host-id]");
    const labelEdited = form.querySelector<HTMLInputElement>(
      "[data-label-edited]",
    );
    const generatedLabel = form.querySelector<HTMLInputElement>(
      "[name='generated_label']",
    );
    const invitationEdited = form.querySelector<HTMLInputElement>(
      "[data-invitation-edited]",
    );
    const warning = form.querySelector<HTMLElement>("[data-duplicate-warning]");
    const warningMessage = form.querySelector<HTMLElement>(
      "[data-duplicate-message]",
    );
    const openLink = form.querySelector<HTMLAnchorElement>(
      "[data-duplicate-open]",
    );
    const confirmed = new Set<string>();
    const isEdit = form.dataset.variant === "edit";
    const currentId =
      form.querySelector<HTMLInputElement>("input[name='id']")?.value;
    const households = JSON.parse(
      drawer.dataset.adminHouseholds ?? "[]",
    ) as Array<{
      id: string;
      label: string;
      displayName: string;
      names: string[];
    }>;
    const allNames = () =>
      isEdit
        ? [
            ...form.querySelectorAll<HTMLInputElement>(
              "[data-seat-row]:not(.is-retired) input[name='seat_name']",
            ),
          ]
            .map((field) => normalizeName(field.value))
            .filter(Boolean)
        : [
            ...form.querySelectorAll<HTMLInputElement>(
              "input[name='member_name']",
            ),
          ]
            .map((field) => normalizeName(field.value))
            .filter(Boolean);
    const takenNames = () =>
      households
        .filter((household) => household.id !== currentId)
        .flatMap((household) => household.names);
    const updateDuplicate = () => {
      const names = allNames();
      const duplicate = names.find((name) =>
        takenNames().some(
          (taken) => duplicateNameKey(taken) === duplicateNameKey(name),
        ),
      );
      if (!duplicate || confirmed.has(duplicateNameKey(duplicate))) {
        if (warning) warning.hidden = true;
        return;
      }
      const row = households.find((household) =>
        household.names.some(
          (taken) => duplicateNameKey(taken) === duplicateNameKey(duplicate),
        ),
      );
      if (warningMessage)
        warningMessage.textContent = `${duplicate} is already invited with ${row?.displayName ?? "another household"}.`;
      if (openLink && row?.id) {
        const url = new URL(location.href);
        url.searchParams.set("edit", row.id);
        openLink.href = `${url.pathname}${url.search}`;
        openLink.hidden = false;
      }
      if (warning) warning.hidden = false;
    };
    const seatNames = () => allNames();
    // Invited members only: the suggestion and the host ID never use a
    // plus-one's name.
    const memberNames = () =>
      isEdit
        ? [
            ...form.querySelectorAll<HTMLInputElement>(
              "[data-seat-row][data-seat-kind='member']:not(.is-retired) input[name='seat_name']",
            ),
          ]
            .map((field) => normalizeName(field.value))
            .filter(Boolean)
        : allNames();
    const sync = () => {
      if (!count) return;
      const names = seatNames();
      const draftSeats = Math.max(
        1,
        names.length,
        Math.min(12, Number(count.value) || names.length),
      );
      const retiredCount = isEdit
        ? form.querySelectorAll("[data-seat-row].is-retired").length
        : 0;
      const seats = Math.max(1, draftSeats - retiredCount);
      count.value = String(draftSeats);
      if (output) output.value = String(seats);
      if (summary) {
        const open = !isEdit && names.length === 0 ? 0 : seats - names.length;
        const noun = isEdit ? "open seat" : "plus-one";
        const number = summary.querySelector("[data-seat-number]");
        const unit = summary.querySelector("[data-seat-unit]");
        const rest = summary.querySelector("[data-seat-rest]");
        if (number) number.textContent = String(seats);
        if (unit) unit.textContent = seats === 1 ? "seat" : "seats";
        if (rest)
          rest.textContent = `· ${names.length} ${names.length === 1 ? "name" : "names"} + ${open} ${noun}${open === 1 ? "" : "s"}${isEdit && open > 0 ? " · plus-one allowed" : ""}`;
      }
      if (toggle) {
        const plusOne = (isEdit || names.length > 0) && seats > names.length;
        toggle.setAttribute("aria-pressed", plusOne ? "true" : "false");
        toggle.value = plusOne ? "off" : "on";
      }
      const members = memberNames();
      const nextSuggestion = suggestInvitationName(members);
      // The ID follows the invitation name (typed or suggested) until the host
      // uses Edit ID; an existing household keeps its ID.
      const idSource = invitation?.dataset.edited
        ? invitation.value
        : nextSuggestion;
      if (hostId && !isEdit && !hostId.dataset.edited && idSource) {
        const taken = households.flatMap((household) => [
          household.id,
          household.label,
        ]);
        hostId.value = generateHostId(idSource, taken);
        if (generatedLabel) generatedLabel.value = hostId.value;
        if (hostIdText) hostIdText.textContent = hostId.value;
      }
      if (invitation && !invitation.dataset.edited)
        invitation.value = nextSuggestion;
      if (preview) preview.textContent = invitation?.value ?? nextSuggestion;
      if (admits) admits.textContent = `Admits ${seats}`;
      const hintText = hint?.querySelector<HTMLElement>("[data-hint-text]");
      if (hintText)
        hintText.textContent = invitation?.dataset.edited
          ? "Your own · "
          : "Suggested from the names · edit freely";
      if (restore) {
        restore.hidden = !invitation?.dataset.edited;
        restore.textContent = `use suggestion: ${nextSuggestion}`;
      }
      updateDuplicate();
    };
    const addChip = (value: string) => {
      if (!list) return;
      const chip = document.createElement("span");
      chip.className = "admin_guests_name-chip";
      chip.dataset.nameChip = "true";
      const text = document.createElement("span");
      text.textContent = value;
      const remove = document.createElement("button");
      remove.type = "button";
      remove.dataset.removeName = "true";
      remove.setAttribute("aria-label", `Remove ${value}`);
      remove.textContent = "×";
      const hidden = document.createElement("input");
      hidden.type = "hidden";
      hidden.name = "member_name";
      hidden.value = value;
      chip.append(text, remove, hidden);
      list.insertBefore(chip, addInput?.closest("label") ?? null);
    };
    const addEditRow = (value: string, plusOnes: number) => {
      if (!list) return;
      const countToAdd = plusOnes || 1;
      for (let index = 0; index < countToAdd; index += 1) {
        const row = document.createElement("div");
        row.className = "admin_guests_person";
        row.dataset.seatRow = "true";
        row.dataset.seatKind = plusOnes ? "plus_one" : "member";
        const name = value && !plusOnes ? value : "";
        row.innerHTML = `<input type='hidden' name='seat_id' value=''><input type='hidden' name='seat_name' value=''><input type='hidden' name='invited_name' value=''><div class='admin_guests_person_identity'><strong></strong><small></small></div><div class='admin_guests_person_rsvp'>—</div><div class='admin_guests_person_action'></div>`;
        const nameField = row.querySelector<HTMLInputElement>(
          "input[name='seat_name']",
        )!;
        nameField.value = name;
        const strong = row.querySelector("strong")!;
        strong.textContent = name || "Open seat · no name yet";
        row.querySelector("small")!.textContent = name
          ? `Invited as ${name} · lead`
          : "+1 · They name their guest in the RSVP.";
        list.insertBefore(row, addInput?.closest("label") ?? null);
      }
    };
    const addValue = () => {
      const value = normalizeName(addInput?.value ?? "");
      const plusOnes = parsePlusOne(value);
      if (!value || !list) return;
      if (isEdit) addEditRow(plusOnes ? "" : value, plusOnes);
      else if (plusOnes)
        count!.value = String(Math.min(12, Number(count!.value) + plusOnes));
      else addChip(value);
      if (addInput) addInput.value = "";
      if (isEdit)
        count!.value = String(
          Math.min(12, Number(count!.value) + (plusOnes || 1)),
        );
      sync();
    };
    form.addEventListener("submit", (event) => {
      const submitter = (event as SubmitEvent).submitter as HTMLElement | null;
      if (!submitter) return;
      if (form.dataset.submitting) {
        event.preventDefault();
        return;
      }
      if (submitter.matches("[data-no-js-add]")) {
        event.preventDefault();
        addValue();
      } else if (submitter.matches("[data-seat-plus], [data-seat-minus]")) {
        event.preventDefault();
        const names = seatNames().length;
        const next =
          Number(count?.value) +
          (submitter.matches("[data-seat-plus]") ? 1 : -1);
        if (count)
          count.value = String(Math.max(1, names, Math.min(12, next)));
        sync();
      } else if (submitter.matches("[data-plus-one-toggle]")) {
        event.preventDefault();
        const names = seatNames().length;
        const buttonValue = (submitter as HTMLButtonElement).value;
        if (count)
          if (buttonValue === "on") {
            count.value = String(Math.min(12, names + 1));
          } else if (form.dataset.variant === "new") {
            // Add has no seat rows: open seats are seat_count minus the names.
            count.value = String(Math.max(1, names));
          } else {
            const removable = [
              ...form.querySelectorAll<HTMLElement>(
                "[data-seat-kind='plus_one'][data-seat-row]",
              ),
            ].filter((row) => {
              const name = row.querySelector<HTMLInputElement>(
                "input[name='seat_name']",
              )?.value;
              return (
                !normalizeName(name ?? "") &&
                row.dataset.activity !== "true"
              );
            });
            for (const row of removable) {
              const id = row.dataset.seatId;
              if (id) {
                const hidden = document.createElement("input");
                hidden.type = "hidden";
                hidden.name = "removed_seat";
                hidden.value = id;
                form.append(hidden);
              }
              row.remove();
            }
            // Off also drops open seats added in this draft (they have no row
            // yet); the seats left are the rows that remain.
            count.value = String(
              Math.max(
                1,
                form.querySelectorAll("[data-seat-row]:not([hidden])").length,
              ),
            );
          }
        sync();
      } else if (submitter.matches("[data-remove-open-seat]")) {
        event.preventDefault();
        const row = submitter.closest<HTMLElement>("[data-seat-row]");
        const id = submitter.getAttribute("value");
        if (id) {
          const hidden = document.createElement("input");
          hidden.type = "hidden";
          hidden.name = "removed_seat";
          hidden.value = id;
          form.append(hidden);
        }
        row?.remove();
        if (count)
          count.value = String(
            Math.max(seatNames().length, Number(count.value) - 1),
          );
        sync();
      }
      if (
        !event.defaultPrevented &&
        submitter.matches(
          "button[type='submit'][name='save'], button[type='submit'][name='save_and_add']",
        )
      ) {
        form.dataset.submitting = "true";
        const mirror = document.createElement("input");
        mirror.type = "hidden";
        mirror.name = submitter.getAttribute("name") ?? "";
        mirror.value = submitter.getAttribute("value") ?? "";
        mirror.dataset.adminSubmitMirror = "true";
        form.append(mirror);
        const buttons = form.querySelectorAll<HTMLButtonElement>(
          "button[type='submit'][name='save'], button[type='submit'][name='save_and_add']",
        );
        const visibleSubmitter =
          submitter.classList.contains("sr-only") &&
          submitter.getAttribute("name") === "save"
            ? form.querySelector<HTMLButtonElement>(
                "button[type='submit'][name='save'].primary",
              )
            : submitter;
        queueMicrotask(() => {
          for (const button of buttons) button.disabled = true;
          if (visibleSubmitter) visibleSubmitter.textContent = "Saving…";
        });
      }
    });
    addInput?.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        addValue();
      }
    });
    form.addEventListener("click", (event) => {
      const target = event.target as Element;
      if (target.closest("[data-remove-name]")) {
        target.closest("[data-name-chip]")?.remove();
        sync();
      }
      if (target.closest("[data-confirm-duplicate]")) {
        // With JS the confirmation stays in the draft; the submit is the no-JS path.
        event.preventDefault();
        const names = allNames();
        const duplicate = names.find((name) =>
          takenNames().some(
            (taken) => duplicateNameKey(taken) === duplicateNameKey(name),
          ),
        );
        if (duplicate) {
          confirmed.add(duplicateNameKey(duplicate));
          const hidden = document.createElement("input");
          hidden.type = "hidden";
          hidden.name = "confirmed_name";
          hidden.value = duplicate;
          form.append(hidden);
        }
        updateDuplicate();
      }
    });
    form.addEventListener("change", (event) => {
      const target = event.target as HTMLInputElement;
      if (target.matches("[data-archive-seat]")) {
        target
          .closest("[data-seat-row]")
          ?.classList.toggle("is-retired", target.checked);
        const label = target.parentElement?.querySelector<HTMLElement>(
          "[data-archive-label]",
        );
        if (label) label.textContent = target.checked ? "Undo" : "Archive";
        sync();
      }
    });
    invitation?.addEventListener("input", () => {
      invitation.dataset.edited = "true";
      if (invitationEdited) invitationEdited.value = "1";
      sync();
    });
    hostId?.addEventListener("input", () => {
      hostId.dataset.edited = "true";
      if (labelEdited) labelEdited.value = "1";
      if (hostIdText) hostIdText.textContent = hostId.value;
    });
    restore?.addEventListener("click", () => {
      if (invitation) {
        delete invitation.dataset.edited;
        if (invitationEdited) invitationEdited.value = "";
        invitation.value = suggestInvitationName(memberNames());
      }
      sync();
    });
    sync();
    rememberGuestForm(form);
    if (refusedOnLoad) form.dataset.dirtyStart = "true";
  }

  function hydrateInitialDrawer() {
    const drawer = document.querySelector<HTMLElement>(
      "[data-admin-drawer]:not([data-closing])",
    );
    if (!drawer) return;
    setDrawerOpen(true);
    hydrateDrawer(drawer);
    syncLinks();
    drawer.querySelector<HTMLElement>("h2")?.focus();
  }
  hydrateInitialDrawer();
</script>
