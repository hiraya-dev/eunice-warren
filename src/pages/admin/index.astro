---
import { env } from "cloudflare:workers";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { selectAdminStore } from "@/lib/admin/store";
import {
  dateLine,
  deadlineStamp,
  greeting,
  relativeTime,
} from "@/lib/admin/presentation";
export const prerender = false;
import type { AdminOverview } from "@/lib/admin/store";
const host = Astro.locals.adminHost!;
const store = selectAdminStore((env as Record<string, unknown>).RSVP_STORE, (env as Record<string, unknown>).DB as never);
let data: AdminOverview | null = null;
let counts = { households: 0, slipperPairs: 0, songRequests: 0 };
let failed = false;
try {
  [data, counts] = await Promise.all([store.getOverview(), store.getNavCounts()]);
} catch {
  failed = true;
  Astro.response.status = 503;
}
const view =
  data ??
  ({
    seatsOffered: 0,
    guestsComing: 0,
    households: { invited: 0, attending: 0, declined: 0, waiting: 0 },
    repliedPercent: 0,
    songCount: 0,
    latestReplies: [],
    waiting: { total: 0, households: [] },
  } satisfies AdminOverview);
const deadline = deadlineStamp();
const [stampLead, ...stampRest] = deadline.text.split(deadline.closed ? " · " : " to ");
const stampLabel = deadline.closed ? stampRest.join(" · ") : `to ${stampRest.join(" to ")}`;
const stampShort = deadline.closed
  ? ""
  : `to ${stampLabel.split(" · ").at(-1)}`;
const hello = greeting(new Date(), host.firstName);
const nameAt = hello.lastIndexOf(", ") + 2;
const statCaptions = ["yes", "no", "waiting", "songs"];
---

<AdminLayout
  active="overview"
  host={host}
  counts={counts}
>
  <section id="overview" class="admin-overview_wrap" data-admin-overview>
    {host.sample && <p class="admin_sample" data-admin-sample>Sample data</p>}
    {
      failed ? (
        <div class="admin_notice error" data-admin-error>
          <h1>Couldn't load the guest data</h1>
          <a href={Astro.url.pathname}>Try again</a>
        </div>
      ) : view.households.invited === 0 ? (
        <div class="admin_notice empty" data-admin-empty>
          <h1>No guests yet</h1>
          <p>The guest list hasn't been loaded.</p>
        </div>
      ) : (
        <>
          <header class="admin-overview_header">
            <p class="admin_label" data-admin-date>{dateLine()}</p>
            <h1 class="admin-overview_greeting" data-admin-greeting>
              {hello.slice(0, nameAt)}<em>{hello.slice(nameAt)}</em>
            </h1>
            <p
              class:list={["admin-overview_stamp", { closed: deadline.closed }]}
              data-admin-deadline
            >
              <span class="admin-overview_stamp-lead">{stampLead}</span>
              <span class="admin_label admin-overview_stamp-long">
                {stampLabel}
              </span>
              {stampShort && (
                <span
                  class="admin_label admin-overview_stamp-short"
                  aria-hidden="true"
                >
                  {stampShort}
                </span>
              )}
            </p>
          </header>
          <section class="admin-overview_coming" data-admin-coming>
            <div class="admin-overview_total">
              <h2 class="admin_label">Guests coming</h2>
              <strong>
                <span class="admin-overview_number">{view.guestsComing}</span>
                <span class="admin-overview_seats">
                  {" "}/ {view.seatsOffered}
                  <span class="admin-overview_seats-unit"> seats</span>
                </span>
              </strong>
            </div>
            <div class="admin-overview_detail">
              <p class="admin-overview_replied admin_label">
                <span>{view.households.invited} households invited</span>
                <span>{view.repliedPercent}% replied</span>
              </p>
              <div class="admin-overview_bar" data-admin-bar>
                <span
                  class="attending"
                  style={`flex-grow:${view.households.attending}`}
                >
                  <span class="sr-only">Attending</span>
                </span>
                <span
                  class="declined"
                  style={`flex-grow:${view.households.declined}`}
                >
                  <span class="sr-only">Declined</span>
                </span>
                <span
                  class="waiting"
                  style={`flex-grow:${view.households.waiting}`}
                >
                  <span class="sr-only">Not replied yet</span>
                </span>
              </div>
              <dl class="admin-overview_stats">
                {[
                  ["Attending", view.households.attending],
                  ["Declined", view.households.declined],
                  ["Not replied yet", view.households.waiting],
                  ["Song requests", view.songCount],
                ].map(([label, value], index) => (
                  <div class:list={{ waiting: index === 2 }}>
                    <dt data-short={statCaptions[index]}>
                      <span>{label}</span>
                    </dt>
                    <dd>{value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </section>
          <div class="admin-overview_lists">
            <section class="admin-overview_latest" data-admin-latest>
              <header class="admin-overview_head">
                <h2>Latest replies</h2>
                <a href="/admin/rsvps">All RSVPs →</a>
              </header>
              {view.latestReplies.map((reply) => (
                <article class="admin-overview_reply" data-admin-reply>
                  <span
                    class="admin_pill"
                    data-state={reply.attending ? "yes" : "no"}
                  >
                    {reply.attending ? "Yes" : "No"}
                  </span>
                  <strong>{reply.displayName}</strong>
                  <span class="admin-overview_party">
                    {reply.coming} of {reply.seatCount}
                  </span>
                  <time class="admin_label" datetime={reply.submittedAt}>
                    {relativeTime(reply.submittedAt)}
                  </time>
                  {reply.namedPlusOnes.length > 0 && (
                    <small>
                      Seat change · (plus-one) →{" "}
                      {reply.namedPlusOnes.map((seat) => seat.name).join(", ")}
                    </small>
                  )}
                </article>
              ))}
            </section>
            <section class="admin-overview_waiting" data-admin-waiting>
              <header class="admin-overview_head">
                <h2>Still waiting on</h2>
                <span class="admin_label">{view.waiting.total} households</span>
              </header>
              {view.waiting.households.map((row) => (
                <div class="admin-overview_row" data-admin-waiting-row>
                  <span>{row.displayName}</span>
                  <span>{row.seatCount} seats</span>
                </div>
              ))}
              {view.waiting.total > 3 && (
                <a class="admin-overview_more" href="/admin/guests">
                  <span class="admin-overview_more-long">
                    + {view.waiting.total - 3} more · <span>see the guest list</span>
                  </span>
                  <span class="admin-overview_more-short">
                    See all {view.waiting.total} waiting
                  </span>
                </a>
              )}
            </section>
          </div>
        </>
      )
    }
  </section>
</AdminLayout>
