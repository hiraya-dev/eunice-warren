---
import { env } from "cloudflare:workers";
import AdminLayout from "@/layouts/AdminLayout.astro";
import {
  djText,
  duplicateLabel,
  relativeTime,
  songsEyebrow,
  spotifyTrackUrl,
} from "@/lib/admin/presentation";
import { selectAdminStore, type AdminSongRequests } from "@/lib/admin/store";
import { isSameOriginPost } from "@/lib/admin/origin";
import {
  fakeRemovedSongsSetCookie,
  parseFakeRemovedSongIds,
} from "@/lib/admin/song-cookie";
export const prerender = false;
const host = Astro.locals.adminHost!;
const storeName = (env as Record<string, unknown>).RSVP_STORE;
const removedSongIds = storeName === "fake"
  ? parseFakeRemovedSongIds(Astro.request.headers.get("cookie"))
  : new Set<number>();
const store = selectAdminStore(
  storeName,
  (env as Record<string, unknown>).DB as never,
  { removedSongIds },
);
let data: AdminSongRequests | null = null;
let counts = { households: 0, slipperPairs: 0, songRequests: 0 };
let failed = false;
let writeError = "";
if (Astro.request.method === "POST") {
  if (!isSameOriginPost(Astro.request, Astro.url)) {
    Astro.response.status = 403;
    writeError = "Forbidden";
  } else {
    const form = await Astro.request.formData();
    if (String(form.get("action") ?? "") === "remove") {
      try {
        const rawId = form.get("id");
        const id = typeof rawId === "string" && /^\d+$/.test(rawId) ? Number(rawId) : NaN;
        const changed = await store.removeSong(id, host.email);
        const response = Astro.redirect(`/admin/songs?removed=${changed ? "1" : "0"}`, 303);
        if (storeName === "fake" && changed)
          response.headers.set("Set-Cookie", fakeRemovedSongsSetCookie(removedSongIds));
        return response;
      } catch {
        Astro.response.status = 503;
        writeError = "Couldn't remove that song. Try again.";
      }
    }
  }
}
try {
  [data, counts] = await Promise.all([
    store.getSongRequests(),
    store.getNavCounts(),
  ]);
} catch {
  failed = true;
  Astro.response.status = 503;
}
const view = data ?? { rows: [], requests: 0, songs: 0 };
const text = djText(view.rows);
---

<AdminLayout active="songs" host={host} counts={counts}>
  <section
    id="songs"
    class="admin-songs_wrap"
    data-admin-songs-page
    data-dj-songs={view.songs}
  >
    {
      host.sample && (
        <p class="admin_sample" data-admin-sample>
          Sample data
        </p>
      )
    }
    {
      failed ? (
        <div class="admin_notice error" data-admin-error>
          <>
            <h1>Couldn't load the song requests</h1>
            <a href={Astro.url.pathname}>Try again</a>
          </>
        </div>
      ) : (
        <>
          {writeError && <div class="admin_notice error" data-admin-error>{writeError}</div>}
          {Astro.url.searchParams.get("removed") === "1" && <div class="admin_notice" data-admin-song-removed>Song removed.</div>}
          {Astro.url.searchParams.get("removed") === "0" && <div class="admin_notice" data-admin-song-removed>That song was already removed.</div>}
          <header class="admin_pagehead admin-songs_header">
            <div>
              <p class="admin_label">
                {songsEyebrow(view.requests, view.songs)}
              </p>
              <h1>
                Song <em>requests</em>
              </h1>
            </div>
            <div class="admin_actions">
              <a
                class="admin_button outline"
                href={view.requests ? "/admin/songs.csv" : undefined}
                download
                aria-disabled={view.requests ? undefined : "true"}
              >
                Download CSV
              </a>
              <button
                class="admin_button primary"
                type="button"
                data-dj-copy
                disabled={!view.requests}
                aria-disabled={view.requests ? undefined : "true"}
              >
                Copy list for the DJ
              </button>
              <span role="status" aria-live="polite" data-dj-copy-status />
            </div>
          </header>
          {view.requests === 0 ? (
            <div class="admin_notice empty" data-admin-empty>
              <h2>No song requests yet</h2>
              <p>Guests haven't sent any songs.</p>
            </div>
          ) : (
            <div class="admin-songs_table" role="table">
              <div class="admin-songs_row admin-songs_header-row" role="row">
                <span role="columnheader">No.</span>
                <span role="columnheader">Song · artist</span>
                <span role="columnheader">From</span>
                <span role="columnheader">Dedication</span>
                <span role="columnheader">Sent ↓</span>
                <span role="columnheader"><span class="sr-only">Actions</span></span>
              </div>
              {view.rows.map((row) => (
                <Fragment>
                <div class="admin-songs_row" data-song-row role="row" data-song-id={row.id}>
                  <span role="cell" data-song-no>
                    {row.no}
                  </span>
                  <div role="cell">
                    <span class="admin-songs_title">
                      <strong data-song>{row.song}</strong>
                      {duplicateLabel(row.requestCount) && (
                        <small data-song-dupe>
                          {duplicateLabel(row.requestCount)}
                        </small>
                      )}
                      {spotifyTrackUrl(row.spotifyTrackId) && <a href={spotifyTrackUrl(row.spotifyTrackId)!} target="_blank" rel="noopener">Spotify</a>}
                    </span>
                    <span data-song-artist>{row.artist ?? ""}</span>
                  </div>
                  <span role="cell" data-song-from>
                    {row.name}
                  </span>
                  <span
                    role="cell"
                    data-song-dedication
                    data-song-no-dedication={!row.dedication}
                  >
                    {row.dedication ? `“${row.dedication}”` : "No dedication"}
                  </span>
                  <time role="cell" data-song-sent datetime={row.createdAt}>
                    {relativeTime(row.createdAt)}
                  </time>
                  <span role="cell" class="admin-songs_remove">
                    <a class="admin_guests_btn" data-song-remove href={`/admin/songs?remove=${row.id}`}>Remove</a>
                  </span>
                </div>
                {Astro.url.searchParams.get("remove") === String(row.id) && (
                  <div class="admin-songs_confirm" data-song-remove-confirm role="row">
                    <div class="admin_guests_confirm" role="cell">
                      <p>Remove “{row.song}” from {row.name}?</p>
                      <form method="post">
                        <input type="hidden" name="action" value="remove" />
                        <input type="hidden" name="id" value={row.id} />
                        <div class="admin_guests_form-actions">
                          <button class="admin_button primary" type="submit">Remove song</button>
                          <a class="admin_button outline" href="/admin/songs">Keep</a>
                        </div>
                      </form>
                    </div>
                  </div>
                )}
                </Fragment>
              ))}
            </div>
          )}
          <template data-dj-text>{text}</template>
        </>
      )
    }
  </section>
</AdminLayout>
<script>
  import { copiedLabel } from "@/lib/admin/presentation";
  const root = document.querySelector<HTMLElement>("[data-admin-songs-page]");
  if (root && !root.dataset.djInitialized) {
    root.dataset.djInitialized = "true";
    const button = root.querySelector<HTMLButtonElement>("[data-dj-copy]");
    const status = root.querySelector<HTMLElement>("[data-dj-copy-status]");
    const text =
      root
        .querySelector<HTMLTemplateElement>("[data-dj-text]")
        ?.content.textContent?.trim() ?? "";
    const songs = Number(root.dataset.djSongs ?? 0);
    let statusTimer: number | undefined;
    button?.addEventListener("click", async () => {
      if (statusTimer !== undefined) window.clearTimeout(statusTimer);
      try {
        await navigator.clipboard.writeText(text);
        if (status) status.textContent = copiedLabel(songs);
        statusTimer = window.setTimeout(() => {
          if (status) status.textContent = "";
        }, 2000);
      } catch {
        if (status) status.textContent = "Couldn't copy. Use Download CSV.";
      }
    });
  }
</script>
