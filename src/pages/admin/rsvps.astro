---
import { env } from "cloudflare:workers";
import { parseAdminHosts } from "@/lib/admin/auth";
import AdminLayout from "@/layouts/AdminLayout.astro";
import {
  adminHistoryHeading,
  adminTimestamp,
  relativeTime,
  replyCountText,
  rsvpHistoryBody,
  rowSlippersText,
  seatSubline,
} from "@/lib/admin/presentation";
import { selectAdminStore } from "@/lib/admin/store";
import { StaleHouseholdError } from "@/lib/admin/store";
import { isRsvpClosed, submissionProblems } from "@/lib/rsvp/logic";
import { SLIPPER_SIZES } from "@/lib/rsvp/slippers";
import { normalizeName } from "@/lib/admin/names";
import { loadAdminRsvps } from "@/lib/admin/rsvps";
import type {
  AdminRsvpDetail,
  AdminRsvpList,
  AdminRsvpRow,
} from "@/lib/admin/store";
export const prerender = false;
const host = Astro.locals.adminHost!;
const hosts = parseAdminHosts(
  String((env as Record<string, unknown>).ADMIN_HOSTS ?? ""),
) ?? { [host.email]: host.firstName };
const store = selectAdminStore(
  (env as Record<string, unknown>).RSVP_STORE,
  (env as Record<string, unknown>).DB as never,
);
let data: AdminRsvpList | null = null;
let detail: AdminRsvpDetail | null = null;
let failed = false;
let editDraft: {
  updatedAt: string;
  attending: boolean | null;
  note: string;
  seats: Array<{
    seatId: number;
    shownName: string;
    name: string;
    attending: boolean;
    slipperSize: string;
  }>;
} | null = null;
let validationErrors: Array<{
  seatId?: number;
  field: string;
  message: string;
}> = [];
let staleError = false;
const requested = Astro.url.searchParams.get("household");
const loaded = await loadAdminRsvps(
  () => store,
  requested,
);
data = loaded.data;
detail = loaded.detail;
failed = loaded.failed;
if (loaded.failed) Astro.response.status = 503;
if (loaded.notFound) Astro.response.status = 404;
const view =
  data ??
  ({
    totals: { all: 0, attending: 0, declined: 0, seatChanges: 0, waiting: 0 },
    rows: [],
  } satisfies AdminRsvpList);
const filter = [
  "all",
  "attending",
  "declined",
  "seat-changes",
  "waiting",
].includes(Astro.url.searchParams.get("filter") ?? "")
  ? Astro.url.searchParams.get("filter")!
  : "all";
const q = Astro.url.searchParams.get("q") ?? "";
const normalize = (value: string) =>
  value
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLocaleLowerCase();
const matches = (row: AdminRsvpRow) =>
  normalize(
    [
      row.displayName,
      row.label,
      row.email ?? "",
      row.respondentName ?? "",
      ...row.seats.map((s) => `${s.invitedName ?? ""} ${s.name ?? ""}`),
    ].join(" "),
  ).includes(normalize(q));
const filtered = view.rows
  .filter((row) =>
    filter === "all"
      ? row.state !== "waiting"
      : filter === "seat-changes"
        ? row.state !== "waiting" && row.seatChange
        : filter === row.state,
  )
  .filter(matches);
const href = (next: Record<string, string | null>) => {
  const params = new URLSearchParams();
  const values = {
    filter,
    q,
    household: Astro.url.searchParams.get("household"),
    ...next,
  };
  for (const [key, value] of Object.entries(values))
    if (value) params.set(key, value);
  return `${Astro.url.pathname}?${params}`;
};
const redirectHref = (form: FormData, extra: Record<string, string> = {}) => {
  const params = new URLSearchParams();
  const filterValue = String(form.get("filter") ?? "");
  const queryValue = String(form.get("q") ?? "");
  if (filterValue && filterValue !== "all") params.set("filter", filterValue);
  if (queryValue) params.set("q", queryValue);
  for (const [key, value] of Object.entries(extra)) params.set(key, value);
  return `/admin/rsvps${params.toString() ? `?${params}` : ""}`;
};
const savedCookieName = "admin_rsvp_saved";
const savedCookie = `${savedCookieName}=1`;
const hasSavedCookie = (Astro.request.headers.get("cookie") ?? "")
  .split(";")
  .some((cookie) => cookie.trim() === savedCookie);
if (Astro.request.method === "POST") {
  const origin = Astro.request.headers.get("origin");
  if (origin && origin !== Astro.url.origin) {
    Astro.response.status = 403;
    validationErrors = [{ field: "form", message: "Forbidden" }];
  } else {
    const form = await Astro.request.formData();
    if (String(form.get("action") ?? "") === "save") {
      const householdId = String(form.get("id") ?? "");
      const postedUpdatedAt = String(form.get("updated_at") ?? "");
      const postedDetail = detail ?? (await store.getRsvpDetail(householdId));
      if (postedDetail) {
        detail = postedDetail;
        const answer = String(form.get("attending") ?? "");
        const attending = answer === "yes" ? true : answer === "no" ? false : null;
        const seats = postedDetail.seats.map((seat) => ({
          seatId: seat.seatId!,
          shownName: String(form.get(`shown_name_${seat.seatId}`) ?? seat.name ?? ""),
          name: normalizeName(String(form.get(`seat_name_${seat.seatId}`) ?? seat.name ?? "")),
          attending: form.get(`seat_attending_${seat.seatId}`) === "on",
          slipperSize: String(form.get(`slipper_size_${seat.seatId}`) ?? ""),
        }));
        const note = String(form.get("note") ?? "");
        // Without JS the size select stays enabled, so an unticked seat can
        // post a size; it is not coming, so the size is dropped, not refused.
        for (const seat of seats) if (!seat.attending) seat.slipperSize = "";
        if (attending === false) {
          for (const seat of seats) {
            seat.attending = false;
            seat.slipperSize = "";
          }
        }
        editDraft = { updatedAt: postedUpdatedAt, attending, note, seats };
        if (postedDetail.id !== householdId) {
          staleError = true;
          validationErrors = [];
        } else {
          const invite = {
            id: postedDetail.id,
            householdName: postedDetail.displayName,
            ticketCode: postedDetail.id,
            members: postedDetail.seats
              .filter((seat) => seat.kind === "member")
              .map((seat) => seat.invitedName ?? ""),
            seats: postedDetail.seats.length,
            seatList: postedDetail.seats.map((seat) => ({
              seatId: seat.seatId!,
              kind: seat.kind,
              invitedName: seat.invitedName,
              name: seat.name,
            })),
          };
          validationErrors = submissionProblems({
            attending,
            seats: seats.map((seat) => ({ ...seat, slipperSize: seat.slipperSize || undefined })),
            invite,
            note,
            requireMemberNames: true,
          });
          if (!validationErrors.length && attending !== null) {
            try {
              await store.saveRsvp(
                {
                  id: postedDetail.id,
                  updatedAt: postedUpdatedAt,
                  attending,
                  seats,
                  note: note.trim() || null,
                },
                { email: host.email, firstName: host.firstName },
              );
              const response = Astro.redirect(
                redirectHref(form, { household: postedDetail.id, saved: "1" }),
                303,
              );
              response.headers.append(
                "Set-Cookie",
                `${savedCookie}; HttpOnly; SameSite=Lax; Path=/admin/rsvps; Max-Age=60`,
              );
              return response;
            } catch (error) {
              if (error instanceof StaleHouseholdError) staleError = true;
              else validationErrors = [{ field: "form", message: "Could not save the reply." }];
            }
          }
        }
      }
    }
  }
}
const titleParts = (name: string) => {
  const parts = name.split(/\s+/);
  return { first: parts.slice(0, -1).join(" "), last: parts.at(-1) ?? name };
};
const editMode = Boolean(detail && Astro.url.searchParams.get("edit") === "1");
const formSeats = detail
  ? editDraft?.seats ??
    detail.seats.map((seat) => ({
      seatId: seat.seatId!,
      shownName: seat.name ?? seat.invitedName ?? "",
      name: seat.name ?? seat.invitedName ?? "",
      attending: seat.coming,
      slipperSize: seat.slipperSize ?? "",
    }))
  : [];
const formAttending = editDraft?.attending ?? (detail?.history[0]?.attending ?? null);
const formNote = editDraft?.note ?? detail?.note ?? "";
const problemFor = (seatId: number, field: string) =>
  validationErrors.find((problem) => problem.seatId === seatId && problem.field === field);
const formProblem = (field: string) =>
  validationErrors.find((problem) => !problem.seatId && problem.field === field);
const savedNotice = hasSavedCookie;
if (savedNotice && !editMode) {
  Astro.response.headers.append(
    "Set-Cookie",
    `${savedCookieName}=; HttpOnly; SameSite=Lax; Path=/admin/rsvps; Max-Age=0`,
  );
}
---

<AdminLayout
  active="rsvps"
  host={host}
  counts={loaded.counts}
>
  <section id="rsvps" class="admin-rsvps_wrap" data-admin-rsvps-page>
    {
      host.sample && (
        <p class="admin_sample" data-admin-sample>
          Sample data
        </p>
      )
    }
    {
      failed ? (
        <div class="admin_notice error" data-admin-error>
          <>
            <h1>Couldn't load the RSVP data</h1>
            <a href={Astro.url.pathname}>Try again</a>
          </>
        </div>
      ) : view.rows.length === 0 ? (
        <div class="admin_notice empty" data-admin-empty>
          <>
            <h1>No RSVPs yet</h1>
            <p>The RSVP list hasn't been loaded.</p>
          </>
        </div>
      ) : (
        <>
          {requested && !detail && (
            <div class="admin_notice error" data-admin-not-found>
              <h1>Household not found</h1>
            </div>
          )}
          <header class="admin-rsvps_header">
            <>
              <div>
                <>
                  <p class="admin_label">Newest reply per household</p>
                  <h1>RSVPs</h1>
                </>
              </div>
              <div class="admin-rsvps_actions">
                <a href="/admin/rsvps.csv" data-admin-download>
                  Download CSV
                </a>
              </div>
            </>
          </header>
          {savedNotice && !detail && (
            <p class="admin-rsvps_saved" data-admin-saved>
              <span aria-hidden="true">✓</span> Reply saved
            </p>
          )}
          <div class="admin-rsvps_toolbar">
            <>
              <nav aria-label="RSVP filters" data-admin-filters>
                {(
                  [
                    ["all", "All replies"],
                    ["attending", "Attending"],
                    ["declined", "Declined"],
                    ["seat-changes", "Seat changes"],
                    ["waiting", "Waiting"],
                  ] as const
                ).map(([key, label]) => (
                  <a
                    href={href({ filter: key, household: null })}
                    aria-current={filter === key ? "page" : undefined}
                    data-admin-filter={key}
                  >
                    <span>{label}</span>{" "}
                    <span class="admin-rsvps_count">
                      {
                        view.totals[
                          key === "seat-changes" ? "seatChanges" : key
                        ]
                      }
                    </span>
                  </a>
                ))}
              </nav>
              <form method="get" data-admin-search-form>
                <>
                  <input type="hidden" name="filter" value={filter} />
                  <label class="sr-only" for="admin-rsvp-search">
                    Search a name or email
                  </label>
                  <svg
                    viewBox="0 0 16 16"
                    width="16"
                    height="16"
                    fill="none"
                    aria-hidden="true"
                  >
                    <circle
                      cx="7"
                      cy="7"
                      r="5"
                      stroke="currentColor"
                      stroke-width="1.5"
                    />
                    <path
                      d="M11 11l3.5 3.5"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                    />
                  </svg>
                  <input
                    id="admin-rsvp-search"
                    type="search"
                    name="q"
                    value={q}
                    placeholder="Search a name or email"
                    data-admin-search
                    autocomplete="off"
                  />
                </>
              </form>
            </>
          </div>
          <p class="admin-rsvps_no-match" data-admin-no-match hidden>
            No RSVPs match
          </p>
          <div class="admin-rsvps_card">
            <table class="admin-rsvps_table" data-admin-rsvps>
              <>
                <thead>
                  <tr>
                    <>
                      <th data-col="reply">Reply</th>
                      <th data-col="household">Household · email</th>
                      <th data-col="who">Who's coming · note</th>
                      <th data-col="slippers">Slippers</th>
                      <th data-col="sent">Sent ↓</th>
                    </>
                  </tr>
                </thead>
                <tbody>
                  {filtered.map((row) => (
                    <tr
                      data-admin-rsvp-row
                      data-household={row.id}
                      data-state={row.state}
                      data-search={normalize(
                        [
                          row.displayName,
                          row.label,
                          row.email ?? "",
                          row.respondentName ?? "",
                          ...row.seats.flatMap((s) => [
                            s.invitedName ?? "",
                            s.name ?? "",
                          ]),
                        ].join(" "),
                      )}
                    >
                      <td data-col="reply">
                        <span
                          class="admin_pill"
                          data-state={
                            row.state === "attending"
                              ? "yes"
                              : row.state === "declined"
                                ? "no"
                                : "waiting"
                          }
                        >
                          {row.state === "attending"
                            ? "YES"
                            : row.state === "declined"
                              ? "NO"
                              : "WAITING"}
                        </span>
                      </td>
                      <th scope="row" data-col="household">
                        <a
                          href={href({ household: row.id })}
                          data-admin-rsvp-link
                          aria-label={row.displayName}
                        >
                          <strong>{row.displayName}</strong>
                          <small>
                            {row.email || (row.respondentName ? "—" :
                              `${row.seatCount} ${row.seatCount === 1 ? "seat" : "seats"}`)}
                          </small>
                        </a>
                      </th>
                      <td data-col="who">
                        <div class="admin-rsvps_who">
                          {row.state === "declined" ? (
                            <>
                              Not coming <span>· 0 of {row.seatCount}</span>
                            </>
                          ) : row.state === "waiting" ? (
                            <>
                              Waiting <span>· 0 of {row.seatCount}</span>
                            </>
                          ) : (
                            <>
                              {row.comingNames.join(", ")}{" "}
                              <span>
                                · {row.comingNames.length} of {row.seatCount}
                              </span>
                            </>
                          )}
                        </div>
                        {row.seatChanges.map((change) => (
                          <small class="admin-rsvps_change">
                            Seat change · {change.from ?? "(plus-one)"} →{" "}
                            {change.to}
                          </small>
                        ))}
                        {row.notComingNames.length > 0 && (
                          <small class="admin-rsvps_out">
                            Not coming: {row.notComingNames.join(", ")}
                          </small>
                        )}
                        {row.note && (
                          <small class="admin-rsvps_note">“{row.note}”</small>
                        )}
                      </td>
                      <td
                        data-col="slippers"
                        data-none={row.state === "declined" ? "" : undefined}
                      >
                        {rowSlippersText(row)}
                      </td>
                      <td data-col="sent">
                        {row.submittedAt ? relativeTime(row.submittedAt) : "—"}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </>
            </table>
          </div>
          {detail && (
            <aside
              class="admin-drawer_wrap"
              role="dialog"
              aria-modal="true"
              aria-labelledby="admin-drawer-title"
              data-admin-drawer
            >
              <a
                class="admin-drawer_scrim"
                href={href({ household: null })}
                aria-label="Close"
              />
              <div class="admin-drawer_panel">
                <div class="admin-drawer_top">
                  <p class="admin_label">
                    {editMode
                      ? detail.versionCount
                        ? `Edit reply · ${detail.label} · ${replyCountText(detail.versionCount)}`
                        : `Answer for them · ${detail.label} · waiting`
                      : `Household ${detail.label} · ${detail.versionCount ? `replied ${replyCountText(detail.versionCount)}` : "no reply yet"}`}
                  </p>
                  {!editMode && (
                    <a
                      class="admin-drawer_edit-link"
                      data-fill={detail.versionCount ? undefined : ""}
                      href={href({ household: detail.id, edit: "1" })}
                      data-admin-drawer-nav
                    >
                      {detail.versionCount ? "Edit reply" : "Answer for them"}
                    </a>
                  )}
                  <a
                    href={href({ household: null })}
                    data-admin-drawer-close
                    aria-label="Close"
                  >
                    <svg
                      viewBox="0 0 14 14"
                      width="14"
                      height="14"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M2 2l10 10M12 2L2 12"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                      />
                    </svg>
                    <span class="sr-only">Close</span>
                  </a>
                </div>
                {savedNotice && !editMode && (
                  <p class="admin-rsvps_saved" data-admin-saved>
                    <svg viewBox="0 0 14 14" width="14" height="14" fill="none" aria-hidden="true">
                      <path d="M2.5 7.5l3 3 6-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Reply saved
                  </p>
                )}
                {editMode ? (
                  <form class="admin-drawer_edit-form" method="post">
                    <input type="hidden" name="action" value="save" />
                    <input type="hidden" name="id" value={detail.id} />
                    <input type="hidden" name="updated_at" value={editDraft?.updatedAt ?? detail.updatedAt ?? ""} />
                    <input type="hidden" name="filter" value={filter} />
                    <input type="hidden" name="q" value={q} />
                    <div class="admin-drawer_edit-scroll">
                    <header>
                      {(() => {
                        const parts = titleParts(detail.displayName);
                        return (
                          <h2 id="admin-drawer-title" tabindex="-1">
                            {parts.first} <em>{parts.last}</em>
                          </h2>
                        );
                      })()}
                      <p>
                        {detail.versionCount
                          ? `${detail.email || "—"} · ${detail.seatCount} seats`
                          : `No reply yet · ${detail.seatCount} seats`}
                      </p>
                    </header>
                    {staleError && (
                      <div class="admin-drawer_stale" role="alert">
                        <div>
                          <strong>This reply changed while you were editing</strong>
                          <p>Nothing was saved. Reload to see the latest, then make your edit again.</p>
                        </div>
                        <a href={href({ household: detail.id, edit: "1" })}>Reload</a>
                      </div>
                    )}
                    {formProblem("form") && <p class="admin-drawer_error">{formProblem("form")?.message}</p>}
                    {isRsvpClosed() && (
                      <p class="admin-drawer_deadline-note">
                        RSVPs closed on December 12. Guests can't change this reply any more; you still can.
                      </p>
                    )}
                    <fieldset id="admin-rsvp-answer" class="admin-drawer_answer">
                      <legend>Their answer</legend>
                      <div class="admin-drawer_segmented">
                        <label>
                          <input type="radio" name="attending" value="yes" checked={formAttending === true} />
                          <span>Yes, coming</span>
                        </label>
                        <label>
                          <input type="radio" name="attending" value="no" checked={formAttending === false} />
                          <span>No, can't make it</span>
                        </label>
                      </div>
                      {formProblem("answer") && <p class="admin-drawer_error">{formProblem("answer")?.message}</p>}
                    </fieldset>
                    <section id="admin-rsvp-nobody" class="admin-drawer_nobody" data-admin-nobody hidden>
                        <strong>Nobody is coming</strong>
                        <p>
                          {formSeats.map((seat) => seat.name || "+1").join(", ")}. Ticks and slipper sizes are cleared on Save; names stay. Switch back to Yes to tick seats again.
                        </p>
                    </section>
                    <section id="admin-rsvp-seats" class="admin-drawer_edit-seats" data-admin-edit-seats>
                        <div class="admin-drawer_seat-head">
                          <span>In</span><span>Seats<span class="admin-drawer_head-wide"> · name on the place card</span><span class="admin-drawer_head-narrow"> · tick who's coming</span></span><span>Slippers</span>
                        </div>
                        {detail.seats.map((seat, index) => {
                          const draft = formSeats[index]!;
                          const nameProblem = problemFor(seat.seatId!, "name");
                          const sizeProblem = problemFor(seat.seatId!, "slipperSize");
                          return (
                            <div class="admin-drawer_edit-seat" data-admin-seat>
                              <input type="hidden" name={`seat_id`} value={seat.seatId} />
                              <input type="hidden" name={`shown_name_${seat.seatId}`} value={draft.shownName} />
                              <label class="admin-drawer_check">
                                <span class="sr-only">{`Seat ${index + 1} attending`}</span>
                                <input type="checkbox" name={`seat_attending_${seat.seatId}`} checked={draft.attending} />
                                <span aria-hidden="true" />
                              </label>
                              <div class="admin-drawer_edit-seat-fields">
                                <input
                                  class={nameProblem ? "has-error" : undefined}
                                  name={`seat_name_${seat.seatId}`}
                                  value={draft.name}
                                  data-shown-name={draft.shownName}
                                  placeholder={seat.kind === "plus_one" && !seat.name ? "Name of their guest" : undefined}
                                  aria-label={`Name for seat ${index + 1}`}
                                />
                                <small>
                                  {seat.kind === "member"
                                    ? `Invited as ${seat.invitedName ?? ""}${index === 0 ? " · lead" : ""}`
                                    : "Open seat · plus-one"}
                                  {!draft.attending && " · not coming"}
                                  <span
                                    class="admin-drawer_was"
                                    data-admin-was
                                    hidden={!(draft.name !== draft.shownName && draft.shownName)}
                                  >
                                    was “{draft.shownName}”
                                  </span>
                                  {nameProblem && <span class="admin-drawer_error">{nameProblem.message}</span>}
                                  {sizeProblem && <span class="admin-drawer_error admin-drawer_size-error">{sizeProblem.message}</span>}
                                </small>
                              </div>
                              <span class="admin-drawer_select">
                                <select
                                  class={sizeProblem ? "has-error" : undefined}
                                  name={`slipper_size_${seat.seatId}`}
                                  aria-label={`Slipper size for seat ${index + 1}`}
                                >
                                  <option value="">Size</option>
                                  {SLIPPER_SIZES.map((size) => <option value={size} selected={size === draft.slipperSize}>{size}</option>)}
                                </select>
                              </span>
                            </div>
                          );
                        })}
                        {formProblem("seats") && <p class="admin-drawer_error">{formProblem("seats")?.message}</p>}
                    </section>
                    <section id="admin-rsvp-note" class="admin-drawer_edit-note">
                      <div><h3>Their note</h3><span>Their words · optional</span></div>
                      <textarea name="note" maxlength="1000" aria-label="Their note">{formNote}</textarea>
                      {formProblem("note") && <p class="admin-drawer_error">{formProblem("note")?.message}</p>}
                    </section>
                    <p class="admin-drawer_footnote">Saved as a new version, by host. Earlier replies stay in the history.</p>
                    </div>
                    <footer class="admin-drawer_edit-footer">
                      <p>Saved as a new version, by host. Earlier replies stay in the history.</p>
                      <a href={href({ household: detail.id })} data-admin-drawer-nav>Cancel</a>
                      <button type="submit">Save reply</button>
                    </footer>
                  </form>
                ) : (
                  <>
                <header>
                  {(() => {
                    const parts = titleParts(detail.displayName);
                    return (
                      <h2 id="admin-drawer-title" tabindex="-1">
                        {parts.first} <em>{parts.last}</em>
                      </h2>
                    );
                  })()}
                  <p>
                    {detail.versionCount
                      ? `${detail.email || "—"} · ${detail.seatCount} seats · sent ${adminTimestamp(detail.submittedAt)}`
                      : `No reply yet · ${detail.seatCount} seats`}
                  </p>
                </header>
                <section class="admin-drawer_seats">
                  <div class="admin-drawer_seat-head">
                    <span>Seats</span>
                    <span>Slippers</span>
                  </div>
                  {detail.seats.map((seat) => (
                    <div class="admin-drawer_seat" data-admin-seat>
                      <span data-coming={seat.coming} aria-hidden="true">
                        {seat.coming && (
                          <svg
                            viewBox="0 0 12 10"
                            width="12"
                            height="10"
                            fill="none"
                          >
                            <path
                              d="M1 5l3.5 3.5L11 1.5"
                              stroke="currentColor"
                              stroke-width="1.6"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        )}
                      </span>
                      <div>
                        <strong>{seat.name ?? seat.invitedName ?? "+1"}</strong>
                        <small
                          data-renamed={
                            seat.kind === "member" &&
                            seat.name !== seat.invitedName
                          }
                        >
                          {seatSubline(seat, hosts)}
                        </small>
                      </div>
                      <b>{seat.coming ? (seat.slipperSize ?? "—") : "—"}</b>
                    </div>
                  ))}
                </section>
                {detail.note && (
                  <section class="admin-drawer_note">
                    <h3>Their note</h3>
                    <p>“{detail.note}”</p>
                  </section>
                )}
                {detail.history.length > 0 && (
                  <section class="admin-drawer_history">
                    <h3>Reply history · every version they sent</h3>
                    <ol>
                      {detail.history.map((version, index) => (
                        <li
                          data-current={index === 0 ? true : undefined}
                          data-source={version.source}
                        >
                          <h4>
                            {adminHistoryHeading(version)}
                            {version.source === "host" && (
                              <span data-admin-host-edit>
                                by host · {version.editedBy}
                              </span>
                            )}
                          </h4>
                          <p>
                            {rsvpHistoryBody(
                              version,
                              detail.history[index + 1],
                              hosts,
                            )}
                          </p>
                        </li>
                      ))}
                    </ol>
                  </section>
                )}
                  </>
                )}
              </div>
            </aside>
          )}
        </>
      )
    }
  </section>
</AdminLayout>
<script>
  const normalize = (value: string) =>
    value
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLocaleLowerCase();
  const input = document.querySelector<HTMLInputElement>("[data-admin-search]");
  const rows = [
    ...document.querySelectorAll<HTMLElement>("[data-admin-rsvp-row]"),
  ];
  const empty = document.querySelector<HTMLElement>("[data-admin-no-match]");
  const syncLinks = () => {
    const query = input?.value ?? "";
    for (const link of document.querySelectorAll<HTMLAnchorElement>(
      "[data-admin-filter], [data-admin-rsvp-link], [data-admin-drawer-nav], [data-admin-drawer-close], .admin-drawer_scrim",
    )) {
      const url = new URL(link.href);
      if (query) url.searchParams.set("q", query);
      else url.searchParams.delete("q");
      link.href = `${url.pathname}${url.search}${url.hash}`;
    }
  };
  input?.addEventListener("input", () => {
    const query = normalize(input.value);
    let count = 0;
    for (const row of rows) {
      row.hidden = !normalize(row.dataset.search ?? "").includes(query);
      if (!row.hidden) count++;
    }
    if (empty) empty.hidden = count !== 0;
    const url = new URL(location.href);
    query
      ? url.searchParams.set("q", input.value)
      : url.searchParams.delete("q");
    history.replaceState(null, "", url);
    syncLinks();
  });
  // The edit form can arrive later through the drawer swap, so the change
  // listener is delegated and every swap re-syncs the form it brings in.
  const syncEditForm = (form: HTMLFormElement) => {
    const no =
      form.querySelector<HTMLInputElement>("input[name='attending']:checked")
        ?.value === "no";
    const nobody = form.querySelector<HTMLElement>("[data-admin-nobody]");
    const seats = form.querySelector<HTMLElement>("[data-admin-edit-seats]");
    if (nobody) nobody.hidden = !no;
    if (seats) seats.hidden = no;
    for (const checkbox of form.querySelectorAll<HTMLInputElement>("input[type='checkbox'][name^='seat_attending_']")) {
      const select = form.querySelector<HTMLSelectElement>(`select[name='slipper_size_${checkbox.name.replace("seat_attending_", "")}']`);
      if (select) select.disabled = no || !checkbox.checked;
    }
    for (const nameInput of form.querySelectorAll<HTMLInputElement>("input[name^='seat_name_']")) {
      const was = nameInput.closest(".admin-drawer_edit-seat-fields")?.querySelector<HTMLElement>("[data-admin-was]");
      const storedName = nameInput.dataset.shownName ?? "";
      if (was) {
        was.hidden = !storedName || nameInput.value === storedName;
      }
    }
  };
  const syncEditForms = () => {
    for (const form of document.querySelectorAll<HTMLFormElement>(".admin-drawer_edit-form"))
      syncEditForm(form);
  };
  document.addEventListener("change", (event) => {
    const form = (event.target as Element | null)?.closest<HTMLFormElement>(
      ".admin-drawer_edit-form",
    );
    if (!form) return;
    syncEditForm(form);
    const select = event.target instanceof HTMLSelectElement ? event.target : null;
    if (select?.name.startsWith("slipper_size_") && select.value) {
      select.classList.remove("has-error");
      const error = select.closest(".admin-drawer_edit-seat")?.querySelector<HTMLElement>(".admin-drawer_size-error");
      if (error) error.hidden = true;
    }
  });
  document.addEventListener("input", (event) => {
    const nameInput = event.target instanceof HTMLInputElement && event.target.name.startsWith("seat_name_")
      ? event.target
      : null;
    if (!nameInput) return;
    const was = nameInput.closest(".admin-drawer_edit-seat-fields")?.querySelector<HTMLElement>("[data-admin-was]");
    const storedName = nameInput.dataset.shownName ?? "";
    if (was) was.hidden = !storedName || nameInput.value === storedName;
  });
  syncEditForms();
  let opener: HTMLAnchorElement | null = null;
  const setOpen = (open: boolean) => {
    document.documentElement.toggleAttribute("data-admin-drawer-open", open);
  };
  const closeDrawer = () => {
    const url = new URL(location.href);
    url.searchParams.delete("household");
    history.pushState(null, "", url);
    document.querySelector<HTMLElement>("[data-admin-drawer]")?.remove();
    setOpen(false);
    (
      opener ??
      document.querySelector<HTMLAnchorElement>("[data-admin-rsvp-link]")
    )?.focus();
  };
  const loadDrawer = async (url: string, push = true) => {
    try {
      const response = await fetch(url, { headers: { Accept: "text/html" } });
      if (!response.ok) throw new Error("drawer request failed");
      const next = new DOMParser()
        .parseFromString(await response.text(), "text/html")
        .querySelector<HTMLElement>("[data-admin-drawer]");
      if (!next) throw new Error("drawer missing");
      document.querySelector<HTMLElement>("[data-admin-drawer]")?.remove();
      document
        .querySelector<HTMLElement>("[data-admin-rsvps-page]")
        ?.append(next);
      syncLinks();
      syncEditForms();
      if (push) history.pushState(null, "", url);
      setOpen(true);
      next.querySelector<HTMLElement>("h2")?.focus();
    } catch {
      location.href = url;
    }
  };
  document.addEventListener("click", (event) => {
    const target = event.target as Element;
    const mouse = event as MouseEvent;
    if (
      mouse.button !== 0 ||
      mouse.metaKey ||
      mouse.ctrlKey ||
      mouse.shiftKey ||
      mouse.altKey
    )
      return;
    const rowLink = target.closest<HTMLAnchorElement>("[data-admin-rsvp-link]");
    if (rowLink) {
      event.preventDefault();
      opener = rowLink;
      void loadDrawer(rowLink.href);
      return;
    }
    const drawerNav = target.closest<HTMLAnchorElement>("[data-admin-drawer-nav]");
    if (drawerNav) {
      event.preventDefault();
      void loadDrawer(drawerNav.href);
      return;
    }
    if (target.closest("[data-admin-drawer-close], .admin-drawer_scrim")) {
      event.preventDefault();
      closeDrawer();
    }
  });
  document.addEventListener("keydown", (event) => {
    const drawer = document.querySelector<HTMLElement>("[data-admin-drawer]");
    if (!drawer) return;
    if (event.key === "Escape") {
      event.preventDefault();
      if (drawer.querySelector(".admin-drawer_edit-form")) {
        const url = new URL(location.href);
        url.searchParams.delete("edit");
        void loadDrawer(url.href);
      } else {
        closeDrawer();
      }
      return;
    }
    if (event.key !== "Tab") return;
    const focusable = [
      ...drawer.querySelectorAll<HTMLElement>(
        "a,button:not([disabled]),input:not([type='hidden']):not([disabled]),select:not([disabled]),textarea:not([disabled]),[tabindex]:not([tabindex='-1'])",
      ),
    ].filter((element) => !element.hidden && !element.closest("[hidden]") && element.getAttribute("aria-hidden") !== "true");
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable.at(-1)!;
    const active = document.activeElement;
    const activeIndex = focusable.indexOf(active as HTMLElement);
    if (!drawer.contains(active) || activeIndex === -1) {
      event.preventDefault();
      (event.shiftKey ? last : first).focus();
    } else if (event.shiftKey && active === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
  window.addEventListener("popstate", () => {
    const url = new URL(location.href);
    if (url.searchParams.has("household")) void loadDrawer(url.href, false);
    else {
      document.querySelector<HTMLElement>("[data-admin-drawer]")?.remove();
      setOpen(false);
    }
  });
  if (document.querySelector("[data-admin-drawer]")) {
    setOpen(true);
    syncLinks();
    document.querySelector<HTMLElement>("[data-admin-drawer] h2")?.focus();
  }
  if (document.querySelector("[data-admin-saved]")) {
    const url = new URL(location.href);
    url.searchParams.delete("saved");
    history.replaceState(null, "", url);
  }
</script>
