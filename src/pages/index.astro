---
import Layout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/sections/Hero.astro";
import Invitation from "@/components/sections/Invitation.astro";
import Wedding from "@/components/sections/Wedding.astro";
import Attire from "@/components/sections/Attire.astro";
import Entourage from "@/components/sections/Entourage.astro";
import Stay from "@/components/sections/Stay.astro";
import Explore from "@/components/sections/Explore.astro";
// Ribbon marquee hidden for now; restore this import and <Ribbons /> below to show it.
// import Ribbons from "@/components/sections/Ribbons.astro";
import Gallery from "@/components/sections/Gallery.astro";
import Playlist from "@/components/sections/Playlist.astro";
import Faq from "@/components/sections/Faq.astro";
import Rsvp from "@/components/sections/Rsvp.astro";
import Preloader from "@/components/global/Preloader.astro";
---

<Layout theme="light">
  <Preloader slot="preloader" />
  <Hero />
  <Invitation />
  <Wedding />
  <Attire />
  <Entourage />
  <Stay />
  <Explore />
  {/* <Ribbons /> */}
  <Gallery />
  <Playlist />
  <Faq />
  <Rsvp />
</Layout>
