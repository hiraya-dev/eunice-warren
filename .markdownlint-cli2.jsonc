{
  // Lightweight docs check. Structural problems only; prose style is not linted.
  // MD022 and MD032 are off because the lessons ledger puts each entry's field
  // list directly under its heading (the format scripts/lessons/select.mjs parses).
  "config": {
    "default": true,
    "MD013": false,
    "MD022": false,
    "MD024": { "siblings_only": true },
    "MD032": false,
    "MD033": false,
    "MD040": false,
    "MD041": false
  },
  // src/** is site content (content collections), rendered by the build, not
  // workflow prose. .context/** holds local scratch files and saved logs.
  // Vendored skills (skills-lock.json) are kept byte-for-byte as published.
  "ignores": [".claude/**", ".context/**", ".agents/skills/copy-editing/**", "src/**", "node_modules/**", "dist/**", "playwright-report/**", "test-results/**"]
}
